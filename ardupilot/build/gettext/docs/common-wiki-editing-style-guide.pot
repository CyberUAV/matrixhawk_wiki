#: c17ce51d758f4847a7fc1648cdbf9d3e
msgid "Images in common pages or useful across wikis should be in the root **/images** directory."
msgstr ""

#: ../../source/docs/common-wiki-editing-style-guide.rst:357
#: 11ad0995c9af4a888801dd7621d58ca2
msgid "Images specific to the wiki can be stored in its **/images** sub directory."
