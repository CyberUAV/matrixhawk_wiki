msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 12"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:97
#: 2f757c641b2f4aee9c9afd58980b025c
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11"
msgstr ""

