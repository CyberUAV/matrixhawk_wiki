#: ../../source/docs/common-luxf765-ndaa.rst:342
#: 5254fcae2ee547d89708aa1c5bd1f545
msgid "PWM 9/10 (S1/S2) are in Group3"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:343
