#: ../../source/docs/common-luxf765-ndaa.rst:330
#: 4238006549d643679866b2f221c62c02
msgid "The Lumenier LUX F765 NDAA supports 12 PWM outputs and a serial LED PWM output. All outputs are DShot capable. Outputs 1-4 are bi-directional DShot capable. Outputs are grouped and every group must use the same output protocol."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:332
#: e04f62a0631b4ed38cb47952912a092f
msgid "The 8 main PWM outputs are labeled M1 through M8. The 4 auxiliary outputs are labeled S1 through S4."
msgstr ""

