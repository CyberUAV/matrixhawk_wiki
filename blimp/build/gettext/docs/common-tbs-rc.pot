#: ../../source/docs/common-tbs-rc.rst:56
#: aaac6b4d2eb1481f99e9b1544ce4792a
#: 2c34785f39a041e4b78ee3326cd86cd6
msgid "Set :ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 2"
msgstr ""

