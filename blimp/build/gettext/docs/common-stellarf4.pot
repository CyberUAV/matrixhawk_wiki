msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:92
#: 77c89057bed946ca851d12f463c6f508
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11 (CURR pin)"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:93
#: f2fef565034a4f2a9d6953c886e65365
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 11"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:94
#: 6f3ca8eb2cec4d4db9f41f882896493f
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 52.7"
msgstr ""

