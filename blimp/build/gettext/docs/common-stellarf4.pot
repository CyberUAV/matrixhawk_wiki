#: bf5da036778b46a39fa14874308eb21a
msgid "FPort requires connection to TX2 and :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` set to \"7\". See :ref:`common-FPort-receivers`."
msgstr ""

#: ../../source/docs/common-stellarf4.rst:65
#: 04a0a5acd4f3435d9cf2f6e8009c673d
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to “4”."
msgstr ""

#: ../../source/docs/common-stellarf4.rst:68
#: 0d0c3fe285fb4500840c1793a54cad88
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:69
#: 7f8598ac81f7481fa04bb8079a35065b
msgid "StellarF4 supports using its internal OSD using OSD_TYPE 1 (MAX7456 driver). External OSD support such as DJI or DisplayPort can be used simultaneously and is preconfigured on SERIAL3 but can be supported on any spare UART. See :ref:`common-msp-osd-overview-4.2` for more info."
msgstr ""

#: ../../source/docs/common-stellarf4.rst:73
#: 665c11bc1b1b41918406a8f61a7db1f8
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:74
#: c39cdfeaffa14414810eaffbe5aa992f
msgid "StellarF4 supports up to 10 PWM/Dshot outputs. PWM1-4 outputs support Bi-Directional DShot."
msgstr ""

#: ../../source/docs/common-stellarf4.rst:76
#: 88a633e2feaa43eda34e923eb6ae8917
msgid "Channels 1-4 support bi-directional DShot. Channels 1-8 marked as M1-M8 on the board. Channels 9-10 marked as S1-S2 on the board. PWM outputs are grouped and every group must use the same output protocol:"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:79
#: b3132f4bf9d54df39996bc345c2505f3
msgid "1, 2, 3, 4  are Group 1;"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:80
#: c01af6b12fef4ffd970d9e9f11ecc32b
msgid "5, 6, 7, 8  are Group 2;"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:81
#: 77489e32ab49409e8f4c216f9c122bd5
msgid "9           is Group 3;"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:82
#: f6bf545909d9424988c1b23dde542ec9
msgid "10           is Group 4;"
msgstr ""

#: ../../source/docs/common-stellarf4.rst:85
