#: ../../source/docs/common-install-sdcard.rst:117
#: 5f078aae5a734f35bdcabaca9eae64c1
msgid "Also you must include the SD card setup. See the `MatekH743 autopilot definition <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_HAL_ChibiOS/hwdef/MatekH743/hwdef-bl.dat>`__ for an example."
msgstr ""

