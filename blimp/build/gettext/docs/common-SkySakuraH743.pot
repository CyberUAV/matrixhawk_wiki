#: 403ad96998194f97a613cec474adb118
msgid "Firmware can be found on the `firmware server <https://firmware.ardupilot.org>`__  in the \"SkySakuraH743\" folders."
msgstr ""

#: ../../source/docs/common-SkySakuraH743.rst:127
#: c2ee29c87a274d21b20b49b0ac09a5f4
msgid "Loading Firmware"
msgstr ""

