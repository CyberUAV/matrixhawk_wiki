#: ccb4a3be78e34cbdbafa7c035067175a
msgid "The default battery configuration is:"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:83
#: a8f3557ae0b14d778695177221c9a851
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:84
#: efd60bac45a94ac4be1724b40a153ace
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 14"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:85
#: 273b52c099ee48ba9c22ef356c15b616
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11 (CURR pin)"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:86
#: 887e7ef83a634519b4b1ed897408bbfc
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 13"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:87
#: cde5f858ae7d428e8126a9b771c4c06a
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 37"
msgstr ""

