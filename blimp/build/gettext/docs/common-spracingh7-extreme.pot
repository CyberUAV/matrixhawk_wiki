#: ../../source/docs/common-spracingh7-extreme.rst:87
#: 6330e57e25bd444da2eefea4d31f770e
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-spracingh7-extreme.rst:88
#: 2686755eb0a6408b80d2c1d38f75c2a0
msgid "RC input is configured on the R1 (UART1_RX) pin. It supports all RC protocols except PPM. See :ref:`common-rc-systems` for details for a specific RC system. :ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>` is set to \"23\", by default, to enable this."
msgstr ""

#: ../../source/docs/common-spracingh7-extreme.rst:90
#: e241e0f72bc54f4eb4d48e90a663de52
msgid "SBUS/DSM/SRXL connects to the R1 pin but SBUS requires that the :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` be set to \"3\"."
msgstr ""

#: ../../source/docs/common-spracingh7-extreme.rst:92
#: 30a8a7574e5646a5824532401393f7b4
msgid "FPort requires connection to T6 and :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-spracingh7-extreme.rst:94
#: 4dc9dff9888f41aea99ca726a1aeee31
msgid "CRSF also requires a T1 connection, in addition to R1, and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to \"0\"."
msgstr ""

#: ../../source/docs/common-spracingh7-extreme.rst:96
#: ed3d1c51f4fe4a63a8d0494aadcaefd8
msgid "SRXL2 requires a connection to T1 and automatically provides telemetry.  Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-spracingh7-extreme.rst:98
#: 6186d911316649708cdd0018977d3a34
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

