#: f9afc6787e054ed499e16653c62ab6ef
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-radiolinkpix6.rst:526
#: 9884525dd7894008bebfbc3d1b3473a1
msgid "The RadiolinkPIX6 support using its internal OSD using OSD_TYPE 1 (MAX7456 driver). External OSD support such as DJI or DisplayPort is supported using UART3 or any other free UART. See :ref:`common-msp-osd-overview-4.2` for more info."
msgstr ""

#: ../../source/docs/common-radiolinkpix6.rst:529
#: 8ca2fb9130f149b18282f405a30f8776
msgid "PWM Outputs"
msgstr ""

#: ../../source/docs/common-radiolinkpix6.rst:531
#: f63dc9bd03dd44a791826953b17643fd
msgid "The RadiolinkPIX6 supports up to 16 PWM outputs. All 16 outputs support all normal PWM output formats. All FMU (\"AUX OUT\") outputs also support DShot."
msgstr ""

#: ../../source/docs/common-radiolinkpix6.rst:533
#: a5da6299c0344a6083d3d670412d407e
msgid "The 8 FMU PWM outputs are in 4 groups:"
msgstr ""

#: ../../source/docs/common-radiolinkpix6.rst:536
#: 65e127deaf00400198d2075657e4845e
msgid "Outputs 1, 2, 3 and 4 in group1"
msgstr ""

#: ../../source/docs/common-radiolinkpix6.rst:537
#: 1a38bd821ad0416da9d3d0bd3aacf629
msgid "Outputs 5 and 8 in group2"
msgstr ""

#: ../../source/docs/common-radiolinkpix6.rst:538
#: 0fe0f123ef71424590094346da8812cc
msgid "Outputs 6 and 7 in group3"
msgstr ""

#: ../../source/docs/common-radiolinkpix6.rst:540
#: 4feda3b465b348a78308a060531267e0
msgid "FMU outputs within the same group need to use the same output rate and protocol, ie. if any output in a group uses DShot then all channels in that group need to use DShot."
msgstr ""

