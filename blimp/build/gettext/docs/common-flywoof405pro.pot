msgstr ""

#: ../../source/docs/common-flywoof405pro.rst:76
#: ff5c6f627ca542e29799942b43b4c8d1
msgid "Dshot capability"
msgstr ""

#: ../../source/docs/common-flywoof405pro.rst:78
#: b82f429028b845b3a7e2652d84da925e
msgid "The FlywooF405 Pro supports up to 9 PWM outputs. The M1 to M4 outputs are on the esc connector and are bi-directional DShot capable, M5 to M8 on solder pads and DShot capable, plus LED pad(PWM output 9) for LED strip or another PWM output."
msgstr ""

#: ../../source/docs/common-flywoof405pro.rst:80
#: e794cea2285e4677b68f56f8e8f5b35b
msgid "The PWM is in 3 groups:"
msgstr ""

#: ../../source/docs/common-flywoof405pro.rst:82
#: c284cfbc286b423989eaa30953ab2f46
msgid "PWM 1-2,5,7 in group1"
msgstr ""

#: ../../source/docs/common-flywoof405pro.rst:83
#: b2eecad045704c509e218069661553b3
msgid "PWM 3-4 in group2"
msgstr ""

#: ../../source/docs/common-flywoof405pro.rst:84
#: 22c40fe9297b4497b61f8ed5442b8c26
msgid "PWM 6,8 in group2"
msgstr ""

#: ../../source/docs/common-flywoof405pro.rst:85
#: ab84607db698483e98e44b22c0d6931d
msgid "PWM 9   in group3"
msgstr ""

#: ../../source/docs/common-flywoof405pro.rst:87
#: ba9b35dc5aa84b538930030ea1d620e1
msgid "Channels within the same group need to use the same output protocol. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-4 also support bi-directional DShot."
msgstr ""

