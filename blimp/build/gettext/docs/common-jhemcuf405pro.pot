#: ../../source/docs/common-jhemcuf405pro.rst:85
#: 8a08085860e24d0ba6cda848b055cecc
msgid "Compass"
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:86
#: 6f835d59d2ec47a69e41f7a92a41a4fc
msgid "JHEMCUF405PRO does not have a builtin compass, but you can attach an external compass using I2C on the SDA and SCL pads. The SCL/SDA pads are exposed as two tiny circles."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:89
#: 0ca06ac1f4ae4e968aa19d052d75ab7e
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:90
#: ccea179b71a44ffa96808f05c0bf3b2c
msgid "Firmware for this board can be found `here <https://firmware.ardupilot.org>`__  in sub-folders labeled “JHEMCUF405PRO”."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:92
#: 7ddf327cec6248c6836c4c976ef8d393
msgid "Initial firmware load can be done with DFU by plugging in USB with the bootloader button pressed. Then you should load the \"with_bl.hex\" firmware, using your favourite DFU loading tool."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:96
#: f8add488499847f68d6051e9f4d9de40
msgid "Once the initial firmware is loaded you can update the firmware using any ArduPilot ground station software. Updates should be done with the \\*.apj firmware files."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:98
#: 2f61e32232854d18b3c3e557fbb7909d
msgid "If you're having trouble entering DFU mode then try desoldering the wire coming from the receiver to the board's input pad."
msgstr ""
