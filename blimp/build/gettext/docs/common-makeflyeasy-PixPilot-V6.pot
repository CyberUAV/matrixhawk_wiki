#: ../../source/docs/common-makeflyeasy-PixPilot-V6.rst:347
#: 1f8b60fe8a1f4e0bb2f107d70abfce71
msgid "The SBus input pin, which by default is mapped to a timer input, can be used for all ArduPilot supported receiver protocols, except CRSF/ELRS and SRXL2 which require a true UART connection. However, FPort, when connected in this manner, will only provide RC without telemetry."
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixPilot-V6.rst:349
#: 4652cca2429b410b9fc42b67f5358b03
msgid "To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 receivers, a full UART, such as SERIAL4 (UART8) would need to be used for receiver connections. Below are setups using UART4. :ref:`SERIAL4_PROTOCOL<SERIAL4_PROTOCOL>` should be set to \"23\"."
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixPilot-V6.rst:351
#: 73df211c868e47a69cff2037cddfc11e
msgid "FPort would require :ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` be set to \"15\"."
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixPilot-V6.rst:353
#: 527b916e24dc4ef5a5fb6352411a4363
msgid "CRSF would require :ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` be set to \"0\"."
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixPilot-V6.rst:355
#: 7cbf7ddb9baa4672b063191c286ffce6
msgid "SRXL2 would require :ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` be set to \"4\" and connects only the UART4 TX pin."
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixPilot-V6.rst:357
#: bd77313f8af74c20aff4ef3e825325ed
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

