msgstr ""

#: ../../source/docs/flight-modes.rst:87
#: 87b96530b108411495d2f18fd3bad5a9
msgid "YAW"
msgstr ""

#: ../../source/docs/flight-modes.rst:87
#: dce850f24ec34e89baf7374d437a1e82
