msgid "THROTTLE"
msgstr ""

#: ../../source/docs/flight-modes.rst:90
#: 4da2ab340dbc4937afef2688cfd165e1
msgid "MANUAL: Ascend/Descend, VELOCITY: Full throw attempts to increase/decrease altitude ``MAX_VEL_Z`` m/s, LOITER: Full throw attempts to increase/decrease heading ``MAX_POS_Z`` m/s"
msgstr ""
