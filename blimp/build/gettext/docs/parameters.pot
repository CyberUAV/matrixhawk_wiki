msgid "Pitch-Axis"
msgstr ""

#: ../../source/docs/parameters.rst:36928
#: 34f303849f124aaab1d3df1ef21b311a
msgid "FFT\\_NUM\\_FRAMES: FFT output frames to retain and average"
msgstr ""

#: ../../source/docs/parameters.rst:36933
#: 3480ac8ecbc643b7a335bcc882f4a0f1
msgid "Number of output frequency frames to retain and average in order to calculate final frequencies\\. Averaging output frames can drastically reduce noise and jitter at the cost of latency as long as the input is stable\\. The default is to perform no averaging\\. For rapidly changing frequencies \\(e\\.g\\. smaller aircraft\\) fewer frames should be averaged\\."
msgstr ""

#: ../../source/docs/parameters.rst:36939
#: 57ca27bc30c04b71a4d73faa635e52d0
msgid "0 to 8"
msgstr ""

#: ../../source/docs/parameters.rst:36948
#: 5cca923d9c0b46cf9dece3bf187bff1b
msgid "FFT\\_OPTIONS: FFT options"
msgstr ""

#: ../../source/docs/parameters.rst:36953
#: ff722ecb8ad047e785b81e9e83a88394
msgid "FFT configuration options\\. Values\\: 1\\:Apply the FFT \\*after\\* the filter bank\\,2\\:Check noise at the motor frequencies using ESC data as a reference"
msgstr ""

