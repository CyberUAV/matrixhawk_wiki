msgstr ""

#: ../../source/docs/parameters.rst:36454
#: 338f113bb7a34be3831e040311720957
msgid "ESC\\_TLM\\_MAV\\_OFS: ESC Telemetry mavlink offset"
msgstr ""

#: ../../source/docs/parameters.rst:36457
#: 73667b79c2474777bf90d1a59a9bb970
msgid "Offset to apply to ESC numbers when reporting as ESC\\_TELEMETRY packets over MAVLink\\. This allows high numbered motors to be displayed as low numbered ESCs for convenience on GCS displays\\. A value of 4 would send ESC on output 5 as ESC number 1 in ESC\\_TELEMETRY packets"
msgstr ""

#: ../../source/docs/parameters.rst:36473
#: 2a4e46e362524a28b605dd35211e3d08
msgid "FENCE\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:36479
#: 743d38d89a5a48f88183e934e514322d
msgid "FENCE\\_ENABLE: Fence enable\\/disable"
msgstr ""

#: ../../source/docs/parameters.rst:36482
#: ee1b4df23f8040f9ac23b4ea72d8bc18
msgid "Allows you to enable \\(1\\) or disable \\(0\\) the fence functionality\\. Fences can still be enabled and disabled via mavlink or an RC option\\, but these changes are not persisted\\."
msgstr ""

#: ../../source/docs/parameters.rst:36504
#: ac4321131f3f4d4993d7be8453df2872
msgid "FENCE\\_ACTION: Fence Action"
msgstr ""

#: ../../source/docs/parameters.rst:36507
#: 701ecb7d68d3475e893ec61fcac6c09a
msgid "What action should be taken when fence is breached"
msgstr ""

#: ../../source/docs/parameters.rst:36516
#: 4a795066c78048d491e795a59adc4d78
msgid "Report Only"
msgstr ""

#: ../../source/docs/parameters.rst:36518
#: e678bfd6145b4e3b978618e07cdbc845
msgid "RTL or Land"
msgstr ""

#: ../../source/docs/parameters.rst:36529
#: 290d75bf1f48473f9adb97ae281c2adc
msgid "FENCE\\_RADIUS: Circular Fence Radius"
msgstr ""

#: ../../source/docs/parameters.rst:36532
#: 7c3754e4f58f4a9cb4b17d656c8e0ca0
msgid "Circle fence radius which when breached will cause an RTL"
msgstr ""

#: ../../source/docs/parameters.rst:36538
#: 55a2d31a0e7a492593ff40f3c8fbb01c
msgid "30 to 10000"
msgstr ""

#: ../../source/docs/parameters.rst:36547
#: 17c365845a0944308919345aaf6c2ed9
msgid "FENCE\\_MARGIN: Fence Margin"
msgstr ""

#: ../../source/docs/parameters.rst:36550
#: 83bb71c549354e99ac97c37fb827e1ca
msgid "Distance that autopilot\\'s should maintain from the fence to avoid a breach"
msgstr ""

#: ../../source/docs/parameters.rst:36565
#: def3b12a8ce4450b86756c6a953cd89e
msgid "FENCE\\_TOTAL: Fence polygon point total"
msgstr ""

#: ../../source/docs/parameters.rst:36568
#: c3e733b99f8a4e579b02e73eee846da2
msgid "Number of polygon points saved in eeprom \\(do not update manually\\)"
msgstr ""

#: ../../source/docs/parameters.rst:36574
#: 03fd6fda6b924fe1b3b86b6a03eac917
msgid "1 to 20"
msgstr ""

#: ../../source/docs/parameters.rst:36583
#: c8d49d51cf08472fbd8e2a275e395af4
msgid "FENCE\\_OPTIONS: Fence options"
msgstr ""

#: ../../source/docs/parameters.rst:36586
#: 986f576889594a77ab73dfcb7e36fe2d
msgid "When bit 0 is set disable mode change following fence action until fence breach is cleared\\. When bit 1 is set the allowable flight areas is the union of all polygon and circle fence areas instead of the intersection\\, which means a fence breach occurs only if you are outside all of the fence areas\\."
msgstr ""

#: ../../source/docs/parameters.rst:36595
#: 552e6251cddd4d39a08936bb60d57ec9
msgid "Disable mode change following fence action until fence breach is cleared"
msgstr ""

#: ../../source/docs/parameters.rst:36597
#: 648490184e5048448bd2489ea5d1dbaf
msgid "Allow union of inclusion areas"
msgstr ""

#: ../../source/docs/parameters.rst:36599
#: 84167aa0a67d4de8aa5e17b80bb04406
msgid "Notify on margin breaches"
msgstr ""

#: ../../source/docs/parameters.rst:36610
#: df8f3559b3bd4969ad60240cbd963217
msgid "FENCE\\_NTF\\_FREQ: Fence margin notification frequency in hz"
msgstr ""

#: ../../source/docs/parameters.rst:36614
#: 2705dbe7cf66420c9cecf45aca5a23f1
msgid "When bit 2 of FENCE\\_OPTIONS is set this parameter controls the frequency of margin breach notifications\\. If set to 0 only new margin breaches are notified\\."
msgstr ""

#: ../../source/docs/parameters.rst:36629
#: f192dfecb12048e1b98a834f69d167d9
msgid "FENCE\\_MARGIN\\_XY: Fence Horizontal Margin"
msgstr ""

#: ../../source/docs/parameters.rst:36632
#: 2d5c48b19ae544039bf6cc633051c425
msgid "Distance that autopilot\\'s should maintain from the fence in the horizontal plane to avoid a breach\\. If set to 0 then FENCE\\_MARGIN is used\\."
msgstr ""

