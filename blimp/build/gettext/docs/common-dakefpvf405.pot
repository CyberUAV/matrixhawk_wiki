#: ../../source/docs/common-dakefpvf405.rst:59
#: fcc43d602d4245b79b960c6c6f0408c1
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:60
#: 39d53cad88f84e1c8d448a1df9b2d701
msgid "RC input is configured by default via the USART2 RX input. It supports all unidirectional serial RC protocols except PPM and SBUS. The SBUS pin is inverted and applied to R2 for SBUS support."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:62
#: cbfb073fb8ca4ff3b96deb41610f1585
msgid "FPort requires an external bi-directional inverter attached to T2 and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` set to 4 (half-duplex).  See :ref:`common-FPort-receivers`."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:63
#: e3f5c6ef0aaf46e6a47bffe5ac791bdb
msgid "CRSF/ELRS uses RX2/TX2."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:64
#: 9583af3423664dcba75ccc34af8f4cc5
msgid "SRXL2 requires a connection to T2 and automatically provides telemetry.  Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:67
#: a920dbf68d354bcd8a5232e57f313619
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:68
#: f6321fd5626d41b3a6bf0e9e29687c3b
msgid "The DAKEFPV F405 supports up to 7 PWM or DShot outputs. The pads for motor output M1 to M6 are provided on both the motor connectors and on separate pads."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:71
#: 842288671b544b71850703157244f418
msgid "The PWM is in 4 groups:"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:74
#: 3490c5b11657448895ff22c3435bb6ce
msgid "PWM 1-2    in group1"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:75
#: 85cb780e1c5044d6ae17b69ddc6fc4ed
msgid "PWM 3-4    in group2"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:76
#: 65591503d22c47ab9d391f1423a147fb
msgid "PWM 5-6    in group3"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:77
#: 540d3acfd0b645b7ab2cdba3573f1afa
msgid "PWM 7(LED) in group4 (set as Serial LED output function by default)"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:79
#: 72f7decd2e7d417ca196a0177fbb0a86
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:84
#: 66706469d3e3416d84696f9094232b24
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:85
#: 647a021b8d9745ddab88af8899ec9163
msgid "The board has a built-in voltage sensor and external current sensor input. The current sensor can read up to 130 Amps. The voltage sensor can handle up to 8S LiPo batteries."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:88
#: c5b3353921e1487fb15d0902958e6955
msgid "The correct battery setting parameters are:"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:90
#: d531c71149244918aff1c07ac1a9ddea
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` 4"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:91
#: d6e50e4dacb24b28bfb7414e489598b2
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` 11"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:92
#: c5f4a4a58d2441dca2329a36a8e4ad91
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 10"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:93
#: 12a0431e10454ae4961c8b796930bbfa
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 11.0"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:94
#: 04a1fdb1785c49598ca7f92e88ca8c14
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` 83.3"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:97
#: ac5c7f888cbe4d32baa42f955a0c216e
msgid "RSSI"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:98
#: 321709f36a224991ac9dadfefdb83fef
msgid "ADC Pin 12 -> Analog RSSI voltage monitoring. Set :ref:`RSSI_TYPE<RSSI_TYPE>` = 1 and :ref:`RSSI_ANA_PIN<RSSI_ANA_PIN>` = 12. For RSSI embedded in digital RC protocols like CRSF, set :ref:`RSSI_TYPE<RSSI_TYPE>` = 3"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:101
#: f4069282353d4c2cba149b2be9e6e07c
msgid "Compass"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:102
#: 4aa285d084164c88bf49681f1f9f949a
msgid "The DAKEFPV F405 does not have a builtin compass, but you can attach an external compass using I2C on the SDA and SCL pads."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:105
#: c1503022d42e4029a741f991bc2b0633
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:106
#: 6b479e1401c94799b7ac1cb6f4de1ae4
msgid "The autopilot has an onboard OSD using a MAX7456 chip and is enabled by default. The CAM1/2 and VTX pins provide connections for using the internal OSD. Simultaneous DisplayPort OSD is also possible and is configured by default."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:109
#: 6066a521bd3c4d339b533940f5b56854
msgid "VTX power control"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:110
#: 930dbd1b98664b81abe1faa69139a381
msgid "GPIO 81 controls the VTX BEC output to pins marked \"12V\". Setting this GPIO low removes voltage supply to pins. By default RELAY2 is configured to control this pin and sets the GPIO high on boot."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:114
#: 1ab172c3c6734579866cbf4505eeb0e9
msgid "Camera control"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:115
#: a3fa1deee2ad4f8fbeab94b53d36c99d
msgid "GPIO 82 controls the camera output to the connectors marked \"CAM1\" and \"CAM2\". Setting this GPIO low switches the video output from CAM1 to CAM2. By default RELAY3 is configured to control this pin and sets the GPIO high on boot."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:118
#: c0f2e0d4e4c640d184eda84086f5214d
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:119
#: 2a34823e113043639de1bf5126237460
msgid "Firmware for these boards can be found `here <https://firmware.ardupilot.org>`__ in sub-folders labeled \"DAKEFPVF405\"."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:121
#: c503b39ce79e45d9b9882efc3128223c
msgid "Initial firmware load can be done with DFU by plugging in USB with the bootloader button pressed. Then you should load the \"with_bl.hex\" firmware, using your favourite DFU loading tool."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:125
#: 4653e9d94498402bb749e2c27ad7d6ae
msgid "Once the initial firmware is loaded you can update the firmware using any ArduPilot ground station software. Updates should be done with the \\*.apj firmware files."
msgstr ""
