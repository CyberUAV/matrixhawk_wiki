msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-spracingh7-rf.rst:93
#: 189a594079b74a2c9fb43a9e52b31861
msgid "The SPRacingH7 RF supports up to 9 PWM outputs. PWM 1-8 support DShot and Bi-Directional DShot. The pads for motor output M1 to M4 on ESC connector 1, and M5 to M8 on ESC connector 2, plus M9 for LED strip or another PWM output."
msgstr ""

#: ../../source/docs/common-spracingh7-rf.rst:97
#: 6ebaf770d72b4897a041b46258f05b5c
msgid "The PWM is in 5 groups:"
msgstr ""

#: ../../source/docs/common-spracingh7-rf.rst:99
#: e95caaa648e943569c14eba91f5e6b54
msgid "PWM 1-4   in group1"
msgstr ""

#: ../../source/docs/common-spracingh7-rf.rst:100
#: b06856b5b32443e3bbcaf15c22446678
msgid "PWM 5-8  in group2"
msgstr ""

#: ../../source/docs/common-spracingh7-rf.rst:101
#: fbd158791f4742b9a73c971e5f919bef
msgid "PWM 9 (LED)  in group3"
msgstr ""

#: ../../source/docs/common-spracingh7-rf.rst:104
#: 2a28dacf8e51493d80c20ef77587a129
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot."
msgstr ""

