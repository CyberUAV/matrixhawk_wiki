#: fcd83ab72e4e4e70ba4536d38aecbd31
msgid "PWM 7 and 8 in group3 (TIM1)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:85
#: 3ba118bd821544c7a199bb0dc9aae7c5
msgid "PWM 9, 10 and 11 in group4 (TIM8)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:86
#: 181f1746adfb42e391c1afd0d6315ce9
msgid "PWM 12 in group5 (TIM15)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:87
#: 3d8ae3209e684aee9f09c08889de3f2a
msgid "PWM 13 and 14 in group6 (TIM12)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:89
#: ca10e43e294a46508f85e8aa25b7b399
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Outputs 1-4 support BDShot."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:91
#: b90f54ef34544517ae539c1067d80a37
msgid "First first 8 PWM outputs of CUAV-7-Nano flight controller support switching between 3.3V voltage and 5V voltage output. It can be switched to 5V by setting GPIO 80 high by setting up a Relay (see :ref:`common-relay`) to control it."
msgstr ""

