#: ../../source/docs/common-tbs-lucid-h7-wing.rst:122
#: 7a706b2b9f3e4b0aadf3e251b40c83cf
msgid "VTX power control"
msgstr ""

#: ../../source/docs/common-tbs-lucid-h7-wing.rst:123
#: 7fdd6bcdb2be4638b2a9ad6f3d802333
msgid "GPIO 81 controls the Vsw pins which can be set to output either VFC (9/12V) or 5V via a board jumper. Setting this GPIO high removes voltage supply to pins. RELAY2 is configured by default to control this GPIO and is low by default."
msgstr ""

#: ../../source/docs/common-tbs-lucid-h7-wing.rst:125
#: 494e34f1d128422e943592098bd3a7dc
msgid "GPIO 83 controls the VTX BEC output to pins marked \"9V/12V\"  included on the HD VTX connector and VFC pads and is included on the HD VTX connector. Setting this GPIO low removes voltage supply to this pin/pad. By default RELAY4 is configured to control this pin and sets the GPIO high."
msgstr ""

#: ../../source/docs/common-tbs-lucid-h7-wing.rst:129
#: e5ff00969f744364b12c01fabbe907ad
msgid "Camera control"
msgstr ""

#: ../../source/docs/common-tbs-lucid-h7-wing.rst:130
#: 13ab1b75ab6447baa1de6976f315badb
msgid "GPIO 82 controls the camera output to the connectors marked \"C1\" and \"C2\". Setting this GPIO low switches the video input from C1 to C2. By default RELAY3 is configured to control this pin."
msgstr ""

#: ../../source/docs/common-tbs-lucid-h7-wing.rst:133
