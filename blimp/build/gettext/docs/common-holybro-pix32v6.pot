#: 8307bc6834b04307a663287785920f4d
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:40
#: 10f504433e6240a1bc1a694ed2c98149
msgid "The RCIN pin, which by default is mapped to a timer input, can be used for all ArduPilot supported receiver protocols, except CRSF/ELRS and SRXL2 which require a true UART connection. However, FPort, when connected in this manner, will only provide RC without telemetry."
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:42
#: 60d3ab64b8db4dde9e484270f6392134
msgid "To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 receivers, a full UART, such as SERIAL6 (UART3) would need to be used for receiver connections. Below are setups using Serial6."
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:44
#: 71155bf4b3b84d5baf547ee00b28fc71
msgid ":ref:`SERIAL6_PROTOCOL<SERIAL6_PROTOCOL>` should be set to \"23\"."
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:46
#: 71d90f406f2a43b7ad48e6ef67187ce1
msgid "FPort would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"15\"."
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:48
#: 6a6349309e23474f8be74902a69b375b
msgid "CRSF would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"0\"."
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:50
#: af8f7591d3e446a2acd0320268d31741
msgid "SRXL2 would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"4\" and connects only the TX pin."
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:52
#: 7767e088e35948b7b3f8d5e59ea1c8aa
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:55
#: 8581fd0dc79c4b2c8db109f2b3dc7c0b
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:57
#: ed120f48a0114e30b3730355ccdc7e20
msgid "The Pix32v6 supports up to 16 PWM outputs. All 16 outputs support all normal PWM output formats. All FMU outputs (marked \"FMU PWM Output\") also support DShot."
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:60
#: a74aa9add31c48c59b16b0682eae0e1e
msgid "The 8 FMU PWM outputs are in 4 groups:"
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:62
#: 2a02bbe4c82e458993fb0590c45d5457
msgid "PWM 1, 2, 3 and 4 in group1"
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:63
#: b0555f44a5fc4f3097248b55b0384ca4
msgid "PWM 5 and 6 in group2"
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:64
#: 847b2ad85ea847c8ab4a2c5f6cd6f64f
msgid "PWM 7 and 8 in group3"
msgstr ""

#: ../../source/docs/common-holybro-pix32v6.rst:67
#: 25ebbda6a810415daf5878c1534b665f
msgid "FMU outputs within the same group need to use the same output rate and protocol. If any output in a group uses DShot then all channels in that group need to use DShot."
msgstr ""

