msgstr ""

#: ../../source/docs/common-spedixh743.rst:54
#: 6b599c7ba30c421386233a54f846cd54
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:55
#: 16c30fb13e104cb5b7241b3a23797316
msgid "The SPEDIX F405 supports up to 9 PWM outputs. The pads for motor output M1 to M8 are provided on both the motor connectors and on separate pads, plus M9 on a separate pad for LED strip (default configuration) or another PWM output."
msgstr ""

#: ../../source/docs/common-spedixh743.rst:59
#: 4fed558092d44ab6936a314050ed7bae
msgid "The PWM is in 4 groups:"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:61
#: e56fe553c7a44b7997fe2acd8e0b1025
msgid "PWM 1-4 in group1"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:62
#: b6733ed257204a159f4e0dd6b978cc73
msgid "PWM 5-6 in group2"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:63
#: 7c6bc6b412554914a87be327300360ca
msgid "PWM 7-8 in group3"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:64
#: f501eff1d92f4736a33fecb834d84e2a
msgid "PWM 9 in group4"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:66
#: 101da006cf0a4123baa923f766482f77
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-8 support bi-directional dshot."
msgstr ""

