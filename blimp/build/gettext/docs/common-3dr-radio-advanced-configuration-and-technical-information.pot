#: ../../source/docs/common-3dr-radio-advanced-configuration-and-technical-information.rst:360
#: ae2cdcba0c0f45628735bfd3042fb81d
msgid "ATSn? - display radio parameter number 'n'"
msgstr ""

#: ../../source/docs/common-3dr-radio-advanced-configuration-and-technical-information.rst:361
