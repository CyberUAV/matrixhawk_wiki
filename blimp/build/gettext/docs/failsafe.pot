#: ../../source/docs/failsafe.rst:5
#: 048d26e97ba84c0b8377dda92b89fa23
msgid "Failsafe Setup"
msgstr ""

#: ../../source/docs/failsafe.rst:7
#: 0a8b7c3fe765468582e8f8f68d531773
msgid "Since the Blimp code is very new, limited failsafe behavior is currently provided and is expected to improve and evolve over time."
msgstr ""

#: ../../source/docs/failsafe.rst:9
#: ee609db394b84bfea31b23c641ae3891
msgid "Blimp provides several failsafes which can be enabled or disabled:"
msgstr ""

#: ../../source/docs/failsafe.rst:11
#: 6924b73aaab54f10b7a73e72e7c39f30
msgid "RC loss via :ref:`FS_THR_ENABLE<FS_THR_ENABLE>` or via lost RC signal for greater than :ref:`RC_FS_TIMEOUT<RC_FS_TIMEOUT>` (default = 1 sec), always disarms on any RC failsafe. \"0\" ignores RC failsafes"
msgstr ""

#: ../../source/docs/failsafe.rst:12
#: add2004c98b145fe91b6d30231f39375
msgid "Ground Control Station via :ref:`FS_GCS_ENABLE<FS_GCS_ENABLE>`, any non-zero value enables disarming after :ref:`FS_GCS_TIMEOUT<FS_GCS_TIMEOUT>` seconds of GCS connection failure. \"0\" ignores GCS connection failures."
msgstr ""

#: ../../source/docs/failsafe.rst:13
#: a01b6a8a72404ad5a51f7f2ebe4b9e48
msgid "EKF Failsafe, when EKF is determined to be unhealthy, :ref:`FS_EKF_ACTION<FS_EKF_ACTION>` occurs"
msgstr ""

#: ../../source/docs/failsafe.rst:14
#: 112c31283b1a4453920fbde83c9c1598
msgid "Vibration Failsafe via :ref:`FS_VIBE_ENABLE<FS_VIBE_ENABLE>`"
msgstr ""

#: ../../source/docs/failsafe.rst:15
#: 0726d84a2761456a968f5f9275ccde53
msgid "Battery Failsafe via :ref:`BATT_LOW_VOLT<BATT_LOW_VOLT>` and :ref:`BATT_CRT_VOLT<BATT_CRT_VOLT>`,always disarms currently, independent of failsafe action selected by the :ref:`BATT_FS_CRT_ACT<BATT_FS_CRT_ACT>` and :ref:`BATT_FS_LOW_ACT<BATT_FS_LOW_ACT>` parameters."
msgstr ""

#: ../../source/docs/failsafe.rst:17
#: 017f3b6d7a394f62a95a7bd09ffcc662
msgid "setting :ref:`FS_THR_ENABLE<FS_THR_ENABLE>` to 1 also allows throttle values below :ref:`FS_THR_VALUE<FS_THR_VALUE>` to force a failsafe in addition to RC loss or corruption. Be sure its set below any active throttle channel value to avoid triggering a failsafe unintentionally while demanding maximum descent."
msgstr ""
