#: ../../source/docs/common-corvon743v1.rst:56
#: 734e44d3343b4783bee4e2b375907a67
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:57
#: 20d3c580567344d58502993f599660e3
msgid "The default RC input is configured on the UART6. The SBUS pin is inverted and connected to RX6. Non SBUS, single wire serial inputs can be directly tied to RX6 if SBUS pin is left unconnected. RC could  be applied instead to a different UART port such as UART1, UART4 or UART8, and set the protocol to receive RC data ``SERIALn_PROTOCOL`` =23 and change :ref:`SERIAL5_PROTOCOL <SERIAL5_PROTOCOL>` to something other than '23'. For RC protocols other than unidirectional, the TX6 pin will need to be used:"
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:59
#: 601047c5fd254d36b8161ab17e6899c8
msgid ":ref:`SERIAL5_PROTOCOL<SERIAL5_PROTOCOL>` should be set to \"23\"."
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:60
#: 5b0feaeb470f48dd8adc457cd2b20ec9
msgid "FPort would require :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>` be set to \"15\"."
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:61
#: e7254617b3854df49f60a5c4037b4282
msgid "CRSF would require :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>` be set to \"0\"."
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:62
#: 50e7591248ae44d79e2cb324f985d845
msgid "SRXL2 would require :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>` be set to \"4\" and connects only the TX pin."
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:65
#: 9ce2b9f0748648c79970ff19763e4380
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:67
#: 83f65ae51d6f4a93bb19e085cc25ffd4
msgid "The CORVON743V1 supports onboard OSD using OSD_TYPE 1 (MAX7456 driver). Simultaneously, DisplayPort OSD is available on the HD VTX connector, See below."
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:70
#: aaaae1774cc4469f8afe9a936009fa2d
msgid "HD VTX Support"
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:71
#: cbac231faedd4fc39e6e11e413671a34
msgid "The SH1.0-6P connector supports a DJI Air Unit / HD VTX connection. Protocol defaults to DisplayPort. Pin 1 of the connector is 9v so be careful not to connect this to a peripheral that can not tolerate this voltage."
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:74
