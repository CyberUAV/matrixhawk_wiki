msgstr ""

#: ../../source/docs/frame-type.rst:12
#: 9b7b9ea8e4104482a1e605af8abee53a
msgid "1 Prerequisites"
msgstr ""

#: ../../source/docs/frame-type.rst:14
#: ead2665fd163439a8f30ca63f46420b1
msgid "The vehicle is completely built to flight condition."
msgstr ""

#: ../../source/docs/frame-type.rst:15
