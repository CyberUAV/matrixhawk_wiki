#: ../../source/docs/common-wiki-editing-quick-edit.rst:5
#: b92c4bc2778443c78ee7e40e11895591
msgid "Wiki Editing - Quick Edits"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:7
#: ec4bcc3ee8c245f39fc470d0abb800d2
msgid "Below is a video tutorial for quickly editing the ArduPilot wiki"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:12
#: 5709b06ac23048d9b1e1ecab2bba27d2
msgid "Create a `Github account <https://github.com/join>`__ if you do not have one already"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:13
#: 0ce3ff4f8401479298221bc9bce20342
msgid "Find the page you wish to edit and click the **Edit on GitHub** link on the top right of the page to be taken to its source"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:14
#: 837625fcbae8450ab827a4752813c84a
msgid "Select the **Edit this file** icon"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:18
#: cb99337d234040fcb701994da0b38069
msgid "Make the changes in the \"Edit file\" tab and use the \"Preview changes\" tab to check the change.  Note: links to other wiki pages are not rendered properly and will appear with ``:ref:``` in front"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:19
#: 8ffd5975ab474be1bfa983d9513a0f61
msgid "At the bottom of the page under \"Commit changes\""
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:21
#: 9facaeecc56f484eb6a0f0cd28086330
msgid "Fill in the subject line with a short description of the change"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:22
#: 5516005dc9284a56ae68ff2f803b31da
msgid "Optionally fill in an extended description"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:23
#: 1c0ed8c7b981487aa5649b0aa46f3176
msgid "Click \"Create a new branch for this commit\""
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:24
#: c09c3ed4ccd44997a44d63106d74a9c1
msgid "Press the \"Commit changes\" button"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:26
#: 36e0be47112c441ba6047796431a16ab
msgid "When taken to the \"Open a pull request\" screen, press the \"Create pull request\" button"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:28
#: c3c9b71dce3841039ac3339038f5be41
msgid "For more information see the Github Help topic: `Editing files in another user's repository <https://help.github.com/articles/editing-files-in-another-user-s-repository/>`__"
msgstr ""

#: ../../source/docs/common-wiki-editing-quick-edit.rst:32
#: cba1d765e0ba4cf99d5620ac407a7c05
msgid "Wiki home pages (named \"index.html\") do not have the **Edit on GitHub** link. You can still edit them by manually navigating to the desired page on Github."
msgstr ""
