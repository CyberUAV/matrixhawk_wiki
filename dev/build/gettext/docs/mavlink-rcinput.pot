#: ../../source/docs/mavlink-rcinput.rst:5
#: e3a538eb540e4387ba5212e737c1a65c
msgid "RC Input (aka Pilot Input)"
msgstr ""

#: ../../source/docs/mavlink-rcinput.rst:7
#: abaee96895794b39929f1a38728b2d03
msgid "Traditionally the pilot's manual input via an RC transmitter is sent to the autopilot via a separate wireless link but it can alternatively be sent via MAVLink.  This page describes the messages that can be used and gives advice on some potential issues"
msgstr ""

#: ../../source/docs/mavlink-rcinput.rst:9
#: d981dc8e5e8d4a31906448d5459b04ff
msgid "For reference here are some user focused RC related wiki pages:"
msgstr ""

