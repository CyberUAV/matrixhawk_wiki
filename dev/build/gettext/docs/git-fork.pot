#: ../../source/docs/git-fork.rst:5
#: d1181feb235744c99e5c91bbe9e4f751
msgid "Forking the repository"
msgstr ""

#: ../../source/docs/git-fork.rst:10
#: 69112b6f695e4d618e96dcd7010f29a5
msgid "If you are working towards :ref:`submitting code back to the main ArduPilot repo <submitting-patches-back-to-master>` you will want to create your own personal copy of the ArduPilot repository on the GitHub servers.  This is called \"forking\" the repo."
msgstr ""

#: ../../source/docs/git-fork.rst:12
#: 7d303eca5fb145b6bb700754ccad5336
msgid "When you fork the ArduPilot repo, the code's history of changes is preserved and a relationship between the fork and the original is maintained which allows the fork to be updated from the original and for changes to be submitted back to the original."
msgstr ""

#: ../../source/docs/git-fork.rst:14
#: e96c5b5a375f467f84c8f07d0e31511a
msgid "`sign up for a free user account with Github <https://github.com/join>`__"
msgstr ""

#: ../../source/docs/git-fork.rst:15
#: 004cd1ba269f4fa79027a3d0c221529e
msgid "open a web browser and go to `github.com/ArduPilot/ardupilot <https://github.com/ArduPilot/ardupilot>`__"
msgstr ""

#: ../../source/docs/git-fork.rst:16
#: b51dac9c1c944f518f115125d1566168
msgid "Click the \"Fork\" button on the upper right corner and follow the instructions"
msgstr ""

#: ../../source/docs/git-fork.rst:20
#: e6456d54fc4443a7b9669a9bc85385b3
msgid "When your are finished there will be a new repository within your account: ``//github.com/your-github-userid/ardupilot``"
msgstr ""

#: ../../source/docs/git-fork.rst:22
#: ae1a3f64ae4f48c8998fc7349b11ec7e
msgid "This forked repository is what you will :ref:`clone <git-clone>` and work on locally when making changes to the code."
msgstr ""
