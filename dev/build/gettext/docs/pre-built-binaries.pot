#: ../../source/docs/pre-built-binaries.rst:6
#: ad2c8db7b7924593a88d7ebbf3bce4d1
msgid "ArduPilot Pre-Built Binaries"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:8
#: 5d5ffee9b8314f439439add702cc1c5b
msgid "The ArduPilot firmware server at https://firmware.ardupilot.org has pre-built binaries for many common flight boards."
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:11
#: 4513e574e0df4c0e87ba226a1d2e367d
msgid "Build Categories"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:13
#: 92b0d592478a4bed85e9e8cb29b0f986
msgid "For each vehicle type there are 4 categories of pre-built binary:"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:15
#: 21c42fdda171477494b008595e519956
msgid "stable: the most recent stable release, recommended for normal usage"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:16
#: 41e23d3624d942c795ab9a8a01e81716
msgid "beta: the most recent beta release, this is for users who wish to help test new features before they go into a stable release"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:17
#: 547e368dc07e4daf850af9ebf8cbd584
msgid "latest: the most recent build of our git master branch, this contains the latest code. Use with caution, this version has undergone very little testing"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:18
#: 4d6f4161a812421195ec07bc478caea7
msgid "historical builds: These are older version of the latest builds. These can be used to find when a bug was introduced by trying a range of build dates"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:22
#: d3da113fb00c4cb59de99f4874e799ab
msgid "File Types"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:24
#: 8b8a8893fefb43f8822417528d43dc3b
msgid "Within the build directories you will find files of the following types:"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:27
#: df734533d1cd44f6abd4e36b04e3e2e8
msgid "``*.apj`` files: these are \"ArduPilot JSON\" firmwares, which contain a firmware that can be loaded by ArduPilot compatible ground station software"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:28
#: b062d29971f449ee97b1aeea534b2844
msgid "``*.px4`` files: these are an older name for an apj file, and use the same format"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:29
#: 69f4f26f1fda43b7bd7ff27c06abd5bb
msgid "``*.hex`` files: these are firmwares in Intel hex format, for loading with DFU loading tools. These are used for boards which don't come with an ArduPilot compatible bootloader"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:31
#: f2e31ca6f0604f6ca3820583f511e7cb
msgid "``*_with_bl.hex`` files: these are variants of the hex files with the bootloader built-in. They can be used to install both the bootloader and ArduPilot vehicle firmware in one step using a DFU loading tool"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:35
#: f180a341cbbb419797e670d458f909ab
msgid "Build Variants"
msgstr ""

#: ../../source/docs/pre-built-binaries.rst:37
#: 74ebcb5e83fc4eeb833157aa7094263f
msgid "For some types of flight boards multiple builds in separate directories are provided. For example, you can find a firmware suitable for a Pixhawk 2.1 (CubePilot CubeBlack) in both the px4-v3 directory and the CubeBlack directory. These variants use different underlying RTOS code (NuttX and ChibiOS). As we move the project away from NuttX to ChibiOS the NuttX builds will be removed over time."
msgstr ""
