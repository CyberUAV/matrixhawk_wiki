#: ../../source/docs/ros-data-from-ap.rst:4
#: b43a0b3bae8c42afa691e44b14bab940
msgid "Data from AP to ROS"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:6
#: 9841dcb87d3640bca7a46969fb46714e
msgid "Mavros consumes MAVLink sensor data messages from ArduPilot and places the data within the /mavros/ topic"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:9
#: 1452695a30104e32ae4b93b21fec5c2c
msgid "IMU data"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:11
#: dc3a00ea65c54f709a925e6707176add
msgid "ArduPilot sends accelerometer, gyro and compass (aka \"mag\") data to ROS/mavros using MAVLink's `RAW_IMU <https://mavlink.io/en/messages/common.html#RAW_IMU>`__ message."
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:13
#: 89273bab67b9446fae0c825f5bf6351a
msgid "mavros consumes this data and places it within the following topics:"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:15
#: 5d40633759ec47be8909da1e923de8f8
msgid "/mavros/imu/data and /mavros/imu/data_raw hold the accelerometer (called \"linear_acceleration\") and gyro (called \"angular_velocity) data"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:16
#: 2d7d05a3fe724738a3dfb2f19692dd6b
msgid "/mavros/imu/mag holds the compass data.  This may be all zero if AP's COMPASS_USE parameters have been set to zero"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:19
#: baaab64424b54ec78da00d273296db66
msgid "Checking and setting the data rate"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:25
#: 555317518ca54317af9745713b846fee
msgid "Run the following command to view the accelerometer and gyro data and update rate on the companion computer running ROS"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:32
#: 958143bc9305433c83e13519122d1533
msgid "mavros can be used to send a command to ArduPilot to change the rate of the data as shown below"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:40
#: d0f0afa7d1dc4c6bb8147bc3bdd3b059
msgid "From within ArduPilot the default update rate of the IMU data sent to ROS/mavros can be set by changing the SRx_EXTRA1 parameter (where \"x\" is normally the serial port number on the flight controller)"
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:44
#: 7942201c31c64a5fb1ac0b3bd12a9a86
msgid "Users of :ref:`APSync <apsync-intro>` may notice that `APWeb <https://github.com/ArduPilot/APWeb>`__ resets the data stream rates to 4hz every 10 seconds.  This is a `known issue <https://github.com/ArduPilot/APWeb/issues/15>`__ that can be worked around by editing the /etc/rc.local file and commenting out the line that starts APWeb."
msgstr ""

#: ../../source/docs/ros-data-from-ap.rst:48
#: 74e6bed985354fd598f0e2941e2ac4a6
msgid "If you notice AP is sending data at a higher rate than requested it may be because of `this issue <https://github.com/ArduPilot/ardupilot/issues/9878>`__"
msgstr ""
