#: ../../source/docs/mavlink-precision-landing.rst:20
#: f78e89af129845e09f14b10b4231cfe8
msgid "If the x (e.g. forward), y (e.g. right) and z (e.g. down) distance to the target is known (in body frame) then \"x\", \"y\" and \"z\" fields should be populated, and \"position_valid\" should be set to \"1\"."
msgstr ""

#: ../../source/docs/mavlink-precision-landing.rst:22
#: d8a2816c337e4f80b0119ca5659c133d
msgid "If only the body-frame angle to the target is known then \"angle_x\" and \"angle_y\" fields should be populated and \"position_valid\" should be set to \"0\"."
msgstr ""
