#: c5f8f465ef4c4de28552d080533b2a3d
msgid "The Terminal tab is visible on the top icon row when “Advanced View” is checked in the Config tab."
msgstr ""

#: ../../source/docs/commonmission-planner-command-line-interface-cli.rst:24
#: d99d69d4b46e4dee8cd7f304bfb4322c
msgid "The Mission Planner serial terminal is the best a way to see text data coming from APM via its USB port and to type commands into the CLI. You can can also run tests and download and analyze log files from this screen."
msgstr ""
