#: ../../source/docs/ros-slam.rst:167
#: b62c6cb672674a9086905227af9eda35
msgid "Connect to the flight controller with a ground station (i.e. Mission Planner) and check that the following parameters are set as shown below:"
msgstr ""

#: ../../source/docs/ros-slam.rst:169
#: 0e4c18275fa543d68067604be5277553
msgid ":ref:`AHRS_EKF_TYPE <copter:AHRS_EKF_TYPE>` = 2 (the default) to use EKF2 (at the time this page was written the EKF3 did not yet support external position estimates)"
msgstr ""

#: ../../source/docs/ros-slam.rst:170
#: 780daf187a964414a782617d7f1f3c49
msgid ":ref:`EK2_ENABLE <copter:EK2_ENABLE>` = 1 (the default)"
msgstr ""

#: ../../source/docs/ros-slam.rst:171
#: 3b77e5b5cf7e443d8c8f0046539cc0c7
msgid ":ref:`EK3_ENABLE <copter:EK3_ENABLE>` = 0 (the default)"
msgstr ""

#: ../../source/docs/ros-slam.rst:172
#: 321db73d63d3477fa10413a2e5db4e61
msgid ":ref:`GPS1_TYPE <GPS1_TYPE>` = 0 to disable the GPS"
msgstr ""

#: ../../source/docs/ros-slam.rst:173
#: 3290c78173774730b6d53b39b0fa7658
msgid ":ref:`EK2_GPS_TYPE <copter:EK2_GPS_TYPE>` = 3 to disable the EKF's use of the GPS"
msgstr ""

#: ../../source/docs/ros-slam.rst:174
#: a32e5f272e7248909763779c92adaa47
msgid ":ref:`COMPASS_ENABLE<copter:COMPASS_ENABLE>` = 0, :ref:`COMPASS_USE <copter:COMPASS_USE>` = 0, :ref:`COMPASS_USE2 <copter:COMPASS_USE2>` = 0, :ref:`COMPASS_USE3 <copter:COMPASS_USE3>` = 0 to disable the EKF's use of the compass and instead rely on the heading from ROS and Hector SLAM"
msgstr ""

#: ../../source/docs/ros-slam.rst:176
#: f2197440376148c6a82918ee47445604
msgid "After changing any of the values above, reboot the flight controller."
msgstr ""

