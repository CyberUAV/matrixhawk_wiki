msgstr ""

#: ../../source/docs/ros-vio-tracking-camera.rst:157
#: b4f15d52452e4192a87b7928732f9e48
msgid "Establish connection in ROS: :ref:`Connect to ArduPilot with MAVROS <ros-connecting>`."
msgstr ""

