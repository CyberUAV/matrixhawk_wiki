#: e3ded6e1f03b4d6e91e97347e19bcebf
msgid ":ref:`EK3_SRC1_POSXY <copter:EK3_SRC1_POSXY>` = 6 to set position horizontal source to ExternalNAV"
msgstr ""

#: ../../source/docs/ros-cartographer-slam.rst:278
#: c841e5572ba1475dac38817bd58f8279
msgid ":ref:`EK3_SRC1_POSZ <copter:EK3_SRC1_POSZ>` = 1 to set position vertical source to Baro"
msgstr ""

#: ../../source/docs/ros-cartographer-slam.rst:279
#: 317f86e3458c4423ab0c2d33c56eb787
msgid ":ref:`EK3_SRC1_VELXY <copter:EK3_SRC1_VELXY>` = 6 to set velocity horizontal source to ExternalNAV"
msgstr ""

#: ../../source/docs/ros-cartographer-slam.rst:280
#: 2f02dfc1eabe4ae0b15812def08a79a1
msgid ":ref:`EK3_SRC1_VELZ <copter:EK3_SRC1_VELZ>` = 6 to set vertical velocity source to ExternalNAV"
msgstr ""

#: ../../source/docs/ros-cartographer-slam.rst:281
#: d47e3506602c4d8cb923121660718e30
msgid ":ref:`EK3_SRC1_YAW <copter:EK3_SRC1_YAW>` = 6 to set yaw source to ExternalNAV"
msgstr ""

#: ../../source/docs/ros-cartographer-slam.rst:282
#: d16ecf0a18cd45ffab124929ae82892f
msgid ":ref:`GPS1_TYPE <GPS1_TYPE>` = 0 to disable the GPS"
msgstr ""

#: ../../source/docs/ros-cartographer-slam.rst:283
#: f08e7314dae44123a5b59da695a7b919
msgid ":ref:`VISO_TYPE <copter:VISO_TYPE>` = 1 to enable visual odometry"
msgstr ""

#: ../../source/docs/ros-cartographer-slam.rst:284
#: a462d85602ee427f8979b46fe95cf64f
msgid ":ref:`ARMING_SKIPCHK <copter:ARMING_SKIPCHK>` = 8 (optional, to disable GPS checks)"
msgstr ""

