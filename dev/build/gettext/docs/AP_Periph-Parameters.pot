#: ../../source/docs/AP_Periph-Parameters.rst:75938
#: d46d3a904dd5443eac21c9e545c08304
msgid "SERIAL\\_PASS2: Serial passthru second port"
msgstr ""

#: ../../source/docs/AP_Periph-Parameters.rst:75942
#: 854a7cdcc04c48d4856e43cfedb5afbb
msgid "This sets one side of pass\\-through between two serial ports\\. Once both sides are set then all data received on either port will be passed to the other port\\. This parameter is normally reset to \\-1 on reboot\\, disabling passthrough\\. If SERIAL\\_PASSTIMO is set to \\-1 then it is not reset on reboot\\."
msgstr ""

#: ../../source/docs/AP_Periph-Parameters.rst:75976
#: fca9ea221b0b4239b5b6a77f58fe4fa2
msgid "SERIAL\\_PASSTIMO: Serial passthru timeout"
msgstr ""

#: ../../source/docs/AP_Periph-Parameters.rst:75980
#: 4088457577cf4a4084e5e54c1a8ddb56
msgid "This sets a timeout for serial pass\\-through in seconds\\. When the pass\\-through is enabled by setting the SERIAL\\_PASS1 and SERIAL\\_PASS2 parameters then it remains in effect until no data comes from the first port for SERIAL\\_PASSTIMO seconds\\. This allows the port to revent to its normal usage \\(such as MAVLink connection to a GCS\\) when it is no longer needed\\. A value of 0 means no timeout\\. A value of \\-1 means no timeout and the SERIAL\\_PASS2 parameter is not reset on reboot\\."
msgstr ""

#: ../../source/docs/AP_Periph-Parameters.rst:75986
