#: ../../source/docs/mavlink-get-set-flightmode.rst:16
#: 45252db8caa44f8ebfa7d413147b1a6c
msgid "Get the Flightmode with HEARTBEAT"
msgstr ""

#: ../../source/docs/mavlink-get-set-flightmode.rst:18
#: 0de89cfc1c944005bdaf84443318cf9f
msgid "The vehicle's current flight mode is sent once per second within the `HEARTBEAT <https://mavlink.io/en/messages/common.html#HEARTBEAT>`__ message's custom_mode field.  The flightmode number varies by vehicle type (e.g. Copter, Plane, Rover, etc) so please refer to the links above to convert the custom_mode number to a human readable flightmode name."
msgstr ""

#: ../../source/docs/mavlink-get-set-flightmode.rst:21
#: 9c95892123cc4c7cb6ed4a6bc8657dbe
msgid "Set the Flightmode with MAV_CMD_DO_SET_MODE"
msgstr ""

#: ../../source/docs/mavlink-get-set-flightmode.rst:23
#: 2b1418609b00484ead6312a8fa8b81b7
msgid "Attempt to set the vehicle's flightmode by sending a `COMMAND_LONG <https://mavlink.io/en/messages/common.html#COMMAND_LONG>`__ with the command and param2 fields set as specified for the `MAV_CMD_DO_SET_MODE <https://mavlink.io/en/messages/common.html#MAV_CMD_DO_SET_MODE>`__ command."
msgstr ""

