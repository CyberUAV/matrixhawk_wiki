msgstr ""

#: ../../source/docs/mavlink-get-set-flightmode.rst:10
#: e3bc8b7535d6470abbd6632eab90dd64
msgid ":ref:`Plane flight modes <plane:flight-modes>`, see :ref:`FLTMODE1 <plane:FLTMODE1>` for flightmode numbers"
msgstr ""

