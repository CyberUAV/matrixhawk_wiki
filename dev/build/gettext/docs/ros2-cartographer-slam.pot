#: ../../source/docs/ros2-cartographer-slam.rst:65
#: 4aedebe1cedb4342bbc5864b0f0d72b1
msgid ":ref:`EK3_SRC1_YAW <copter:EK3_SRC1_YAW>` = 6 to set yaw source to ExternalNAV"
msgstr ""

