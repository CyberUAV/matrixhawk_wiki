msgstr ""

#: ../../source/docs/bootloader.rst:23
#: 9f32c8ce16a649b9a78129f324277be4
msgid "ArduPilot firmware already include the bootloader. You can flash it using the MAVLink long command : MAV_CMD_FLASH_BOOTLOADER with parameter 5 at 290876"
msgstr ""

