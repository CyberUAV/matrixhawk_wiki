#: ../../source/docs/bootloader.rst:7
#: a976e644c1614665afa11431c723e4ed
msgid "The source code for the bootloaders can be found in `AP_Bootloader <https://github.com/ArduPilot/ardupilot/tree/master/Tools/AP_Bootloader>`__ but pre-compiled binaries are available for many boards in the `Tools/Bootloaders <https://firmware.ardupilot.org/Tools/Bootloaders>`__ directory on our firmware server.  Please refer to the `README text <https://github.com/ArduPilot/ardupilot/blob/master/Tools/bootloaders/README.md>`__ to see if one of the existing bootloaders is compatible for the new board."
msgstr ""

#: ../../source/docs/bootloader.rst:13
#: 3031c6144b1b4ffd879df897250d760e
msgid "Flash the bootloader"
msgstr ""

#: ../../source/docs/bootloader.rst:15
#: fe11b53d1a154ebf8d6f4ac8b9e1eac6
msgid "We have currently two ways to flash the ArduPilot bootloader:"
msgstr ""

#: ../../source/docs/bootloader.rst:17
#: bc6f3033796649689518ce6abce08310
msgid "flashing the one embedded into the firmware with MAVLink (recommended) via a GCS"
msgstr ""

#: ../../source/docs/bootloader.rst:18
#: 21e0634be7c04a5c8cec16886d8b8631
msgid "using DFU mode to flash. For this method, refer to :ref:`using-DFU-to-load-bootloader`"
msgstr ""

#: ../../source/docs/bootloader.rst:21
#: ef7b6d7cea224143b4313425fb7e8084
