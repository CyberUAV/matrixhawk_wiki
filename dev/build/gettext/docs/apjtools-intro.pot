msgstr ""

#: ../../source/docs/apjtools-intro.rst:16
#: 14990ed7d8c34356bee86808191ee54b
msgid "`Download and Install Python <https://www.python.org/downloads/>`__ if not already installed on your machine"
msgstr ""

#: ../../source/docs/apjtools-intro.rst:17
