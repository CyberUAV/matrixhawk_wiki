#: 9ec5cd23001944358591a1963771b4a4
msgid "GPS Point: gimbal points towards a Location (Lat, Lon, Alt) (see MAV_CMD_DO_SET_ROI).  It is not necessary to specifically change to this mode, this will happen automatically if MAV_CMD_DO_SET_ROI is sent"
msgstr ""

#: ../../source/docs/mavlink-gimbal-mount.rst:37
#: b6fa72b016744af59318ee8bdd217b4a
msgid "SysId Target: gimbal points towards another vehicle (see MAV_CMD_DO_SET_ROI_SYSID).  It is not necessary to specifically change to this mode, this will happen automatically if MAV_CMD_DO_SET_ROI_SYSID is sent"
msgstr ""

