#: ../../source/docs/building-setup-windows-eclipse.rst:5
#: 7509a9fa988f4eacad1e85e8c7c63214
msgid "Setup Eclipse on Windows"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:7
#: ed8f6a63cc8a4596a57f3928e63bc658
msgid "This page shows how to setup Eclipse on Windows to build using waf which allows building for all supported boards."
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:11
#: 0494ee7d07254b3baadc39ab854a9087
msgid "These instructions assume you have already :ref:`Setup the Build Environment on Windows using Cygwin <building-setup-windows-cygwin>`"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:14
#: 757557fc6e174cd2a1b3975881e6cd04
msgid "Remove Pixhawk Toolchain (if present)"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:16
#: 642a212571ef48a5b90383486367717e
msgid "If you have been using the :ref:`older method which relied on Make <building-px4-with-make>` first remove the old tool chain by renaming the ``C:\\pixhawk_toolchain`` directory to ``C:\\pixhawk_toolchain.bak``"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:19
#: 4494021017814199a77cbd53319968b9
msgid "Install and Run Eclipse"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:21
#: 43dfa3f02a914ba8b9e82cede63d9953
msgid "Download `Eclipse 64 bit from here <https://www.eclipse.org/downloads/>`__"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:22
#: 59a381151e094c5da89701b128c0478a
msgid "Run the downloaded eclipse installer and select \"Eclipse IDE for C/C++ Developers\""
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:23
#: 3b6d719d11b24f91ba7fd52069eeb4b6
msgid "Accept the Eclipse Foundation certificate when asked"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:24
#: abe2944707684d63840a2e1d5d280012
msgid "Launch Eclipse and click on the \"Workbench\" button on the top right"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:27
#: a78884b8c3404828bc7e809f74275ba4
msgid "Import ArduPilot"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:29
#: e74441b240a343febf91cb06e61d7ef7
msgid "Once Eclipse has been started import ArduPilot by doing the following:"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:31
#: 65e44ff1f83d426c92428fc1227f7cd6
msgid "Select File, New, Makefile Project with Existing Code"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:37
#: 7ec2e48e38884ff08027f0cd9cd30c4b
msgid "When the \"New Project\" window appears select the folder into which ardupilot was :ref:`cloned <git-clone>` and select the Toolchain to be \"Cygwin GCC\""
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:43
#: 098f3846da6f42b986bf8d0263d1d7a4
msgid "In the Project Explorer tab on the top right, right-mouse-button-click on the \"ardupilot\" folder and select \"Properties\""
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:44
#: 4f98ea6ae58048ad8da8e5fac8466024
msgid "When the \"Properties for ardupilot\" window appears, under \"C/C++ Build\", uncheck \"Use default build command\" and enter ``c:\\cygwin64\\bin\\python3.7m`` into the \"Build command\" field as shown below"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:50
#: fad2d535932a490782590a87b5759d46
msgid "Click the \"Behavior\" tab, select \"Use custom build arguments\" enter ``waf``. Additional arguments such as ``-j 16`` may be added here. The argument ``-j 16`` configures Cygwin to use 16 logical processors of the 8 core machine in this example."
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:51
#: 9bc7a74db9954db08d7b623bf312d3a4
msgid "Setting \"Workbench Build Behavior\" will allow the use of built-in buttons for clean and build all targets. Note if you prefer to only build for a single vehicle type using these buttons change \"build\" to \"copter\"."
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:58
#: 5955daf4b1b84a3f9a72fda9e09c8cd0
msgid "Setup Build Target"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:60
#: fd09be1d631a4513918ac0b36152a98b
msgid "Within the \"Build Targets\" tab on the right select \"ardupilot\" and push the green \"New Build Target\" button."
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:61
#: 386450f92529472f83249c2064309c0f
msgid "In the \"Target name\" field enter ``configure --board fmuv3 --no-submodule-update`` and press OK to create a build target to configure the waf build for Pixhawk/Cube flight controllers using ChibiOS"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:62
#: 157befe23fd94987be5664872240504d
msgid "Create another build target called ``copter``"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:63
#: 870a7006414947928ddc998b223711ad
msgid "Run these two targets in order to create an ArduPilot Copter binary for Pixhawk/Cube flight controllers"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:64
#: 9cda49d07e444154ba36592a41a60135
msgid "If the build fails with a \"Missing configuration file\" check the ardupilot directory for a directory called \"build\" and delete it and try again"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:65
#: 0cd87d038eb9438693f3417684c6e885
msgid "Other useful build targets include, ``clean``, ``plane``, ``rover`` and  ``--help``"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:67
#: 036fef5d112d401fa4b14e4ed8ba02a5
msgid "The arducopter.apj firmware will be created in the **ardupilot\\\\build\\\\fmuv3\\\\bin** directory and can be uploaded from the Mission Planner or other ground station."
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:75
#: 6ed5e3180cbf4ca5bfad6f0e2a59bdc6
msgid "The ``configure`` build target described above requires the ``--no-submodule-update`` be prepended because the submodule update step of the build does not yet work with the setup described here.  We expect this to be resolved in the future but until then, please open a **git bash** terminal and run ``git submodule update --recursive`` if you believe the submodules have been updated recently."
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:78
#: 90d26f153a324e78a45b86e2f394a84a
msgid "Use spaces instead of tabs"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:80
#: 4308d42882524b2c97d9ae2014c67748
msgid "By default Copter, Plane and Rover use spaces in place of tabs. This can be set to the default in Eclipse by changing two settings"
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:82
#: 0cb7df522f3d467fa0d49d0df617784a
msgid "Select **Window \\| Preferences \\| General \\| Editors \\| Text Editors \\| Insert spaces for tabs**."
msgstr ""

#: ../../source/docs/building-setup-windows-eclipse.rst:88
#: 23e719539ba640a6a5b7d6890bef9d68
msgid "Select **Windows \\| Preferences \\| C/C++ \\| Code Style \\| Formatter** and creating a new Profile (i.e. \"K&R Tab\") which has the \"Indentation\" set to \"Spaces only\""
msgstr ""
