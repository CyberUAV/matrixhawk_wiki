#: ../../source/docs/building_with_make.rst:27
#: f09f551e99954a3597767ebda2589126
msgid "Overview"
msgstr ""

#: ../../source/docs/building_with_make.rst:29
#: 2173da044f66487eb67a24cf82adfde3
msgid "The preferred way for developers to build APM applications is using the Makefile system distributed with the repository. This Makefile system is the canonical way to build APM. APM applications can no longer be built with the standard Arduino IDE, as the APM build requires the Arduino IDE base libraries to be excluded from the build."
msgstr ""

#: ../../source/docs/building_with_make.rst:35
#: cdc4bd0b5b6442a7a31008c425964ff9
msgid "For developers who would prefer not to use make, a modified Arduino IDE which emulates the custom APM build process is available."
msgstr ""

#: ../../source/docs/building_with_make.rst:39
#: b388d0b32d6d463ea3c3b5285c8cab82
msgid "Requirements"
msgstr ""

#: ../../source/docs/building_with_make.rst:41
#: 5d35c3299a1a400eb4b5508e6b22321b
msgid "The APM makefiles will work out of the box for Mac OS and Linux users. Windows users can use the makefiles via a Unix compatibility system such as Mingw or Cygwin."
msgstr ""

