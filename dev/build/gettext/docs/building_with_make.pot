#: ../../source/docs/building_with_make.rst:134
#: 3d7d0f9546cd4df2bba4e754ff1501ad
msgid "Troubleshooting"
msgstr ""

#: ../../source/docs/building_with_make.rst:136
#: 7c4a05396fb64fdd9301a19b0406c6e0
msgid "The build process itself attempts to diagnose problems that would prevent a successful build outside of code errors. It may emit the following diagnostics:"
msgstr ""

#: ../../source/docs/building_with_make.rst:140
#: eb96663ba79b4631875370a054b0248a
msgid "**WARNING: More than one copy of Arduino was found, using ...(Mac OS only)**"
msgstr ""

#: ../../source/docs/building_with_make.rst:143
#: 0872007092da410a84270076e9aae9b1
msgid "Spotlight found more than one copy of Arduino installed on your system. Check the path that is printed to ensure that the correct version is being used. To avoid this problem, either remove old versions of Arduino or specify the ARDUINO option when invoking the build system. Typically the installation that will be chosen is the one that was most recently launched."
msgstr ""

#: ../../source/docs/building_with_make.rst:150
#: 6c925004d2c04db48de7dcc422214379
msgid "**ERROR: must set BOARD before including this file.**"
msgstr ""

#: ../../source/docs/building_with_make.rst:152
#: 0358c1b6784249e38ee1be4076afd337
msgid "The sketch Makefile has not defined the BOARD variable. This is normally set to \\`atmega2560\\` for APM2.x builds."
msgstr ""

#: ../../source/docs/building_with_make.rst:155
#: 092ed73d599d481db19dc86073db3b9e
msgid "**ERROR: Spotlight cannot find Arduino on your system.(Mac OS only)**"
msgstr ""

#: ../../source/docs/building_with_make.rst:157
#: 80d77231cb1546969995cc55fa66bca6
msgid "Arduino is not installed, or it is installed in a location that is not being indexed by Spotlight. You can either enable Spotlight for the location where Arduino is installed, or specify the location explicitly by setting the ARDUINO option as described above. Note that Spotlight indexing may take some time, so enabling it for the location containing Arduino may not immediately correct this issue."
msgstr ""

#: ../../source/docs/building_with_make.rst:164
#: 938f60236065488e9319f47ab112cf6e
msgid "**ERROR: Cannot find Arduino on this system**"
msgstr ""

#: ../../source/docs/building_with_make.rst:166
#: e471c0fc540b46e7865281ccd041c233
msgid "(Linux and Windows only)Arduino was not found in one of the standard locations. Either move Arduino to a standard location, or specify its current location with the ARDUINO option in the **config.mk** file"
msgstr ""

#: ../../source/docs/building_with_make.rst:170
#: d36b1deaf4af458b975134ade8782c01
msgid "**ERROR: cannot find the compiler tools anywhere on the path ...**"
msgstr ""

#: ../../source/docs/building_with_make.rst:172
#: a2e4a7960dfa453c8f5842de40d7eb01
msgid "The compiler and related tools cannot be found. For Mac OS and Windows the tools are normally part of Arduino and this message indicates that the Arduino installation is damaged."
msgstr ""

#: ../../source/docs/building_with_make.rst:176
#: 2587f4aeedeb4336a2683b0a4258db91
msgid "For Linux systems, this means that the AVR tools are not installed in a standard location. Either set the TOOLPATH option to point to the directory containing the AVR tools, or install them in a standard location. Normally installing Arduino on a Linux system will result in a correct installation of the AVR tools."
msgstr ""

#: ../../source/docs/building_with_make.rst:182
#: af9e2094910345a4909f2f830deb6524
msgid "**ERROR: cannot find gawk - you may need to install GNU awk**"
msgstr ""

#: ../../source/docs/building_with_make.rst:184
#: 3918a4cfcd2a4a2683f2afcc374c2f08
msgid "(Linux and Windows only)The GNU awk utility is required, but it has not been installed or cannot be found. Check that \\`gawk --version\\` works at the command promp. You may need to specify its location explicitly with the AWK option."
msgstr ""
