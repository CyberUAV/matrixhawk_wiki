#: ../../source/docs/soaring-sitl-with-xplane.rst:96
#: f62dac7ac9b24c9893035d68588da904
msgid "Setting up ArduPlane SITL"
msgstr ""

#: ../../source/docs/soaring-sitl-with-xplane.rst:98
#: 1a8e6f269e004ac6be4fef19c54a6b3e
msgid "**Install** `Mission Planner <https://firmware.ardupilot.org/Tools/MissionPlanner/MissionPlanner-latest.msi>`_."
