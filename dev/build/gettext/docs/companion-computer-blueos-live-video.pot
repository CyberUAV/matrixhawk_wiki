#: ../../source/docs/companion-computer-blueos-live-video.rst:5
#: 7d9a30cf949b4ece90d0dcdeeae2f840
msgid "BlueOS Live Video Setup"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:7
#: 7a46575114e04e789a486ea9b810129f
msgid "BlueOS supports live video visible in `Cockpit <https://blueos.cloud/cockpit/docs/stable/usage/overview/>`__, Mission Planner and QGC ground stations.  This page explains the setup assuming :ref:`this setup <companion-computer-blueos-install>` has already been completed."
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:9
#: 8976ad200d794eeb9d73c26a0a6ecb15
msgid "`BlueOS's official wiki is here <https://blueos.cloud/docs/latest/usage/overview/>`__"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:12
#: cf3091628b3e4662a2b0e8b9fdc3af83
msgid "Video Manager for Cockpit"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:14
#: ../../source/docs/companion-computer-blueos-live-video.rst:48
#: 732533f6663e4bb8b1afa8568385254b
#: c00e3e78fc3c4ba48f0b0e945b0a1815
msgid "Power on the vehicle and wait about 1 minute to allow BlueOS to start"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:15
#: ../../source/docs/companion-computer-blueos-live-video.rst:49
#: cb62abd80a8044969faa7b62a79bf120
#: 69499d4a890f4abe8f670ab5f9a3c464
msgid "On the PC, open a chrome browser and connect to BlueOs running on the vehicle by entering the vehicle's IP address (see :ref:`4G/LTE telemetry setup <companion-computer-blueos-lte-telem>`) or try http://blueos-wifi.local/"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:16
#: 996bd143056f4a819bb2d3216b80d651
msgid "From the left menu select \"Video Streams\""
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:18
#: 2ad5d58fabc046da82ae3993b518ba14
msgid "under \"Redirect source\" push the \"Add Stream\" button"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:20
#: af2d8b9b4d0145f2822c03af18fdc24e
msgid "Set the \"Stream nickname\" to something like \"Siyi A8\" (anything is fine)"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:21
#: 33af7a21320e474f9f318a891d73909b
msgid "From the lower-left drop-down change select \"RTSP\""
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:22
#: cd22f578296f438893bd60ec6160734d
msgid "Under \"Stream endpoint\" enter the RTSP URL for your camera.  Please refer to the :ref:`ArduPilot wiki page for your camera gimbal <common-cameras-and-gimbals>` and check the \"Ethernet Connectivity\" section.  For the Siyi A8 it is normally ``rtsp://192.168.144.25:8554/main.264``"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:23
#: e6f4ded322de47e8918b09981fab41f7
msgid "Push \"Create\""
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:25
#: e3e2596d317a4cd9a4920dd82c625fa5
msgid "after a few seconds a thumbnail from the camera may be displayed"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:27
#: d750f613a64c4cbca698c417a8189af7
msgid "From the left menu select \"Cockpit\""
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:29
#: 7fc1fe2653884a7c93c644e369996153
msgid "Expose the configuration menu by pushing the arrow button in the middle left of the screen"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:30
#: 417e482b0d87494089d582428500aeba
msgid "Select Settings, Video"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:32
#: f4fbdad482224fb99a9f7b0976ba9f15
msgid "At the top under \"Streams mapping\" the video stream should be visible with a \"Status\" of \"Available\""
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:33
#: 825f3c051b8d46f491ce34e13d212844
msgid "Check the \"Allowed WebRTC remote IP addresses\" field and delete any IP addresses shown"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:39
#: 9c8418cea184431d8eb419dee873d30a
msgid "Return to the top of the configuration menu and select \"Edit Interface\""
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:40
#: edbbbda54d2d48f485d34c3533d54964
msgid "Find \"Video Player\" from the bottom row of icons (this may require scrolling down with the mouse) and drag it to the desired location on the map"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:41
#: 5527ebcb449747acacacf436c201383c
msgid "`More information on the WebRTC Video Player can be found here <https://blueos.cloud/cockpit/docs/stable/usage/advanced/#webrtc-video-player>`__"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:44
#: 4fabac2c4bdc467baf54a67f4a560aa8
msgid "RTSP Relay for Mission Planner and QGC"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:46
#: 059f3257cb9145af96fffa2697e58f00
msgid "To view the live video in Mission Planner or QGC, the RTSP Relay (aka MediaMTX) extension must be configured"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:50
#: 7aa428a501564010b66a6a743bd58b98
msgid "From the left menu select \"Extensions\", find MediaMTX and push the \"Get\" button"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:51
#: 832f6edea621409d86aa798713abb999
msgid "From the left menu select \"RTSP Relay\""
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:52
#: dc4c4fd7d64646c8b6a846dd8e105f5f
msgid "Copy and paste the code below into the \"MediaMTX Configuration\" section, making sure to set the \"source:\" field to the RTSP URL appropriate for your camera.  This can be found on the :ref:`ArduPilot wiki page for your camera gimbal <common-cameras-and-gimbals>` in the \"Ethernet Connectivity\" section"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:88
#: 0ad7045356e6446c922a886dffdc2ffd
msgid "Optionally adjust the video resolution and frame rate by changing the \"scale=640:360,fps=10\" portion of the line starting with \"ffmpeg\""
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:89
#: fdde218d12c54755b16e5f5250c08f00
msgid "This creates two streams either of which may be viewed in Mission Planner or QGC.  If using ZeroTier, the <vehicle_ip> will have been set during the :ref:`4G/LTE setup <companion-computer-blueos-lte-telem>`"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:91
#: 3366020057b145e1a27f317ca9c979de
msgid "rtsp://<vehicle_ip>:8555/input (full resolution and frame rate)"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:92
#: b817cf26ab504daa880b4eed8f5d2904
msgid "rtsp://<vehicle_ip>:8555/compressed (lower bandwidth)"
msgstr ""

#: ../../source/docs/companion-computer-blueos-live-video.rst:94
#: c6f0575f1eb347d5ae6c981691f36687
msgid "`See here for more information on displaying live video in Mission Planner <https://ardupilot.org/planner/docs/live-video.html>`__"
msgstr ""
