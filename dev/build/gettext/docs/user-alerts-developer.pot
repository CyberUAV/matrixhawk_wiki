#: 0455074702024c41be54cd838d0cce4b
msgid "Examples of Safe Operation issues include:"
msgstr ""

#: ../../source/docs/user-alerts-developer.rst:11
#: 27e4ff01c9fa47649c935a5afa970f92
msgid "Corrupted packets in I2C bus locking up the flight controller"
msgstr ""

#: ../../source/docs/user-alerts-developer.rst:12
#: d340e4ab744c494db8025189de3777f9
msgid "Non-commanded disarming whilst in-flight"
msgstr ""

#: ../../source/docs/user-alerts-developer.rst:13
#: 6c27de9462bb49079cd49c3dd5d142dc
msgid "Malformed stored waypoint causes vehicle to fly away whilst in AUTO mode"
msgstr ""

#: ../../source/docs/user-alerts-developer.rst:14
#: 38f15aeb3cae4710a0e8fade4fc372cb
msgid "Triggering of the watchdog reset whilst in-flight"
msgstr ""

#: ../../source/docs/user-alerts-developer.rst:16
#: 9685439e50814d5e9c8aee12803a0323
msgid "Examples of issues which are NOT Safe Operation issues include:"
msgstr ""

#: ../../source/docs/user-alerts-developer.rst:18
#: b5b729cef1bc4a599b02d987192c5465
msgid "Sub-optimal parameter values that lead to poor navigation performance"
