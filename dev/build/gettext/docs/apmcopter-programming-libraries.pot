msgid "ArduPilot Libraries"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:7
#: 7bad585917a940fcbf4811deb55b1236
msgid "The \\ `libraries <https://github.com/ArduPilot/ardupilot/tree/master/libraries>`__ are shared with Copter, Plane and Rover. Below is a high level list of libraries and their function."
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:11
#: e96b59c60f32423f9b752fce49c68239
msgid "**Core libraries:**"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:13
#: 000182cc951f46229b8f98a6219d78a6
msgid "`AP_AHRS <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_AHRS>`__ - attitude estimation using DCM or EKF"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:15
#: 82c01bd9911f4d90b7c93f7062e62c06
msgid "`AP_Common <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Common>`__ - core includes required by all sketches and libraries"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:17
#: 11b016c6edec45a9a10b942e19345720
msgid "`AP_Math <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Math>`__ - various math functions especially useful for vector manipulation"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:19
#: c12f3563e9494cdb9ae744e318b05191
msgid "`AC_PID <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AC_PID>`__ - PID(Proportional-Integral-Derivative) controller library"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:21
#: de30b189d7b14515936ee577c6bf673b
msgid "`AP_InertialNav <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_InertialNav>`__ - inertial navigation library for blending accelerometer inputs with gps and baro data"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:24
#: 09c5c1b9acb3467b96ce22c6fe5683f0
msgid "`AC_AttitudeControl <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AC_AttitudeControl>`__ - ArduCopter's control library includes various functions of attitude, position control based on PID control."
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:27
#: ed032808f9334df5a5413c02cf882fa2
msgid "`AC_WPNav <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AC_WPNav>`__ - waypoint navigation library"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:29
#: 2bf07c2d05ae4a268cd65b654d4ec69c
msgid "`AP_Motors <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Motors>`__ - multicopter and traditional helicopter motor mixing"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:31
#: 858694ec4fd44226a820ab657777818c
msgid "`RC_Channel <https://github.com/ArduPilot/ardupilot/tree/master/libraries/RC_Channel>`__ - a library to more convert pwm input/output from APM_RC into internal units such as angles"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:34
#: a5d7538d141a4608abaaaa5f062d145b
msgid "`AP_HAL <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_HAL>`__, `AP_HAL_ChibiOS <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_HAL_ChibiOS>`__, `AP_HAL_Linux <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_HAL_Linux>`__ - libraries to implement the \"Hardware abstraction layer\" which presents an identical interface to the high level code so that it can more easily be ported to different boards."
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:41
#: 0d81a82fc9464dd2b3597261926735fc
msgid "**Sensor libraries:**"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:43
#: 4f44cc6276574a0e98e8ab823e36b804
msgid "`AP_InertialSensor <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_InertialSensor>`__ - reads gyro and accelerometer data, perform calibration and provides data in standard units (deg/s, m/s) to main code and other libraries"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:46
#: f8f943619c8f499abf9cb8d13ae013b2
msgid "`AP_RangeFinder <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_RangeFinder>`__ - sonar and ir distance sensor interfaced library"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:48
#: 86baad0edc2f4b6d98981e92c77735d7
msgid "`AP_Baro <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Baro>`__ - barometer interface library"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:50
#: f7b28163a6274702b595a8b2997e9d7b
msgid "`AP_GPS <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_GPS>`__ - gps interface library"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:52
#: 4ab0c9df09f041029a341da7a6f5958b
msgid "`AP_Compass <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Compass>`__ - 3-axis compass interface library"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:54
#: ee7e09fa480f4ce39ef367deef2b1dc5
msgid "`AP_OpticalFlow <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_OpticalFlow>`__ - optical flow sensor interface library"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:57
#: ed770b32ef5b4ffe91440447c6ce088d
msgid "**Other libraries:**"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:59
#: b7a616372b1b46b499ee8cec349dc58b
msgid "`AP_Mount <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Mount>`__, \\ `AP_Camera <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Camera>`__, \\ `AP_Relay <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Relay>`__ - camera mount control library, camera shutter control libraries"
msgstr ""

#: ../../source/docs/apmcopter-programming-libraries.rst:61
#: dd84063a5c3a467e91658b13a13e9be7
msgid "`AP_Mission <https://github.com/ArduPilot/ardupilot/tree/master/libraries/AP_Mission>`__ - stores/retrieves mission commands from eeprom"
msgstr ""
