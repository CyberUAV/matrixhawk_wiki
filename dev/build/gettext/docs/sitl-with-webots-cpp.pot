msgstr ""

#: ../../source/docs/sitl-with-webots-cpp.rst:54
#: 9f05539b816f485a9b8ca44c251d8301
msgid "Ability to add OpenStreetMap and run the simulator in environments very similar to reality."
msgstr ""

