#: 3fe11ecbe8134350b95b5ae985f4f28d
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 12"
msgstr ""

#: ../../source/docs/common-foxeerf745aio.rst:138
