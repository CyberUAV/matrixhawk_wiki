msgid "RC Input"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:46
#: 96928cc9fcd84916bc352d17db52cf52
msgid "The default RC input is configured on UART2, and all ArduPilot compatible protocols, except PPM and SBUS, are supported. SBUS support is provided via the HD VTX connector on SERIAL1 and but requires the protocol be set to :ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>` = \"23\" and to change :ref:`SERIAL2_PROTOCOL<SERIAL2_PROTOCOL>` to something other than '23'."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:48
#: 19db038fd3084633a7e6fc0ca41ae483
msgid "PPM is not supported"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:49
#: e0126c5d9f5442dbb41315e777d23b7d
msgid "FPort requires an external bi-directional inverter (see :ref:`common-fport-receivers`)"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:50
#: ff449d3d76334116a8dbe55351b6f1d9
msgid "CRSF requires connection to TX2 and automatically supports telemetry"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:51
#: d8297e455ecc454183965ce818f39e91
msgid "DSM/SRXL connects to the RX2 pin, but SBUS would still be connected to SBUS."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:52
#: 45b97e6a7dce4ca2a9bdf7eb94bb1c96
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry. Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to “4”."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:55
#: cd01da034d984f649fa297213057315d
msgid "FrSky Telemetry"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:56
#: afd0c58ee9e64ecbb802fe5125e5a27a
msgid "FrSky Telemetry can be supported using a spare UART's transmit pin. For example, you could set the following parameters to enable support for FrSky S.PORT on SERIAL4"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:58
#: e657d576ade54fc3943f696de25410d8
msgid ":ref:`SERIAL4_PROTOCOL<SERIAL4_PROTOCOL>` 10"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:59
#: 025279f88e5044ef933af6192977b890
msgid ":ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` 7"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:62
#: 3907a33862ec40c8bb3f6eb0bebe97e9
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:63
#: 125752a28ede4f76b6312d14bb100135
msgid "The BROTHERHOBBYF405v3 supports OSD using OSD_TYPE 1 (MAX7456 driver). Simultaneously, DisplayPort HD VTX connections can be made to UART3 (included on the HD VTX connector)."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:66
#: 2b7e21c1d9884069beb40d00cae17d8d
msgid "VTX Support"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:67
#: b4a73b8785394e7a916b1629592c3a08
msgid "The SH1.0-6P connector supports a standard DJI HD VTX connection. Pin 1 of the connector is 10v so be careful not to connect anything that could be damaged by this voltage."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:71
#: 4db1e2c46717424fbb117fa3b7fb530b
msgid "PWM Outputs"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:72
#: 372365b76ea44021880abd94ca39e1f7
msgid "The BROTHERHOBBYF405v3 supports up to 9 PWM outputs. Outputs 1-4 are on the ESC connector, while the others are available via solder pads."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:74
#: aafa8d57539b4e05ba206665bf723185
msgid "Channels 1-8 support DShot. Channels 1-4 support bi-directional DShot."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:77
#: c580fa20d29444ce8d1ab50fa45f3cee
msgid "PWM outputs are grouped into 5 groups and every group must use the same output protocol:"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:80
#: c84e4c268c1042d3a17b64036b209998
msgid "PWM 1-2  in group1"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:81
#: cec2c680d31e417ba466c2acb0268607
msgid "PWM 3-4  in group2"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:82
#: 7af903923a5845d18622f89d7cf16dce
msgid "PWM 5-6  in group3"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:83
#: d5ac169c03b7457f9b24a04b18b54964
msgid "PWM 7-8  in group4"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:84
#: 0d780f2199854cf3b37a7b18e20c02e1
msgid "PWM 9    in group5 (LED pad)"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:87
#: b6572778f5264205b6147425a6608be0
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:88
#: c2269a2894ac4a6f812b7c2379ccd866
msgid "The board has a internal voltage sensor and connections on the ESC connector for an external current sensor input. The voltage sensor can handle up to 6S LiPo batteries."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:90
#: c37424c2630448eb8adacb1927a1d4ac
msgid "The default battery parameters are:"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:93
#: df17c7c3ad4e4f23a5aa07ef1ad81d84
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:94
#: e363224f2c224c6f8a48d92d6d3de994
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:95
#: 1c8c18539c1947d59d131c503a2472ca
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:96
#: 4a8aa2436abe4ea4a45d30e5837691b0
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 11"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:97
#: 496fef7aa0a64558b06e31c827ba3cf5
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 25.9 (will need to be adjusted for whichever current sensor is attached)"
msgstr ""

