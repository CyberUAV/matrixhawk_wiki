msgid "BATT2\\_LOW\\_MAH: Low battery capacity"
msgstr ""

#: ../../source/docs/parameters.rst:6637
#: 127bd3bd99824a24a513946f81e30c93
msgid "Battery capacity at which the low battery failsafe is triggered\\. Set to 0 to disable battery remaining failsafe\\. If the battery capacity drops below this level the vehicle will perform the failsafe specified by the BATT2\\_FS\\_LOW\\_ACT parameter\\."
msgstr ""

#: ../../source/docs/parameters.rst:6652
#: 6a34a6aa440b48819b19b0845e4e41e8
msgid "BATT2\\_CRT\\_VOLT: Critical battery voltage"
msgstr ""

#: ../../source/docs/parameters.rst:6655
#: f222c141ec0e4f009cbec1327ea928fd
msgid "Battery voltage that triggers a critical battery failsafe\\. Set to 0 to disable\\. If the battery voltage drops below this voltage continuously for more then the period specified by the BATT2\\_LOW\\_TIMER parameter then the vehicle will perform the failsafe specified by the BATT2\\_FS\\_CRT\\_ACT parameter\\."
msgstr ""

#: ../../source/docs/parameters.rst:6670
#: 037599f4ca0e47a08462631026966227
msgid "BATT2\\_CRT\\_MAH: Battery critical capacity"
msgstr ""

#: ../../source/docs/parameters.rst:6673
#: be8d69e1ae594ab69c0c2d8ffdb6ba56
msgid "Battery capacity at which the critical battery failsafe is triggered\\. Set to 0 to disable battery remaining failsafe\\. If the battery capacity drops below this level the vehicle will perform the failsafe specified by the BATT2\\_FS\\_CRT\\_ACT parameter\\."
msgstr ""

#: ../../source/docs/parameters.rst:6688
