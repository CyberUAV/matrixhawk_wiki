#: c2a6c23e61c249ccb7fdb3668f563cd2
msgid "FFT\\_ENABLE: Enable"
msgstr ""

#: ../../source/docs/parameters.rst:55290
#: 12d12f33dd3c4b03ae00dd61c24c5cf8
msgid "Enable Gyro FFT analyser"
msgstr ""

#: ../../source/docs/parameters.rst:55312
#: a2217ff7cdd64f6e8895d5def2f8f724
msgid "FFT\\_MINHZ: Minimum Frequency"
msgstr ""

#: ../../source/docs/parameters.rst:55316
#: 4cdbfa29e93746a2aafd5dccbdfec66a
msgid "Lower bound of FFT frequency detection in Hz\\. On larger vehicles the minimum motor frequency is likely to be significantly lower than for smaller vehicles\\."
msgstr ""

#: ../../source/docs/parameters.rst:55322
#: f5fe94df52be475c91acc90f8c84dc7e
msgid "20 to 400"
msgstr ""

#: ../../source/docs/parameters.rst:55331
#: 49053142d9284cd4a7f18d03da923483
msgid "FFT\\_MAXHZ: Maximum Frequency"
msgstr ""

#: ../../source/docs/parameters.rst:55335
#: ec57e4d26a3b46a0bdef0b75e42910a2
msgid "Upper bound of FFT frequency detection in Hz\\. On smaller vehicles the maximum motor frequency is likely to be significantly higher than for larger vehicles\\."
msgstr ""

#: ../../source/docs/parameters.rst:55341
#: 2abe3e2a91454f09b091831a99528d89
msgid "20 to 495"
msgstr ""

#: ../../source/docs/parameters.rst:55350
#: 6b448d7ea4ff4efab355f53b6335c4ab
msgid "FFT\\_SAMPLE\\_MODE: Sample Mode"
msgstr ""

#: ../../source/docs/parameters.rst:55355
#: ac9745d5441142e98d6aaa25e8ea812e
msgid "Sampling mode \\(and therefore rate\\)\\. 0\\: Gyro rate sampling\\, 1\\: Fast loop rate sampling\\, 2\\: Fast loop rate \\/ 2 sampling\\, 3\\: Fast loop rate \\/ 3 sampling\\. Takes effect on reboot\\."
msgstr ""

#: ../../source/docs/parameters.rst:55370
#: 15cdeedca9e44e2abb0ac6271f0c3b7e
msgid "FFT\\_WINDOW\\_SIZE: FFT window size"
msgstr ""

#: ../../source/docs/parameters.rst:55375
#: e21946224326469093eea728fd50d2ae
msgid "Size of window to be used in FFT calculations\\. Takes effect on reboot\\. Must be a power of 2 and between 32 and 512\\. Larger windows give greater frequency resolution but poorer time resolution\\, consume more CPU time and may not be appropriate for all vehicles\\. Time and frequency resolution are given by the sample\\-rate \\/ window\\-size\\. Windows of 256 are only really recommended for F7 class boards\\, windows of 512 or more H7 class\\."
msgstr ""

#: ../../source/docs/parameters.rst:55381
#: 58838a5ddef24d988aaa5d0ed1ceed95
msgid "32 to 1024"
msgstr ""

#: ../../source/docs/parameters.rst:55390
#: bcf72e4cbf9b429589e169815cdddcaa
msgid "FFT\\_WINDOW\\_OLAP: FFT window overlap"
msgstr ""

#: ../../source/docs/parameters.rst:55395
#: faea8d962e9c496d8e9eb1efd6149b5d
msgid "Percentage of window to be overlapped before another frame is process\\. Takes effect on reboot\\. A good default is 50\\% overlap\\. Higher overlap results in more processed frames but not necessarily more temporal resolution\\. Lower overlap results in lost information at the frame edges\\."
msgstr ""

#: ../../source/docs/parameters.rst:55401
#: 0c8b2e97d1e24b438629b7a06668a4fb
msgid "0 to 0.9"
msgstr ""

#: ../../source/docs/parameters.rst:55410
#: f1ae94d3e95a4fdb9cb10f88f1ce747e
msgid "FFT\\_FREQ\\_HOVER: FFT learned hover frequency"
msgstr ""

#: ../../source/docs/parameters.rst:55414
#: 9e133b3a29924488ac9c794c3672962a
msgid "The learned hover noise frequency"
msgstr ""

#: ../../source/docs/parameters.rst:55429
#: 73821e31563241daa4467276a331f5d8
msgid "FFT\\_THR\\_REF: FFT learned thrust reference"
msgstr ""

#: ../../source/docs/parameters.rst:55433
#: d1bbb59e00454984a8e551e36190062b
msgid "FFT learned thrust reference for the hover frequency and FFT minimum frequency\\."
msgstr ""

#: ../../source/docs/parameters.rst:55439
#: 2bb167cb86174cea828d6e8682bc2dba
msgid "0.01 to 0.9"
msgstr ""

#: ../../source/docs/parameters.rst:55448
#: 08a7f932aeba4f66bce62b5648314f27
msgid "FFT\\_SNR\\_REF: FFT SNR reference threshold"
msgstr ""

#: ../../source/docs/parameters.rst:55452
#: 280a7338471a4f96aa862060f39d74bd
msgid "FFT SNR reference threshold in dB at which a signal is determined to be present\\."
msgstr ""

#: ../../source/docs/parameters.rst:55458
#: eb8da9ed4fb946ee8b95b290e72b1ae4
msgid "0.0 to 100.0"
msgstr ""

#: ../../source/docs/parameters.rst:55467
#: e0aef01494ed48279d976ccc20a2475b
msgid "FFT\\_ATT\\_REF: FFT attenuation for bandwidth calculation"
msgstr ""

#: ../../source/docs/parameters.rst:55471
#: e9ddf7a044154e29b9e6a453e6d784ea
msgid "FFT attenuation level in dB for bandwidth calculation and peak detection\\. The bandwidth is calculated by comparing peak power output with the attenuated version\\. The default of 15 has shown to be a good compromise in both simulations and real flight\\."
msgstr ""

#: ../../source/docs/parameters.rst:55486
#: 8144df780e524d8f85e7a1f48e2a79c7
msgid "FFT\\_BW\\_HOVER: FFT learned bandwidth at hover"
msgstr ""

#: ../../source/docs/parameters.rst:55490
#: 5bf6405a95c442eaa7dbbf38ac706615
msgid "FFT learned bandwidth at hover for the attenuation frequencies\\."
msgstr ""

#: ../../source/docs/parameters.rst:55505
#: 7eb4a2b999324efebb0860cefde8a55e
msgid "FFT\\_HMNC\\_FIT: FFT harmonic fit frequency threshold"
msgstr ""

#: ../../source/docs/parameters.rst:55510
#: f9611c7517144256a950ae9ac503a4bf
msgid "FFT harmonic fit frequency threshold percentage at which a signal of the appropriate frequency is determined to be the harmonic of another\\. Signals that have a harmonic relationship that varies at most by this percentage are considered harmonics of each other for the purpose of selecting the harmonic notch frequency\\. If a match is found then the lower frequency harmonic is always used as the basis for the dynamic harmonic notch\\. A value of zero completely disables harmonic matching\\."
msgstr ""

#: ../../source/docs/parameters.rst:55525
#: 62b0b55234a9437392fb0e2766fc5b23
msgid "FFT\\_HMNC\\_PEAK: FFT harmonic peak target"
msgstr ""

#: ../../source/docs/parameters.rst:55529
#: e6d2e6589cb640cd9eec2542d7c10d0c
msgid "The FFT harmonic peak target that should be returned by FTN1\\.PkAvg\\. The resulting value will be used by the harmonic notch if configured to track the FFT frequency\\. By default the appropriate peak is auto\\-detected based on the harmonic fit between peaks and the energy\\-weighted average frequency on roll on pitch is used\\. Setting this to 1 will always target the highest energy peak\\. Setting this to 2 will target the highest energy peak that is lower in frequency than the highest energy peak\\. Setting this to 3 will target the highest energy peak that is higher in frequency than the highest energy peak\\. Setting this to 4 will target the highest energy peak on the roll axis only and only the roll frequency will be used \\(some vehicles have a much more pronounced peak on roll\\)\\. Setting this to 5 will target the highest energy peak on the pitch axis only and only the pitch frequency will be used \\(some vehicles have a much more pronounced peak on roll\\)\\."
msgstr ""

#: ../../source/docs/parameters.rst:55540
#: c7220b25c4d74b87bb10cdc78c08d2cf
msgid "Center Frequency"
msgstr ""

#: ../../source/docs/parameters.rst:55542
#: 8dfb75beeef2494299ef82dfb3cd55ab
msgid "Lower-Shoulder Frequency"
msgstr ""

#: ../../source/docs/parameters.rst:55544
