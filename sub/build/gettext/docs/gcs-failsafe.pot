#: ../../source/docs/gcs-failsafe.rst:5
#: c58a80536614484a90fccbc2cb3332c7
msgid "GCS Failsafe"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:6
#: 5c981d0182464b2b89188302dbd6f645
msgid "The Ground Station Control (GCS) failsafe controls how Sub will behave if contact with the GCS is lost.  The GCS failsafe monitors the time since the last MAVLink heartbeat from the GCS.  If no heartbeat is received :ref:`FS_GCS_TIMEOUT<FS_GCS_TIMEOUT>` seconds (Default is 5 seconds), the GCS failsafe event will trigger based on your parameter settings. Note that if no GCS is ever connected, the GCS failsafe will remain inactive regardless of parameter settings."
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:10
#: ece2f255ae64422e95a8f3b7e26d247d
msgid "Sub also supports other failsafes, see the :ref:`failsafe-landing-page`."
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:13
#: 328c622fb39e4c16938b19882129fe81
msgid "When the failsafe will trigger"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:14
#: 06b901e88a4d4c88a72825e4af39e92e
msgid "The following situations can cause a loss of GCS MAVLink heartbeat, triggering a GCS failsafe event after :ref:`FS_GCS_TIMEOUT<FS_GCS_TIMEOUT>` seconds:"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:16
#: a7fa11bc2bdf4dadb92a63e651d6ac69
msgid "The operator turns off or otherwise disconnects the GCS"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:17
#: 7e33ba0328f14e7bb300f9052d480c3d
msgid "The vehicle travels beyond the range of the GCS telemetry radios"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:18
#: 5c518816583a427e9fe74e237ad95fe2
msgid "The GCS telemetry mechanism on either end loses power"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:19
#: c49ebfdd1338409dbdf7aeda9d147e17
msgid "Wires connecting the GCS telemetry to the autopilot or ground equipment become disconnected"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:22
#: 939c516d3a4e4f17a40bd092c43d32dc
msgid "What will happen"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:23
#: e12ae7b4491a439c9686e6466b8e10ff
msgid "When a GCS failsafe is triggered, the vehicle can be configured via parameters to do nothing, send the GCS a warning message, disarm, or change to ALTHOLD or SURFACE modes."
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:26
#: 255fe42f246b4798bd8eff22e5605efa
msgid "If the failsafe clears (i.e. GCS reconnects and MAVLink heartbeat is restored) the vehicle will remain in its failsafe mode. It will **not** automatically return to the flight mode that was active before the failsafe was triggered, if it was changed."
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:29
#: 5080928e7a764b62b2e4e219f373dd37
msgid "Setting the failsafe"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:31
#: 3e02af6b7afd43deb72745b7b96bf56f
msgid "In Mission Planner's  full parameter list or full parameter tree, set the :ref:`FS_GCS_ENABLE <FS_GCS_ENABLE>` parameter to:"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:33
#: 91bccc805cef44d789c9f3d40d393a1d
msgid "**Disabled** (Value 0) will disable the GCS failsafe entirely."
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:34
#: d86d9bde4d0642c7ad9bb387290e9cb9
msgid "**Warn Only** (Value 1) will send a GCS warning message."
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:35
#: f832f0752d5f4266b385066e4ca06212
msgid "**Disarm** (Value 2)"
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:36
#: f1de56af3a2e47b4a6ab3b37d1f3a7db
msgid "**Enter ALTHOLD mode** (Value 3), if armed. If mode change fails, disarm."
msgstr ""

#: ../../source/docs/gcs-failsafe.rst:37
#: bbf1186a2dc74a7cbaa631eba0a51d0b
msgid "**Enter SURFACE mode** (Value 4), if armed. If mode change fails, disarm."
msgstr ""
