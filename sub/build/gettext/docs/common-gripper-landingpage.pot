#: 2fc35df81cb74be59328b380726a54f4
msgid ":ref:`GRIP_NEUTRAL<GRIP_NEUTRAL>`: PWM in uS to neither grab nor release payload"
msgstr ""

#: ../../source/docs/common-gripper-landingpage.rst:31
#: f24ec3f9d65c4818bb8e62645120e7b4
msgid ":ref:`GRIP_RELEASE<GRIP_RELEASE>`: PWM in uS to release payload"
msgstr ""

