#: ../../source/docs/common-rangefinder-nra24.rst:5
#: 79ebd4d331a7410a8adda495c27089d9
msgid "Nanoradar NRA 24"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:8
#: 0a148f4bb1084e728a72b63f3a5c12e0
msgid "Support for this sensor is available in firmware versions 4.5 and later."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:10
#: c51cf4a78bd64edd8d6df0ae51e5ea84
msgid "The `NRA24 <http://en.nanoradar.cn/Article/detail/id/372.html>`__ is K-band radar commonly used for detecting height above terrain in all-weather conditions.Currently, only connection via CAN is supported for more than one NRA24 module. Serial (UART) versions of this Radar have only been tested with a single NRA24 module."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:14
#: 8b8213f2008546118cea03eeb47de1bd
msgid "Connecting via CAN"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:16
#: 8adc150c2f5c442caacc0037b51d3f15
msgid "Setup the sensor through the NSM Software. In particular set the \"ID\" to a unique number if planning to use multiple NRA24 on a single CAN bus. You can also set the bitrate from the software."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:19
#: 1c4b577f751543f180b1f460b61c8a60
msgid "ArduPilot does not currently support the same type CAN rangefinders connected to different CAN ports. If you would like to use multiple CAN rangefinders together, connect them to the same bus."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:23
#: b901be175e0d4867828d48928f678371
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:24
#: d8dd4ca0b89f49199a196811d4413bff
msgid "Setup the sensor through the NSM tools provided by the manufacturer. More details can be found `here <http://en.nanoradar.cn/File/download/id/467.html>`__. Set the \"ID\" to a unique number if planning to use multiple NRA24 on a single CAN bus. You can also set the bitrate from the software to match the CAN bus bitrate (500000 is recommended)."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:26
#: 5baf487bac27462c94d0efe6428f3086
msgid "For a serial connection you can use any spare CAN port. Since this is not a DroneCAN based sensor, you will not be able to use the connected port with any other sensor. The diagram below shows how to connect to CAN2."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:31
#: 732daa288c004522b2cb97113f267f70
msgid "Set the following parameters"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:33
#: 576b5888d5384605aba8e6f74f6b194d
msgid ":ref:`CAN_P2_DRIVER <CAN_P2_DRIVER>` = 2 (to enable the second CAN driver)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:34
#: 26f1146db2504e15a66d4fcfa8f34dd9
msgid ":ref:`CAN_P2_BITRATE <CAN_P2_BITRATE>` = 500000 (Or as set in NSM tools)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:35
#: b6a2547a8eed46f88bafe0a1680c2dda
msgid ":ref:`CAN_D2_PROTOCOL <CAN_D2_PROTOCOL>` = 14 (RadarCAN)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:36
#: 5de5a122c7a9429395b23acdb907f089
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 39 (NRA-24). Reboot after setting this."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:37
#: ../../source/docs/common-rangefinder-nra24.rst:55
#: 2fb907ab53924af8a7a6d1cc278f4091
#: 9a6929c4635242e283f731b6a5c1f0e3
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 190 (i.e. 200m max range with 10m buffer)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:38
#: ../../source/docs/common-rangefinder-nra24.rst:56
#: 80e842f6f1d3404cb582e26a6d0af436
#: a3c3b01c96de4a19b82a051789e5165a
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.5 (0.5m min range)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:39
#: cf10cb19e0d04697a0afe0c22136e3a6
msgid ":ref:`RNGFND1_RECV_ID <RNGFND1_RECV_ID>` = ID of the sensor (0 to accept all CAN ids for distance)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:43
#: f139fdc45d5b448fbd071406e582d09f
msgid "Connecting via UART"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:45
#: 3d4c8cc7462d41fbb6b382a65759289a
msgid "This is the recommended configuration by Nanoradar given `here <http://en.nanoradar.cn/Article/detail/id/495.html>`__, but ArduPilot has not verified that all operational edge cases are satisfied using the USD-1 driver. Caution is advised."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:50
#: 78c6480a8b234d569c8fb26279e7d62f
msgid "Set the following parameters (Example for setup on TELEM1/SERIAL1)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:52
#: 21e0f65339cf43b7a89c60970d7ca010
msgid ":ref:`SERIAL1_BAUD <SERIAL1_BAUD>` = 115 (Baud rate as per the official documentation `here <http://en.nanoradar.cn/File/view/id/436.html>`__)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:53
#: b5a8b3dbec534aecbc8a7ee78409d454
msgid ":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` = 9 (which translates to Rangefinder)"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:54
#: fd12a37993aa4bf5a4cf6a218c8f9820
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 11 (which is USD1_Serial). Reboot after setting this."
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:60
#: ff064df60954473591487471e0a1add4
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-rangefinder-nra24.rst:62
#: 107d46f71c324f5dbc2523532fd28780
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""
