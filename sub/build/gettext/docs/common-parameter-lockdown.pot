#: ../../source/docs/common-parameter-lockdown.rst:5
#: 6f49c6431e574ef4bb6748db2e8c2692
msgid "Parameter Lockdown"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:7
#: 58285827f1f649299a3b714c585f1347
msgid "To avoid accidental changes to critical parameters, ArduPilot provides a parameter lockdown feature using the `param-lockdown.lua <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_Scripting/applets/param-lockdown.lua>`__ Lua applet."
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:9
#: 3b9ececce1b848e2bd5f7c3c3bd792f1
msgid "As with other Lua scripts this requires an autopilot with a fast CPU and sufficient memory (e.g. STM32H7)."
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:11
#: 1a835da325ca4a22b89d165fe49da6d5
msgid "Please note that this is not an iron clad security feature because some ground stations (including Mission Planner) allow users to stop and start scripts meaning the user could stop the script and then change parameter values."
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:14
#: f532ffed63c24b4c93288da0966b07ae
msgid "Setup"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:16
#: f4ced63e3f50461fa68ca116d0bfad5d
msgid "Details on the setup can be found in the `param-lockdown.md file <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_Scripting/applets/param-lockdown.md>`__ but in short this involves:"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:18
#: 08dd7d3aadcf4ff7b36118f6b21fe4cc
msgid "Follow the :ref:`Lua Script setup instructions <common-lua-scripts>` to set up Lua scripting on the autopilot including setting :ref:`SCR_ENABLE <SCR_ENABLE>` = 1"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:19
#: 4088d748bff049719a635073c6124ec8
msgid "Download `param-lockdown.lua <https://raw.githubusercontent.com/ArduPilot/ardupilot/refs/heads/master/libraries/AP_Scripting/applets/param-lockdown.lua>`__ from the ArduPilot repository"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:20
#: dc7f5c6f684043678b44e546ea1f2ed3
msgid "Copy the script to the autopilot's SD card's /APM/scripts/ directory and restart the autopilot"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:21
#: 4f18498a966e4fee87146d99847dd12b
msgid "Confirm the script has loaded by looking for \"param-lockdown script loaded\" in the GCS's messages tab"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:22
#: 97980f48ba7f4f1fa1ff8c62998430e2
msgid "Confirm parameters cannot be set by using the GCS's full parameter list to change a single parameter value. If using Mission Planner it may be necessary to reload parameters and then check if the parameter value has actually changed or not"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:25
#: b20da96c441c4acca9953a13d1e2a1ee
msgid "Customising the Script"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:27
#: a43855473974429da034ed3a02c0be6a
msgid "The list of parameters that may be changed is called the \"white list\" and can be found `here in the param-lockdown script <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_Scripting/applets/param-lockdown.lua#L120>`__"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:37
#: 416a5399fd13464d82bd0ff30b02e3be
msgid "This list can be customised by adding or removing lines from the list and then re-uploading the script to the autopilot"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:40
#: 3100bea657da422b9bb6d909947a8cb1
msgid "Alternative Method"
msgstr ""

#: ../../source/docs/common-parameter-lockdown.rst:42
#: 44b0718e0d604db98c42e38edbc406ae
msgid "Parameters can be marked as ``@READONLY`` in the defaults.parm file as described in the :ref:`OEM Customisations <common-oem-customizations>` page."
msgstr ""
