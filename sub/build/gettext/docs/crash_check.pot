msgstr ""

#: ../../source/docs/crash_check.rst:23
#: 596ee60aa8874e8f8b65c199afb45952
msgid "A crash event will be written to the dataflash logs (look for EV, 12 in the logs)"
msgstr ""

#: ../../source/docs/crash_check.rst:26
#: a0ba8aa641f04b5a96a7cc7cc367f201
msgid "How and when should the crash check be disabled?"
msgstr ""

