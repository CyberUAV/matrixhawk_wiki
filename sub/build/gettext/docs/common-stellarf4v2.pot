#: ../../source/docs/common-stellarf4v2.rst:62
#: 04c2774aa012407980f630a830cf5471
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to “4”."
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:65
#: f0f343d01e684ef19333ce61cdc7a806
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:66
#: 75389130524940b49c2e4cc466877780
msgid "StellarF4V2 supports using its internal OSD using OSD_TYPE 1 (MAX7456 driver). External OSD support such as DJI or DisplayPort can be used simultaneously and is preconfigured on SERIAL3 but can be supported on any spare UART. See :ref:`common-msp-osd-overview-4.2` for more info."
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:70
#: ee9b6d8e3e14460696e2cffd42192fce
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:71
#: 5d498ed181964dc49b841df63eb86034
msgid "StellarF4V2 supports up to 11 PWM/Dshotg outputs. PWM1-4 outputs support Bi-Directional DShot."
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:73
#: 2a869799a23643b590f8f2039d2e471e
msgid "Channels 1-4 support bi-directional DShot. Channels 5-8 marked as S1M5-S4M8 on the board. Channels 9-11 marked as S5-S7 on the board. PWM outputs are grouped and every group must use the same output protocol:"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:76
#: 52708cacf8e04f169f33fe94c0f0fe33
msgid "1, 2, 3, 4  are Group 1;"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:77
#: 330ac67ea44a4f7e8199e90318350eed
msgid "5, 6, 7, 8  are Group 2;"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:78
#: 73184653c5d042ac9b2d7e02499b69a7
msgid "9, 10, 11   are Group 3;"
msgstr ""

