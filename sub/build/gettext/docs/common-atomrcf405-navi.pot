#: ad67f90cec774af386726f485a441d75
msgid "Default UART order"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:74
#: 0dd3a7fe8eb848f3ad13da5a3c5bd547
msgid "SERIAL0 = console = USB"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:75
#: cb321b5c18d343cf9235895b85923957
msgid "SERIAL1 = Telemetry1 = USART1 (DMA capable)"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:76
#: ef3c1b91c4324fd090b188b376af4ccc
msgid "SERIAL2 = RCinput = USART2 (RX2 connected to SBUS via inverter, to use as UART input use :ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>` = 1 and do not attach anything to SBUS pin)"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:77
#: 25f675e73893421a95994be517c47a64
msgid "SERIAL3 = GPS1 = USART3"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:78
#: f77c39b16e4d448d8490a4d71622c453
msgid "SERIAL4 = GPS2 = UART4"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:79
#: fd2353b589144e769203d74027ce16bb
msgid "SERIAL5 = USER = UART5 (typically used for DJI Goggles (see :ref:`common-msp-osd-overview-4.2`) or Tramp VTX control (see :ref:`common-vtx`))"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:80
#: dbe200705a3942ecac39cba463863494
msgid "SERIAL6 = USER = USART6 (solder pads)"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:83
#: d51e734d45b64973b1a5f2e289c90143
msgid "Serial protocols shown are defaults, but can be adjusted to personal preferences."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:86
#: 24cf004becfc4177abf34bc36bc3d84d
msgid "Dshot capability"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:88
#: 8d9dc325d10b491eb0ce25a948d452b2
msgid "All motor/servo outputs are Dshot and PWM capable. However, mixing Dshot and normal PWM operation for outputs is restricted into groups, ie. enabling Dshot for an output in a group requires that ALL outputs in that group be configured and used as Dshot, rather than PWM outputs. The output groups that must be the same (PWM rate or Dshot, when configured as a normal servo/motor output) are: 1/2, 3/4/8, 5/6/7, 8, and 9 (LED)."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:90
#: 43c48b7e53fe4cc8ac79d8c716ca33a9
msgid "PWM9 is marked as \"LED\""
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:93
#: 58b525e22a2843fd94afd172a6e674e7
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:95
#: 9bd1eea94bb34bab80a3b4e4112491ce
msgid "The SBUS pin, is passed by an inverter to RX2 (UART2 RX), which by default is mapped to a timer input instead of the UART, and can be used for all ArduPilot supported receiver protocols, except CRSF/ELRS and SRXL2 which require a true UART connection. However, FPort, when connected in this manner, can provide RC without telemetry."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:97
#: 2575d2f06a49458992ddae637ae0fffa
msgid "To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 receivers, the RX2 pin can also be configured to be used as true UART2 RX pin for use with bi-directional systems by setting the :ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>` to “1” so it becomes the SERIAL7 port's RX input pin."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:99
#: 5cbc2d35fc0245539b50a8d410839bd2
msgid "With this option, :ref:`SERIAL2_PROTOCOL<SERIAL2_PROTOCOL>` must be set to \"23\", and:"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:101
#: 366b3124e7f144d79806baeece0f0c60
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:103
#: a31d1de9832c4146936c95c0a2cafb5a
msgid "DSM/SRXL connects to the RX2  pin, but SBUS would still be connected to SBUS."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:105
#: b3378ddf50444b7d8573559e0ec71124
msgid "FPort requires connection to TX2 and RX2 via a bi-directional inverter. See :ref:`common-FPort-receivers`."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:107
#: 625f6ff226794400a9237b5fb144361e
msgid "CRSF also requires a TX2 connection, in addition to RX2, and automatically provides telemetry."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:109
#: 4cae834ed2894268bf2c14c88f60b141
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry.  Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:111
#: 232fa91548784a2e98c7dcd558f53b80
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM (SBUS requires external inversion on other UARTs). See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi.rst:113
#: 136009e25f9949b693442d4d6327c647
msgid "the 5v pin above the SBUS pin and the 5V pin in the GPS connector are powered when USB is connected. All other 5V pins are only powered when battery is present."
msgstr ""

