#: 676a99ae0cfd4f928eea026e13190253
msgid "Connect to the autopilot with a ground station and do the following"
msgstr ""

#: ../../source/docs/common-djirs2-gimbal.rst:39
#: 9c9b7f3b83dd443792760f454b50c106
msgid "If using CAN1, set :ref:`CAN_D1_PROTOCOL <CAN_D1_PROTOCOL>` = 10 (Scripting), :ref:`CAN_P1_DRIVER <CAN_P1_DRIVER>` = 1 (First driver)"
msgstr ""

#: ../../source/docs/common-djirs2-gimbal.rst:40
#: 25f0a45ec51c4df18142c8124207746d
