#: ../../source/docs/common-mamba405-mk2.rst:30
#: 253c7230d3464313913674f2b3439ecf
msgid "Plane"
msgstr ""

#: ../../source/docs/common-mamba405-mk2.rst:31
#: e7947f0f0a6a44ea84f311a1002da58c
msgid "An altitude source must be provided for any operation. Attach a GPS and follow the instructions in :ref:`common-gps-for-alt`."
msgstr ""

#: ../../source/docs/common-mamba405-mk2.rst:34
#: 70beb3ca5dfe4f9a94823cd8f270ccf1
msgid "Copter"
msgstr ""

#: ../../source/docs/common-mamba405-mk2.rst:35
#: 1e558099e4cf4c5092cb2a2b5d38682a
msgid "Arming and operation in ACRO and STABILIZE modes is possible. It is also possible to arm and fly in ALTHOLD, but altitude hold performance relies on accelerometer/gyro exclusively and could be exceptionally poor, even resulting in a crash so is not recommended. As with Plane you can use a GPS for altitude data, but Rangefinders and Beacons can also be used and the ``EK3_SCRX_POSZ`` parameters set appropriately."
msgstr ""

#: ../../source/docs/common-mamba405-mk2.rst:38
#: d90696ad93e34cc980c1f1c8b896f277
msgid "Rover"
msgstr ""

#: ../../source/docs/common-mamba405-mk2.rst:39
#: 30fb96654c5d47d39e51ea093486d6a0
msgid "Rover does not require an altitude source and the ``EK3_SCRX_POSZ`` parameters can be set to \"0\""
msgstr ""

