#: 8aca1900918847e9b76cf514704fb087
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:106
#: 9154511359464be0bc88c9a9632c4774
msgid "The KakuteF7 Mini supports up to 6 outputs. M1 to M4 are accessed via the connector and are :ref:`bi-directional<bidir-dshot>` capable. M5 and M6 are the pads shown on the above diagram. M1-4 and M6 outputs support DShot as well as all PWM types.M5 only supports PWM."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:108
#: e03b17df9f594b0993d0fd2dc1e341e1
msgid "The PWM is in 3 groups:"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:110
#: 500b6b1089fd479b9239632a36bb03ec
msgid "PWM 1, 4 in group1"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:111
#: dfcce24b9b46488098afce49ac187f3f
msgid "PWM 2 and 3 in group2"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:112
#: 4b3b10be84a948f8bfc74481360c4afb
msgid "PWM 5 in group3"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:113
#: c5db8a7f7b774a22bab814ce37a37e8e
msgid "PWM 6 in group4"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:115
#: c19e3401f0914f04aa5c9bd193a85a92
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:118
#: 2a7cd7478e2b42ad860dc73e08eabf60
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:120
#: c478d51e83a2441eaa7ef2e7662d6e28
msgid "The board has a built-in voltage sensor. The voltage sensor can handle up to 6S LiPo batteries. An external current sensor can be attached to pin 4 on the ESC connector."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:124
#: e3f81087242845fcabbcdd34201870ba
msgid "The correct battery setting parameters are:"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:126
#: 3f9f154d60a34c428c60a9e90054157c
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` 4, if external sensor used; 3 for voltage only"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:127
#: 0bbd1ac593a248df8f52a67d86455b61
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` 13"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:128
#: 0f8fb6d91dd84cdcb9d9507622558772
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 12 , if external sensor used."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:129
#: 2a49a56d773f41e19b541cf09f506eed
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 10.9"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:130
#: 12552f7146b54375a883b55be963d74a
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` should be set to match external current sensor, if used."
msgstr ""

