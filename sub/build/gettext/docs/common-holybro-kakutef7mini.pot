#: ../../source/docs/common-holybro-kakutef7mini.rst:71
#: 727e70504671458fa528296620d9ea3a
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:73
#: 71273662369149dbbebd7d312b75eb5d
msgid "RC input is configured on the R6 (UART6_RX) pin. It supports all RC protocols except PPM. See :ref:`common-rc-systems` for details for a specific RC system. :ref:`SERIAL6_PROTOCOL<SERIAL6_PROTOCOL>` is set to \"23\", by default, to enable this."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:75
#: 682acd08acf4400a81d5754864d66257
msgid "SBUS/DSM/SRXL connects to the R6 pin but SBUS requires that the :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"3\"."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:77
#: 7c4123a835f0424f940f03136523d598
msgid "FPort requires connection to T6 and :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:79
#: a214d7f0a1d444449aaf2afcb40a80a0
msgid "CRSF also requires a T6 connection, in addition to R6, and automatically provides telemetry. Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` to \"0\"."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:81
#: 7b8810b33f7d4d8ab7c4d70126eed83f
msgid "SRXL2 requires a connection to T6 and automatically provides telemetry.  Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:83
#: 97811a3e67af442e82beff7182218485
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:87
#: 2fd7207200304173b20bd4fa39456084
msgid "FrSky Telemetry"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:89
#: 990b56841b3e45659fb7e5ed763c377c
msgid "FrSky Telemetry is supported using the T6 pin (UART6 transmit). You need to set the following parameters to enable support for FrSky S.PORT."
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:92
#: 4057e2450cf842ee9d7e6d296712dcd2
msgid ":ref:`SERIAL6_PROTOCOL<SERIAL6_PROTOCOL>` 4 or 10"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:93
#: 78b4c88979a14f488c9f0740a144e8c2
msgid ":ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` 7"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:95
#: aa7ad5c9e5fb428595e807f326fe229c
msgid "FrSky Telemetry is supported on all UARTs, UART6 TX is suggested as its RX input is already being used for RC input and avoids consuming another UART."
msgstr ""

