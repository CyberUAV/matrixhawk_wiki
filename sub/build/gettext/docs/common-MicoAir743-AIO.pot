msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:101
#: fbbf72f70fcb46ca8e5c9fc6cc4f225a
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:103
#: 3f4f69a29a7b4aea997fc4a57fecbb34
msgid "Initial firmware load can be done with DFU by plugging in USB with the bootloader button pressed. Then you should load the \"\\*xxxxx_with_bl.hex\" firmware, using your favorite DFU loading tool."
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:105
#: 771898f6f43b47a99fd042ae36892dea
msgid "Once the initial firmware is loaded you can update the firmware using any ArduPilot ground station software. Updates should be done with the \"\\*.apj\" firmware files."
msgstr ""
