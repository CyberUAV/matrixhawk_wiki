msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:86
#: dbf99bee0611456580269365472dd42e
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:87
#: 1e457a4570ba4295a09d6300cc2e5eac
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11"
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:88
#: 1ca22ac2e10543e5848d20be59878968
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 21.2"
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:89
#: 699062e78bb34c3390a1a3db6a325cfe
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 14.14"
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:92
#: bfeef222b9c546aba442689be8f578ee
msgid "Compass"
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:93
#: 8737fcf92ecd4bddae76ff55b32fa1a2
msgid "The MicoAir743-AIO does not have a built-in compass, but you can attach an external compass using I2C on the SDA and SCL connector."
msgstr ""

#: ../../source/docs/common-MicoAir743-AIO.rst:97
#: 6826ac0abfa54cf7b96be8c80b6fba2f
msgid "Firmware"
msgstr ""

