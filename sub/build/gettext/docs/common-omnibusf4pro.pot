#: db1e80870d7543e7b4b8cf92ac3bff90
msgid "Default UART order"
msgstr ""

#: ../../source/docs/common-omnibusf4pro.rst:96
#: 5a3744a5e4c449229b10996feea4b28b
msgid "SERIAL0 = console = USB"
msgstr ""

#: ../../source/docs/common-omnibusf4pro.rst:97
#: a987c4250ed34a86adb300f2d42bb8a1
