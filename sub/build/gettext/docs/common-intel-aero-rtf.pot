msgid "The default parameter file can be uploaded from the Mission Planner's Full Parameter Tree screen (raw parameter file is `here <https://github.com/ArduPilot/ardupilot/blob/master/Tools/Frame_params/intel-aero-rtf.param>`__)"
msgstr ""

#: ../../source/docs/common-intel-aero-rtf.rst:65
