#: ../../source/docs/common-greensightultrablue.rst:970
#: 012729cca3784455a6e4efeb029d9b34
msgid "Bi-directional protocols such as CRSF/ELRS and SRXL2 require a full UART connection. FPort, when connected to RCIN, will only provide RC without telemetry."
msgstr ""

#: ../../source/docs/common-greensightultrablue.rst:972
#: d18d2e7ab88d46e285a7027934a6a2d7
msgid "To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 receivers, a full UART, such as SERIAL2 (telem2) or SERIAL4 (GPS2) would need to be used for receiver connections. Below are setups using Serial2. Be sure to change :ref:`SERIAL5_PROTOCOL<SERIAL5_PROTOCOL>` to something other than \"23\"."
msgstr ""

#: ../../source/docs/common-greensightultrablue.rst:975
#: da1b19651a2745b6952ed159b8353306
