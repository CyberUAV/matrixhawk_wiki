#: ../../source/docs/common-leddar-one-lidar.rst:5
#: 63f4700dbd8642dfb94b78d11076a3fc
msgid "Leddar One Lidar"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:7
#: 4218d4ef34014d25988f83bfca9cf8bf
msgid "The `Leddar One Lidar <https://leddartech.com/modules/leddarone/>`__ is a light weight and reasonably priced lidar with 40m range, 70hz update rate and 3-degree diffuse beam.  For more details please refer to the `datasheet <https://leddartech.com/app/uploads/dlm_uploads/2016/02/Datasheet-LeddarOne.pdf>`__."
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:13
#: daa5de0e1284493d9d3f8ffd6f9dce76
msgid "Connecting to the AutoPilot"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:15
#: 3e4bac4735124610ba770197be65b50d
msgid "The sensor's serial connection can be connected to any spare serial port (i.e. Telem1, Teleme2, Serial4) on the autopilot.  Connect the lidar's RX line to the autopilot's UART TX line, the lidar's TX line to the UART's RX then also connect the GND and 5V lines.  The image below shows how the sensor output pins can be connected to a Pixhawk's Serial4 port."
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:20
#: 952104c8db874c29ab1835d01f0c7a46
msgid "You then need to setup the serial port and rangefinder parameters. If you have used the SERIAL4/5 port on the Pixhawk then you would set the following parameters for the first rangefinder (this is done on the Mission Planner's **Config/Tuning \\| Full Parameter List** page):"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:25
#: 3ee782d73fae4dfb833fe493d610a194
msgid ":ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:26
#: 57f2c2e5351e46faa75079cc8f3407cb
msgid ":ref:`SERIAL4_BAUD <SERIAL4_BAUD>` = 115200"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:27
#: 840f5b5bbdb14c3680e3891273dd3c90
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 12 (LeddarOne)"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:28
#: 988c617121db4041bdaa4d1543164847
msgid ":ref:`RNGFND1_SCALING <RNGFND1_SCALING>` = 1"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:29
#: fdbd7204f00b48c4af3bffa1f546151a
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.05"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:30
#: e7078a77599b4253a3d5b5e8388da4d7
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = **40** (40m) *This is the distance in meters that the rangefinder can reliably read.*"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:31
#: 4c2e7d61655c45d5abd159b726ef15d1
msgid ":ref:`RNGFND1_GNDCLR <RNGFND1_GNDCLR>` = 0.1 *or more accurately the distance in metres from the range finder to the ground when the vehicle is landed.  This value depends on how you have mounted the rangefinder.*"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:33
#: 2bea4c207aed482f913c8c79f0a265c0
msgid "If you instead were using the Telem2 port on the Pixhawk then you would set :ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 9, and :ref:`SERIAL2_BAUD <SERIAL2_BAUD>` = 115200"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:36
#: e8c2199d98114f2faec674e9588c740d
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-leddar-one-lidar.rst:38
#: 78a2e83ff6f84cd5aa179f572ad054b8
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""
