#: ../../source/docs/common-ethernet-vehicle.rst:167
#: 44579bebfb8a4124b1d78a387d6e93a4
msgid "Notes on cabling"
msgstr ""

#: ../../source/docs/common-ethernet-vehicle.rst:169
#: 53690d46a8c64ea88e88104b7113b08d
msgid "You do not have to use twisted pairs for TX and RX if the cables are short (~<12 inches)"
msgstr ""

#: ../../source/docs/common-ethernet-vehicle.rst:170
#: 19d35ebd4246471da619bb9eb28f597b
msgid "28 gauge wire is sufficient"
msgstr ""

#: ../../source/docs/common-ethernet-vehicle.rst:171
#: aa1aa8a5853042dc86f24b8f3aedcc17
msgid "When you interconnect Ethernet devices, hosts(in our case the autopilot, gimbal, and Herelink) connect to switches with \"crossover cabling\" , ie device TX pairs go to RX pairs on the switch, and vice versa. In the above cables you will note that the SIYI cable does this, but the others do not. That is because the CUAV autopilot and Herelink have an advanced Ethernet IC that autodetects if the cabling is not \"crossover\" and internally accommodates this (\"Auto MDX\"). The SIYI gimbal does not."
msgstr ""

