#: 66db497dbd4c4565b813486bebd59c32
msgid "1, 2, 3, 4 are Group 1"
msgstr ""

#: ../../source/docs/common-MicoAir743.rst:98
#: c042dd41a4cb4c61978fdb73a5c4c553
msgid "5, 6 are Group 2"
msgstr ""

#: ../../source/docs/common-MicoAir743.rst:99
#: 7c2bd39ecac3429289d0ab2a30674382
msgid "7, 8, 9, 10 are Group 3"
msgstr ""

