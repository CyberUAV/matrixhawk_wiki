msgid "SERIAL5 = USER = UART5"
msgstr ""

#: ../../source/docs/common-matekf405-se.rst:80
#: 0fcd3de68879448a93e8c6bb666c16e7
msgid "SERIAL6 = USER = USART6 (RX only; for ESC telemetry, use SERIAL6_PROTOCOL=16)"
msgstr ""

#: ../../source/docs/common-matekf405-se.rst:81
#: d630e6d9cda14e8f9d868a4ff7538cbc
msgid "SERIAL7 = USER = USART2 (only if BRD_ALT_CONFIG =1)"
