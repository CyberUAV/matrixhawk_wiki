#: ../../source/docs/common-rangefinder-mr72.rst:5
#: edc7c7e899a84efd9a383711c330997d
msgid "Nanoradar MR72"
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:8
#: 9ff48ad697904d6bbd2920fc8aaea974
msgid "Support for this sensor is available in firmware versions 4.5 and later. Plane does not support this sensor since its a Proximity sensor."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:10
#: fcf8e3dd07dd41e5b163de53ee883244
msgid "The `MR72 <http://en.nanoradar.cn/Article/detail/id/488.html>`__ is 77Ghz-band radar commonly used for object avoidance/detection. Currently only connection via CAN is supported. Serial versions of this Radar isn't officially supported."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:17
#: 8e4969b1f07f417ba147818fdb989248
msgid "Connecting via CAN"
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:19
#: 3bbf95f7d56642efbf3d37929a335937
msgid "Setup the sensor through the NSM Software. In particular set the \"ID\" to a unique number if planning to use multiple MR72 on a single CAN bus. You can also set the bitrate from the software."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:22
#: dc3ecc86590e449b98d0d368a744142e
msgid "ArduPilot does not currently support  same CAN rangefinders connected to different CAN ports. If you would like yo use multiple CAN rangefinders together, connect them to the same bus."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:26
#: 18fe09c40e0d4b2a90ab174692882228
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:27
#: 9e9f6465df3548dfb469aeeee335f902
msgid "Setup the sensor through the NSM toolprovided by the manufacturer. More details can be found `here <http://en.nanoradar.cn/File/download/id/466.html>`__. Set the \"ID\" to a unique number if planning to use multiple MR72 on a single CAN bus. You can also set the bitrate from the software to match the CAN bus bitrate (500000 is recommended)."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:29
#: 36ffe3d54481478ea5ff609f94d7682a
msgid "For autopilot connection you can use any spare CAN port. Since this is not a DroneCAN based sensor, you will not be able to use the connected port with any other sensor. The diagram below shows how to connect to CAN2."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:34
#: e77f40a5d0e647daa65d942de84f4c4e
msgid "Set the following parameters"
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:36
#: 383239c9c44e48ddbe02afff5412bea5
msgid ":ref:`CAN_P2_DRIVER <CAN_P2_DRIVER>` = 2 (to enable the 2nd CAN port using the second CAN driver)"
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:37
#: a0bb8598d02040208325b4caa8e8d428
msgid ":ref:`CAN_P2_BITRATE<CAN_P2_BITRATE>` = 500000 (Or as set in NAssistant)"
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:38
#: a933fe2cda5d4565ac0de206ac817075
msgid ":ref:`CAN_D2_PROTOCOL<CAN_D2_PROTOCOL>` = 14 (RadarCAN)"
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:39
#: 976ab4e196944cafa6db20563155e9e7
msgid ":ref:`PRX1_TYPE <PRX1_TYPE>` = 17 (MR72_CAN) Reboot after setting this."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:40
#: 414be9de9e674305a34175eb4fe6661f
msgid ":ref:`PRX1_ORIENT <PRX1_ORIENT>` = \"0\" if mounted on the top of the vehicle, \"1\" if mounted upside-down on the bottom of the vehicle."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:41
#: 4fecc72b6c6443aa8dd0fddeeb1944f8
msgid ":ref:`PRX1_YAW_CORR <PRX1_YAW_CORR>` allows adjusting the forward direction of the unit.  One way to determine this angle is to use the Mission Planner's Setup >> Advanced, Proximity viewer and then walk around the vehicle and ensure that the sector distances shorten appropriately."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:42
#: a820fc65f59a40e48402e56ea03ca352
msgid ":ref:`PRX1_IGN_ANG1 <PRX1_IGN_ANG1>` and :ref:`PRX1_IGN_WID1 <PRX1_IGN_WID1>` should be left at default."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:44
#: 6124b0f46db4463097ea8f49bb1277f9
msgid "More details on using this sensor for object avoidance on Copter can be found :ref:`here <common-object-avoidance-landing-page>`."
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:49
#: 9acf149570504b58a23640d28cddc845
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-rangefinder-mr72.rst:51
#: 491503ed1aa94e42accdaf7341fa238d
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""
