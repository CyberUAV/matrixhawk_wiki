#: ../../source/docs/common-network.rst:120
#: 3e2c3cc619124f0dae1aa09e3fbf1efa
msgid "These parameters apply for either Ethernet or PPP data link connections to the network. Parameters for each of the four logical ports per network physical interface (example shown only for Port 1):"
msgstr ""

#: ../../source/docs/common-network.rst:123
#: 0273b5423d354cb6a71f34dbf1afc28c
msgid ":ref:`NET_P1_TYPE<NET_P1_TYPE>`: Type can be disabled (0), UDP Client (1), UDP Server (2), TCP Client (3), or TCP Server(4). For the two client types a valid destination IP address must be set. For the two server types either 0.0.0.0 or the autopilot's local IP address can be used. The UDP client type will use broadcast if the IP is set to 255.255.255.255 and will use UDP multicast if the IP is in the multicast address range. A reboot is required to see the following parameters once the TYPE is set."
msgstr ""

#: ../../source/docs/common-network.rst:124
#: f3f94dbb9a5c44bb885d737f15e0974b
msgid ":ref:`NET_P1_IP0<NET_P1_IP0>`, :ref:`NET_P1_IP1<NET_P1_IP1>`, :ref:`NET_P1_IP2<NET_P1_IP2>`, :ref:`NET_P1_IP3<NET_P1_IP3>`:IP address for outgoing packets from Clients. Can be 0.0.0.0 or the autopilot's IP address for Servers. A reboot is required after changing."
msgstr ""

#: ../../source/docs/common-network.rst:125
#: d99e3eed149045bd889d937e05fce4a9
msgid ":ref:`NET_P1_PORT<NET_P1_PORT>`: This is the TCP or UDP port number. Reboot required after changing."
msgstr ""

#: ../../source/docs/common-network.rst:126
#: e9ecc216509f4c25a2de179df723b4a3
msgid ":ref:`NET_P1_PROTOCOL<NET_P1_PROTOCOL>`: This registers this port with the ArduPilot Serial Manager as having a device attached which uses the specified protocol. This allows ArduPilot to use the data as if it had come from a UART attached device or connection. A reboot is required after changing."
msgstr ""

