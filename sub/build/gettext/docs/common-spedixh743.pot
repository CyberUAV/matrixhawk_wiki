#: ../../source/docs/common-spedixh743.rst:50
#: c74d8ffac1c14b1da08df821ddfd051b
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:51
#: ae7ca92cc9904672b7258890aabad650
msgid "Onboard OSD using OSD_TYPE 1 (MAX7456 driver) is supported by default. Simultaneously, DisplayPort OSD is available on the HD VTX connector."
msgstr ""

#: ../../source/docs/common-spedixh743.rst:54
#: 5365ec6a6e6848e8accaf659a7fb7698
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:55
#: 73a2b3646f1d4f17be99b96f4e297288
msgid "The SPEDIX F405 supports up to 9 PWM outputs. The pads for motor output M1 to M8 are provided on both the motor connectors and on separate pads, plus M9 on a separate pad for LED strip (default configuration) or another PWM output."
msgstr ""

#: ../../source/docs/common-spedixh743.rst:59
#: a368cad01b2347ff9b4684f09d31bc9d
msgid "The PWM is in 4 groups:"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:61
#: 8581aff0518b4153b1bdd3f900b76e57
msgid "PWM 1-4 in group1"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:62
#: 1f9eb50e57fb4ab8882c1cbbaf20b5cb
msgid "PWM 5-6 in group2"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:63
#: 21efe21d3dd54a428d35a418e7971e28
msgid "PWM 7-8 in group3"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:64
#: 0c3ac9be865e411aba21867624854ddc
msgid "PWM 9 in group4"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:66
#: 51efc7febb7344a2b151fcecf07ef440
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-8 support bi-directional dshot."
msgstr ""

#: ../../source/docs/common-spedixh743.rst:71
#: 06a1a7e5940c4c068c4a746e32b6846a
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:72
#: ae5c9f45089b45c49432100e1d40ef19
msgid "The board has a built-in voltage sensor and external current sensor input. The voltage sensor can handle up to 6S LiPo batteries. The correct battery setting parameters are:"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:74
#: c851ee586a4c4a479325b89ee6801ca6
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:75
#: 93e9a466b2cd44339bc2cb423ce9c7e1
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:76
#: 1a79bf6c778c427fa7d6706c5a3d5127
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11 (CURR pin)"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:77
#: 7c934665c61548c198b4d6dd2bfb83ea
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 11.0"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:78
#: bd7eff06775d42b99b5c9bd77448f033
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 25 (depends on sensor used)"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:81
