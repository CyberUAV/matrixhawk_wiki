#: ../../source/docs/common-teraranger-neo.rst:5
#: 8dc9a9e376b64aa186822cb2b3357fb5
msgid "TeraRanger NEO"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:9
#: c7cb5848e2824dfaa09835da928c257d
msgid "A new addition to the TOF rangefinder offering by `TeraBee <https://www.terabee.com/>`__ . This sensor has much longer range (up to 30 meters) and better performance over less reflective surfaces such as grass, making it very suitable for Plane landing, Copter takeoff and landing, and Object Avoidance applications."
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:12
#: a1e6daae61194fd2bb83cbed27d67182
msgid "Where to Buy"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:14
#: f8d87fee752a4ca5afc9c1aea23845fe
msgid "`TeraBee <https://www.terabee.com/shop/lidar-tof-range-finders/teraranger-neo/>`__"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:18
#: 1313d694803e4370aa4dd3faf4af3084
msgid "Connection to Autopilot"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:20
#: 89e05d1d5ed4416181c581344734bfd3
msgid "The sensor can be connected to any autopilot serial port."
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:26
#: 5b2fba8fc6eb4f9a862eafffc7ddee9c
msgid "Setup"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:28
#: b8d4b99c5ffd45b990df13d8cbf57940
msgid "For the below example, we will assume that the rangefinder is connected to SERIAL2 as the first system rangefinder:"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:30
#: 2d6b060829774378909ccd6603162c2e
msgid "Set :ref:`SERIAL2_PROTOCOL<SERIAL2_PROTOCOL>` =  9 (Rangefinders)"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:31
#: fbe69a0eb8894525903b6467e1852eb8
msgid "Set :ref:`SERIAL2_BAUD<SERIAL2_BAUD>` = 9 (9600 Baud)"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:32
#: 10b3799814364df48fc794ce56a8c2d1
msgid "Set :ref:`RNGFND1_TYPE<RNGFND1_TYPE>` = 35 (TeraRanger NEO)"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:35
#: 5b01a0585b7a4ba3903b805bfde3d6ad
msgid "As a Plane altitude rangefinder used in auto landings:"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:37
#: d2bced73a0b54b43b62698297d7ed948
msgid "Set :ref:`RNGFND_LANDING<RNGFND_LANDING>` bits 0 or 1 to enable used of the rangefinder during landing phases of Plane and QuadPlane. The first rangefinder with \"down\" orientation will be used."
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:39
#: 9f8f88f9debc4a378835bc50d45b7189
msgid "Set :ref:`RNGFND1_ORIENT<RNGFND1_ORIENT>` = 25 (down)"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:40
#: 32c6b453e3c64cf58c78c3a1a832acd1
msgid "Set :ref:`RNGFND1_MIN<RNGFND1_MIN>` = 0.5 (meters)"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:41
#: 017903792d2d4f9e9fef73bcd63317e8
msgid "Set :ref:`RNGFND1_MAX<RNGFND1_MAX>` = 22 (22m since grass landings will reduce reliable range down to this range instead of 30m)"
msgstr ""

#: ../../source/docs/common-teraranger-neo.rst:47
#: d28af58360c04b108ee4a0be99ea6001
msgid "For Copter and Object Avoidance applications, additional/different parameters will be need to set. See :ref:`common-rangefinder-setup`."
msgstr ""
