#: ba79e72e487c44cfa14ffc78293920cb
msgid "PWM 7, 8  in group3"
msgstr ""

#: ../../source/docs/common-jhemcu-h743hd.rst:80
#: dd6f6ec2eaac4bc690f875f3bf0100f5
msgid "PWM 9     in group4"
msgstr ""

#: ../../source/docs/common-jhemcu-h743hd.rst:82
#: 6703eb14cd4d41bfab848f3474022338
msgid "Outputs within the same group need to use the same output rate. If any output in a group uses DShot then all in the group need to use DShot."
msgstr ""

