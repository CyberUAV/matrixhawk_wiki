#: ../../source/docs/common-chdk-camera-control-tutorial.rst:555
#: 2842b94f881d42b79f422fcf8819c6d4
msgid "CHDK cables work by translating pulse width modulation (PWM) output by the autopilot into USB power pulses that can be read by the camera. It does this by establishing a range of how long power is applied to the USB port (ex: 40-80 ms) and assigning that range to a PWM value corresponding to a channel switch position (ex: Channel middle).The table below shows the corresponding output values between the switch position on the RC transmitter, the autopilot's PWM output, and the camera's USB power. In practice, our Spektrum DX 8 outputs the values shown in the rightmost column."
msgstr ""

#: ../../source/docs/common-chdk-camera-control-tutorial.rst:566
#: 2c65fc964c6144b1bb282c1f5a346674
msgid "Spektrum DX8 USB power readings (ms)"
msgstr ""

#: ../../source/docs/common-chdk-camera-control-tutorial.rst:568
#: 655595e1dbd34737bdcc450f8d079445
msgid "30"
msgstr ""

#: ../../source/docs/common-chdk-camera-control-tutorial.rst:570
#: 28c03c2535564201bc804d7567ca4d8a
msgid "50 or 60"
msgstr ""

#: ../../source/docs/common-chdk-camera-control-tutorial.rst:572
#: fe3e62877698400f873a1e004970878e
msgid "90"
msgstr ""

#: ../../source/docs/common-chdk-camera-control-tutorial.rst:574
#: e07d4f668e134d7da6d49491fd7f9864
msgid "130"
msgstr ""

#: ../../source/docs/common-chdk-camera-control-tutorial.rst:576
#: 38befc2f81314a4db9fc5fa8fe21564f
