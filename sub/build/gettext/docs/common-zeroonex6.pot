msgid "Outputs 3 and 4 in group2"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:84
#: d64bec57c69e401e9619151a862bbd76
msgid "Outputs 5, 6, 7 and 8 in group3"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:86
#: 77f276a314a5461dae5d7f0dbd8a4e1b
msgid "The 8 FMU PWM outputs are in 4 groups:"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:89
#: dd59c37f4e444f4e81a26fe4403428a6
msgid "Outputs 9-12 in group1"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:90
#: 2bec286fb281440b9a9c0831ebc58732
msgid "Outputs 13 and 14 in group2"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:91
#: df5bb9a1e2fa406f91f5005047f29a5f
msgid "Outputs 15 and 16 in group3 (PWM only)"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:93
#: 54465e9cfede4bb4a877e183fad8ccb4
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot."
msgstr ""

