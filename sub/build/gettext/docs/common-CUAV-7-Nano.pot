#: ../../source/docs/common-CUAV-7-Nano.rst:56
#: 52fdf1bb4fb2447db35e12bae1562924
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:58
#: 002dd7877faf43889a2402d739267e22
msgid "RC input is configured on the RCIN pin, at one end of the servo rail, marked RCIN in the above diagram. All ArduPilot supported unidirectional RC protocols can be input here including PPM. For bi-directional or half-duplex protocols, such as CRSF/ELRS a full UART will have to be used. For example if SERIAL2 (UART5) is used for bi-directional RC, then:"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:60
#: 21f0c5ef88084e1fbf10038cd62e54ab
msgid ":ref:`SERIAL2_PROTOCOL<SERIAL2_PROTOCOL>` must be set to \"23\", and:"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:62
#: 209f79d9bac94d0e90f30e2f3dace000
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:64
#: 457059ced33048fb8bd28f87e7251b81
msgid "SBUS/DSM/SRXL connects to the R6 pin."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:66
#: d59496c15e03482caabb29aebda01397
msgid "FPort requires connection to Tx and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:68
#: b8b67ebded204868a7c0cab226164cea
msgid "CRSF/ELRS also requires a Tx connection, in addition to Rx, and automatically provides telemetry. Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"0\"."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:70
#: cc68dd3b7def44b7b54104832480d2d4
msgid "SRXL2 requires a connection to Tx and automatically provides telemetry.  Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:72
#: 291638789362413aa1d55dcdfae699f9
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:75
#: 9c1b794fd40c403289e6ebe7f83cb072
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:77
#: 2fba14c713954f44a44a9ccad66473ff
msgid "The CUAV-7-Nano flight controller supports up to 14 PWM outputs."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:79
#: 135b705750164c2cb69792dda9589c30
msgid "The 14 PWM outputs are in 6 groups:"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:82
#: b90828d94f5941b5b510f4e03f249ac5
msgid "PWM 1-4 in group1 (TIM5)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:83
#: a0dff62206904a42aa641fa9f3e4babf
msgid "PWM 5 and 6 in group2 (TIM4)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:84
#: a4d5cd3fcddb46c984a6ab143ff4be44
msgid "PWM 7 and 8 in group3 (TIM1)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:85
#: 039c866934724a04b1f517f8f7cc5216
msgid "PWM 9, 10 and 11 in group4 (TIM8)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:86
#: 12a04dbf656244f4aed60429ca28bffc
msgid "PWM 12 in group5 (TIM15)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:87
#: fdef49e358e041d2939383ffca6adc20
msgid "PWM 13 and 14 in group6 (TIM12)"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:89
#: a789b4aefa9a42c8a6f4e39ce54c28ae
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Outputs 1-4 support BDShot."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:91
#: c2afb0f336aa4ee39cc5d0d297cbab05
msgid "First first 8 PWM outputs of CUAV-7-Nano flight controller support switching between 3.3V voltage and 5V voltage output. It can be switched to 5V by setting GPIO 80 high by setting up a Relay (see :ref:`common-relay`) to control it."
msgstr ""

