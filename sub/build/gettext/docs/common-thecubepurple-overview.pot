#: d941aee0bb2d46858660cfe6bc79742b
msgid "**Sensors**"
msgstr ""

#: ../../source/docs/common-thecubepurple-overview.rst:31
#: be12923a0c1f437ca99440d557903c34
msgid "1 x IMU (accels, gyros and compass)"
msgstr ""

#: ../../source/docs/common-thecubepurple-overview.rst:32
#: daf2d9c8190342dc84b6ca51524c9f08
