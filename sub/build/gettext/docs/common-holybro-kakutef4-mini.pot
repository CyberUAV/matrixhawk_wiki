#: ../../source/docs/common-holybro-kakutef4-mini.rst:106
#: 786d0df97ef74f4fa331703dcc1ca33f
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-holybro-kakutef4-mini.rst:108
#: 6d956c0a71194d298053be6500b4e091
msgid "The KakuteF4 supports up to 5 PWM outputs. The pads for motor output M1 to M6 on the above diagram are for the 5 outputs. M1-4 outputs support DShot and :ref:`Bi-Directional DShot<bidir-dshot>`, as well as all PWM types. The M5 is defaulted to support serial LEDs instead of PWM but can be changed by changing its default function using :ref:`SERVO5_FUNCTION<SERVO5_FUNCTION>` and supports Dshot."
msgstr ""

#: ../../source/docs/common-holybro-kakutef4-mini.rst:112
#: 7164fca003844db7a2a29afe14307ab7
msgid "The PWM is in 2 groups:"
msgstr ""

#: ../../source/docs/common-holybro-kakutef4-mini.rst:114
#: 1eab1acb8e1a4edba92de5ad2872940b
msgid "PWM 1 and 2 in group 1"
msgstr ""

#: ../../source/docs/common-holybro-kakutef4-mini.rst:115
#: 208e7134ba91413dacd6a5c4dfdf496d
msgid "PWM 3 and 4 in group 2"
msgstr ""

#: ../../source/docs/common-holybro-kakutef4-mini.rst:116
#: 77ab3b3c1c314fab89658ec8b9dfd829
msgid "PWM 5 in group 3 (defaulted as serial LED)"
msgstr ""

#: ../../source/docs/common-holybro-kakutef4-mini.rst:118
#: d616f416f9ff4e80a650de7e43e9e615
msgid "Channels within the same group need to use the same output rate, whether PWM or Dshot. If any channel in a group uses DShot then all channels in the group need to use DShot."
msgstr ""

