#: ../../source/docs/common-luxf765-ndaa.rst:387
#: fb19ea657ba4426aa454995a34f645f1
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:388
#: e60a4cac46bd4d38a5ab9c13b066ad7c
msgid "The LUX F765 - NDAA does not come with ArduPilot firmware pre-installed. Use instructions here to load ArduPilot the first time :ref:`common-loading-firmware-onto-chibios-only-boards`."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:390
#: 84d26e961432447ba1728a845cd54041
msgid "Initial firmware load can be done with DFU by plugging in USB with the bootloader button pressed. Then you should load the \"with_bl.hex\" firmware, using your favorite DFU loading tool."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:394
#: cbebf0e38e5146bab336a35b75fec9f9
msgid "Once the initial firmware is loaded you can update the firmware using any ArduPilot ground station software. Updates should be done with the \\*.apj firmware files."
msgstr ""
