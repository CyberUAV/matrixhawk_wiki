#: ../../source/docs/common-luxf765-ndaa.rst:330
#: c92f6be0b7714f1b892837623413d35e
msgid "The Lumenier LUX F765 NDAA supports 12 PWM outputs and a serial LED PWM output. All outputs are DShot capable. Outputs 1-4 are bi-directional DShot capable. Outputs are grouped and every group must use the same output protocol."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:332
#: 3c386e38bcef47d3a89bba73d0bbc182
msgid "The 8 main PWM outputs are labeled M1 through M8. The 4 auxiliary outputs are labeled S1 through S4."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:335
#: 51413f889a92423196dfa490840e34b6
msgid "The 8 main PWM outputs are in 2 groups:"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:337
#: 6193c7da67be4a2b8f41c09b82a1349a
msgid "PWM 1 through 4 (M1 - M4) are in Group1"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:338
#: 9e198583919f4e7c8400f318d7083fc5
msgid "PWM 5 through 8 (M5 - M8) are in Group2"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:340
#: 88f576501d11404891845a9f380b63ea
msgid "The auxiliary PWM outputs are grouped as follows:"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:342
#: 087e73196cd14973b6afae60670fb447
msgid "PWM 9/10 (S1/S2) are in Group3"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:343
#: 7588f9253e9d4c4782d5e4f4f1829dfe
msgid "PWM 11/12 (S3/S4) are in Group4"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:344
#: 447bfdb74123459ebba656f16c935c06
msgid "PWM 13 (LED) is in Group5"
msgstr ""

