#: ../../source/docs/common-lua-scripts.rst:151
#: 312500cc2bcb4d5a8e9a91acf3aa4468
msgid "Location"
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:153
#: 27ed7b41cbd44e529babfc92b7bbdf83
msgid "Location is a userdata object that holds locations expressed as latitude, longitude, altitude. The altitude can be in several different frames, relative to home, absolute altitude above mean sea level, or relative to terrain. To create a new Location userdata you can call Location() to allocate an empty location object, or call a method that returns one to you."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:155
#: 315f5d6e1971405098d689620f4d0f98
msgid "A Location userdata object supports the following calls:"
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:157
#: 55278a49b4d04de088ae277f07fae820
msgid ":code:`lat( [new_lat] )` - If called with no arguments, returns the current latitude in degrees * 1e7 as an integer. If called with one argument, it will assign the value to the latitude."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:159
#: 3aecb429991c4ea7a47dfd32d1c8d8b1
msgid ":code:`lng( [new_lng] )` - If called with no arguments, returns the current longitude in degrees * 1e7 as an integer. If called with one argument, it will assign the value to the longitude."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:161
#: 0365198bb5c54d1c8736f0a4e96e4864
msgid ":code:`alt( [new_alt] )` - If called with no arguments, returns the current altitude in cm as an integer. If called with one argument, it will assign the value to the altitude."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:163
#: c65a2cce290c4d35ab3429b35a8bd54d
msgid ":code:`relative_alt( [is_relative] )` - If called with no arguments returns true if the location is planned as relative to home. If called with a boolean value this will set the relative altitude."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:165
#: 24e64df5e77143dc91b06be2ca331732
msgid ":code:`terrain_alt( [is_terrain] )` - If called with no arguments returns true if the location is planned as relative to terrain. If called with a boolean value this will flag if the altitude should be relative to terrain."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:167
#: 2cb9e8cd6fd9453c87e298f6b697fbaa
msgid ":code:`origin_alt( [is_origin] )` - If called with no arguments returns true if the location is planned in absolute altitude relative to mean sea level. If called with a boolean value this will set the altitude to be relative to mean sea level."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:169
#: d636bffbcf0243b49918e0ed79d135aa
msgid ":code:`loiter_xtrack( [should_xtrack] )` - If the location is used for a loiter location this flags if the aircraft should track from the center point, or from the exit location of the loiter."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:171
#: 7d6076e1e14f446aaf71a44222668ad6
msgid ":code:`get_distance( other_Location )` - Given a Location this calculates the horizontal distance between the two locations in meters."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:173
#: 7ecd2a44b8d246909521924ae04c76e9
msgid ":code:`offset( offset_north ,  offset_east )` - Translates this Location by the specified number of meters."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:175
#: df69ce8e794c4e7f995d7a8513cfa1f0
msgid ":code:`get_vector_from_origin_NEU()` - Returns nil or Vector3f that contains the offset from the EKF origin to this location. This will return nil if the EKF origin wasn’t available at the time this was called."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:177
#: b33f9368e25a465fa8881bba1330df2c
msgid ":code:`get_bearing( other_Location )` - Given a Location this calculates the relative bearing to the location in radians"
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:179
#: 29f28843a1bd4a45bf9d1874766e303f
msgid ":code:`get_distance_NED( other_Location )` - Returns nil or Vector3f that contains the 3D vector in meters to the other Location."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:181
#: 08a3a28ae4a4470db9f5e67bdfda9250
msgid ":code:`get_distance_NE( other_Location )` - Returns nil or Vector2f that contains the 2D vector in meters to the other Location."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:184
#: 76295cc301744367b03a273a9c2b5aae
msgid "Vector2f"
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:186
#: d1f90c8a4ae3469481e8238ff0dfe104
msgid "Vector2f is a userdata object that holds a 2D vector. The components are stored as floating point numbers. To create a new Vector2f you can call Vector2f() to allocate a new one, or call a method that returns one to you."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:188
#: ff9d836f3ee447dcaa30c733807a87e7
msgid "A Vector2f object supports the following calls:"
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:190
#: ../../source/docs/common-lua-scripts.rst:217
#: 4d3b93f783da4be79fc63c42fe98731b
#: fa5b388c089d4a8d826620c1cacccb48
msgid ":code:`x( [new_x] )` - If called with no arguments, return the currently set X component as a floating point number. If called with one argument it will assign the value to the X component."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:192
#: ../../source/docs/common-lua-scripts.rst:219
#: 245b9dc8fd7c4e6884ce3400654de9a4
#: 9526002d38c241659331fbe49f04dcef
msgid ":code:`y( [new_y] )` - If called with no arguments, return the currently set Y component as a floating point number. If called with one argument it will assign the value to the Y component."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:194
#: ../../source/docs/common-lua-scripts.rst:223
#: f196faa2fed74bd28cdb08d3f6ca8a14
#: 3132ff362ed9448296d3b5acfb9f3f6c
msgid ":code:`length()` - Returns the length of the vector as a floating point number."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:196
#: ../../source/docs/common-lua-scripts.rst:225
#: 9d1b70d71f5e442bac221c0dace08d3d
#: 8a5a5e9954bc4e1c94b60eeaca610ea3
msgid ":code:`normalize()` - Normalizes the vector to be a unit vector."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:198
#: ../../source/docs/common-lua-scripts.rst:227
#: 9e249ca306dd48fcb89c8199bde9c075
#: 9c2481f2f69d410fa7e7590e16652a08
msgid ":code:`is_nan()` - Returns true if the vector contains any NaN members."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:200
#: ../../source/docs/common-lua-scripts.rst:229
#: 382a60eeccad48f5936ce29bcbaeb2b3
#: 5a9bae8bc6304d4f92206b27c9a4e992
msgid ":code:`is_inf()` - Returns true if the vector contains any infinity members."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:202
#: ../../source/docs/common-lua-scripts.rst:231
#: 91a97bc443794a948949960601bb6698
#: 27c40cc36c3c4ae9933f310bf9cd1fa8
msgid ":code:`is_zero()` - Returns true if all the vector fields are 0."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:204
#: a1d55046c80746a09f83cb9343a47fc7
msgid "The following operators are supported on a Vector2f:"
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:206
#: ../../source/docs/common-lua-scripts.rst:235
#: 6a97a47c8dcd401dab8ac5359a7ec9c1
#: 1a8d8e2efbe5468ab5f936d3ebcc2aec
msgid ":code:`+` - Adds the two vectors by components."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:208
#: ../../source/docs/common-lua-scripts.rst:237
#: 15c3b0cd30fc44d28907b8a76e071165
