#: ab6c7dd3422944d1b66aedb34b119100
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-aedroxh7.rst:87
#: d66180a059544d3bb3eb30ccc764947f
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11 (CURR pin)"
msgstr ""

#: ../../source/docs/common-aedroxh7.rst:88
#: 7c5dc974d2024629ac926ba41eaf524c
