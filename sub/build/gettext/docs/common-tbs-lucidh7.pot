#: e495e02bb0ce4d3b9c401ec3558ed8d5
msgid "The TBS LUCID H7 supports OSD using OSD_TYPE 1 (MAX7456 driver) and simultaneously DisplayPort using TX3/RX3 on the HD VTX connector."
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:80
#: eed05a0379e347e0b3a7b25bdfacdd8b
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:81
#: a4af4d371ea34b98bab58524cf52d98e
msgid "The TBS LUCID H7 supports up to 13 PWM or DShot outputs. The pads for motor output M1 to M4 are provided on both the motor connectors and on separate pads, plus M9-13 on a separate pads for LED strip and other PWM outputs."
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:85
#: abc13ea3b2bb49acb424fe963998caf2
msgid "The PWM is in 4 groups:"
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:88
#: 5a1df546fe1b48e5919c26d7b3b862d6
msgid "PWM 1-2   in group1"
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:89
#: 1f17f70359614929a32a8c51db2594ce
msgid "PWM 3-4   in group2"
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:90
#: 144258d4e73446b7a201b5f6e39a144c
msgid "PWM 5-6   in group3"
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:91
#: 911c2938d20347a69c4b95e910a7ba0a
msgid "PWM 7-10  in group4"
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:92
#: dcfbd3e381ec4b3d8c32f9301fbc5593
msgid "PWM 11-12 in group5"
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:93
#: 570b39a5decb4564acf85607c001d26b
msgid "PWM 13    in group6"
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:95
#: 5ec7c268f2b648128a27939fce5095bd
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-10 support bi-directional dshot."
msgstr ""

#: ../../source/docs/common-tbs-lucidh7.rst:100
