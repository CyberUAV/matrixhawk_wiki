#: ../../source/docs/common-camera-gimbal.rst:23
#: abfd5d1d5cb643749f4036f24e28419f
msgid "Mounting the Camera and Gimbal"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:25
#: 98492223c5d7442aa45da7809c9fda60
msgid "The camera needs to be mounted securely to the gimbal, but in such a way that reduces/dampens vibrations from the motor."
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:28
#: c983f2271b0649e3983db25e89ab2362
msgid "Common methods for mounting the camera on the gimbal include using soft foam, stiff foam, neoprene tubes (mount camera on tube side), surgical tube, rubber bands, nylon bolts (direct stiff attachment) and velcro."
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:33
#: 382e0c81103343529cfcdf38978d548d
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:35
#: 9097c116d0a546cc9ed8e4b312f09ce4
msgid "Connect the gimbal's roll, pitch, and/or yaw servos signal and ground pins to the autopilot's PWM output pins as shown below.  Most autopilots do not provide power on the servo rail meaning a separate BEC is required."
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:41
#: 26b122fd16964da993816a7c81b265a9
msgid "Configuration"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:45
#: ac10df9813a844a6a985b163b261fe18
msgid "Mission Planner includes a \"Camera Gimbal\" configuration screen but it has not yet been updated to work with ArduPilot 4.3 (and higher)."
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:47
#: 3cf8754950e94884b5b283a8e809293b
msgid "Connect to the autopilot with a ground station and set the following parameters. These settings assume the autopilot's PWM outputs 9, 10 and 11 will control the gimbal's roll, pitch and yaw angles respectively. They also assume common angular ranges of the gimbal which may need adjusting to match the actual gimbal being used."
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:49
#: 56863d07a3e240de9f503455a4c79420
msgid "Currently up to two mounts can be supported, MNT1 and MNT2. The following parameters are for the first mount. The second mount has the same parameters."
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:51
#: 5d48b5dd564246049327c09e6785c44d
msgid ":ref:`MNT1_TYPE <MNT1_TYPE>` to 1 (Servo) and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:52
#: 508b40d6628a44518e6ec3136d97e45f
msgid ":ref:`MNT1_PITCH_MIN <MNT1_PITCH_MIN>` to -90 (meaning the gimbal can pitch straight downwards)"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:53
#: 2d5f340ad7414d2b898c5c3784694af3
msgid ":ref:`MNT1_PITCH_MAX <MNT1_PITCH_MAX>` to 25 (meaning the gimbal can pitch up by 25 deg)"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:54
#: c2b27ab18183425887240165cc124370
msgid ":ref:`MNT1_ROLL_MIN <MNT1_ROLL_MIN>` to -30 (meaning the gimbal can roll right 30 deg)"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:55
#: 2178f354e05540399828619d252f4d75
msgid ":ref:`MNT1_ROLL_MAX <MNT1_ROLL_MAX>` to 30 (meaning the gimbal can roll left 30 deg)"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:56
#: ef820803b4624209bce8548f7d3c1a0f
msgid ":ref:`MNT1_YAW_MIN <MNT1_YAW_MIN>` to -180 (meaning the gimbal can yaw to the left 180deg)"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:57
#: 9d2e93828b614e58821a2897feb6f30b
msgid ":ref:`MNT1_YAW_MAX <MNT1_YAW_MAX>` to 180 (meaning the gimbal can yaw to the right 180deg)"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:58
#: bd661c8574a5427bbf8460c6ab231976
msgid ":ref:`MNT1_RC_RATE <MNT1_RC_RATE>` to 90 (deg/s) to control speed of gimbal when using RC targeting. If RC value is intended to control the ANGLE, then set it to 0."
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:60
#: a5cfe58d91164035b07266dd567bde11
msgid "Typical input and output assignments are shown below, but any unused RC input channel or autopilot output channels can be assigned for some or all of these functions."
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:62
#: a4c2016edba1409b8ef1b2afb931c2c5
msgid ":ref:`SERVO9_FUNCTION <SERVO9_FUNCTION>` to 8 (Mount1 Roll)"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:63
#: fcd2be5055124567864bc80ed97e6bc1
msgid ":ref:`SERVO9_MIN <SERVO9_MIN>` and :ref:`SERVO9_MAX <SERVO9_MAX>` to match the min and max range of the roll servo"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:64
#: fe052ccd8c964970a3c9c23ced6838a1
msgid ":ref:`SERVO10_FUNCTION <SERVO10_FUNCTION>` to 7 (Mount1 Pitch)"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:65
#: b161e6e40e5042cdb35af3223b317188
msgid ":ref:`SERVO11_MIN <SERVO11_MIN>` and :ref:`SERVO11_MAX <SERVO11_MAX>` to match the min and max range of the yaw servo"
msgstr ""

