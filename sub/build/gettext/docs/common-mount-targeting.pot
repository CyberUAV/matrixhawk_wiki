msgstr ""

#: ../../source/docs/common-mount-targeting.rst:115
#: 6d80041937cb4f5f868cfdb143825c9b
msgid "If Terrain data is enabled and available, the gimbal's \"boresight\" POI will be set to whatever terrain elevation it is pointing. If not, the HOME altitude will be used for the POI point."
msgstr ""

