#: ../../source/docs/common-brushless-pwm-gimbal.rst:7
#: 777b5b9706bc4afca35ce5b55863bd8c
msgid "Brushless PWM Gimbal"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:9
#: 5a72bf196d53477bad337a6e44b4a97a
msgid "Many camera gimbals can accept PWM input or SBUS input for controlling the roll, pitch and yaw angles.  This page describes the setup procedure to allow ArduPilot to control these gimbals."
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:16
#: 303c6a7a632a4cca872c069a273c7ccb
msgid "These instructions are for ArduPilot 4.3 (and higher).  For ArduPilot 4.2 (and lower) please refer to the :ref:`Servo Gimbal <common-camera-gimbal>` instructions."
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:19
#: 69ef19ce9d1740f7b692150d91f6ecbb
msgid "Supported Gimbals"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:21
#: c545edc825614c498cf675a8a2b3c480
msgid "Gimbals that accept PWM input or SBUS input to control the gimbal's *lean angle* should work."
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:23
#: f1616714dc9a4277b5db8bc0f1bd3c59
msgid "Some gimbals accept PWM or SBUS input but only provide *rate* control.  These gimbals will not work by default but it may be possible, using the gimbal's configuration application, to configure them to interpret the input for angle control."
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:25
#: 123d6d7cf2274101a7060a9ed256509d
msgid "The list of supported gimbals is a work-in-progress.  If you would like to add a gimbal that is known to work, please `raise an issue <https://github.com/ArduPilot/ardupilot_wiki/issues>`__"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:28
#: 69410b68cc4048ffa7275332dc3d1cb3
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:34
#: 98b51c3a278842b6b5087213baeaefa3
msgid "If the gimbal has multiple PWM input ports (one for each axis), connect them to the autopilot PWM output channels. If the gimbal accepts SBUS input then connect it to the autopilot's SBUSo (aka \"SBus output\") port."
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:37
#: 70322bf3b83c48c2b5f75be489fe7331
msgid "Connect to the autopilot with a ground station and set the following parameters.  These settings assume the autopilot's PWM outputs 9, 10 and 11 will control the gimbal's roll, pitch and yaw angles respectively.  They also assume common angular ranges of the gimbal which may need adjusting to match the actual gimbal being used."
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:39
#: b963523264ea4d00a9ca75a7913c23c5
msgid ":ref:`MNT1_TYPE <MNT1_TYPE>` to 7 (BrushlessPWM) and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:40
#: 3ebd1b1e3806490bbc40bb47c445adfb
msgid ":ref:`MNT1_PITCH_MIN <MNT1_PITCH_MIN>` to -90 (meaning the gimbal can pitch straight downwards)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:41
#: 6cb7b50c129349b29c260f1cb3f05572
msgid ":ref:`MNT1_PITCH_MAX <MNT1_PITCH_MAX>` to 25 (meaning the gimbal can pitch up by 25 deg)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:42
#: 0994ee07cc794a628dd4f7991b664a5d
msgid ":ref:`MNT1_ROLL_MIN <MNT1_ROLL_MIN>` to -30 (meaning the gimbal can roll right 30 deg)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:43
#: e2fec5b70b3c4fac97481bb558943270
msgid ":ref:`MNT1_ROLL_MAX <MNT1_ROLL_MAX>` to 30 (meaning the gimbal can roll left 30 deg)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:44
#: 5406a2e1be12487ab1017b53da4ef381
msgid ":ref:`MNT1_YAW_MIN <MNT1_YAW_MIN>` to -180 (meaning the gimbal can yaw to the left 180deg)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:45
#: 3bda3d6d2ade456791be82c39b0a8f6b
msgid ":ref:`MNT1_YAW_MAX <MNT1_YAW_MAX>` to 180 (meaning the gimbal can yaw to the right 180deg)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:46
#: 689c085c94b545f3b487d715ec1aa5f6
msgid ":ref:`MNT1_RC_RATE <MNT1_RC_RATE>` to 90 (deg/s) to control speed of gimbal when using RC targeting. If RC value is intended to control the ANGLE, then set it to 0."
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:47
#: b8d0e5c137164eb1ad9d1ee474d9567d
msgid ":ref:`SERVO9_FUNCTION <SERVO9_FUNCTION>` to 8 (Mount1 Roll)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:48
#: 7eb5cadf27664db0922ddd8fec8ac7c0
msgid ":ref:`SERVO10_FUNCTION <SERVO10_FUNCTION>` to 7 (Mount1 Pitch)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:49
#: 8ab28914b04241869f2cea6727747742
msgid ":ref:`SERVO11_FUNCTION <SERVO11_FUNCTION>` to 6 (Mount1 Yaw)"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:52
#: adc085f714b643f8bd2ec569338d635c
msgid "Optional"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:53
#: ae99a12e464242b093a5c2811d9f0984
msgid "To allow pilot RC transmitter control of the gimbal:"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:55
#: 99a5decb8d114eabb75b5a6664aa8214
msgid ":ref:`RC6_OPTION <RC6_OPTION>` = 213 (\"Mount Pitch\") to control the gimbal's pitch angle with RC channel 6"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:56
#: ef319d61d5c04e758d6ce086e7e21b4c
msgid ":ref:`RC7_OPTION <RC7_OPTION>` = 214 (\"Mount Yaw\") to control the gimbal's yaw angle with RC channel 7"
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:57
#: a339c94d484a40b09e3a7be435e6ef03
msgid ":ref:`RC8_OPTION <RC8_OPTION>` = 163 (\"Mount Yaw Lock\") to switch between normal yaw operation and locking mount heading with RC channel 8 (in RC Targeting mode only)."
msgstr ""

#: ../../source/docs/common-brushless-pwm-gimbal.rst:58
#: bd5e043ccee74a9084a1bb55017cb752
msgid ":ref:`RC9_OPTION <RC9_OPTION>` = 185 (\"Mount RP Lock\") to switch between three modes of earth frame/body frame locks for the roll and pitch axis in RC targeting mode."
msgstr ""

