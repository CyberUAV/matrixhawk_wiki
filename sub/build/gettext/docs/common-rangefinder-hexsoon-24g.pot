#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:5
#: e854d7ef0f11492daab790c311e63479
msgid "Hexsoon 24G Radar"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:7
#: e3b2fb29232d4114bf124ef05520fbaf
msgid "The `Hexsoon 24G radar <http://www.hexsoon.com/en/list-4-27.html>`__ (available in `20m <http://www.hexsoon.com/en/product/product-96-167.html>`__, `100m <http://www.hexsoon.com/en/product/product-88-685.html>`__, and `200m <http://www.hexsoon.com/en/product/product-85-346.html>`__ versions) are 24Ghz-band radar useful for :ref:`surface tracking <copter:terrain-following-manual-modes>`, :ref:`terrain following <copter:terrain-following>` and :ref:`object avoidance <common-object-avoidance-landing-page>`"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:15
#: ad3e35a9ff7d43aa9d215ba19a328520
msgid "ArduPilot only supports the CAN versions of these sensors"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:19
#: 47fbb9bd4e414a7385c0ac40cdd737e9
msgid "Support is available in ArduPilot versions 4.6 and higher"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:22
#: 852efd282da4417c9de70969a1c7ca88
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:24
#: 80aa5ca4ea2440cf9a4dcd7afe16ca52
msgid "Mount the radar to the vehicle so that the radar points downwards and connect to one of the autopilot's CAN ports as shown below"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:30
#: 2e2d8d5e15874e69b56e0e77e1bb1400
msgid "Set the following parameters assuming the sensor is connected to CAN1"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:32
#: 7e088284b6a249009e23a42ab1397de8
msgid ":ref:`CAN_P1_DRIVER <CAN_P1_DRIVER>` = 1 (First CAN driver)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:33
#: ef4d5ecb39654f75aa4e37199e8b7a53
msgid ":ref:`CAN_P1_BITRATE <CAN_P1_BITRATE>` = 500000"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:34
#: ea8d908e96244a1c9c02bb850da60644
msgid ":ref:`CAN_D1_PROTOCOL <CAN_D1_PROTOCOL>` = 14 (RadarCAN)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:35
#: 65d9b4533b534900bf8a87667c84dc44
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 44 (HexsoonRadar)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:36
#: 430c0de658f74e8c810d75cfa0717a4d
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 18 (meters), 95 (meters) or 190 (meters) depending upon the model (this is the maximum range of the radar minus a few meters of buffer)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:37
#: 60d74856ba4d47f587e0edb26ae783fd
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.5 (0.5m minimum range)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:38
#: d07aa334731649e490f3be90baa985d9
msgid ":ref:`RNGFND1_RECV_ID <RNGFND1_RECV_ID>` = 0 (ID of the sensor, 0 to accept all CAN ids for distance)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:42
#: 2a32c1daf5d74c2fabd8e53beec8252b
msgid "ArduPilot does not currently support the same type of CAN rangefinders connected to different CAN ports. If you would like to use multiple CAN rangefinders together, connect them to the same CAN port."
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:45
#: d8a28142eed34ff3ab963ab7f596f5f5
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-24g.rst:47
#: 63a3af74093c454a8cc2445388643cf2
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""
