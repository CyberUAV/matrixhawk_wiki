#: 8e18ff38ed134857a2cda62d528c761d
msgid "The sensor can be connected to any available serial/uart port on the autopilot. In the diagram below the first sensor is connected to SERIAL2 (TELEM2)."
msgstr ""

#: ../../source/docs/common-kogger-sonar.rst:58
#: 295e893b807e42d992fe4ab3b9b96c42
msgid ":ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 9 (Lidar)"
msgstr ""

