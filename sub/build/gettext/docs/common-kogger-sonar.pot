#: 7960f0a05554436abf9263e6affab72b
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.3"
msgstr ""

#: ../../source/docs/common-kogger-sonar.rst:65
#: 0d6f6338f6e040da82e4b6a41b40657b
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 50 (i.e. 50m).  *This is the distance in meters that the rangefinder can reliably read.*"
msgstr ""

