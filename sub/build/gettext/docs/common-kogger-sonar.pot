msgid "Set the following rangefinder parameters:"
msgstr ""

#: ../../source/docs/common-kogger-sonar.rst:31
#: 5515d46562814713af19bfaf1d84121a
msgid "Max distance = 50000"
msgstr ""

#: ../../source/docs/common-kogger-sonar.rst:32
#: 53ee41822b1c47efb0536a9d1fff8144
msgid "Dead zone = 100"
