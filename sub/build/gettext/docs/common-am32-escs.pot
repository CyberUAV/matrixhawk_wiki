msgid "ArduPilot Connection and Configuration"
msgstr ""

#: ../../source/docs/common-am32-escs.rst:27
#: 7d799bcceba34ce6829622f7c4acf1f7
msgid "The ESCs should be connected to the autopilot's CAN port.  Below shows the ESCs connected to the autopilot's CAN1 port but CAN2 may also be used.  The ESC furthest from the autopilot's CAN port should have a CAN bus terminator connecting the CAN_L and CAN_H pins.  The VimDrones ESC shown includes a solder pad for this purpose."
msgstr ""

#: ../../source/docs/common-am32-escs.rst:32
#: aebdbfb259fc4551b7b6752a9f5b0351
msgid "To enable communication with the AM32 ESCs using DroneCAN, set the following parameters:"
msgstr ""

#: ../../source/docs/common-am32-escs.rst:34
#: 73f899572b884d6ab8071b5e5be98f59
msgid "Set :ref:`CAN_P1_DRIVER <CAN_P1_DRIVER>` = 1 (First driver) to specify that the ESCs are connected to the CAN1 port"
msgstr ""

#: ../../source/docs/common-am32-escs.rst:35
#: f300d5970ddd4ca3810fbfb238e6269d
msgid "Set :ref:`CAN_D1_PROTOCOL <CAN_D1_PROTOCOL>` = 1 (DroneCAN)"
msgstr ""

#: ../../source/docs/common-am32-escs.rst:38
#: 46292632fbb44f2eb7b1df66ec30c1bd
msgid "Set ``SERVOx_FUNCTION`` to each motor channel (e.g. 33 - 40 for motors 1 - 8). This is automatically configured when setting frame class/type. If a motor channel isn't assigned to a servo output, commands won't be sent to the associated ESC."
msgstr ""

#: ../../source/docs/common-am32-escs.rst:39
#: 22f12d90c4d4456f99f0cf51a7ef7265
msgid ":ref:`CAN_D1_UC_ESC_BM <CAN_D1_UC_ESC_BM>` is a bitmask that determines which servo output channels are transmitted over CAN.  For quadcopters this is normally \"15\""
msgstr ""

#: ../../source/docs/common-am32-escs.rst:40
#: 9571090c6a954218bbdd444af5a11d30
msgid ":ref:`CAN_D1_UC_ESC_OF <CAN_D1_UC_ESC_OF>` allows for more efficient packing of ESC command messages when ESCs are connected to higher servo outputs (e.g. 5 to 8).  For most vehicles this can be left at zero"
msgstr ""

#: ../../source/docs/common-am32-escs.rst:41
#: c7d765f8603f47e18b899586884fcc87
msgid ":ref:`CAN_D1_UC_ESC_RV <CAN_D1_UC_ESC_RV>` allows specifying which ESCs support spinning in reverse"
msgstr ""

