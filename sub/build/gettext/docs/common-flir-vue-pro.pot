#: c44aa073d3774e5b9111e690761ac016
msgid "Serial Protocol: MAVLink"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:55
#: 8fbb0ae360b345b78baace11ecd9960b
msgid "Serial Data Rate: 57600"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:56
#: 90c4cab46962448bbcd2a0b24e3de0f6
msgid "Channel 1 : MAVLink TX"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:57
#: dec9409e84944d00ac607d17f96a7cc5
msgid "Channel 3: Record Start/Stop"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:60
#: e6883e0f940d427295b2e04b703db01c
msgid "Testing"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:62
#: f8d07cabea9b4d69a5ace8195e2e9154
msgid "Power up the camera and autopilot in a location where the vehicle can get a GPS lock."
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:63
#: 29d9046a80a849d4a69aae105726c6e3
msgid "Connect with a ground station (like Mission Planner) and check that the vehicle appears on the map"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:64
#: 2169b1471db9462e962d3dd8f6ea112d
msgid "If the serial connection between the autopilot and camera is working then shortly after the camera is powered on, it will begin sending heartbeats to the autopilot and ground station which, if using the Mission Planner, will make it appear as \"CAMERA\" in the top-right drop-down.  Selecting the CAMERA will not work though because the camera does not respond to requests for parameters"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:69
#: 39873447e505475293b3fdfca4028b38
msgid "Trigger taking a picture using the transmitter's auxiliary switch or by right-mouse-button-clicking on the map and selecting \"Trigger Camera NOW\".  The camera should beep"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:70
#: e798ddb2578f492ca33648be676fcc11
msgid "Connect the camera to your computer using a USB cable (or remove the camera's SD card) and check that an image has been captured"
msgstr ""

#: ../../source/docs/common-flir-vue-pro.rst:71
#: e68dad2086b04e62aa047fcdcbf1e02e
msgid "Check the file properties to ensure the latitude, longitude and altitude have been recorded with the image"
msgstr ""
