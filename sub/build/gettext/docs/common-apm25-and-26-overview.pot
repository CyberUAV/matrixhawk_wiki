#: ../../source/docs/common-apm25-and-26-overview.rst:127
#: 6dbf0742497c4b4688095c0508369881
msgid "Analog input pins"
msgstr ""

#: ../../source/docs/common-apm25-and-26-overview.rst:129
#: c54b7d2af9e244a688b093f7747cd7db
msgid "Pin 0 to 8: The APM2 has a row of analog input pins down one side, labelled A0 to A8 on the underside of the board. These are available as pin numbers 0 to 8 inclusive in PIN variables."
msgstr ""

#: ../../source/docs/common-apm25-and-26-overview.rst:133
#: 5dc5df22bba140bda13462f102633e60
msgid "All these pins can take up to 5V and may be used for any general analog input. They are commonly used for airspeed and sonar inputs."
msgstr ""

#: ../../source/docs/common-apm25-and-26-overview.rst:136
#: ba74bb198b9742c7b64e9acc2715e274
msgid "Pin 12: power management connector current pin, accepts up to 5V, usually attached to 3DR power brick with 17:1 scaling"
msgstr ""

#: ../../source/docs/common-apm25-and-26-overview.rst:139
#: 886ba6b6e2584f15920bd63961fce4f2
msgid "Pin 13: power management connector voltage pin, accepts up to 5V, usually attached to 3DR power brick with 10.1:1 scaling"
msgstr ""

#: ../../source/docs/common-apm25-and-26-overview.rst:146
#: 13621d6ecb32425d9182338e8e16e350
msgid "Digital output pins"
msgstr ""

#: ../../source/docs/common-apm25-and-26-overview.rst:148
#: fa79fc65d92f46a7bb77243e018e8194
msgid "The APM2 uses the same set of 9 analog input pins as digital output pins. They are configured as digital output pins automatically when you start to use them as digital outputs."
msgstr ""

#: ../../source/docs/common-apm25-and-26-overview.rst:152
#: ac34c425eae64b269c85372b3986c84d
msgid "Pin 54 to 62: You need to add 54 to the pin number to convert from an analog pin number to a digital pin number. So pin 54 is digital output pin on the A0 connector. Pin 58 is A4 etc."
msgstr ""

#: ../../source/docs/common-apm25-and-26-overview.rst:156
#: 1c186a917d914081a88d7f265c1427e4
msgid "These pins are usually used with the RELAY_PIN to RELAY_PIN4 parameters, allowing you to control things like camera shutter, bottle drop etc. They are also used as sonar \"stop\" pins allowing you to have multiple sonars and not have them interfere with each other."
msgstr ""
