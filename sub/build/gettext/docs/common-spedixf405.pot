#: ../../source/docs/common-spedixf405.rst:97
#: 86e1403a00ca4ec9b83d08f1e66fd3de
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-spedixf405.rst:99
#: b1d33215ba614b5a9cef2b5f19051717
msgid "To flash firmware initially, connect USB while holding the bootloader button and use DFU to load the ``with_bl.hex`` file. Subsequent updates can be applied using ``.apj`` files through a ground station."
msgstr ""
