#: 54df09c8b060448ead85ca58088dceb8
msgid ":ref:`CAN_D1_PROTOCOL <CAN_D1_PROTOCOL>` = 14 (RadarCAN)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:35
#: 837feeb5217c477db85b468618458941
msgid ":ref:`PRX1_TYPE <PRX1_TYPE>` = 18 (Hexsoon Radar)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:36
#: 92c614c6366e414ba80d8b62ee157ad8
msgid ":ref:`PRX1_YAW_CORR <PRX1_YAW_CORR>` = 0 (forward) if the radar is mounted pointing forwards"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:38
#: 3f03b62eeb0d4c0fbbe284c8d37e2797
msgid "After setting the above parameters reboot the autopilot"
msgstr ""

