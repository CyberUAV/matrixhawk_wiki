#: ../../source/docs/internal-pressure-failsafe.rst:5
#: 79909fc64fa847b59d4417cd180f3077
msgid "Internal Pressure Failsafe"
msgstr ""

#: ../../source/docs/internal-pressure-failsafe.rst:6
#: c643ff550b7a4ec98fd3c59c883f161b
msgid "Sub can use the barometer normally included with an autopilot to determine if the pressure inside the vehicle has increased too much. This could occur if the enclosure is bowing in and near implosion, or if something is burning/off-gassing, or if there's a big enough leak that water is forcing its way in. It can also be from the internal electronics heat."
msgstr ""

#: ../../source/docs/internal-pressure-failsafe.rst:8
#: 2cacea4bfc0b40bfbba06bfdc8062f31
msgid "The amount of the pressure in pascals is set by :ref:`FS_PRESS_MAX<FS_PRESS_MAX>`. If it is exceeded, then the following actions is taken as set by the value of the :ref:`FS_PRESS_ENABLE<FS_PRESS_ENABLE>` parameter:"
msgstr ""

#: ../../source/docs/internal-pressure-failsafe.rst:10
#: dcb0eb6ebe344d0a8585d6366011f394
msgid "**Disabled** (Value 0) will disable the failsafe entirely."
msgstr ""

#: ../../source/docs/internal-pressure-failsafe.rst:11
#: 1be25cfaf63e4a6aab217b44c617c250
msgid "**Warn Only** (Value 1) will send a GCS warning message."
msgstr ""
