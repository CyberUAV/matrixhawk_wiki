#: ../../source/docs/common-daiwa-winch.rst:100
#: 689cefdcf5724d228c8b9bc5b4167f99
msgid "Retract the line (perhaps using the RC6 tuning knob) to within 20cm or so of the ideal minimum length"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:101
#: 98bd456876f74ef295c134ad6e246eff
