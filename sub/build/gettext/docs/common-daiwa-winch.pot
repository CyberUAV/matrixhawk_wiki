msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:31
#: 130ca4267cab4e60a14a6c3da6727230
msgid "Connect the winch to the autopilot as shown below"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:37
#: 8b386a73cc7d45539a8510a14c91083d
msgid "Connect the 3-pin Winch Control wire (red cable tie) to AUX OUT 1 (aka Servo9)"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:38
#: 3a7ee55af53c4079b05ac83b755911d1
msgid "Connect the 3-pin Winch Clutch wire (yellow cable tie) to AUX OUT 2 (aka Servo10)"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:39
#: 71ec6ffe9e15414785e6503f4e22cc34
msgid "Connect the 3-pin Winch Zero Reset wire (blue cable tie) to AUX OUT 3 (aka Servo11)"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:40
#: e8a2e3cf5c22438d9f326d55aba0a9df
msgid "Connect the 3-pin Winch Telemetry wire (blue cable tie) to the Autopilot's Telem2 (or any other telemetry port)"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:41
#: b429247f3c6441d2b56fb3defc67cf9b
msgid "The Zero Reset (green cable tie) used to calibrate the winch should be left disconnected"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:42
#: 254e1bf396194e6d9b899d435efd83e8
msgid "A 7.2V to 22.2V power supply is required to power the motors"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:43
#: c2fb0449e4c54b26babac9a68a8423b6
msgid "A 5V BEC can optionally be connected to the autopilot's servo rail to provide power to the winch electronics.  This is not required if the Telemetry wire is connected"
msgstr ""

