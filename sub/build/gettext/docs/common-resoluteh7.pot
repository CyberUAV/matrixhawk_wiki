msgstr ""

#: ../../source/docs/common-resoluteh7.rst:53
#: bc1ad855cd814512bb5effdc596701dc
msgid "RC input is configured by default via the USART2 RX input. It supports all serial RC protocols except PPM."
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:56
#: 713d7fde1d524c2580a1b69c4f2df67f
msgid "FPort requires an external bi-directional inverter attached to T5 and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` set to 4 (half-duplex).  See :ref:`common-FPort-receivers`."
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:57
#: fccda2229d5d4f19923c8dfb92061fc6
msgid "CRSF/ELRS uses RX2/TX2."
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:58
#: 11c10c244d4f49b580f983301359a03b
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry.  Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:60
#: c2c6f917b2dc476c88c27f56414a4f0c
msgid "If the user wishes to use the SBUS from a DJI air unit for RC control, it is suggested that the RX8 pads be used as shown in the wiring diagram and :ref:`SERIAL8_PROTOCOL <SERIAL8_PROTOCOL>` be set to \"23\" and :ref:`SERIAL5_PROTOCOL<SERIAL5_PROTOCOL>` be changed from \"23\" to something else."
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:63
#: 4fa9ac034abd475d85f49b47992ddc08
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:65
#: a78f13bfef8b45e5a61a8e2836ba4830
msgid "The Resolute H7 supports up to 11 outputs. Motor outputs M1 to M4 are on the ESC connector, as well as pads. M5 to M7 are available on pads, along with independent pads marked LED for LED strips and a PWM output near the camera pads for camera OSD control. M1-8 support bi-directional DShot, and all the outputs support DShot."
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:67
#: c22370fc23e6455b9f88732e7e1099f7
msgid "The PWM is in 5 groups:"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:69
#: c5bf7377963844f481d4699a15c2a8c9
msgid "PWM 1-4     in group1"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:70
#: ff51284f1b744204b5c1ca0d6adbc586
msgid "PWM 5-8     in group2"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:71
#: 1c44f531012743e5a66ec1dea2338ae3
msgid "PWM 9(LED)  in group3 (set as Serial LED output function by default)"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:72
#: bec367b1196d45bfb2a545ae4d0a2399
msgid "PWM 10/11   in group4 (Servo 0/1)"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:73
#: 75baadfa6193476bb997c99964d162eb
msgid "PWM 12(Camera_Control) in group5"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:75
#: 78e4febe31024896860d5158e2322087
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot or LED then all channels in the group need to use DShot or LED."
msgstr ""

