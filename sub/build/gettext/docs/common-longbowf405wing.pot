msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:94
#: 5cfa7321b91c4695bf1a0b6d796f4a74
msgid "PWM 3,4 in group2"
msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:95
#: 44199a122499414fb32d45d809e64c70
msgid "PWM 5-6 in group3"
msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:96
#: 11fadc05dff44b99a75cb81bedf46827
msgid "PWM 7-9 in group4"
msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:97
#: 9e9372a23f764313ac9569e6220ae96f
msgid "PWM 10-12 in group5"
msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:99
#: 7661534051dc49f78a4d256edca3bd14
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in that group would need to use DShot."
msgstr ""

