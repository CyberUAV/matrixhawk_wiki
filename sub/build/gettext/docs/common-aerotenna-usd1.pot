#: ../../source/docs/common-aerotenna-usd1.rst:25
#: 5d6d3244f710488dad41e10f06f96ab5
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:27
#: 17df149d22bc4c45a383971bec9e710c
msgid "The USD1 is available in serial and DroneCAN versions."
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:29
#: e20a5331562d41cfb606295b462c4dc7
msgid "For a serial connection you can use any spare Serial/UART port.  The example below shows how to connect to SERIAL4 as the first rangefinder."
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:31
#: ad17bd8586ce41dfa743ceb59ad0993d
msgid ":ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:32
#: 2e5c672c045a4fe7a8ae7bce602947ff
msgid ":ref:`SERIAL4_BAUD <SERIAL4_BAUD>` = 115 (115200 baud)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:33
#: 11044a26c14449f180f9b2cd9dac954a
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 11 (USD1-Serial)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:34
#: ../../source/docs/common-aerotenna-usd1.rst:43
#: 7be60ab611dd41658c8693c013ca06b0
#: 00593fa2d6d74404a8224568ef5a75bb
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.5"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:35
#: ../../source/docs/common-aerotenna-usd1.rst:44
#: defb281972934163b86e7f183f52710e
#: 3182c115473944cca4feb81f3c7deba3
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 45"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:36
#: ../../source/docs/common-aerotenna-usd1.rst:45
#: cad935434a284ceda4c5a899a8b09f08
#: 27f634f0090b45438e4d44a8ac96f7d5
msgid ":ref:`RNGFND1_GNDCLR <RNGFND1_GNDCLR>` = 0.1 *or more accurately the distance in meters from the range finder to the ground when the vehicle is landed.  This value depends on how you have mounted the rangefinder.*"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:38
#: 772de1f99a0c45908d668c3206eef306
msgid "For the CAN version, connect via CAN to the autopilot and set the following parameters:"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:40
#: 51477fee70aa4394b479540e116fee29
msgid ":ref:`CAN_P1_DRIVER<CAN_P1_DRIVER>` =  1 (first can port driver set to driver 1)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:41
#: 04aface0fb294f6bb7fea27524c50a39
msgid ":ref:`CAN_D1_PROTOCOL<CAN_D1_PROTOCOL>` =  7 (USD1 protocol for driver 1)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:42
#: c78a3714533a46549288b0e15227d80f
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 33 (USD1_CAN)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:49
#: e161603d8e384fdf9468f117149f6513
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:51
#: fa1cce4a42cb4f9d9c23e88d7acac671
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:59
#: 4a0834bc42c944acaec74e52f5b81870
msgid "Using the sensor with an AP Periph DroneCAN Node"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:60
#: d9a7b51c8ac047f0825041fbbbe6a8ba
msgid "The USD1 is available in either CAN or Serial communication protocol versions. The USD1 CAN protocol is different than DroneCAN and hence requires a dedicated CAN port running this protocol. If the autopilot does not have a spare CAN port or spare serial port for connecting the USD1, but has a DroneCAN port setup, you can create another serial port in the system using an AP_Periph CAN node attached to the DroneCAN port. The USD1 MUST be the Serial version for this to work."
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:62
#: 4a49de8aa0d74ad7bf77a7d586146d8d
msgid "To use the USD1 with a CAN Node like the Matek AP_Periph CAN Node L431, use the following set up."
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:64
#: e314338208544b3dbb73d7c4fe069fa6
msgid "First, flash the AP_Periph device with a firmware that has the rangefinder features. For the Matek AP_Periph CAN Node L431, the latest stable firmware is `here. <https://firmware.ardupilot.org/AP_Periph/stable/MatekL431-Rangefinder/>`__"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:69
#: f2cf14f74f774e7987fc365ec1f8ca75
msgid "Set the parameters in the CAN Node to the following:"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:71
#: 1de816a6e9284776a793a24226f6c098
msgid "RNGFND_BAUDRATE = 115"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:72
#: c522edcbaac9441c8328c138e0fc2a1a
msgid "RNGFND_MAX_RATE = 50"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:73
#: ceab3a7536c24d999a48e72c14fb3d10
msgid "RNGFND_PORT = 1 (UART 2, i.e. TX2, RX2)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:74
#: d8ace0f0a9614fc19d8593b05f976b65
msgid "RNGFND1_ORIENT = 0 (No matter what orientation)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:75
#: fec3391ce3aa43e79d6313baa57ea79f
msgid "RNGFND1_TYPE = 11"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:79
#: f7cb113b554649b386b21556cbb1fe90
msgid "RNGFND_PORT is indexed differently than the UARTs on the board. For RNGFND_PORT = 0, use RX1 and TX1 on the board, etc."
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:81
#: a7a93c3583e54964a12a1fdad36f0be0
msgid "Next, set the parameters on the autopilot:"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:83
#: a64912fad04049478f136153659b3a43
msgid "RNGFND1_TYPE = 24 (DroneCAN) Then Restart"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:84
#: b833eb229f2642ad84e613524dd9fb0e
msgid "RNGFND1_ORIENT = 25 (Down)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:85
#: f6dad808edf74580943a1feface073c7
msgid "RNGFND1_ADDR = 0 (For sensor_id = 0)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:89
#: 1f81c8c083054f658310e3a75366e84a
msgid "If there is more than one rangefinder in the system you will need to determine the Sensor ID for the USD1. Look in CAN inspector for a message \"uavcan_equiment_range_sensor_Measurement\" for its sensor_id."
msgstr ""
