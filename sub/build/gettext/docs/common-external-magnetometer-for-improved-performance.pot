msgstr ""

#: ../../source/docs/common-external-magnetometer-for-improved-performance.rst:131
#: ffd1645d26ee477f9d0e2167eb507f4f
msgid "The APM 2.0 requires the cutting of the SDA trace on the top of the GPS / Magnetometer / SDA carrier board."
msgstr ""

#: ../../source/docs/common-external-magnetometer-for-improved-performance.rst:137
#: 5a616af378934451b211b2e4e7171092
msgid "Also, leave the pads on the external Magnetometer board bridged for 3.3 volts rather than switching it to 5 volts.."
msgstr ""

