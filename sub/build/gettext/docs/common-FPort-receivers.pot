#: ../../source/docs/common-FPort-receivers.rst:44
#: 883926799e1a48549fe80ded9858835f
#: 95ded96346df42f9abbb6eb7f39e72f0
msgid "``SERIALx_PROTOCOL`` = 23"
msgstr ""

#: ../../source/docs/common-FPort-receivers.rst:39
#: 9ab489d0ebaa452cbd972c5fe0c5c9eb
msgid "``SERIALx_OPTIONS`` = 160 (enable pull-up/pull-downs on TX and RX pins for those external inverter circuits that may require it, won't affect those that do not need it)"
msgstr ""

#: ../../source/docs/common-FPort-receivers.rst:40
#: ../../source/docs/common-FPort-receivers.rst:46
