#: ../../source/docs/common-do-land-start.rst:5
#: 09011e12309149388716aecd5a8259c1
msgid "Using DO_LAND_START"
msgstr ""

#: ../../source/docs/common-do-land-start.rst:7
#: 4ff3f2cc125c445694afef78f60e0d7a
msgid "The :ref:`DO_LAND_START <mav_cmd_do_land_start>` mission item can be used for two purposes:"
msgstr ""

#: ../../source/docs/common-do-land-start.rst:9
#: 68b8281de9ff490bb6c2b0505e911a8b
msgid "In Plane, to provide an automatic re-attempt for an aborted NAV_LAND autolanding in a mission. (See :ref:`aborting-autolanding`)"
msgstr ""

#: ../../source/docs/common-do-land-start.rst:10
#: bad456b242d241c3a285f53b97af5fe4
msgid "To provide an automatic landing sequence for RTLs in Plane or as a failsafe action in Copter."
msgstr ""

#: ../../source/docs/common-do-land-start.rst:12
#: 3896db4861174b19817b12b4e3de5f90
msgid "in Rover, it can be used, but only via Scripting call to start the landing sequence."
msgstr ""

#: ../../source/docs/common-do-land-start.rst:17
#: 6e5ccaef2e4b4b84b83dcc0c7307ca10
msgid "You can optionally include more than one ``DO_LAND_START`` mission item in your mission. If that is done then the latitude/longitude/altitude of the ``DO_LAND_START`` mission items is used to choose which landing sequence to use. The ``DO_LAND_START`` closest to the current location in all three dimensions is used. This can be useful if you have multiple landing sequences for different wind conditions or different areas."
msgstr ""

#: ../../source/docs/common-do-land-start.rst:19
#: d615821c5a8041348cd4f1e93e3a2c6a
msgid "If you are already in a landing sequence (NAV_LAND or DO_START_LAND sequence), then it will continue."
msgstr ""
