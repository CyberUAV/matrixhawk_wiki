msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:21
#: 77f3c79a8f5941b883cbf96e30277c12
msgid "Connecting and Configuring"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:23
#: 4639fbb766c84d398a736908d78b05bb
msgid "The sonar provides distance measurements using the NMEA protocol over serial at 9600 baud.  There should be a port on the back of the sonar labelled \"NMEA\" with a DB9 connector."
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:25
#: 56f721b1d6834d7ca554e73d0f5575e5
msgid "The sonar's DB9 connector should be wired to the RS232-to-Serial converter board as shown below.  Note that the sonar's DB9 port's pin2 and pin3 are connected to the converter board's pin3 and pin2 (i.e. crossed).  The converter board's serial output can be connected to any available serial port on the autopilot.  In the diagram below the SERIAL2 is used."
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:30
#: 66af03d9eded49b39dc2a53c749dcf9c
msgid "If the SERIAL2 is used then the following parameters should be set:"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:32
#: 6a678881855a432bb5e126315a35c741
msgid ":ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:33
#: 8df0eba929344100a4e2d7d6a9bdbd20
msgid ":ref:`SERIAL2_BAUD <SERIAL2_BAUD>` = 9 (9600 baud)"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:35
#: d64be6f953ef4e37a0a2f0e509df1f22
msgid "The following range finder related parameters should also be set:"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:37
#: deab916c1c9e4a4cb59b59b92fa145a5
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 17 (NMEA)"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:38
#: 52effdcfd4f6415181f5a425c0918f2b
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.13"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:39
#: 3abd864923c849ffa2e3c70dbe1f9b8f
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 100 (i.e. 100m).  *This is the distance in meters that the rangefinder can reliably read.*"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:40
#: cc237ec92af647e1bc7739af349f6d7f
msgid ":ref:`RNGFND1_ORIENT <RNGFND1_ORIENT>` = 25 (i.e. down) if mounted on a boat"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:43
#: 9b03c97d5754440b99dca323239b2e60
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:45
#: a6042f01be24487390e300082bfb043b
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""

#: ../../source/docs/common-hondex-sonar.rst:51
#: 2e6bf5e87a604682a1f5b44ff30dfba5
msgid "More info on NMEA message contents can be found `here <http://www.catb.org/gpsd/NMEA.html>`__"
msgstr ""
