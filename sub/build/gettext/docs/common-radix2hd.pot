#: ../../source/docs/common-radix2hd.rst:105
#: f8b1d56cf2e14ed98c56233a3734a59b
msgid "FPort requires connection to TX3 and :ref:`SERIAL3_OPTIONS<SERIAL3_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-radix2hd.rst:107
#: f811bbf768974966932421c43fb25c7b
msgid "CRSF also requires a TX3 connection, in addition to RX3, and automatically provides telemetry. Set :ref:`SERIAL3_OPTIONS<SERIAL3_OPTIONS>` to \"0\"."
msgstr ""

#: ../../source/docs/common-radix2hd.rst:109
#: 93799e9cea4e4777abd37e54952ca4b7
msgid "SRXL2 requires a connection to Tx6 and automatically provides telemetry.  Set :ref:`SERIAL3_OPTIONS<SERIAL3_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-radix2hd.rst:111
#: 1553d431b2f4446baa5a19565061fada
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-radix2hd.rst:113
#: 480fd35994504d9ca3cddbb3823339d0
msgid "RX6 can be configured for RCin coming from DJI air units by setting :ref:`SERIAL3_PROTOCOL<SERIAL3_PROTOCOL>` to something other than \"23\" and setting :ref:`SERIAL7_PROTOCOL<SERIAL7_PROTOCOL>` to \"23\"."
msgstr ""

