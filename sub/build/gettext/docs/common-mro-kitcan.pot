#: ../../source/docs/common-mro-kitcan.rst:75
#: 67b43581641748588e3a35ed993ef884
msgid "Setup"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:77
#: 72658f482c3d424eae913844ee751e0f
msgid "Verify the following parameters are set on your autopilot via your ground station."
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:79
#: 392f96415d1f4a79b2385614d4b93029
msgid ":ref:`CAN_P1_DRIVER<CAN_P1_DRIVER>` = 1 (assuming its on the first CAN bus of the autopilot)"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:80
#: 63fdc109b1fe4548b15babb42db35648
msgid ":ref:`GPS1_TYPE<GPS1_TYPE>` = 9 (DroneCAN) or if it will be the secondary GPS, set instead"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:81
#: b390fd69555e43d292d905dba71a6397
msgid ":ref:`GPS2_TYPE<GPS2_TYPE>` = 9 (DroneCAN)"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:82
#: 3004bb38cb744d49ac98843cf13b6e72
msgid "Reboot"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:84
#: b7a49c8a74cb4fd0ba217e1ed43ce495
msgid "Make sure the DroneCAN compass driver is not disabled. (:ref:`COMPASS_DISBLMSK<COMPASS_DISBLMSK>` bit 9 should not be set)."
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:86
#: 255d51a1d61b4bac978cb891c296d301
msgid "If your controller has multiple compasses attached already, you may want to set the attached compass as a higher priority than others, if it has better precision or performance."
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:88
#: c3cb8f65a27841e186c9b4e310aefb3b
msgid "To enable the integrated I2C RGB LED set:"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:90
#: 41c8c920168847b5bd0bdac0abdf07d5
msgid ":ref:`NTF_LED_TYPES<NTF_LED_TYPES>` bit 5 (DroneCAN) should be set in the autopilot."
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:92
#: 246a1b07b62c46c29328b39454309665
msgid "The integrated safety switch is automatically used, if the autopilot has enabled the use of safety switches via :ref:`BRD_SAFETY_DEFLT<BRD_SAFETY_DEFLT>` is \"1\" (default).  (``BRD_SAFETYENABLE`` in older firmware versions)"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:94
#: 3d5fc8b24c8d4933b8c14938c0ef970d
msgid "If you want to enable an attached I2C airspeed sensor, set:"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:96
#: 4c80da0e42ef43ac9feae74f44620294
msgid ":ref:`ARSPD_TYPE<ARSPD_TYPE>` = 8 (DroneCAN)"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:98
#: de65453b66fc4e9e8054311e6f94db6b
msgid "If the attached sensor is not an MS5525 type with I2C address 0x76, then you must access your KitCAN's CAN parameters to select Airspeed type being attached to the adapter. Using Mission Planner (or :ref:`common-uavcan-gui`), go to the menu SETUP/Optional Hardware/DroneCAN/SLCan Mode CAN1/Parameters. Once the CAN Adapters parameters appear, change the following (this changes them inside the DroneCAN adapter, NOT the autopilot, allowing the adapter to use the correct driver and convert the information to DroneCAN airspeed format):"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:100
#: 61bad8727d0b4c25a8a373c3b3e7c158
msgid ":ref:`ARSPD_TYPE<ARSPD_TYPE>` = 4 (is default for an I2C-MS5525 with an 0x76 address which prevents conflict with the DSP310 integrated onboard with address 0x77). If another sensor is used, change the type to match that sensor."
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:101
#: 8d5df2c7c13743bdb3027b5e03276e3b
msgid ":ref:`ARSPD_USE<ARSPD_USE>` =  1"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:102
#: 809b3d259ef04cc794ba730028628aa7
msgid ":ref:`ARSPD_BUS<ARSPD_BUS>` =  0"
msgstr ""

#: ../../source/docs/common-mro-kitcan.rst:104
#: 62781d0b63784dfdb351ff1058ae2ff6
msgid "Then reboot."
msgstr ""

