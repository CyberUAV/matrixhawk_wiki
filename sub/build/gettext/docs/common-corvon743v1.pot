#: a03eba696e0a49f48e2172480284b8ba
msgid "The CORVON743V1 supports up to 10 PWM outputs. All outputs support PWM, DShot, and Bi-Directional DShot."
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:77
#: 22fa235474174e21852a725095d38762
msgid "PWM outputs are grouped and every group must use the same output protocol:"
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:79
#: 70023834b11c42baa24324cc06820c1c
msgid "1, 2, 3, 4 are Group 1"
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:80
#: dab372e3bf2b4a4db2a140cf7705663d
msgid "5, 6 are Group 2"
msgstr ""

#: ../../source/docs/common-corvon743v1.rst:81
#: c6cc6e6e942642a1945bc42d786511ec
msgid "7, 8, 9, 10 are Group 3"
msgstr ""

