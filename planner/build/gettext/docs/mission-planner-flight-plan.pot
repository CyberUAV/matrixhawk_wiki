#: 52cc898813c84a62bfbd01b235f24ab0
msgid "Insets Spline WP: Inserts a spline waypoint at current mouse position into the mission list. See `here <https://en.wikipedia.org/wiki/Spline_%28mathematics%29>`_ for more info on spline paths. (valid only for Copter, will insert normal waypoint in other vehicles)"
msgstr ""

#: ../../source/docs/mission-planner-flight-plan.rst:34
#: d4509038cf184271aabb3e51eb09116b
msgid "Loiter: Adds a Loiter waypoint to the mission at the cursor"
msgstr ""

#: ../../source/docs/mission-planner-flight-plan.rst:35
