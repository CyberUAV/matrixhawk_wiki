#: 1b9fa368c6a845e2a07971f306f7a2e9
msgid "Download https://github.com/spracing/ssbl/releases and install SSBL to external flash following https://github.com/spracing/ssbl#installation-to-external-flash"
msgstr ""

#: ../../source/docs/common-loading-firmware-onto-chibios-only-boards.rst:150
#: ba26d3e536704a6da69af4580dff7916
msgid "Download the latest ArduPilot external flash binary, for instance https://firmware.ardupilot.org/Copter/latest/SPRacingH7/arducopter.bin"
msgstr ""

