msgstr ""

#: ../../source/docs/common-intel-aero-rtf.rst:57
#: cb3e56f1eb1047f2a7db8fae7b8eba12
msgid "Turn on the vehicle by pushing the \"Power\" button found between the two rear arms"
msgstr ""

#: ../../source/docs/common-intel-aero-rtf.rst:58
#: 0921f4a68348441aadfcb62df4241883
msgid "From your PC, connect to the vehicle's wifi access point (normally starts with \"Aero-\"), the default password is \"1234567890\""
msgstr ""

