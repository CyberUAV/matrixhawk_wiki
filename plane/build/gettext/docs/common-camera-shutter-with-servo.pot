#: ../../source/docs/common-camera-shutter-with-servo.rst:5
#: 2f778fd3102a4e8e96cdacb939e007ac
msgid "Camera Shutter Configuration"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:7
#: 9e6e8fe3ed0b4c15869c1cfc65294c3d
msgid "ArduPilot allows you to configure a :ref:`servo output<common-servo>` or :ref:`relay<common-relay>` to control a camera trigger from :ref:`an RC transmitter, a ground station or during a mission <common-camera-controls>`."
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:9
#: cc25e0bddaa14c6085113714a48ed9da
msgid "This article explains in general what connections and settings are required but in most cases the autopilot's servo output or relay voltage will be converted into a format understood by the particular camera used and the setup details will depend upon what hardware is used (infrared, cable, etc).  These two pages may provide more details"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:11
#: ef0337ebd2224dbbbe2eaa931e3f300c
msgid ":ref:`DIY article for a Pixhawk using a relay based trigger<common-pixhawk-camera-trigger-setup>`"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:14
#: 2b78ae92719f4b68a2818e5ec0eedfaf
msgid "Servo control connection and configuration"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:16
#: e0389aacd4b344b690120adbd3065e54
msgid "Connect one of the autopilot's PWM output (aka servo outputs) to the camera or the camera control cable that accepts PWM input. As mentioned on the :ref:`servos wiki page <common-servo>` there are some autopilot specific limitations on which PWM outputs may be used:"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:19
#: efb24bf82a9447dea0d54ab3c0373f6f
msgid "For autopilots with IOMCU (e.g. label outputs as MAIN OUT and AUX OUT), it is easiest to use AUX OUT 1 to 6."
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:20
#: f5a0261fe254469eb2026679c3730c88
msgid "For autopilots without an IOMCU any output may be used"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:22
#: ../../source/docs/common-camera-shutter-with-servo.rst:38
#: c7a1035261114a9d9b7ec8d20e638cd3
#: 00e3585b6af3441aa2a0567e9593114b
msgid "Configure the autopilot by setting these parameters:"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:24
#: 4406b2c630024a98a628902066a97d65
msgid "Set `SERVOx_FUNCTION` = 10 (CameraTrigger) where \"x\" is the PWM output connected to the camera"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:25
#: b18571d4e9fd4f10b387ff9d325aa540
msgid "Set :ref:`CAM1_TYPE<CAM1_TYPE>` = 1 (Servo) and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:26
#: b63f9ed5fd9745d0a565a9690b228f08
msgid "Set :ref:`CAM1_SERVO_ON<CAM1_SERVO_ON>` to the pwm value to output to trigger taking a picture (e.g. 1300)"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:27
#: 639822a623a440fb86dc6a4680c970a1
msgid "Set :ref:`CAM1_SERVO_OFF<CAM1_SERVO_OFF>` to the pwm value to output when *not* taking a picture (e.g. 1100)"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:28
#: 801c6249f9204c7faa71e225993f0ddf
msgid "Set :ref:`CAM1_DURATION<CAM1_DURATION>` to the time (in seconds) that the pwm value should remain high (e.g 0.1)"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:31
#: 8caf3bb5ed2549d3b0d36fccfe3f9a82
msgid "Relay control connection and configuration"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:34
#: f46d62f025cc4437980ae43b7dd3d41e
msgid ":ref:`This function is a GPIO and has limited current capabilities.<gpio-warning>`"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:36
#: 56a61bbd9308419480edc0acee08ee24
msgid "Connect one of the autopilot's GPIO pins to the camera or the camera control cable that accepts high/low voltage input.  As mentioned on the :ref:`relay wiki page<common-relay>` the autopilot's servo/motor outputs can normally be used but, in addition, some autopilots have dedicated pins purely for use as relays/GPIOs."
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:40
#: 4c10118064af4bf79be3d39f8c6c5f47
msgid "If using 4.5 (or earlier) only the 1st relay can be used so set ``RELAY_PIN`` to the GPIO pin used"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:41
#: c3ac15eac69045128061fba6cc35a9c4
msgid "If using 4.6 (or higher) any relay can be used.  Below are settings if the first relay is used."
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:43
#: 5054f586181f4e2882d4febd51e7560f
msgid "Set :ref:`RELAY1_FUNCTION<RELAY1_FUNCTION>` = 4 (Camera)"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:44
#: d044bb4ddbcc44ce92e2d3fddee29e66
msgid "Set :ref:`RELAY1_PIN<RELAY1_PIN>` to the GPIO pin used"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:46
#: d76b2a907510476c8c52b7acda5dee40
msgid "Set ``SERVOx_FUNCTION`` = -1 (GPIO) where \"x\" is the servo output channel used.  This is not required in the rare case where an autopilot's dedicated GPIO pins are used."
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:47
#: ca98b843cd1349db89ebaaff60bbdc9a
msgid "Set :ref:`CAM1_DURATION<CAM1_DURATION>` to the time (in seconds) that the relay is held high"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:48
#: 6afd0dc6ebaa4a388d6b65ad218ed0cf
msgid "Set :ref:`CAM1_RELAY_ON<CAM1_RELAY_ON>` = 0 to swap the relay voltage.  E.g. GPIO output would now be normally high by default, and then low to trigger the camera shutter"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:53
#: bcf37220266445728438c932a6e421e0
msgid "Camera shutter feedback logging"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:55
#: 93bae83c742b422b832a1e3ac5d7e8b7
msgid "ArduPilot logs TRIG messages when it *triggers* the camera.  If the camera provides a GPIO output (e.g. camera flash hotshoe) then this can be used to also log CAM messages at the exact moment that pictures are taken."
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:57
#: 4673b1df87424ae78c96c483d64cd273
msgid "Connect the camera's GPIO output  to one of the autopilot's :ref:`GPIO pins <common-gpios>` (e.g. AUX OUT).  As mentioned above there are restrictions on which pins may be used."
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:59
#: 2e71f57736a242ccb6ef517baa4b5c6a
msgid "Set the following parameters:"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:61
#: 00867998ce0247dd93b0eba853390e69
msgid "Set `SERVOx_FUNCTION` = -1 (GPIO) where \"x\" is the servo output channel used.  This is not required in the rare case where the autopilot's dedicated GPIO pins are useds"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:62
#: 756b39f320724737838fbdd3f2e530d7
msgid "Set :ref:`CAM1_FEEDBAK_PIN<CAM1_FEEDBAK_PIN>` to the pin number connected to the hotshoe"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:63
#: 8ea8f99bae0e4297a8a76f74fe0994a3
msgid "Set :ref:`CAM1_FEEDBAK_POL<CAM1_FEEDBAK_POL>` = 0 if the hotshoe voltage goes low when a picture is taken or 1 if the voltage goes high"
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:65
#: a318d8725d864f45a271ffea47be1829
msgid "See :ref:`digital input pin <common-pixhawk-overview_pixhawk_digital_outputs_and_inputs_virtual_pins_50-55>` for more details."
msgstr ""

#: ../../source/docs/common-camera-shutter-with-servo.rst:67
#: 9576497a1495444b9cd2935b935747ac
msgid "Consider using the `Seagulls SYNC2 Shoe Horn Adapter <https://www.seagulluav.com/product/seagull-sync2/>`__"
msgstr ""
