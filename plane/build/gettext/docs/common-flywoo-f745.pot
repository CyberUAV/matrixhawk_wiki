msgstr ""

#: ../../source/docs/common-flywoo-f745.rst:92
#: 31ac037a36e943428445fce223b53fe7
msgid "SERIAL1 = Telemetry1 = USART1 (RX pin only in AIO V3)"
msgstr ""

