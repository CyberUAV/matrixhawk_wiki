#: ../../source/docs/common-zeroonex6-air.rst:62
#: ca8b19a415a14cfe9aeef2b155ab1ff0
msgid "The SBUS pin, can be used for all ArduPilot supported receiver protocols, except CRSF/ELRS and SRXL2 which require a true UART connection. However, FPort, when connected in this manner, will only provide RC without telemetry."
msgstr ""

#: ../../source/docs/common-zeroonex6-air.rst:64
#: 644009a95dd74c06a08cb23e72a15991
msgid "To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 receivers, a full UART, such as SERIAL6 (UART4) would need to be used for receiver connections. Below are setups using Serial6."
msgstr ""

#: ../../source/docs/common-zeroonex6-air.rst:67
#: 76aa9427f3a74d7085fd947e388f962c
msgid ":ref:`SERIAL6_PROTOCOL<SERIAL6_PROTOCOL>` should be set to \"23\"."
msgstr ""

#: ../../source/docs/common-zeroonex6-air.rst:68
#: 2672b2975b0b41a4a16c709d71e71cf2
msgid "FPort would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"15\"."
msgstr ""

#: ../../source/docs/common-zeroonex6-air.rst:69
#: 5043e156758844c9b17b5bc91cd53dee
msgid "CRSF/ELRS would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"0\"."
msgstr ""

#: ../../source/docs/common-zeroonex6-air.rst:70
#: 463751d5140b47b29a954b1583feb430
msgid "SRXL2 would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"4\" and connects only the TX pin."
msgstr ""

#: ../../source/docs/common-zeroonex6-air.rst:73
#: e8c9464d5a17471783bd82ad3d925f40
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

