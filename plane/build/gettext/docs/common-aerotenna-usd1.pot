#: ../../source/docs/common-aerotenna-usd1.rst:27
#: ecb1b6b92a354216951228daae7abaff
msgid "The USD1 is available in serial and DroneCAN versions."
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:29
#: cf30622b3eec48f9929c48741cb859eb
msgid "For a serial connection you can use any spare Serial/UART port.  The example below shows how to connect to SERIAL4 as the first rangefinder."
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:31
#: b606bd5c7f8d478bb878426de3d446be
msgid ":ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:32
#: bf1bc9f59c914e4db7de1bc75bcc1c3d
msgid ":ref:`SERIAL4_BAUD <SERIAL4_BAUD>` = 115 (115200 baud)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:33
#: 20a126e472594687b125dff55f765d7c
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 11 (USD1-Serial)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:34
#: ../../source/docs/common-aerotenna-usd1.rst:43
#: b84a491061c64391a9d7e98acc2231d3
#: 6c7396c647714e3aa6c75ad93daa7bfd
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.5"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:35
#: ../../source/docs/common-aerotenna-usd1.rst:44
#: 5cd5d73ba9344c16b34f1ab55ed18ebc
#: 44f68455a5834faabecbea1a6dc8f14f
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 45"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:36
#: ../../source/docs/common-aerotenna-usd1.rst:45
#: 41269c30c08641b487efa2b5655c94cc
#: ae53d74f742442829bd617da313bd992
msgid ":ref:`RNGFND1_GNDCLR <RNGFND1_GNDCLR>` = 0.1 *or more accurately the distance in meters from the range finder to the ground when the vehicle is landed.  This value depends on how you have mounted the rangefinder.*"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:38
#: d2a432b3bb424ab3a672b4509e571cb9
msgid "For the CAN version, connect via CAN to the autopilot and set the following parameters:"
msgstr ""

