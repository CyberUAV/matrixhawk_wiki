msgstr ""

#: ../../source/docs/common-ublox-gps.rst:14
#: 7ab5fd9e9bf64d6283d7678dbe9535ab
msgid "Connection Option #1 - Mission Planner and Pixhawk as Passthrough"
msgstr ""

#: ../../source/docs/common-ublox-gps.rst:16
#: d07f4b64c6414d05b28e57050cae9ff9
msgid "Mission planner and pixhawk can pass through the communication between u-center and the GPS by doing the following:"
msgstr ""

#: ../../source/docs/common-ublox-gps.rst:19
#: 1212fd729ee84b6382211cea81a78b7e
msgid "Connect Pixhawk to your PC and connect with the Mission Planner"
msgstr ""

#: ../../source/docs/common-ublox-gps.rst:20
#: c2ba75e69644442fbfbdee518681f028
msgid "On the Flight Data screen press Ctrl-F and then select \"MAVSerial pass\""
msgstr ""

#: ../../source/docs/common-ublox-gps.rst:21
#: 989d736f8339401e97e9386b28ae03eb
msgid "Open u-center and select Receiver, TCP Client and in the Network Connection window set Address to \"localhost\" and Port to \"500\" and press OK."
msgstr ""

