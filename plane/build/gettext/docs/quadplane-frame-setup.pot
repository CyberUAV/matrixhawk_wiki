#: ../../source/docs/quadplane-frame-setup.rst:5
#: 1242ffb11d3f43319594ea84e5c67cf7
msgid "QuadPlane Frame setup"
msgstr ""

#: ../../source/docs/quadplane-frame-setup.rst:7
#: 86e7b758d1ed4ca888172c4e4fa38f87
msgid "The QuadPlane code supports several frame arrangements of quadcopter, hexacopter, octacopter and octaquad multicopter frames which use lifting motors in addition to the normal forward motor(s). Also configurations in which the VTOL motors tilt for transitions or control, as well as choice between horizontal VTOL stance or vertical (Tailsitters)."
msgstr ""

#: ../../source/docs/quadplane-frame-setup.rst:11
#: 028f1dd963fa4e1f849305c87742f6b2
msgid "Tailsitters"
msgstr ""

#: ../../source/docs/quadplane-frame-setup.rst:13
#: beb57dc0b69e4f068e14c6166338e324
msgid "Frame setup for Tailsitters is in this section: :ref:`guide-tailsitter`. Once the frame is configured, proceed with the other :ref:`quadplane-setup` instructions."
msgstr ""

#: ../../source/docs/quadplane-frame-setup.rst:16
#: 7c56697cfa4048e2a159a8f89e3a0d6c
msgid "Plane VTOL Motor Configurations"
msgstr ""

#: ../../source/docs/quadplane-frame-setup.rst:18
#: ebeeb71f018c456aaad312fb6b9763b8
msgid "These configurations add multicopter style lifting motors to a conventional fixed wing configuration. Some or all of these motors may also be configured as tilting motors to be used in fixed wing flight instead of the normal fixed forward motor(s)."
msgstr ""

#: ../../source/docs/quadplane-frame-setup.rst:21
#: 8fb778adf0ac47d09d5c10ac582f6fa0
msgid "Frame Types and Classes"
msgstr ""

