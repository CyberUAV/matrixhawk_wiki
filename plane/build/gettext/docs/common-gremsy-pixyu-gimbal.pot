#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:5
#: be6ee44b49c5406ba8f054bc9fbd484c
msgid "Gremsy Mio, Pixy, S1, T3, T7, and ZIO 3-Axis Gimbals"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:7
#: cddaea4ee45c4e11a641b5f5114e7c92
msgid "Gremsy `Mio <https://gremsy.com/products/mio>`__, `Pixy F <https://gremsy.com/products/pixy-f>`__, `Pixy U <https://gremsy.com/products/pixy-u>`__, `Pixy WP <https://gremsy.com/products/pixy-wp>`__,  `S1 <https://gremsy.com/products/gremsy-s1v3>`__, `T3 <https://gremsy.com/products/gremsy-t3v3>`__, `T7 <https://gremsy.com/products/gremsy-t7>`__ and `ZIO <https://gremsy.com/zio>`__ 3-axis gimbals can communicate with the autopilot using the MAVLink protocol and are compatible with a range of cameras for real-time video or mapping purposes."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:14
#: 6d22c1f9e3ff41b989fad2ec8447a960
msgid "MIO gimbals are unable to communication with ArduPilot.  We hope for a fix with Gremsy software version 7.7.3."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:16
#: 9446e082379d4a4ba6c498e74b4086ec
msgid "T3V3 gimbals must be running 7.7.3-Preview (or higher)."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:18
#: a116ad168d0c4d9789de6f78044379af
msgid "PixyU gimbals must be running 7.7.1 or 7.7.2.  7.7.3 does not work correctly.  We hope for a fix with Gremsy version 7.7.4 (or higher)."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:20
#: 0294c4299d174f7fb52c30da3e923014
msgid "PixyWE gimbals are not supported."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:22
#: 2d82a7f83db3481f88fb8a8a21db128a
msgid "ZIO gimbals cannot be used as a secondary mount (e.g. \"Connecting Two Gimbals\" below does not work with the ZIO)"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:25
#: 60a9fec3a77a446ebca1e632d37ed9c2
msgid "Where to Buy"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:27
#: a6f1ba930a5c48148ad145891c0743ac
msgid "These gimbals can be purchased from the `Gremsy store <https://gremsy.com/online-store>`__"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:30
#: ad2a756138244003a7b5b29659e7553a
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:36
#: 50a2010a51264b309d00367942a5ad2d
msgid "Connect the gimbals's COM2 port to one of the autopilot's Serial/Telemetry ports like Telem2 as shown above."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:38
#: 15c79b7c3e36469cb1c118c5086f5772
msgid "Connect to the autopilot with a ground station and set the following parameters, if using the first mount:"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:40
#: 7c977f138ab343b992de7c74734ccb51
msgid ":ref:`MNT1_TYPE <MNT1_TYPE>` to \"6\" for \"MAVLink\" and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:41
#: bcd170dce2314ddc9522c1c8a12fc48d
msgid "If using a ZIO with ArduPilot-4.5.0 (or higher) set :ref:`CAM1_TYPE <CAM1_TYPE>` to \"6\" (MAVLink..Gimbal V2 compatible) and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:42
#: 1700ba967862416d867590458ed6c4fa
msgid ":ref:`SERIAL2_BAUD <SERIAL2_BAUD>` to \"115\" for 115200 bps.  \"SERIAL2\" can be replaced with another serial port (i.e. SERIAL1) depending upon the physical connection"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:43
#: cc59928058c44905ab5df39d0144f92f
msgid ":ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` to 2 for \"MAVLink2\""
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:44
#: 9bc153fffd8249879199296b1681fa0c
msgid ":ref:`SERIAL2_OPTIONS <SERIAL2_OPTIONS>` to 1024 for \"Don't forward mavlink to/from\""
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:46
#: 97504d0747304fa0a0c9c36850ee3679
msgid "See the \"Control with an RC transmitter\" section of :ref:`this page <common-mount-targeting>` for details on parameter changes required to control the gimbal through an RC Transmitter (aka \"RC Targeting\")"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:48
#: 2156d272492a46c3a0d57b039f898af7
msgid "When the autopilot has successfully connected to the gimbal, \"Mount: GREMSY PixyU fw:7.7.1.0\" (or similar) will be sent to the ground station.  Looking for this message may be useful in determining if the autopilot and gimbal are communicating successfully."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:51
#: 2e4353f07f3643d29afaed839464b508
msgid "Configuring the Gimbal"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:53
#: e5c7e79d02144d76ae78f92d29a27890
msgid "Download and install `gTune Desktop <https://github.com/Gremsy/gTuneDesktop/releases>`__"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:54
#: 02ae86a755df474cb47c4eb72fed103a
msgid "Connect the gimbal to your Desktop PC using a USB cable and power on the gimbal"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:55
#: db1e1b7853fd4663a66faddbaa107cb1
msgid "Use gTune Desktop to check the gimbal firmware version"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:57
#: ab9a68b91919459ab52bdb2a9050e0e3
msgid "Open gTune Desktop application, \"Found your device\" should be displayed"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:58
#: 2150045f88724eb4b0691518253c3eb3
msgid "Select \"CONNECT\""
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:59
#: 05429ad00bd24864948883714038cfcb
msgid "Select \"INFO\" and confirm the gimbal is running Firmware \"7.7.1\" or higher"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:65
#: 8fc78e463b3f4bf1a4e08f5d5a726321
msgid "If the gimbal firmware is older than 7.7.1 download the latest .hex for `Mio <https://github.com/Gremsy/Mio-Firmware/releases>`__,  `Pixy F <https://github.com/Gremsy/PixyF-Firmware/releases>`__, `Pixy U <https://github.com/Gremsy/PixyU-Firmware/releases>`__,  `Pixy WP <https://github.com/Gremsy/PixyW-Firmware/releases>`__,  `S1 <https://github.com/Gremsy/S1V3-Firmware/releases>`__, `T3 <https://github.com/Gremsy/T3V3-Firmware/releases>`__, `T7 <https://github.com/Gremsy/T7-Firmware/releases>`__ or `ZIO <https://github.com/Gremsy/Zio-Firmware/releases>`__"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:66
#: 37f2356e1d11400287159059da95a1c5
msgid "Select \"UPGRADE\", \"BROWSE\" and select the file downloaded above"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:67
#: fb156381fcc14638b271dff37bb4d1bd
msgid "Press the other \"UPGRADE\" button and the upgrade should complete within 30 seconds"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:73
#: 039105d8b2d94e63b5d8ff1452d05b4e
msgid "Use gTune Desktop to configure the gimbal"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:75
#: 9a84ca30bf364ffdb374b7c51bddefdd
msgid "Select \"SETTINGS\", \"CONTROLS\" and ensure \"SYNC\" is selected so the gimbal communicates with the autopilot using MAVLink"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:81
#: ca6fbb6319774f2091bbb4fdc53886f3
msgid "Select \"Settings\", \"REDUCE DIRFT by DRONE\""
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:87
#: 8d18546dec4f4b66a65209c4a15a5a78
msgid "Select the \"STIFFNESS\" tab and adjust the Tilt, Roll, and Pan gains so that the gimbal holds the camera in position without shaking"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:90
#: 749cece0232f46dfb481a7af0902d252
msgid "Control and Testing"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:92
#: 9942118753394dbca680dd91fe420526
msgid "See :ref:`Gimbal / Mount Controls <common-mount-targeting>` for details on how to control the gimbal using RC, GCS or Auto mode mission commands"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:95
#: 4fd5934d099e4e6ebf440a64e5b61c71
msgid "Connecting Two Gimbals"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:97
