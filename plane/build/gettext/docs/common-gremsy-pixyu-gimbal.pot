msgid "If two Gremsy gimbals are used, each gimbal can be directly connected to one of the autopilot's serial ports or they can can be daisy-chained together with only one connected to one of the autopilot's serial ports."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:99
#: c4c3c9ecbf224417a9475d81d1e03ebb
msgid "Use the gTune desktop application set the second gimbal's MAVLink component id to \"GIMBAL_COMPID2\""
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:105
#: b5d722cc57bb4e52a50d801f13f6fb67
msgid "Connect a GCS to your autopilot and set"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:107
#: 19f4eaa1c2d245a7a92fc48c297cff89
msgid ":ref:`MNT2_TYPE <MNT2_TYPE>` to \"6\" for \"Gremsy\" and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:108
#: 17afee4a930041ae91e2b2e34f3b08cd
msgid "set the appropriate SERIALx_BAUD, SERIALx_PROTOCOL and SERIALx_OPTIONS parameters as described above"
msgstr ""

