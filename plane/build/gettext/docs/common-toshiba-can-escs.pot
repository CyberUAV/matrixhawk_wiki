#: 4fc8c7e9e3f749418c3a038b4e4ffbda
msgid "ToshibaCAN ESCs are high-end ESCs that allow control and feedback using a custom CAN protocol.  Some additional specifications:"
msgstr ""

#: ../../source/docs/common-toshiba-can-escs.rst:14
#: 64a3af2b00ad4217bc3c04561e48f895
msgid "FOC which should result in about 10% longer flight times while also being quieter than non-FOC ESCs"
msgstr ""

#: ../../source/docs/common-toshiba-can-escs.rst:15
#: 950c361c9e5640c7b2d564f35002046a
msgid "Up to 7S batteries (future versions are planned for up to 12S), 50Amps"
msgstr ""

#: ../../source/docs/common-toshiba-can-escs.rst:16
#: 3679bbb4e05b4ad48af44c35432efd0b
msgid "Up to 12 motors"
msgstr ""

#: ../../source/docs/common-toshiba-can-escs.rst:17
#: 1b720732ac1d41a2b793a55be76cdb34
msgid "Fast sync issue recovery time (100ms to 150ms)"
msgstr ""

#: ../../source/docs/common-toshiba-can-escs.rst:18
#: 4193be238ebf4f2abf9d556110016184
msgid "Relatively lightweight"
msgstr ""

#: ../../source/docs/common-toshiba-can-escs.rst:19
#: 0816b5aab4ff43e5bdf64566aae5572c
msgid "Designed and manufactured in Japan"
msgstr ""

#: ../../source/docs/common-toshiba-can-escs.rst:23
#: 8693d01056cc416692c9708e14485677
