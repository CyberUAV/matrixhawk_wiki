#: ../../source/docs/common-cuav-pwlink.rst:5
#: 4177653b04c8455abc0896bf066298bf
msgid "CUAV PW-Link"
msgstr ""

#: ../../source/docs/common-cuav-pwlink.rst:10
#: b9c688e3defb4cc7a23c1339cba0bcee
msgid "CUAV PW-LINK is an ESP8266 based 2.4Ghz WIFI telemetry radio. It connects to any ArduPilot telemetry port using +5V,gnd,TX and RX signals. Running at the standard default parameters of 57.6 Kbaud and MAVLink2 telemetry protocol, it connects via the standard Mission Planner/ QGC UDP port 14550 over WIFI."
msgstr ""

#: ../../source/docs/common-cuav-pwlink.rst:12
#: 7272d7de5d7b4951a691701005e2ab09
msgid "With its external antenna, range of 450 meters is typical."
msgstr ""

#: ../../source/docs/common-cuav-pwlink.rst:17
#: becce95479204a84bf548c8134e8d437
msgid "Connecting to the Ground Station"
msgstr ""

#: ../../source/docs/common-cuav-pwlink.rst:19
#: 831c8ff62aa444b98cd5ef590ff6c0bf
msgid "Open WIFI connection dialog on PC or Android Phone and select the ``CUAVWLINKxxxx`` SSID and connect using the password ``cuavwlink``. Once connected use the UDP connection with port = 14550 (which is default) to connect using Mission Planner. QGC should auto-detect and connect. The PW-LINK default IP address is ``192.168.4.1``."
msgstr ""

