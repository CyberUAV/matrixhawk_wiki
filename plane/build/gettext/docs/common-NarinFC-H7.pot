msgstr ""

#: ../../source/docs/common-NarinFC-H7.rst:229
#: 6cfbc39f31ed4e1a871167716c7e8c05
msgid "Firmware for these boards can be found here `https://firmware.ardupilot.org <https://firmware.ardupilot.org>`_ in sub-folders labeled “NarinFC-H7”."
msgstr ""

#: ../../source/docs/common-NarinFC-H7.rst:231
#: d9bc979358454628baf214add3321516
msgid "The board comes pre-installed with an ArduPilot bootloader, allowing the loading of \\*.apj firmware files with any ArduPilot compatible ground station, such as Mission Planner."
msgstr ""
