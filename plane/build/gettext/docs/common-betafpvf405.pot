msgstr ""

#: ../../source/docs/common-betafpvf405.rst:213
#: 7a1d942abc234e9ab506838730e087c9
msgid "Firmware for this board can be found `here <https://firmware.ardupilot.org>`_ in  sub-folders labeled \"BETAFPV-F405\". For the AIO version, a firmware labeled \"BETAFPV-F405-I2C\" is provided to allow I2C devices to be attached if the hardware modification mentioned above is made to disconnect the ELRS module from those signals."
msgstr ""
