#: 42e102d4f7214f2c9eadc076a65af266
msgid "The PWM is in 5 groups:"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:100
#: 06caaae52a0b45c9b63868f2a71a4c98
msgid "PWM 1-2   in group1"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:101
#: f55b0c3bb23345de989501c18d4321e6
msgid "PWM 3-6   in group2"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:102
#: ca9b277d949d46c58f4ae56a2cf43551
msgid "PWM 7-8   in group3"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:103
#: 54d1934df95146a9b801912858ea8bcc
msgid "PWM 9     in group4"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:105
#: b926617b2581466b8623247db5628e72
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-8 support bi-directional dshot."
msgstr ""

