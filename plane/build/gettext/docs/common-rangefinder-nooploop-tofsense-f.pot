#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:5
#: d54d93f2eb384a1884486ff9ec449a85
msgid "Nooploop TOFSense F/FP/F2 Mini/F2/F2 P"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:8
#: 51d63b1f8b244e689ccc82faf4e2f0cd
msgid "Support for this sensor is available in firmware versions 4.5 and later."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:10
#: 19e9822ed03a44eb9cedd9e2df27bb81
msgid "The `TOFSense F/FP/F2 Mini/F2/F2 P <https://ftp.nooploop.com/downloads/tofsense/TOFSense-F_Datasheet_V2.0_en.pdf>`__ is lightweight rangefinder module that provides fast and accurate distance measurements up to 50 meters (F2 P variant only). ArduPilot currently supports this sensor via both UART and IIC."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:16
#: a1f164ad8f0c4e9cbc0cd34f138edf95
msgid "Connecting via UART to Autopilot"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:18
#: f213004b4b55422da8a0a4af247c6928
msgid "The same steps as the Nooploop TOFSense P (UART) can be followed, as linked :ref:`here <common-rangefinder-nooploop-tofsense-p>`. :ref:`RNGFND1_MAX <RNGFND1_MAX>` can be changed as per the sensor specifications (15 for TOFSense F and 25 for TOFSense FP)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:22
#: 82df17d4b5f94c068460d23cf7db0c3b
msgid "Connecting via I2C"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:23
#: 7b61dd3c4a844cf2875b805e5cc28016
msgid "Setup the sensor through the NAssistant Software provided by the manufacturer. More details can be found `here <https://www.nooploop.com/download/>`__. For I2C mode, in the setup screen set \"Interface\" to I2C. You can also set the \"ID\" to a unique number if planning to use multiple TOFSenseF. The I2C address of the sensor is linked to the ID set in the NAssistant software. The default address is 0x08 for ID 0 (or 8 in decimal; i.e the parameter you will set in the GCS), 0x09 (or 9) for ID 1 and 0x10 (or 10) for ID 2. The address can be calculated as 0x08 + ID. For example, if the ID is set to 2, the address will be 0x0A (or 10)."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:30
#: b7a21dec65da4bc497cfe866d7335f16
msgid "The 4 Pin JST-GH connector wiring of the sensor does not match with the I2C 2 port wiring of most autopilots (For example, Cube Orange). Wiring incorrectly can lead to damaged sensor and/or autopilot."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:32
#: 134d8b9ff20146ce9fb9c1f516a741d3
msgid "For a I2C connection you can use any spare I2C port."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:37
#: a0fa7ea764bb47e8841c6338b0da43a7
msgid "Set the following parameters"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:39
#: 9b0ea0d9e52c4173b6473ecb20dfa240
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 40 (NoopLoop_TOFSenseF_I2C) Reboot after setting this."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:40
#: 0614371e3fc04d9ab8e600bc74a589c9
msgid ":ref:`RNGFND1_ADDR <RNGFND1_ADDR>` = I2C slave address of the sensor (Default is 8, which corresponds to ID 0 in the NAssistant software)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-f.rst:44
#: 923e873092ba4accbafee54daf99fa0a
msgid "Testing the sensor"
msgstr ""

