#: ed42d56633d345e1b720807d67c9e83c
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:348
#: 6aa04ee41de241f58a1963b9df3d41f9
msgid "The default RC input is configured on the UART7 RX input and can be used for all ArduPilot supported unidirectional receiver protocols."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:350
#: dd7c81f651b548f78950b834846c66b2
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:351
#: d836f31508d544ea882df35d8719a789
msgid "SBUS/DSM/SRXL connects to the RX7 pin."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:352
#: 781e6a09a74d47deb02c71d6b0987a29
msgid "FPort requires connection to TX7 and :ref:`SERIAL7_OPTIONS<SERIAL7_OPTIONS>` set to \"7\". See :ref:`common-FPort-receivers`."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:353
#: 98c063a572744011ba914e53162ac873
msgid "CRSF also requires a TX7 connection, in addition to RX7, and automatically provides telemetry."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:354
#: 44b9552ed9c44d69b837b3c1efc5bbf7
msgid "SRXL2 requires a connection to TX7 and automatically provides telemetry. Set :ref:`SERIAL7_OPTIONS<SERIAL7_OPTIONS>` to “4”."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:357
#: 2b9faafeb9ad450c960ad1a94bed7171
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:358
#: 1b2e291140bd4f37bb056a67bcaedfe1
msgid "The LUX F765 - NDAA supports using its internal OSD using OSD_TYPE 1 (MAX7456 driver). Simultaneous DisplayPort OSD operation  is pre-configured on SERIAL 6. See :ref:`common-msp-osd-overview-4.2` for more info."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:361
#: aaed69c8fd47436f92cfa5b02905723b
msgid "Camera Control"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:362
#: 58bd387c5231475d8fc2e166dcacf255
msgid "The LUX F765 - NDAA has a camera control output assigned to GPIO 82. Additionally, RELAY3 is pre-configured to control GPIO 82."
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:365
#: ca4c212da92d4daa8e373942ea472db0
msgid "Battery Monitor"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:366
#: 7852768e32c341f1acd2c971d644cb36
msgid "The LUX F765 - NDAA has an internal voltage sensor and connections on the ESC connector for an external current sensor input. The voltage sensor can handle up to an 8S battery."
msgstr ""

