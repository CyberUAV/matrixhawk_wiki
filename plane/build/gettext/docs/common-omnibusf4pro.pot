msgstr ""

#: ../../source/docs/common-omnibusf4pro.rst:101
#: 9da5a06435624297a0652e53e2d1249e
msgid "SERIAL5 = not assigned"
msgstr ""

#: ../../source/docs/common-omnibusf4pro.rst:102
