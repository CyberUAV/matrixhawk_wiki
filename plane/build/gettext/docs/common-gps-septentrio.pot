msgid ":ref:`GPS1_MB_TYPE <GPS1_MB_TYPE>` = 1 (RelativeToCustomBase)"
msgstr ""

#: ../../source/docs/common-gps-septentrio.rst:54
#: cea3ade5459b4fe69f64eaaa175331bd
msgid ":ref:`GPS1_MB_OFS_X <GPS1_MB_OFS_X>`, :ref:`GPS1_MB_OFS_Y <GPS1_MB_OFS_Y>` and :ref:`GPS1_MB_OFS_Z <GPS1_MB_OFS_Z>` to match the offset of the main antenna from the second in meters.  For example if the second antenna is 50cm to the right of main antenna set :ref:`GPS1_MB_OFS_Y <GPS1_MB_OFS_Y>` = -0.5."
msgstr ""

#: ../../source/docs/common-gps-septentrio.rst:55
#: bfbf01e70b6c460d9df396878365b7f3
msgid ":ref:`EK3_SRC1_YAW <EK3_SRC1_YAW>` = 2 (GPS)"
msgstr ""

