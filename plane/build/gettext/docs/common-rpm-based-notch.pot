#: ../../source/docs/common-rpm-based-notch.rst:6
#: 9497d3ae12254b8383b8e73cab347ba4
msgid "RPM Sensor Based Dynamic Notch Setup"
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:8
#: 1a82c6b6919442f38fb28b4646e0a3ff
msgid "Setup an :ref:`RPM sensor<common-rpm>`."
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:9
#: a3c677dd6c93467a8165f2f0ef70fa65
msgid "Set :ref:`INS_HNTCH_MODE <INS_HNTCH_MODE>` and/or :ref:`INS_HNTC2_MODE <INS_HNTC2_MODE>` = 2 or 5 to use an RPM sensor to set the harmonic notch frequency."
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:10
#: f2d7def4c2ca4159b083b4140f439c02
msgid "Set :ref:`INS_HNTCH_ENABLE <INS_HNTCH_ENABLE>` and/or :ref:`INS_HNTC2_ENABLE <INS_HNTC2_ENABLE>` = 1 to enable the harmonic notch"
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:11
#: 9c00b4b898ee4b8d9754e73c167bf302
msgid "Set :ref:`INS_HNTCH_REF <INS_HNTCH_REF>` and/or :ref:`INS_HNTC2_REF <INS_HNTC2_REF>` = 1 to set the harmonic notch reference value to unscaled, unless the RPM sensor is reporting a fraction of the actual rotor speed. This might occur in a geared drive train setup. If the reported RPM is 1/3 the actual, for example, set this to 0.33."
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:12
#: 2bc591b06a124c2aa4609a5453a42187
msgid "Set :ref:`INS_HNTCH_FREQ <INS_HNTCH_FREQ>` and/or :ref:`INS_HNTC2_FREQ <INS_HNTC2_FREQ>` = below the hover frequency.  In the RPM based dynamic notch, this parameter sets the lower frequency limit of the notch.  So even if the RPM sensor reads a lower value, the notch's center frequency will remained constrainded to the value of this parameter.  You can easily determine the hover frequency by performing a hover and looking at the RPM sensor log data (e.g. RPM.rpm1)."
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:13
#: 5e32bb373b0b4ae4ad46b423bb698219
msgid "Set :ref:`INS_HNTCH_BW <INS_HNTCH_BW>` and/or :ref:`INS_HNTC2_BW <INS_HNTC2_BW>` = half of INS_HNTCH_FREQ"
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:16
#: 01d97ee7a1cc4494ab8b7a8dc3891e59
msgid "Checking Harmonic Notch Effectiveness"
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:17
#: 9b6c9da5ebbc49d592eb18fa11ed203e
msgid "Check the performance of the filter(s) after setup by doing another post filter configuration test flight as discussed in the :ref:`common-imu-batchsampling` or :ref:`common-raw-imu-logging` page for this and analyze the logs."
msgstr ""

#: ../../source/docs/common-rpm-based-notch.rst:20
#: 493746a5a03246a6b59511ba206838a4
msgid "While the log analysis of noise frequencies is not absolutely required prior to notch setup for RPM based mode, the logging and analysis done for the Confirmation flight using that method can be done in order to confirm the noise elimination, if desired."
msgstr ""
