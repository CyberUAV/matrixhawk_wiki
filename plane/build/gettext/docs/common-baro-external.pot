msgstr ""

#: ../../source/docs/common-baro-external.rst:26
#: b7f8b1dd99874b0e990e8d32014f894a
msgid "Connecting and Configuring"
msgstr ""

#: ../../source/docs/common-baro-external.rst:28
#: 52dd019077bf4463a2558ed367d495dd
msgid "Connect the barometer to the autopilot's I2C port as shown below"
msgstr ""

#: ../../source/docs/common-baro-external.rst:34
#: 7e55d9c957ee499195a9679fbc987b6c
msgid ":ref:`BARO_PROBE_EXT <BARO_PROBE_EXT>` to 4 for the MS5611 or 2 for the Adafruit BMP280.  Reboot the autopilot after changing this parameter."
msgstr ""

#: ../../source/docs/common-baro-external.rst:35
#: 910b449c03a544ec87c4f7e7a2f53226
msgid ":ref:`BARO_PRIMARY <BARO_PRIMARY>` to 1 to use the external barometer as the primary"
msgstr ""

#: ../../source/docs/common-baro-external.rst:38
#: 2562ff7324af4e5ab57f8b812a5426b5
msgid "Testing"
msgstr ""

#: ../../source/docs/common-baro-external.rst:44
#: 02abdc3f75904a379a08f8e32db0be0a
msgid "Real-time pressure and temperature from the barometer are sent to the ground station.  If using Mission Planner they are visible on the Flight Data >> Status tab, look for \"press_abs2\" and \"press_temp2\"."
msgstr ""

#: ../../source/docs/common-baro-external.rst:46
#: 0514d8a920ff4796880e74ffa413388f
msgid "Mission Planner's MAVLink Inspector can also be used to view the data.  From the Flight Data screen press Ctrl-F, then push the \"MAVLink In\" button and then expand the view and look for SCALED_PRESSURE2."
msgstr ""

#: ../../source/docs/common-baro-external.rst:53
#: 54202964552b4bd781d4ea8ada1fade0
msgid "If using ArduPilot onboard OSD, the secondary barometer's temperature reading can be displayed using the OSDn_BTEMP panel."
msgstr ""
