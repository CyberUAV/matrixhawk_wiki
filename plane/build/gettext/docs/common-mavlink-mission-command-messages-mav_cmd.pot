#: 8e972a2979434f9fa4700418ee345553
#: cf646ff259b04c708ba90361d57392c3
msgid "Supported by: Copter, Plane (not Rover)."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:318
#: 0b613c51760444d687c952aa97dad30c
msgid "Takeoff (either from the ground or by hand-launch). It should be the first command of nearly all Plane and Copter missions."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:326
#: 24dd34d66f2e4f388945580be9539a43
msgid "The plane climbs to the specified altitude (at the specified pitch/climb angle) before proceeding to the next waypoint."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:329
#: d8dd5779d8c04163bdda00ede3ed461f
msgid "The plane is *only* attempting to climb at this point and can be pushed off its heading by wind. The pitch value is the *minimum* climb angle when using an airspeed sensor, and *maximum* angle when **not** using an airspeed sensor."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:385
#: f0195f787e254b978e5cc90248062723
msgid "MAV_CMD_NAV_VTOL_TAKEOFF"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:387
#: 2da0a813aadc4ebb98c9b32f7b9bd133
msgid "Supported by:  Plane  (not Copter or Rover). Specifically QuadPlanes."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:389
#: 403b56a731694c88b2581fcbb4ede59d
msgid "Takeoff while in VTOL mode."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:391
#: 5fe8634cf6f74b1a9c8baa0ba206eb9b
msgid "The vehicle will climb straight up from it’s current location to the specified altitude as a delta above its current altitude."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:394
#: 100f436908994622a8798fbd4d75bf27
msgid "However, if :ref:`Q_OPTIONS<Q_OPTIONS>` bit 3 is set (use altitude reference frames for VTOL takeoff), then the altitude value (in the specified reference frame) will be used for the target altitude, instead of a delta above the current altitude. If the command is begun while the vehicle is already flying, the vehicle will climb straight up to the specified altitude, if the vehicle is already above the altitude the command will be ignored and the mission will move on to the next command immediately."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:456
#: 11800fff792340489f1feec5c6f72131
msgid "MAV_CMD_NAV_LOITER_UNLIM"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:460
#: 8c6f25ad69c84b8f803d9f9aaec0ea4c
msgid "Loiter at the specified location for an unlimited amount of time."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:466
#: 0a1116a16c6147feaa9f16813548a303
msgid "Fly to the specified location and then loiter there indefinitely — where loiter means \"circle the waypoint\". If zero is specified for a latitude/longitude/altitude parameter then the current location value for the parameter will be used. You can also specify the radius and direction for the loiter."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:472
#: b608c4ec0e7f42e0b3eafe4efc6355af
msgid "The mission will not proceed past this command while in AUTO mode. In order to break out of this command you need to change the mode (i.e. to MANUAL). If there are subsequent commands then you can continue the mission at the next command, if the Copter ``MIS_RESTART`` parameter is set to resume, by switching back to AUTO mode (otherwise the mission will restart)."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:534
#: a69c87557b924f0589b269106f32a78e
msgid "MAV_CMD_NAV_LOITER_TURNS"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:543
#: e8962378ef61455f916274667e6cb183
msgid "Loiter (circle) the specified location for at least the specified number of complete turns, and then proceed to the next command upon intersection of the course to it with the circle's perimeter. If zero is specified for a latitude/longitude/altitude parameter then the current location value for the parameter will be used. Fractional turns between 0 and 1 are supported, while turns greater than 1 must be integers."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:547
#: 18eab72955674316a015729c2891c494
msgid "The radius of the circle is controlled by the command parameter. A radius of 0 will result in :ref:`WP_LOITER_RAD<WP_LOITER_RAD>` being used as the radius. Negative radius values result in counter-clockwise turns instead of clockwise turns. Radius values over 255 meters will be rounded down to the nearest 10 meter mark. Once the number of turns is completed, continue to loiter until heading points to next nav waypoint. If XTrack Tangent param =1, proceed directly to next waypoint, otherwise, track to the path in a line between the waypoint centers. =1."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:607
#: 3e851928391647b9b4e75bb0be9eada3
msgid "MAV_CMD_NAV_LOITER_TIME"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:609
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1337
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1397
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1661
#: 18f92eb195ed48da95f6971a454706e1
#: 14060d00d1334eb3857a3fc3cce2a5b4
#: ffc0b6491a56499d8e07ba1035ba7d11
#: 6fd7613b8f6d4a5da78d52d82d5ce438
msgid "Supported by: Copter, Plane, Rover."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:614
#: 02e8bb2394b84972b952ae57d28df784
msgid "Fly to the specified location and then loiter there for the specified number of seconds — where loiter means \"circle the waypoint\". The timer starts when the waypoint is reached; when it expires the waypoint is complete. If zero is specified for a latitude/longitude/altitude parameter then the current location value for the parameter will be used. You can also specify the radius and direction for the loiter. Once time has elapsed, continue to loiter until heading points to next nav waypoint. If XTrack Tangent param = gb1, proceed directly to next waypoint, otherwise, track to the path in a line between the waypoint centers."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:625
#: d69e42ca4a714fa6908ffda7bdc8aff5
msgid "The radius of the loiter is set in the ``WP_LOITER_RAD`` parameter."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:680
#: 886bb5dfda0749cd9edfcb93af972672
msgid "MAV_CMD_NAV_RETURN_TO_LAUNCH"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:684
#: 369254b3b46b4611ab81493d9ea6256a
msgid "Return to the *home location* or the nearest `Rally Point <common-rally-points>`__, if closer. The home location is where the vehicle was last armed (or when it first gets GPS lock after arming if the vehicle configuration allows this)."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:693
#: b8f10feb784d4b3696dca20de6abaf8a
msgid "Return to the *home location* (or the nearest :ref:`Rally Point <common-rally-points>` if closer) and then \"Loiter\" (circle the point). The home location is where the vehicle was last armed (or when it first gets GPS lock after arming if the vehicle configuration allows this)."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:698
#: 274a42a5ee80496bbd0af10b7b7b5ae9
msgid "If the return is to a rally point, the plane will loiter at the position and altitude set in the rally point. If the return is to the home location, then the parameter :ref:`RTL_ALTITUDE <RTL_ALTITUDE>` is used for the loiter height (default 100m). The radius of the loiter is defined in the parameter :ref:`WP_LOITER_RAD <WP_LOITER_RAD>`."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:706
#: f60cdb8d0365405caf08b3a56a57acbd
msgid "This command takes no parameters and generally should be the last command in the mission."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:767
#: 31781863f1c645539631f1269a6c122a
msgid "MAV_CMD_NAV_LAND"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:775
#: 18c373fba33e42a4adc56f1847852dbf
msgid "The plane will land at its current location or proceed to the (non-zero) lat/lon coordinates provided beginning with current altitude.  Information on the parameters used to control the landing is provided in :ref:`LAND flight mode <land-mode>`."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:831
#: 19935759b3804b6782f2aa9f63086edb
msgid "MAV_CMD_NAV_VTOL_LAND"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:833
#: e6820114e6bd438ab52758d11ffd1bae
msgid "Supported by: Plane (not Copter or Rover). Specifically QuadPlanes."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:835
#: bc0a6c4edc5f4739bacba11b9381f8b2
msgid "Land the vehicle at the current or a specified location."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:837
#: a7beb6c2276942f3ada5a16f45ce13f8
msgid "If the :ref:`Q_OPTIONS<Q_OPTIONS>` bit 4 is not set (default),the vehicle will land at its current location or proceed at the current altitude to the lat/lon coordinates provided (if non-zero) and land. The ALT parameter is used to determine final landing phase initiation rather than :ref:`Q_LAND_FINAL_ALT<Q_LAND_FINAL_ALT>`. This is the mission equivalent of the :ref:`QLAND flight mode <qland-mode>`."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:840
#: a9acbe950b994ebb9f50f0d6a3792ef8
msgid "If the :ref:`Q_OPTIONS<Q_OPTIONS>` bit 4 is set (Use a fixed wind spiral approach), the it will fly in plane mode to the lat/lon coordinates provided (if non-zero), climbing or descending to the altitude set in the NAV_VTOL_LAND waypoint. When it reaches within :ref:`Q_FW_LND_APR_RAD<Q_FW_LND_APR_RAD>` of the landing location, it will perform a LOITER_TO_ALT to finish the climb or descent to that ALT set in the waypoint, then, turning into the wind, transition to VTOL mode and proceed to the landing location and land."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:842
#: cb890964213f4985b5966f4f9a8173b5
msgid "The motors will disarm on their own once landed"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:844
#: 760f965e573a44149c69348350545179
msgid "param1 of the command acts just like :ref:`Q_OPTIONS<Q_OPTIONS>` bit 4 above, if that option bit is not set. This allows the use of different approaches for different VTOL_LAND commands within the same mission."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:903
#: d2aa2f7277f345dabb94635a0cd0275e
msgid "MAV_CMD_NAV_CONTINUE_AND_CHANGE_ALT"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:905
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:2103
#: 912e6720b061436ba11540c86e836ce4
#: ded22c5b5b6644ebba96415a76ca0e2d
msgid "Supported by: Plane (not Copter, Rover)."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:907
#: 0fdbf55ac7ef42168ef2de4063e2baac
msgid "Continue on the current course and climb/descend to a specified altitude. Move to the next command when the desired altitude is reached."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:912
#: 4e0e6492b8ed44afaf96798a59b08b49
msgid "The ``param1`` value sets how close the vehicle altitude must be to target altitude for command completion."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:983
#: bc1963be87c04904aaab9856a0af31d2
msgid "MAV_CMD_NAV_ALTITUDE_WAIT"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:985
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1049
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:2805
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:2875
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:2933
#: 6d819410b31248189096463313f689a8
#: 6e38737014884745aeb0985b1c3e5305
#: 72b11ed1694b49369d50fa526f8609f9
#: 88cbab671f464a52bae71ba081b5c1ed
#: 43f4971ead4d49a7be1f12b803554c2b
msgid "Supported by: Plane (not Copter or Rover)."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:987
#: fb98a8307517409cba7997b0ad6a2bf0
msgid "Mission command to wait for an altitude or downward vertical speed. This is meant for high-altitude balloon launches, allowing the aircraft to be idle until either an altitude is reached or a negative vertical speed is reached (indicating early balloon burst). The wiggle time is how often to wiggle the control surfaces to prevent them from seizing up."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1047
#: 598f294eb7f14d56bf2e9628735e2699
msgid "MAV_CMD_NAV_LOITER_TO_ALT"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1051
#: 9f8a0b5283a04019832c9d0ae74ffd07
msgid "Loiter while climbing/descending to an altitude."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1053
#: 62d031d55f1841429bb6e7555042ba05
msgid "Begin loitering at the specified Latitude and Longitude. If Lat=Lon=0, then loiter at the current position. Don't consider the navigation command complete (don't leave loiter) until the altitude has been reached. Continue to loiter until heading points to next nav waypoint. If XTrack Tangent param =1, proceed directly to next waypoint, otherwise, track to the path in a line between the waypoint centers."
msgstr ""

