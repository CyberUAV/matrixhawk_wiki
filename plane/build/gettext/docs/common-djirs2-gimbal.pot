msgstr ""

#: ../../source/docs/common-djirs2-gimbal.rst:41
#: e398616ce4de4874b7ea828c1cb6ccf1
msgid "Set :ref:`SCR_ENABLE <SCR_ENABLE>` = 1 to enable scripting"
msgstr ""

#: ../../source/docs/common-djirs2-gimbal.rst:42
#: d17057c6a2bb44c3808caa222354649c
msgid "Set :ref:`SCR_HEAP_SIZE <SCR_HEAP_SIZE>` = 120000 (or higher)"
msgstr ""

#: ../../source/docs/common-djirs2-gimbal.rst:43
#: 1f40329d2fdc4d21a45cca86b3390fdc
msgid "Set :ref:`MNT1_TYPE <MNT1_TYPE>` = 9 (Scripting) to enable the mount/gimbal scripting driver"
msgstr ""

