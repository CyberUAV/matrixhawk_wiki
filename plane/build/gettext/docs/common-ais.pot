msgid "AutoPilot connection"
msgstr ""

#: ../../source/docs/common-ais.rst:22
#: f3fe0b479b394ab3bdb1c1b476f8b340
msgid "The dAISy2 should be connected to one of the autopilot's serial ports as shown below"
