#: ../../source/docs/common-ais.rst:29
#: 51e4ed32dc8244978e899e6a4e4459db
msgid "Autopilot Configuration"
msgstr ""

#: ../../source/docs/common-ais.rst:31
#: 92c7496536c94a17b1ab04109d16560a
msgid "Connect to the autopilot with a ground station and set these parameters and then reboot the autopilot"
msgstr ""

#: ../../source/docs/common-ais.rst:33
#: 5079dd4f38d54e948172491ded1ca42e
msgid ":ref:`AIS_TYPE <AIS_TYPE>` = 1 (NMEA AIVDM message)"
msgstr ""

#: ../../source/docs/common-ais.rst:34
#: 4741aaa377b340b6aa1021f940581a82
msgid ":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` = 40 (AIS) if the sensor is connected to serial port 1.  If another serial port is used please set the appropriate SERIALx_PROTOCOL parameter"
msgstr ""

#: ../../source/docs/common-ais.rst:35
#: 99a45acfa8f04bb0bbe63ec3833b529f
msgid ":ref:`SERIAL1_BAUD <SERIAL1_BAUD>` = 38 (38400 bps) if using serial port 1.  If another serial port is used please set the appropriate SERIALx_BAUD parameter instead"
msgstr ""

#: ../../source/docs/common-ais.rst:36
#: c85c1a1c02fa4576b1f7271aeb4a9507
msgid ":ref:`MAV1_ADSB <MAV1_ADSB>` = 5 to enable sending AIS mavlink messages to the ground station over Serial0 (the USB port).  If a telemetry radio is used the ``MAVx_ADSB`` param corresponding to its stream should also be set to 5(Hz).(Streams are numbered from first in order of Serial ports configured for MAVLink, MAV1 the first, MAV2 the second, etc.)"
msgstr ""

#: ../../source/docs/common-ais.rst:39
#: 2d140e03657d434a8d574f8af82f5c10
msgid "dAISy2 Configuration and Testing"
msgstr ""

#: ../../source/docs/common-ais.rst:41
#: 79491bdb9d4d4446874981fbf9b33d58
msgid "Connect dAISy2 to your PC using a USB cable"
msgstr ""

#: ../../source/docs/common-ais.rst:42
#: 991893b02e784937bc895cd96adf40a0
msgid "Download, install and run a terminal program such as `Putty <https://www.putty.org/>`__"
msgstr ""

#: ../../source/docs/common-ais.rst:43
#: e64463cd8bb742249e9fe39a5ae2b4fe
msgid "Connect to the dAISy2's COM port at 38400 baud and press <ESC> to view the setup menu"
msgstr ""

#: ../../source/docs/common-ais.rst:44
#: 3c0649c807024aecaff7885676e71e33
msgid "Type \"3\" to enable the serial port.  \"38400 8N1 serial output (NMEA HS w/ adapter)\" should be displayed"
msgstr ""

#: ../../source/docs/common-ais.rst:45
#: d2aba1e622c24cfbbac3af608f016480
msgid "Type \"#\" to save this change and retain this baudrate on boot"
msgstr ""

#: ../../source/docs/common-ais.rst:46
#: db16ac021718413fba1615de9e763133
msgid "Type \"T\" to enable entering a test NMEA message and then copy-paste this message, \"!AIVDM,1,1,,A,3815;hUw00wfUdHMPfQ4s8WT0D`r,0*00\", or hit \"Enter\" and use the default location"
msgstr ""

#: ../../source/docs/common-ais.rst:52
#: d30fca2c202148d3ae123c639996e796
msgid "Connect to the autopilot with Mission Planner (or another ground station) and a boat should appear on the South West coast of England"
msgstr ""

#: ../../source/docs/common-ais.rst:58
#: 8422dde216354751a10ca2273f345ec7
msgid "press <ESC> to stop sending test messages"
msgstr ""

