msgstr ""

#: ../../source/docs/common-acns-cm4pilot.rst:97
#: b526db60181c414c98564a0264503a8c
msgid "To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 receivers a UART must be configured and used (USART1 , UART4, or UART6) and their ``SERAILx_PROTOCOL`` set to \"23\"."
msgstr ""

