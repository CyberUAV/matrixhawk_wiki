#: ../../source/docs/common-caddx-gimbal.rst:7
#: 6478962718f24754a666aa0c597b110c
msgid "CADDX Gimbals"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:9
#: 0861626d35b54bf0a605bb64ef7aec6e
msgid "`CADDX <https://caddxfpv.com/products/caddxfpv-gm1-gm2-gm3.html>`__ GM1, GM2, GM3 gimbals are small 1, 2 and 3-axis gimbals weighing between 16g and 46g and can be paired with 19mm x 19mm FPV cameras. The gimbal mounted camera is always stabilized against short term movements in all axes."
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:16
#: d6e4803ce2864c458633a6c48979af26
msgid "Support for these gimbals is available in ArduPilot 4.6 (and higher) and requires the gimbal's firmware be 3.4 (or higher)"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:18
#: bcb8b481a67d4d4db31f9b8dbf62bd80
msgid "The `user manual can be found here <https://cdn.shopify.com/s/files/1/0036/3921/4169/files/GM_Series_Manual_V1.0_1.pdf>`__"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:21
#: db48470cda3749ec85d06442393295af
msgid "Where and What to Buy"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:23
#: 47d76ab73dc948c0bc5716cdd70ed57d
msgid "The GM1, GM2 and GM3 gimbals can be purchased directly from `CADDXFPV <https://caddxfpv.com/products/caddxfpv-gm1-gm2-gm3.html>`__"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:24
#: 013b5cc4ba2c42c78a7c7ffe39b503e1
msgid "The `GL and GM Upgrade Cable <https://caddxfpv.com/products/gl-and-gm-upgrade-cable>`__ can be used to upgrade the gimbal's firmware to 3.4 (or higher). Any FTDI to serial adapter connected to a 3 pin .1mm SH cable can also be used."
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:27
#: ca1e614714e941a4bb704169f68014ee
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:29
#: b1fbff4c74d84a2b8ad27aa0c07f2e33
msgid "the terms \"Gimbal\" and \"Mount\" are interchangeable in ArduPilot."
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:35
#: 4d909779107a4210a735179d51b6740a
msgid "Connect the gimbal's RX, TX and GND pins to one of the autopilot's serial ports as shown above"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:37
#: a58e123bdc364006aa72d6f5627f80d2
msgid "Connect with a ground station and set the following parameters.  The params below assume the autopilot's telem2 port is used. Parameters shown for use of SERIAL2 port and first MOUNT instance. RC switch channels used can be determined by user."
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:39
#: df017ca85cd44b07a75b18774fdc960b
msgid ":ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` to 8 (\"Gimbal\")"
