#: 51b423fcbb6c4bcfaad5de8bf25b09b7
msgid ":ref:`SERIAL2_BAUD <SERIAL2_BAUD>` to \"115\" for 115200 bps"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:41
#: ee70c978b2e342c38027cc60431f59ba
msgid ":ref:`MNT1_TYPE <MNT1_TYPE>` to \"13\" (\"CADDX\") and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:42
#: d49c9d982e664be493884d9e8f228dbb
msgid ":ref:`MNT1_PITCH_MIN <MNT1_PITCH_MIN>` to -90"
msgstr ""

#: ../../source/docs/common-caddx-gimbal.rst:43
#: 098c2a4883dc4b1b86f96e9f155682aa
msgid ":ref:`MNT1_PITCH_MAX <MNT1_PITCH_MAX>` to 90"
msgstr ""

