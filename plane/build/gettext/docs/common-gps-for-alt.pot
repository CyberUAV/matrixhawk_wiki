#: ../../source/docs/common-gps-for-alt.rst:5
#: c15f2e541c12427f92c96942960a59a8
msgid "Using GPS for Altitude Sensing"
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:7
#: d341814d3985423ba9d494dd9bf23d32
msgid "It is possible to boot an autopilot without barometer present, and use GPS (outdoor use) or other altitude sensor (rangefinder, range beacon) for indoor use."
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:9
#: b679e124ea1b4529924246a1780a386b
msgid "Without a barometer as a backup sensor, loss of the primary altitude sensor can result in a crash if in an altitude holding mode or autonomous mode. Be prepared to switch to a non altitude holding mode in case of loss of primary sensor."
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:12
#: f060ec5afc4b47f0ae093f5281242906
msgid "Setup for using a non Baro Source for Altitude Measurement"
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:14
#: 8a7c0c07aa444a40857cabfc5a34d2fa
msgid "If using EKF2:"
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:16
#: 5a8efbe9430c4a51ac26ae669f73b37c
msgid "Set the :ref:`EK2_ALT_SOURCE<EK2_ALT_SOURCE>` parameter to 2 (GPS)."
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:18
#: d3091882abb04ee989271ec473351e5f
msgid "If using EKF3:"
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:20
#: aa123ed8869e46baacc1de428c60cc00
msgid "Set :ref:`EK3_SRC1_POSZ<EK3_SRC1_POSZ>`, :ref:`EK3_SRC2_POSZ<EK3_SRC2_POSZ>`, and  :ref:`EK3_SRC3_POSZ<EK3_SRC3_POSZ>` parameters to 3 (GPS)."
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:22
#: 1e8fdd04f83e413281cc8f47af47f8c3
msgid "In addition:"
msgstr ""

#: ../../source/docs/common-gps-for-alt.rst:24
#: b3de4328f63d4716a7d43db44a82d7fe
msgid "Set :ref:`AHRS_GPS_USE<AHRS_GPS_USE>` to 2 (Use GPS for DCM position and height)."
msgstr ""
