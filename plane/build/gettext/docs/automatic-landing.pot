msgstr ""

#: ../../source/docs/automatic-landing.rst:65
#: be6e6d38c6bb415a962b347ec265f4ac
msgid ":ref:`LAND_PITCH_DEG <LAND_PITCH_DEG>`"
msgstr ""

#: ../../source/docs/automatic-landing.rst:66
#: d22177cf18d54c48af3847e484393255
msgid ":ref:`TECS_LAND_SINK <TECS_LAND_SINK>`"
msgstr ""

#: ../../source/docs/automatic-landing.rst:67
#: 97d161f50a034921bfbde279f0224024
msgid ":ref:`TECS_SINK_MAX<TECS_SINK_MAX>`"
msgstr ""

#: ../../source/docs/automatic-landing.rst:68
#: add28d27d32a42aa8ab2d8176546bdc0
