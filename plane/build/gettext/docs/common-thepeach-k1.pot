msgstr ""

#: ../../source/docs/common-thepeach-k1.rst:74
#: 859364cc4fbb48b2acf8827f3d62eac8
msgid "The 5 AUX outputs are in 2 groups and also support DShot:"
msgstr ""

#: ../../source/docs/common-thepeach-k1.rst:76
#: 3de8bfb1b9b64526b9fd5f78398ba85a
msgid "AUX 1, 2, 3 and 4 in group1"
msgstr ""

#: ../../source/docs/common-thepeach-k1.rst:77
#: eea8ac6cfd8f4f2b972f952cce467f47
msgid "AUX 5 in group2"
msgstr ""

#: ../../source/docs/common-thepeach-k1.rst:79
#: 31cb4e31cfc54f07b4871bb2bb3c821c
msgid "FMU outputs within the same group need to use the same output rate and protocol. If any output in a group uses DShot then all channels in that group need to use DShot."
msgstr ""

