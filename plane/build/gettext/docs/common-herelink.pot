#: ../../source/docs/common-herelink.rst:5
#: adedd22026fc4bc6b915b57fc0de341e
msgid "Herelink RC/HD Video Transmission System"
msgstr ""

#: ../../source/docs/common-herelink.rst:7
#: 7833b2b34d69440c98dc52ee289ba815
msgid "Herelink is an integrated remote controller, ground station and wireless digital transmission system which can be used with the Cube Autopilot and Ardupilot. Herelink allows RC control, HD video and telemetry data to be transmitted up to 20km between the ground station and air unit, the Herelink remote controller features custom Solex TX and QGC applications and both air unit and ground station feature an integrated 8 core SOC for custom application development. Herelink 1.1 also includes Ethernet connectivity from the air unit to gimbals,cameras, and autopilots in addition to HDMI, SBUS and UART based I/O."
msgstr ""

#: ../../source/docs/common-herelink.rst:13
#: 203b680e9551407eab4ae4d503c6e7db
msgid "Features"
msgstr ""

#: ../../source/docs/common-herelink.rst:14
#: be3e3938f4b048518be3230bfc25987e
msgid "Android based smart device with 5.46 inch 1080P capacitive touch screen."
msgstr ""

#: ../../source/docs/common-herelink.rst:15
#: adf6e697edfa40049dc2a16c807cb525
msgid "Integrated digital transmission system simultaneously transmitting video, telemetry and control."
msgstr ""

#: ../../source/docs/common-herelink.rst:16
#: ec698ba4c3ee4487afc328f6072b0fc0
msgid "Custom Solex TX and QGC ground station software with MAVLink support for ArduPilot and PX4."
msgstr ""

#: ../../source/docs/common-herelink.rst:17
#: 514ffb9c41e242f8895c686ff4f453ef
msgid "Dual hall effect self centering gimbals with removable sticks."
msgstr ""

#: ../../source/docs/common-herelink.rst:18
#: 1dc7b7a777bc4f16aa9009b29b0faf60
msgid "1080P HD video with dual digital video inputs."
msgstr ""

#: ../../source/docs/common-herelink.rst:19
#: 1286f8dd89644bc185366171c0afbfe2
msgid "Dual S.bus signal output for simultaneous control of autopilot and pan/tilt cameras."
msgstr ""

#: ../../source/docs/common-herelink.rst:20
#: 4bfc65dababd49658465996351e8219d
msgid "6 customizable MAVLink buttons and Mavlink/Sbus hardware wheel."
msgstr ""

#: ../../source/docs/common-herelink.rst:21
#: 81292f6edb4b48f3897cfb682100c017
msgid "RC gimbal control on dedicated service independent from Solex TX / QGC."
msgstr ""

#: ../../source/docs/common-herelink.rst:22
#: e96a30ace9fc4dd996c792d3bd9c50f9
msgid "Tether and share video and telemetry via wifi ground station such as Mission Planner."
msgstr ""

#: ../../source/docs/common-herelink.rst:23
#: e15c4141fb2e4da69f5e95e50a87a198
msgid "Onboard Arm Cortex A53 & Cortex A53 SOC in both air and ground units for custom applications."
msgstr ""

