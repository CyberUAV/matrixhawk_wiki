#: 5653fd0df59c4c5d9865e497173f5f66
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 20 (Benewake-Serial)"
msgstr ""

#: ../../source/docs/common-benewake-tfmini-lidar.rst:35
