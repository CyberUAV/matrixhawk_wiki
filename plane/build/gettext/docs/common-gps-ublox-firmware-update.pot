#: ../../source/docs/common-gps-ublox-firmware-update.rst:7
#: 2b250dea641746dfb610e14829572553
msgid "The U-Blox F9 GPS is an L1/L2 RTK GPS that can provide high accuracy positioning and can also be used for :ref:`GPS-for-Yaw <common-gps-for-yaw>`.  This documents how to upgrade the firmware on the GPS."
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:10
#: 1ffb890ff1aa49058d22ed0bf0bc4379
msgid "Firmware Upgrade Procedure"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:12
#: b7ffc8a3fbee4cf98034deb0251e144b
msgid "`Download u-center from u-blox.com <https://www.u-blox.com/en/product/u-center>`__ and install on your PC (Windows only)"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:13
#: 96badac11c8b48ed86743d4985207089
msgid "Open the `u-Blox ZED-F9P website <https://www.u-blox.com/en/product/zed-f9p-module?legacy=Current#Documentation-&-resources>`__"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:14
#: 9258bafca7ac43b89b3a06abc693a7da
msgid "Scroll down and click on the \"Documentation & resources\" button"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:15
#: 60fe5cf9ea784fe6922538d98c7f59a2
msgid "Scroll down to the \"Firmware Update\" section and download the latest firmware (\"ZED-F9P L1/L2 HPG 1.50 firmware\" as of Jul 2024)"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:16
#: af6bc9d29f234e878c04b61cd17488bb
msgid "Connect the GPS to your PC using a USB cable"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:17
#: 918dd2e6cd1349678c0c598aaf78eaff
msgid "Open u-center, select the COM port and connect"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:23
#: 99011dc15a8d49ce9f01b5c74bf83260
msgid "Check the GPS's current firmware version by selecting View, Messages View, UBX, MON, VER"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:29
#: aa28140320804dbf8abad25b7db2e658
msgid "If the version is lower than the latest (especially if lower than 1.13) then upgrade the firmware"
msgstr ""

#: ../../source/docs/common-gps-ublox-firmware-update.rst:31
#: bfc715dceacf4ee5aa62ed3ee6d7497e
