#: 6da279f79d1a40dfbc073dcfe97f835c
msgid ":ref:`SERIAL3_OPTIONS<SERIAL3_OPTIONS>` = 7"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:69
#: 39091a5038874975a3a4e9e510abdc87
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:70
#: f6aab37cf693478b96fcf46a4f690092
msgid "The Droneer F405 supports analog OSD using its integrated MAX7456. Simultaneous HD TVX OSD operation can also be obtained using an available UART whose protocol is set to \"DisplayPort (42)\" and :ref:`OSD_TYPE2<OSD_TYPE2>` set to \"5\"."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:72
#: 06f067e61a904e8f8e05be698dc6d5dc
msgid "The JST-GH-4P connector supports a standard \"Tramp\" VTX connection. Pin 1 of the connector is 10v so be careful not to connect this to a peripheral requiring 5v."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:75
#: 447c190376494abb9ab4c02c7776d38d
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:76
#: d9221d5608134c43a324d4f21cc4cccb
msgid "The Droneer F405 supports up to 9 PWM outputs. The ESC connectors have M1-8 outputs, plus M9(marked LED) for LED strip or another PWM output."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:78
#: 256cf840912c4ace832180959a81ce4b
msgid "The PWM is in 3 groups:"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:81
#: 420e7e15d5c44aa28b2583fdb60046db
msgid "PWM 1-4 in group1"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:82
#: 7d65c7deb59e4f6cad084cb16031b84a
msgid "PWM 5-8 in group2"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:83
#: a55d3266ab99442390f1810daf52ef97
msgid "PWM 9 in group3"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:85
#: 9ce99703cd9c4e2ab8912907ae0e921a
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-4 support bi-directional DShot."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:90
#: cccf386787e64d40b60839b5b6afa9d5
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:91
#: 332e84fc42c44203911783890aab4ef3
msgid "The board has a internal voltage sensor and connections on the ESC connector for an external current sensor input. The voltage sensor can handle up to 8S LiPo batteries."
msgstr ""

