#: ../../source/docs/common-efi.rst:124
#: 9f0d6ff4b8dd4522a90dc98c5fddb510
msgid "Throttle Linearization"
msgstr ""

#: ../../source/docs/common-efi.rst:126
#: 53534d4b77014cb586705ce166038bfb
msgid "Some serial EFIs use the ArduPilot throttle output PWM value to control the throttle instead of a servo. Often the engine thrust is not a linear relation to this value. ArduPilot provides up to a third order polynomial curve fit for PWM versus control value sent to the EFI by changing the following parameters from their default values (which is a linear fit):"
msgstr ""

#: ../../source/docs/common-efi.rst:128
#: 085e27b42b7d4f94a5a8bcfbea6e915c
msgid ":ref:`EFI_THRLIN_EN<EFI_THRLIN_EN>` = 1 to enable, then refresh parameters or reboot to show:"
msgstr ""

#: ../../source/docs/common-efi.rst:129
#: 5e7bd6c314074fd8b810f5adfe65828c
msgid ":ref:`EFI_THRLIN_COEF1<EFI_THRLIN_COEF1>` First order polynomial fit term"
msgstr ""

#: ../../source/docs/common-efi.rst:130
#: 21297705ca0f43a58d62997d070fa35b
msgid ":ref:`EFI_THRLIN_COEF2<EFI_THRLIN_COEF2>` Second order polynomial fit term"
msgstr ""

#: ../../source/docs/common-efi.rst:131
#: 631184113da54b8a9a5dfc4819a74779
msgid ":ref:`EFI_THRLIN_COEF3<EFI_THRLIN_COEF3>` Third order polynomial fit term"
msgstr ""

#: ../../source/docs/common-efi.rst:132
#: f623625f3b2d46ecb51d60306d623a62
msgid ":ref:`EFI_THRLIN_OFS<EFI_THRLIN_OFS>` Offset term"
msgstr ""

#: ../../source/docs/common-efi.rst:134
#: e696bdfc96de475ebdbeddcf0ac93dc4
msgid "throttle values are modified as:"
msgstr ""

#: ../../source/docs/common-efi.rst:136
#: 058474605cfa44a7ab0054a1e5f83e2d
msgid "ArduPilot scaled throttle output value = thr"
msgstr ""

#: ../../source/docs/common-efi.rst:138
#: b83eb8096d78473ea5f88975aaed1ec9
msgid "modified throttle = (EFI_THRLIN_COEF3 * thr^3 + EFI_THRLIN_COEF2 * thr^2 + EFI_THRLIN_COEF1 * thr) + EFI_THRLIN_OFS"
msgstr ""

#: ../../source/docs/common-efi.rst:140
#: 57a47bd127c0497d92ad8375daff0c3b
msgid "This allows the non-linearity to be compensated. The values for these parameters should be obtained from the EFI manufacturer, if applicable."
msgstr ""
