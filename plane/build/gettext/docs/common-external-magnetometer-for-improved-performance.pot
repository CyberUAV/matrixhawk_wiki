msgid "In the picture below, we've mounted the board “components up with pins forward”."
msgstr ""

#: ../../source/docs/common-external-magnetometer-for-improved-performance.rst:122
#: 7e14b8256aa443e9bb71ce36033e857d
msgid "Autopilot board orientation and magnetometer orientation must be used to calculate the :ref:`COMPASS_ORIENT<COMPASS_ORIENT>` parameter."
msgstr ""

#: ../../source/docs/common-external-magnetometer-for-improved-performance.rst:129
#: e6998477c9c74d3aa907913ecf735d14
