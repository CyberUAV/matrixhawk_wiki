#: ../../source/docs/common-gps-how-it-works.rst:101
#: b59130fea69b4b39b3e227d3a61b3009
msgid "DGPS corrections"
msgstr ""

#: ../../source/docs/common-gps-how-it-works.rst:103
#: f880971965f044f493163d40c83adb4c
msgid "DGPS corrections are using pseudorange data only. SBAS is a form of DGPS correction freely available from one or more geostationary satellites."
msgstr ""

#: ../../source/docs/common-gps-how-it-works.rst:106
#: d0d083baf0bc460292ce7bfd9ee3ec3f
msgid "Each region of the world has a localized SBAS system : WAAS for America, EGNOS for Europe, MSAS for Japan."
msgstr ""

#: ../../source/docs/common-gps-how-it-works.rst:109
#: d82dfba3364f456fbf90630310023e7b
msgid "DGPS corrections give meter precision (free services) or decimeter precision (paying services)"
msgstr ""

#: ../../source/docs/common-gps-how-it-works.rst:116
#: 7e2a9b8c957547ffab2c84ac5843f837
msgid "RTK corrections"
msgstr ""

#: ../../source/docs/common-gps-how-it-works.rst:118
#: 2aaaa693d3644443bb582ebb85589055
msgid "RTK corrections are using carrier phase information and needs costly advanced GPS as well as a RTK base station or a Network of RTK base stations broadcasting corrections over a modem or Internet through the RTCM protocol."
msgstr ""

#: ../../source/docs/common-gps-how-it-works.rst:126
#: 2d9a0c2e53014141bf09a19ee3d86e60
msgid "RTK is easier to use with slow motion or static applications (like surveying or farming) and give centimeter or millimeter precision."
msgstr ""
