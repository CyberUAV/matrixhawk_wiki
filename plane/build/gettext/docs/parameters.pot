msgid "Disable attitude check for takeoff arming"
msgstr ""

#: ../../source/docs/parameters.rst:2463
#: f9294d279bb646bdb8a13a8c67910645
msgid "Force target airspeed to trim airspeed in Cruise or FBWB"
msgstr ""

#: ../../source/docs/parameters.rst:2465
#: 276e386ef3574448a979b70ff5f3ac4a
msgid "Climb to RTL_ALTITUDE before turning for RTL"
msgstr ""

#: ../../source/docs/parameters.rst:2467
#: ecf9932553f04292898c1b430b307c75
msgid "Enable yaw damper in acro mode"
msgstr ""

#: ../../source/docs/parameters.rst:2469
#: 0b83eae0a19345aa836627abe7fd29d5
msgid "Suppress speed scaling during auto takeoffs to be 1 or less to prevent oscillations without airspeed sensor."
msgstr ""

#: ../../source/docs/parameters.rst:2471
#: 96fd77d368ef415e9e8c101d1fa48324
msgid "EnableDefaultAirspeed for takeoff"
msgstr ""

#: ../../source/docs/parameters.rst:2473
#: ccc0f9edee5047c189adf89fa3f5176b
msgid "Remove the PTCH_TRIM_DEG on the GCS horizon"
msgstr ""

#: ../../source/docs/parameters.rst:2475
