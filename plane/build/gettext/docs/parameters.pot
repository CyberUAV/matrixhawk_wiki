msgid "EnableBaroAffinity"
msgstr ""

#: ../../source/docs/parameters.rst:41257
#: ee98b84af90647e38025b0c817375216
msgid "EnableCompassAffinity"
msgstr ""

#: ../../source/docs/parameters.rst:41259
