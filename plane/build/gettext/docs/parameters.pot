msgid "Adjust mid-throttle to be TRIM_THROTTLE in non-auto throttle modes except MANUAL"
msgstr ""

#: ../../source/docs/parameters.rst:2479
#: 0cf684ffd9f64958b16fdaa9cc44a739
msgid "Disable suppression of fixed wing rate gains in ground mode"
msgstr ""

#: ../../source/docs/parameters.rst:2481
