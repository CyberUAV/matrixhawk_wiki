#: ../../source/docs/parameters.rst:444
#: 89a956deaba245b1840539ab1e65f323
msgid "TKOFF\\_PLIM\\_SEC: Takeoff pitch limit reduction"
msgstr ""

#: ../../source/docs/parameters.rst:448
#: 740d204df19c4c09a6f6a6831df4783b
msgid "This parameter reduces the pitch minimum limit of an auto\\-takeoff just a few seconds before it reaches the target altitude\\. This reduces overshoot by allowing the flight controller to start leveling off a few seconds before reaching the target height\\. When set to zero\\, the mission pitch min is enforced all the way to and through the target altitude\\, otherwise the pitch min slowly reduces to zero in the final segment\\. This is the pitch\\_min\\, not the demand\\. The flight controller should still be commanding to gain altitude to finish the takeoff but with this param it is not forcing it higher than it wants to be\\."
msgstr ""

#: ../../source/docs/parameters.rst:463
#: 4b916a65f3b846abbcca52a6f44bef12
msgid "TKOFF\\_FLAP\\_PCNT: Takeoff flap percentage"
msgstr ""

#: ../../source/docs/parameters.rst:467
#: a553758f40d84231aa8d7751495a2da2
msgid "The amount of flaps \\(as a percentage\\) to apply in automatic takeoff"
msgstr ""

#: ../../source/docs/parameters.rst:482
#: c5ef92d7bcbc46118334d4fa19f3ba28
msgid "LEVEL\\_ROLL\\_LIMIT: Level flight roll limit"
msgstr ""

#: ../../source/docs/parameters.rst:485
#: f94cb8351fe1420298190160572908af
msgid "This controls the maximum bank angle in degrees during flight modes where level flight is desired\\, such as in the final stages of landing\\, and during auto takeoff\\. This should be a small angle \\(such as 5 degrees\\) to prevent a wing hitting the runway during takeoff or landing\\. Setting this to zero will completely disable heading hold on auto takeoff while below 5 meters and during the flare portion of a final landing approach\\."
msgstr ""

