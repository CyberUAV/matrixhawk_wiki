msgid "Enable FBWB style loiter altitude control"
msgstr ""

#: ../../source/docs/parameters.rst:2483
#: da449386a3fb4e1e9938c7f86e6e3476
msgid "Indicate takeoff waiting for neutral rudder with flight control surfaces"
msgstr ""

#: ../../source/docs/parameters.rst:2485
#: fe06d8e6f94d44589766c89f7f604038
msgid "In AUTO - climb to next waypoint altitude immediately instead of linear climb"
msgstr ""

#: ../../source/docs/parameters.rst:2487
#: c70cbf1c56aa49ae82e0347761417354
msgid "Enable autoflap in manual modes and use minimum of target and actual speed for flap setting"
msgstr ""

#: ../../source/docs/parameters.rst:2489
#: 5eedd0d6c66344b8932f9f1c92c19287
msgid "Enable full aerodynamic load factor-based roll limits when an airspeed sensor is enabled and AIRSPEED_STALL is set"
msgstr ""

#: ../../source/docs/parameters.rst:2500
#: f583f279c3284792b0df70bbe3499262
msgid "TKOFF\\_ACCEL\\_CNT: Takeoff throttle acceleration count"
msgstr ""

#: ../../source/docs/parameters.rst:2503
#: 3bcee84b8fee4cd3b5182129f44b3c08
msgid "This is the number of acceleration events to require for arming with TKOFF\\_THR\\_MINACC\\. The default is 1\\, which means a single forward acceleration above TKOFF\\_THR\\_MINACC will arm\\. By setting this higher than 1 you can require more forward\\/backward movements to arm\\."
msgstr ""

#: ../../source/docs/parameters.rst:2518
#: 535238d9aec441bf9258692a88f76745
msgid "DSPOILER\\_CROW\\_W1: Differential spoiler crow flaps outer weight"
msgstr ""

#: ../../source/docs/parameters.rst:2522
#: 9b9c4e3971e844ad9403dec9f7434960
msgid "This is amount of deflection applied to the two outer surfaces for differential spoilers for flaps to give crow flaps\\. It is a number from 0 to 100\\. At zero no crow flaps are applied\\. A recommended starting value is 25\\."
msgstr ""

#: ../../source/docs/parameters.rst:2537
#: b421a6e49d7c40acad2792a73ec70495
msgid "DSPOILER\\_CROW\\_W2: Differential spoiler crow flaps inner weight"
msgstr ""

#: ../../source/docs/parameters.rst:2541
#: 652bf5bd1bc84363be6e7a0cbe45c74a
msgid "This is amount of deflection applied to the two inner surfaces for differential spoilers for flaps to give crow flaps\\. It is a number from 0 to 100\\. At zero no crow flaps are applied\\. A recommended starting value is 45\\."
msgstr ""

#: ../../source/docs/parameters.rst:2556
#: 81a2f8e5ff6d44ed8308e67cb6a6be3a
msgid "TKOFF\\_TIMEOUT: Takeoff timeout"
msgstr ""

#: ../../source/docs/parameters.rst:2559
#: 7bf1b7671b5341e19be1ead7c2cc0c9e
msgid "This is the timeout for an automatic takeoff\\. If this is non\\-zero and the aircraft does not reach a ground speed of at least 4 m\\/s within this number of seconds then the takeoff is aborted and the vehicle disarmed\\. If the value is zero then no timeout applies\\."
msgstr ""

