msgstr ""

#: ../../source/docs/parameters.rst:61417
#: 506c4fbfae204656a492740b3013adb1
msgid "Crosstrack error integrator gain\\. This gain is applied to the crosstrack error to ensure it converges to zero\\. Set to zero to disable\\. Smaller values converge slower\\, higher values will cause crosstrack error oscillation\\."
msgstr ""

