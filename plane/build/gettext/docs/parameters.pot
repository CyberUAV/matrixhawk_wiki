msgstr ""

#: ../../source/docs/parameters.rst:61398
#: 1d06a0f072b8421a86e87c5fe27e532e
msgid "Damping ratio for L1 control\\. Increase this in increments of 0\\.05 if you are getting overshoot in path tracking\\. You should not need a value below 0\\.7 or above 0\\.85\\."
msgstr ""

#: ../../source/docs/parameters.rst:61413
