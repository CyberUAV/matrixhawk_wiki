#: ../../source/docs/parameters.rst:133586
#: 41757aa070284ca1baa287ece1ae6b45
msgid "STEER2SRV\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:133592
#: f8ce90aea97d404bab92c73624a69e30
msgid "STEER2SRV\\_TCONST: Steering Time Constant"
msgstr ""

#: ../../source/docs/parameters.rst:133596
#: 9c43718642f146a0b735f545c2b8af26
msgid "This controls the time constant in seconds from demanded to achieved steering angle\\. A value of 0\\.75 is a good default and will work with nearly all rovers\\. Ground steering in aircraft needs a bit smaller time constant\\, and a value of 0\\.5 is recommended for best ground handling in fixed wing aircraft\\. A value of 0\\.75 means that the controller will try to correct any deviation between the desired and actual steering angle in 0\\.75 seconds\\. Advanced users may want to reduce this time to obtain a faster response but there is no point setting a time less than the vehicle can achieve\\."
msgstr ""

#: ../../source/docs/parameters.rst:133611
#: d2d8680dc2344e52961cae8d85011b6d
msgid "STEER2SRV\\_P: Steering turning gain"
msgstr ""

#: ../../source/docs/parameters.rst:133614
#: cead9b7d28644101b64d275e28cfcac8
msgid "The proportional gain for steering\\. This should be approximately equal to the diameter of the turning circle of the vehicle at low speed and maximum steering angle"
msgstr ""

#: ../../source/docs/parameters.rst:133629
#: bfd706d981f44a5aa25175694b7384a0
msgid "STEER2SRV\\_I: Integrator Gain"
msgstr ""

#: ../../source/docs/parameters.rst:133632
#: 029831146c344d1bb1a852b91bd91ed2
msgid "This is the gain from the integral of steering angle\\. Increasing this gain causes the controller to trim out steady offsets due to an out of trim vehicle\\."
msgstr ""

#: ../../source/docs/parameters.rst:133638
#: 212e8992eacb49ce8d5519def6a832fa
msgid "0 to 1.0"
msgstr ""

#: ../../source/docs/parameters.rst:133647
#: d952597a8fc948009f6e3c5382440acd
msgid "STEER2SRV\\_D: Damping Gain"
msgstr ""

#: ../../source/docs/parameters.rst:133650
#: 217218ac831f4329b341e4ab88d766eb
msgid "This adjusts the damping of the steering control loop\\. This gain helps to reduce steering jitter with vibration\\. It should be increased in 0\\.01 increments as too high a value can lead to a high frequency steering oscillation that could overstress the vehicle\\."
msgstr ""

#: ../../source/docs/parameters.rst:133665
#: 208d91f1bcbc40e997edeb007dd32bf4
msgid "STEER2SRV\\_IMAX: Integrator limit"
msgstr ""

#: ../../source/docs/parameters.rst:133669
#: 497bc7aad5bd40b686620e4db879b488
msgid "This limits the number of degrees of steering in centi\\-degrees over which the integrator will operate\\. At the default setting of 1500 centi\\-degrees\\, the integrator will be limited to \\+\\- 15 degrees of servo travel\\. The maximum servo deflection is \\+\\- 45 centi\\-degrees\\, so the default value represents a 1\\/3rd of the total control throw which is adequate unless the vehicle is severely out of trim\\."
msgstr ""

#: ../../source/docs/parameters.rst:133684
#: 7fb1301051cf4728bb290a6c119e7d74
msgid "STEER2SRV\\_MINSPD: Minimum speed"
msgstr ""

#: ../../source/docs/parameters.rst:133687
#: be7972c1a23b47388ca930bbd7b645c5
msgid "This is the minimum assumed ground speed in meters\\/second for steering\\. Having a minimum speed prevents oscillations when the vehicle first starts moving\\. The vehicle can still drive slower than this limit\\, but the steering calculations will be done based on this minimum speed\\."
msgstr ""

#: ../../source/docs/parameters.rst:133702
#: cde8348300604959bb5e402c09b19e97
msgid "STEER2SRV\\_FF: Steering feed forward"
msgstr ""

#: ../../source/docs/parameters.rst:133705
#: 7c41c3c073bb485888227bd006961fdc
msgid "The feed forward gain for steering this is the ratio of the achieved turn rate to applied steering\\. A value of 1 means that the vehicle would yaw at a rate of 45 degrees per second with full steering deflection at 1m\\/s ground speed\\."
msgstr ""

#: ../../source/docs/parameters.rst:133720
#: 4ac908ed2335455c9fe50b73acc4aa38
msgid "STEER2SRV\\_DRTSPD: Derating speed"
msgstr ""

#: ../../source/docs/parameters.rst:133724
#: d1aded9d2c104f6c9a45f6b5dcacbf01
msgid "Speed after that the maximum degree of steering will start to derate\\. Set this speed to a maximum speed that a plane can do controlled turn at maximum angle of steering wheel without rolling to wing\\. If 0 then no derating is used\\."
msgstr ""

#: ../../source/docs/parameters.rst:133730
#: df3b3b000e3a40d08adba9ae73cfd6c5
msgid "0.0 to 30.0"
msgstr ""

#: ../../source/docs/parameters.rst:133739
#: 89813a9cbbf34fd9bf9da40cb1c0777f
msgid "STEER2SRV\\_DRTFCT: Derating factor"
msgstr ""

#: ../../source/docs/parameters.rst:133743
#: 8a6eb09ffd7c4d1884832e19681ebb0b
msgid "Degrees of steering wheel to derate at each additional m\\/s of speed above \\\"Derating speed\\\"\\. Should be set so that at higher speeds the plane does not roll to the wing in turns\\."
msgstr ""

#: ../../source/docs/parameters.rst:133749
#: c1ae20027b30477eb31847f4319089df
msgid "0.0 to 50.0"
msgstr ""

#: ../../source/docs/parameters.rst:133749
#: 5c7f724c6a5e47eb9ab6f9b6232f46f6
msgid "degrees per meter per second"
msgstr ""

#: ../../source/docs/parameters.rst:133758
#: c757663802854e6cac68a27f15eb6e60
msgid "STEER2SRV\\_DRTMIN: Minimum angle of wheel"
msgstr ""

#: ../../source/docs/parameters.rst:133762
#: 9f8a98f851bb47de82561b97e58e7e14
msgid "The angle that limits smallest angle of steering wheel at maximum speed\\. Even if it should derate below\\, it will stop derating at this angle\\."
msgstr ""

#: ../../source/docs/parameters.rst:133778
#: 5d1477c02c934919af29103a508b0c16
msgid "TECS\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:133784
#: c3f85fc86c3840d0ad7362932812b8b3
msgid "TECS\\_CLMB\\_MAX: Maximum Climb Rate \\(metres\\/sec\\)"
msgstr ""

#: ../../source/docs/parameters.rst:133787
#: b2988ba9ba6f4d86ae3de513e506ddc1
msgid "Maximum demanded climb rate\\. Do not set higher than the climb speed at THR\\_MAX at AIRSPEED\\_CRUISE when the battery is at low voltage\\. Reduce value if airspeed cannot be maintained on ascent\\. Increase value if throttle does not increase significantly to ascend\\."
msgstr ""

#: ../../source/docs/parameters.rst:133793
#: 0a3b089752054889a01168611e49bf28
msgid "0.1 to 20.0"
msgstr ""

#: ../../source/docs/parameters.rst:133802
#: 07ac47d7306641cd91e823cd0a540dcb
msgid "TECS\\_SINK\\_MIN: Minimum Sink Rate \\(metres\\/sec\\)"
msgstr ""

#: ../../source/docs/parameters.rst:133805
#: fc6d5bc5bd5c498fbe0b2c8abed6807c
msgid "Minimum sink rate when at THR\\_MIN and AIRSPEED\\_CRUISE\\."
msgstr ""

#: ../../source/docs/parameters.rst:133820
#: 8b518dbb06824c02b0910c3041f3a21f
msgid "TECS\\_TIME\\_CONST: Controller time constant \\(sec\\)"
msgstr ""

#: ../../source/docs/parameters.rst:133824
#: 84f63aded1c446d28a297f13c7a40a06
msgid "Time constant of the TECS control algorithm\\. Small values make faster altitude corrections but can cause overshoot and aggressive behavior\\."
msgstr ""

#: ../../source/docs/parameters.rst:133830
#: 828ec7d1c320401a8b4b8806abc5d83b
msgid "3.0 to 10.0"
msgstr ""

#: ../../source/docs/parameters.rst:133839
#: 5b06e855ceea439c86351f8385259f72
msgid "TECS\\_THR\\_DAMP: Controller throttle damping"
msgstr ""

#: ../../source/docs/parameters.rst:133843
#: 23060cb22ecd43108c3439bab212f87d
msgid "Damping gain for throttle demand loop\\. Increase to add throttle activity to dampen oscillations in speed and height\\."
msgstr ""

#: ../../source/docs/parameters.rst:133858
#: 998fbc5813194192ade5203a5fa8eda6
msgid "TECS\\_INTEG\\_GAIN: Controller integrator"
msgstr ""

#: ../../source/docs/parameters.rst:133862
#: a122e9087e484975834068b6180c414a
msgid "Integrator gain to trim out long\\-term speed and height errors\\."
msgstr ""

#: ../../source/docs/parameters.rst:133868
#: ../../source/docs/parameters.rst:134245
#: ../../source/docs/parameters.rst:134264
#: a360cd6b7363460db62d7e56a9d93875
#: e8c8de9253894bf4b168125e9fc79d3f
#: 0cce4772ebcd459780eadcf4608a6f88
msgid "0.02"
msgstr ""

#: ../../source/docs/parameters.rst:133877
#: 9d042f241e4b4a64a9a2076cf9b78ccd
msgid "TECS\\_VERT\\_ACC: Vertical Acceleration Limit \\(metres\\/sec\\^2\\)"
msgstr ""

#: ../../source/docs/parameters.rst:133881
#: 511ad2743e4342f089fbea258b221c90
msgid "Maximum vertical acceleration used to correct speed or height errors\\."
msgstr ""

#: ../../source/docs/parameters.rst:133896
#: b9e1f9ca0c2041ffb4c125f1050976e5
msgid "TECS\\_HGT\\_OMEGA: Height complementary filter frequency \\(radians\\/sec\\)"
msgstr ""

#: ../../source/docs/parameters.rst:133900
#: a80bd221c9d845948ac20f3928ac20e9
msgid "This is the cross\\-over frequency of the complementary filter used to fuse vertical acceleration and baro alt to obtain an estimate of height rate and height\\."
msgstr ""

#: ../../source/docs/parameters.rst:133906
#: ../../source/docs/parameters.rst:134131
#: ../../source/docs/parameters.rst:134430
#: 881d5b7149c449d6b5b2ea442f2a9225
#: c3b06682e6134de2b28daf66aaeabeba
#: b8b8eabb7b584b5d853a8e6f7a86a2e7
msgid "1.0 to 5.0"
msgstr ""

#: ../../source/docs/parameters.rst:133915
#: a8ed654a048e4c4ea4bf59b276b2a209
msgid "TECS\\_SPD\\_OMEGA: Speed complementary filter frequency \\(radians\\/sec\\)"
msgstr ""

#: ../../source/docs/parameters.rst:133919
#: 84f9fcaca4784b21baa6172dc236b8d4
msgid "This is the cross\\-over frequency of the complementary filter used to fuse longitudinal acceleration and airspeed to obtain a lower noise and lag estimate of airspeed\\."
msgstr ""

#: ../../source/docs/parameters.rst:133925
#: 514b0b9e0b33440bac3eb635a8fa88fc
msgid "0.5 to 2.0"
msgstr ""

#: ../../source/docs/parameters.rst:133934
#: f2fadd5fc7504605bde1ce8bc92f5f81
msgid "TECS\\_RLL2THR: Bank angle compensation gain"
msgstr ""

#: ../../source/docs/parameters.rst:133938
#: 7d690a8f20374d3f9a95803c586b7e5e
msgid "Gain from bank angle to throttle to compensate for loss of airspeed from drag in turns\\. Set to approximately 10x the sink rate in m\\/s caused by a 45\\-degree turn\\. High efficiency models may need less while less efficient aircraft may need more\\. Should be tuned in an automatic mission with waypoints and turns greater than 90 degrees\\. Tune with PTCH2SRV\\_RLL and KFF\\_RDDRMIX to achieve constant airspeed\\, constant altitude turns\\."
msgstr ""

#: ../../source/docs/parameters.rst:133944
#: aa64bf181f954e83a0ac46b85a201612
msgid "5.0 to 30.0"
msgstr ""

#: ../../source/docs/parameters.rst:133953
#: 2ef30e7e22d44a56accd0b356b8442ff
msgid "TECS\\_SPDWEIGHT: Weighting applied to speed control"
msgstr ""

#: ../../source/docs/parameters.rst:133957
#: e419bc08f0144871a79fdfd024d9fae5
msgid "Mixing of pitch and throttle correction for height and airspeed errors\\. Pitch controls altitude and throttle controls airspeed if set to 0\\. Pitch controls airspeed and throttle controls altitude if set to 2 \\(good for gliders\\)\\. Blended if set to 1\\."
msgstr ""

#: ../../source/docs/parameters.rst:133972
#: 727481ddf8df4e39999b5d282d7cbca5
msgid "TECS\\_PTCH\\_DAMP: Controller pitch damping"
msgstr ""

#: ../../source/docs/parameters.rst:133976
#: 61f5b228a3c141b58da0ed33ead687e4
msgid "Damping gain for pitch control from TECS control\\.  Increasing may correct for oscillations in speed and height\\, but too much may cause additional oscillation and degraded control\\."
msgstr ""

#: ../../source/docs/parameters.rst:133991
#: 1e42b50875fe44e497cc0d76132f0f7f
msgid "TECS\\_SINK\\_MAX: Maximum Descent Rate \\(metres\\/sec\\)"
msgstr ""

#: ../../source/docs/parameters.rst:133994
#: 055c7dfff68a4d89bb538d1025bf4e3c
msgid "Maximum demanded descent rate\\. Do not set higher than the vertical speed the aircraft can maintain at THR\\_MIN\\, TECS\\_PITCH\\_MIN\\, and AIRSPEED\\_MAX\\."
msgstr ""

#: ../../source/docs/parameters.rst:134000
#: ../../source/docs/parameters.rst:134188
#: 449664ca924c4155916dfb1ffd7db72f
#: b502579e04464768ac7763754bcbd88a
msgid "0.0 to 20.0"
msgstr ""

#: ../../source/docs/parameters.rst:134009
#: eeaa5e376e90444b9cd726903fed12b4
msgid "TECS\\_LAND\\_ARSPD: Airspeed during landing approach \\(m\\/s\\)"
msgstr ""

#: ../../source/docs/parameters.rst:134012
#: 49945f108fe34018b501c3332a5e3654
msgid "When performing an autonomous landing\\, this value is used as the goal airspeed during approach\\.  Max airspeed allowed is Trim Airspeed or AIRSPEED\\_MAX as defined by LAND\\_OPTIONS bitmask\\.  Note that this parameter is not useful if your platform does not have an airspeed sensor \\(use TECS\\_LAND\\_THR instead\\)\\.  If negative then this value is halfway between AIRSPEED\\_MIN and AIRSPEED\\_CRUISE speed for fixed wing autolandings\\."
msgstr ""

#: ../../source/docs/parameters.rst:134027
#: 8ca94e5d03694a1fb07045268edf479b
msgid "TECS\\_LAND\\_THR: Cruise throttle during landing approach \\(percentage\\)"
msgstr ""

#: ../../source/docs/parameters.rst:134030
#: 17f79d107cc648c4b89718481c204a4c
msgid "Use this parameter instead of LAND\\_ARSPD if your platform does not have an airspeed sensor\\.  It is the cruise throttle during landing approach\\.  If this value is negative then it is disabled and TECS\\_LAND\\_ARSPD is used instead\\."
msgstr ""

#: ../../source/docs/parameters.rst:134045
#: d0c70262c385498ab51c814d96128ce5
msgid "TECS\\_LAND\\_SPDWGT: Weighting applied to speed control during landing\\."
msgstr ""

#: ../../source/docs/parameters.rst:134049
#: a2121dcdc5f64f31927b195428cc9755
msgid "Same as SPDWEIGHT parameter\\, with the exception that this parameter is applied during landing flight stages\\.  A value closer to 2 will result in the plane ignoring height error during landing and our experience has been that the plane will therefore keep the nose up \\-\\- sometimes good for a glider landing \\(with the side effect that you will likely glide a ways past the landing point\\)\\.  A value closer to 0 results in the plane ignoring speed error \\-\\- use caution when lowering the value below 1 \\-\\- ignoring speed could result in a stall\\. Values between 0 and 2 are valid values for a fixed landing weight\\. When using \\-1 the weight will be scaled during the landing\\. At the start of the landing approach it starts with TECS\\_SPDWEIGHT and scales down to 0 by the time you reach the land point\\. Example\\: Halfway down the landing approach you\\'ll effectively have a weight of TECS\\_SPDWEIGHT\\/2\\."
msgstr ""

#: ../../source/docs/parameters.rst:134055
#: 2ee49f6ee65a43c6937e4394efbb96a6
msgid "-1.0 to 2.0"
msgstr ""

#: ../../source/docs/parameters.rst:134064
#: e851a75520a6448981e88a84db1a3588
msgid "TECS\\_PITCH\\_MAX: Maximum pitch in auto flight"
msgstr ""

#: ../../source/docs/parameters.rst:134068
#: dc33bdfd7c004a6ea2f153aea845d3c6
msgid "Overrides PTCH\\_LIM\\_MAX\\_DEG in automatic throttle modes to reduce climb rates\\. Uses PTCH\\_LIM\\_MAX\\_DEG if set to 0\\. For proper TECS tuning\\, set to the angle that the aircraft can climb at AIRSPEED\\_CRUISE and THR\\_MAX\\."
msgstr ""

#: ../../source/docs/parameters.rst:134083
#: 7c7f04cdb36c40df91b0a7888d854bc4
msgid "TECS\\_PITCH\\_MIN: Minimum pitch in auto flight"
msgstr ""

#: ../../source/docs/parameters.rst:134087
#: a68e9799c7b54116984af548a0ec41c8
msgid "Overrides PTCH\\_LIM\\_MIN\\_DEG in automatic throttle modes to reduce descent rates\\. Uses PTCH\\_LIM\\_MIN\\_DEG if set to 0\\. For proper TECS tuning\\, set to the angle that the aircraft can descend at without overspeeding\\."
msgstr ""

#: ../../source/docs/parameters.rst:134093
#: 6b59844370724c45b97a1c62c6774c1d
msgid "-45 to 0"
msgstr ""

#: ../../source/docs/parameters.rst:134102
#: 60045db7b4e24624b3413d18703ef39d
msgid "TECS\\_LAND\\_SINK: Sink rate for final landing stage"
msgstr ""

#: ../../source/docs/parameters.rst:134106
#: ea3f1936b9a74d2a9a33c08792854057
msgid "The sink rate in meters\\/second for the final stage of landing\\."
msgstr ""

#: ../../source/docs/parameters.rst:134121
#: bbc0c048e57b40b5bed0a1731914bc74
msgid "TECS\\_LAND\\_TCONST: Land controller time constant \\(sec\\)"
msgstr ""

#: ../../source/docs/parameters.rst:134125
#: 534efe4e9be545d88a64196ea73285b7
msgid "This is the time constant of the TECS control algorithm when in final landing stage of flight\\. It should be smaller than TECS\\_TIME\\_CONST to allow for faster flare"
msgstr ""

#: ../../source/docs/parameters.rst:134140
#: c9c73355b8b34c77a9802e6539e5bd3a
msgid "TECS\\_LAND\\_DAMP: Controller sink rate to pitch gain during flare"
msgstr ""

#: ../../source/docs/parameters.rst:134144
#: ad296498e29c43458955213895bf3608
msgid "This is the sink rate gain for the pitch demand loop when in final landing stage of flight\\. It should be larger than TECS\\_PTCH\\_DAMP to allow for better sink rate control during flare\\."
msgstr ""

#: ../../source/docs/parameters.rst:134159
#: 82bd4c2b28da4870aa6e31baa0c6902a
msgid "TECS\\_LAND\\_PMAX: Maximum pitch during final stage of landing"
msgstr ""

#: ../../source/docs/parameters.rst:134163
#: 199f4e89837f46a898d428a22bfb693f
msgid "This limits the pitch used during the final stage of automatic landing\\. During the final landing stage most planes need to keep their pitch small to avoid stalling\\. A maximum of 10 degrees is usually good\\. A value of zero means to use the normal pitch limits\\."
msgstr ""

#: ../../source/docs/parameters.rst:134169
#: 5d8c8232671a405e9ac0e3ee078fc796
msgid "-5 to 40"
msgstr ""

#: ../../source/docs/parameters.rst:134178
#: ed7e1516adf241b19bd3522f41c67781
msgid "TECS\\_APPR\\_SMAX: Sink rate max for landing approach stage"
msgstr ""

#: ../../source/docs/parameters.rst:134182
#: 1b26649a24f7457980309773f37c81b4
msgid "The sink rate max for the landing approach stage of landing\\. This will need to be large for steep landing approaches especially when using reverse thrust\\. If 0\\, then use TECS\\_SINK\\_MAX\\."
msgstr ""

#: ../../source/docs/parameters.rst:134197
#: 4b8ec89bc8f648a99aefdbc0b2f9f363
msgid "TECS\\_LAND\\_SRC: Land sink rate change"
msgstr ""

#: ../../source/docs/parameters.rst:134201
#: cb0cc659957c4507b62fb45c577716e6
msgid "When zero\\, the flare sink rate \\(TECS\\_LAND\\_SINK\\) is a fixed sink demand\\. With this enabled the flare sink rate will increase\\/decrease the flare sink demand as you get further beyond the LAND waypoint\\. Has no effect before the waypoint\\. This value is added to TECS\\_LAND\\_SINK proportional to distance traveled after wp\\. With an increasing sink rate you can still land in a given distance if you\\'re traveling too fast and cruise passed the land point\\. A positive value will force the plane to land sooner proportional to distance passed land point\\. A negative number will tell the plane to slowly climb allowing for a pitched\\-up stall landing\\. Recommend 0\\.2 as initial value\\."
msgstr ""

#: ../../source/docs/parameters.rst:134207
#: c2d01971484c4cc0813b611b0dbefbe9
msgid "-2.0 to 2.0"
msgstr ""

#: ../../source/docs/parameters.rst:134207
#: ea2c25a2bb0b423eab4a61da694c0948
msgid "meters per second per meter"
msgstr ""

#: ../../source/docs/parameters.rst:134216
#: 0d4a39e88c544c0293c4b57852bcbad5
msgid "TECS\\_LAND\\_TDAMP: Controller throttle damping when landing"
msgstr ""

#: ../../source/docs/parameters.rst:134220
#: e308a0160ee748dfb6a9aedb0808dfce
msgid "Damping gain for the throttle demand loop during an auto\\-landing\\. Same as TECS\\_THR\\_DAMP but only in effect during an auto\\-land\\. Increase to add throttle activity to dampen oscillations in speed and height\\. When set to 0 landing throttle damping is controlled by TECS\\_THR\\_DAMP\\."
msgstr ""

#: ../../source/docs/parameters.rst:134235
#: 1054d37c7a964c7d831693962f11b278
msgid "TECS\\_LAND\\_IGAIN: Controller integrator during landing"
msgstr ""

#: ../../source/docs/parameters.rst:134239
#: 170dae89e5b749abad49dc65bd7738b2
msgid "This is the integrator gain on the control loop during landing\\. When set to 0 then TECS\\_INTEG\\_GAIN is used\\. Increase to increase the rate at which speed and height offsets are trimmed out\\. Typically values lower than TECS\\_INTEG\\_GAIN work best"
msgstr ""

#: ../../source/docs/parameters.rst:134254
#: d2c29f55469b4ca5bdc8ef344bcf1974
msgid "TECS\\_TKOFF\\_IGAIN: Controller integrator during takeoff"
msgstr ""

#: ../../source/docs/parameters.rst:134258
#: b7573f361a0847d5a9811ff66c343bc7
msgid "This is the integrator gain on the control loop during takeoff\\. Increase to increase the rate at which speed and height offsets are trimmed out\\."
msgstr ""

#: ../../source/docs/parameters.rst:134273
#: 5f00aaada3f548cc83440ddb4fee9909
msgid "TECS\\_LAND\\_PDAMP: Pitch damping gain when landing"
msgstr ""

#: ../../source/docs/parameters.rst:134277
#: 572e50b5615542a7aab5076cf5d47642
msgid "This is the damping gain for the pitch demand loop during landing\\. Increase to add damping  to correct for oscillations in speed and height\\. If set to 0 then TECS\\_PTCH\\_DAMP will be used instead\\."
msgstr ""

#: ../../source/docs/parameters.rst:134292
#: 69be272294c04d50b12847044b380de4
msgid "TECS\\_SYNAIRSPEED: Enable the use of synthetic airspeed"
msgstr ""

#: ../../source/docs/parameters.rst:134296
#: b8a5ffe4df284a70ab26b79940f1496d
msgid "This enables the use of synthetic airspeed in TECS for aircraft that don\\'t have a real airspeed sensor\\. This is useful for development testing where the user is aware of the considerable limitations of the synthetic airspeed system\\, such as very poor estimates when a wind estimate is not accurate\\. Do not enable this option unless you fully understand the limitations of a synthetic airspeed estimate\\. This option has no effect if a healthy airspeed sensor is being used for airspeed measurements\\."
msgstr ""

#: ../../source/docs/parameters.rst:134318
#: e89e4feb78474b4faaaaf5a86cf512d6
msgid "TECS\\_OPTIONS: Extra TECS options"
msgstr ""

#: ../../source/docs/parameters.rst:134322
#: 92e89cf74f4343cd973510e39d1bc48d
msgid "This allows the enabling of special features in the speed\\/height controller\\."
msgstr ""

#: ../../source/docs/parameters.rst:134331
#: 859d03f8d3284d4fa4b505369d485757
msgid "GliderOnly"
msgstr ""

#: ../../source/docs/parameters.rst:134333
#: f949e37324b44639b28e7d13c9c38fa3
msgid "AllowDescentSpeedup"
msgstr ""

#: ../../source/docs/parameters.rst:134344
#: 0d2ff6ba6ae74c9db61242c37f152917
msgid "TECS\\_PTCH\\_FF\\_V0: Baseline airspeed for pitch feed\\-forward\\."
msgstr ""

#: ../../source/docs/parameters.rst:134348
#: b149efcaf4d247a2919a938c56fc19bc
msgid "This parameter sets the airspeed at which no feed\\-forward is applied between demanded airspeed and pitch\\. It should correspond to the airspeed in metres per second at which the plane glides at neutral pitch including STAB\\_PITCH\\_DOWN\\."
msgstr ""

#: ../../source/docs/parameters.rst:134354
#: ef930e9342c347bf9cb02fbdfdb7a6cc
msgid "5.0 to 50.0"
msgstr ""

#: ../../source/docs/parameters.rst:134363
#: 514e1473b0434bd78d1425ece37aba53
msgid "TECS\\_PTCH\\_FF\\_K: Gain for pitch feed\\-forward\\."
msgstr ""

#: ../../source/docs/parameters.rst:134367
#: 4fa4eb11888e4ea7b627b1d4aa6cc6b9
