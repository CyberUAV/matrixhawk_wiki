#: ../../source/docs/parameters.rst:136832
#: 3278a457afb842e5827f2bda07a61d89
msgid "TERRAIN\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:136838
#: 3c199a36d490454fa2eeae9100f29f32
msgid "TERRAIN\\_ENABLE: Terrain data enable"
msgstr ""

#: ../../source/docs/parameters.rst:136842
#: a90b5852ea3147998a91a92a7d3bdacf
msgid "enable terrain data\\. This enables the vehicle storing a database of terrain data on the SD card\\. The terrain data is requested from the ground station as needed\\, and stored for later use on the SD card\\. To be useful the ground station must support TERRAIN\\_REQUEST messages and have access to a terrain database\\, such as the SRTM database\\."
msgstr ""

#: ../../source/docs/parameters.rst:136864
#: a62304f423854fe7b0da76bc689883df
msgid "TERRAIN\\_SPACING: Terrain grid spacing"
msgstr ""

#: ../../source/docs/parameters.rst:136868
#: 3b3bc95c08c1479f8f54763ae27e4c71
msgid "Distance between terrain grid points in meters\\. This controls the horizontal resolution of the terrain data that is stored on te SD card and requested from the ground station\\. If your GCS is using the ArduPilot SRTM database like Mission Planner or MAVProxy\\, then a resolution of 100 meters is appropriate\\. Grid spacings lower than 100 meters waste SD card space if the GCS cannot provide that resolution\\. The grid spacing also controls how much data is kept in memory during flight\\. A larger grid spacing will allow for a larger amount of data in memory\\. A grid spacing of 100 meters results in the vehicle keeping 12 grid squares in memory with each grid square having a size of 2\\.7 kilometers by 3\\.2 kilometers\\. Any additional grid squares are stored on the SD once they are fetched from the GCS and will be loaded as needed\\."
msgstr ""

#: ../../source/docs/parameters.rst:136883
#: a6262da317cc450f94bb574404212c50
msgid "TERRAIN\\_OPTIONS: Terrain options"
msgstr ""

#: ../../source/docs/parameters.rst:136887
#: b900e631f001484a93cbd0c9dd01a89f
msgid "Options to change behaviour of terrain system"
msgstr ""

#: ../../source/docs/parameters.rst:136896
#: f280f1f5eddf49e4b2810a3c5dca85f3
msgid "Disable Download"
msgstr ""

#: ../../source/docs/parameters.rst:136898
#: 96b85ba36655485b993cadb50d470e01
msgid "Disable Disk"
msgstr ""

#: ../../source/docs/parameters.rst:136909
#: e2b4246c2ad3477f97fe6b413ee75d5c
msgid "TERRAIN\\_MARGIN: Acceptance margin"
msgstr ""

#: ../../source/docs/parameters.rst:136913
#: 1678b7894d1b4aa6be764cb6b25147cf
msgid "Margin in centi\\-meters to accept terrain data from the GCS\\. This can be used to allow older terrain data generated with less accurate latitude\\/longitude scaling to be used"
msgstr ""

#: ../../source/docs/parameters.rst:136919
#: e2992ae6b8bc4d2a8227f1847c78ce20
msgid "0.05 to 50000"
msgstr ""

#: ../../source/docs/parameters.rst:136928
#: 4b33018b5a5443eb81c2d031f910d43c
msgid "TERRAIN\\_OFS\\_MAX: Terrain reference offset maximum"
msgstr ""

#: ../../source/docs/parameters.rst:136932
#: 50f0c1a0ee4c4339b8f6ae0f23e694db
msgid "The maximum adjustment of terrain altitude based on the assumption that the vehicle is on the ground when it is armed\\. When the vehicle is armed the location of the vehicle is recorded\\, and when terrain data is available for that location a height adjustment for terrain data is calculated that aligns the terrain height at that location with the altitude recorded at arming\\. This height adjustment is applied to all terrain data\\. This parameter clamps the amount of adjustment\\. A value of zero disables the use of terrain height adjustment\\."
msgstr ""

#: ../../source/docs/parameters.rst:136947
#: 2181aeb4713b4c359b94cd5879b22bcd
msgid "TERRAIN\\_CACHE\\_SZ: Terrain cache size"
msgstr ""

#: ../../source/docs/parameters.rst:136951
#: 9da534a7935c45fb805ae54b540174ee
msgid "The number of 32x28 cache blocks to keep in memory\\. Each block uses about 1800 bytes of memory"
msgstr ""

#: ../../source/docs/parameters.rst:136957
#: 9274f5d6a4064719b4f536ebc53672f1
msgid "0 to 128"
msgstr ""

#: ../../source/docs/parameters.rst:136967
#: 5547c4f8477d4cb3b27f2ba0521c95d6
msgid "TKOFF\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:136973
#: 8e971760386742898a16ad2f5d8ec732
msgid "TKOFF\\_ALT: Takeoff mode altitude"
msgstr ""

#: ../../source/docs/parameters.rst:136976
#: 0c1fde44a2a44105b0b4a7036b0c8e67
msgid "This is the target altitude for TAKEOFF mode"
msgstr ""

#: ../../source/docs/parameters.rst:136991
#: 59331a8f970646778f63ee2654fe701b
msgid "TKOFF\\_LVL\\_ALT: Takeoff mode altitude level altitude"
msgstr ""

#: ../../source/docs/parameters.rst:136994
#: 3946219c4e57439194662a69db05db83
msgid "This is the altitude below which the wings are held level for TAKEOFF and AUTO modes\\. Below this altitude\\, roll demand is restricted to LEVEL\\_ROLL\\_LIMIT\\. Normal\\-flight roll restriction resumes above TKOFF\\_LVL\\_ALT\\*3 or TKOFF\\_ALT\\, whichever is lower\\. Roll limits are scaled while between TKOFF\\_LVL\\_ALT and those altitudes for a smooth transition\\."
msgstr ""

#: ../../source/docs/parameters.rst:137009
#: 459a6264204941ddbce99ba1ebf39025
msgid "TKOFF\\_LVL\\_PITCH: Takeoff mode altitude initial pitch"
msgstr ""

#: ../../source/docs/parameters.rst:137012
#: 269a282d3cd24b139d22264f7a84ce55
msgid "This is the target pitch during the takeoff\\."
msgstr ""

#: ../../source/docs/parameters.rst:137027
#: 5988b40add71490f92064fa7b1fb7703
msgid "TKOFF\\_DIST: Takeoff mode distance"
msgstr ""

#: ../../source/docs/parameters.rst:137030
#: 79797228a31141eb9ad143a631750845
msgid "This is the distance from the takeoff location where the plane will loiter\\. The loiter point will be in the direction of takeoff \\(the direction the plane is facing when the plane begins takeoff\\)"
msgstr ""

#: ../../source/docs/parameters.rst:137045
#: d39b5dee469c451cb1903c11e8b78e1c
msgid "TKOFF\\_GND\\_PITCH: Takeoff run pitch demand"
msgstr ""

#: ../../source/docs/parameters.rst:137048
#: 7ccf150a3aa241a890ee5ab11b0fc3c8
msgid "Degrees of pitch angle demanded during the takeoff run before speed reaches TKOFF\\_ROTATE\\_SPD\\. For taildraggers set to 3\\-point ground pitch angle and use TKOFF\\_TDRAG\\_ELEV to prevent nose tipover\\. For nose\\-wheel steer aircraft set to the ground pitch angle and if a reduction in nose\\-wheel load is required as speed rises\\, use a positive offset in TKOFF\\_GND\\_PITCH of up to 5 degrees above the angle on ground\\, starting at the measured pitch angle and incrementing in 1 degree steps whilst checking for premature rotation and takeoff with each increment\\. To increase nose\\-wheel load\\, use a negative TKOFF\\_TDRAG\\_ELEV and refer to notes on TKOFF\\_TDRAG\\_ELEV before making adjustments\\."
msgstr ""

#: ../../source/docs/parameters.rst:137054
#: 7ec5acf185934ab7adcb678fc89cf502
msgid "-5.0 to 10.0"
msgstr ""

#: ../../source/docs/parameters.rst:137064
#: 689b36f7dd404f9ba107e23a56473020
msgid "TUNE\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:137070
#: 72fc8a2fa5e442cab74b2ee96d77de23
msgid "TUNE\\_PARAM: Transmitter tuning parameter or set of parameters"
msgstr ""

#: ../../source/docs/parameters.rst:137073
#: 126f200ef2df4f32a96b38fe3d5afd91
msgid "This sets which parameter or set of parameters will be tuned\\. Values greater than 100 indicate a set of parameters rather than a single parameter\\. Parameters less than 50 are for QuadPlane vertical lift motors only\\."
msgstr ""

