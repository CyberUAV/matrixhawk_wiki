#: ../../source/docs/parameters.rst:137181
#: ae0de898ea06429585713bc06054ea5b
msgid "TUNE\\_CHAN: Transmitter tuning channel"
msgstr ""

#: ../../source/docs/parameters.rst:137184
#: 838067bf6f2e4399b23df69aebde5536
msgid "This sets the channel for transmitter tuning\\. This should be connected to a knob or slider on your transmitter\\. It needs to be setup to use the PWM range given by TUNE\\_CHAN\\_MIN to TUNE\\_CHAN\\_MAX"
msgstr ""

#: ../../source/docs/parameters.rst:137228
#: 92eaadc739c641cdabf34297f3f874e5
msgid "TUNE\\_CHAN\\_MIN: Transmitter tuning channel minimum pwm"
msgstr ""

#: ../../source/docs/parameters.rst:137231
#: c0728c894db0480ea881c06f3f587830
msgid "This sets the PWM lower limit for the tuning channel"
msgstr ""

#: ../../source/docs/parameters.rst:137246
#: 214340a8b26545a18384050fc7bad739
msgid "TUNE\\_CHAN\\_MAX: Transmitter tuning channel maximum pwm"
msgstr ""

#: ../../source/docs/parameters.rst:137249
#: b07444a5737c4a75974034fbbebab87c
msgid "This sets the PWM upper limit for the tuning channel"
msgstr ""

#: ../../source/docs/parameters.rst:137264
#: 7ce21aadf3bd40b0aa52672aa706226d
msgid "TUNE\\_SELECTOR: Transmitter tuning selector channel"
msgstr ""

#: ../../source/docs/parameters.rst:137267
#: 48e6bf831f284102bf1b8e50ed2623e1
msgid "This sets the channel for the transmitter tuning selector switch\\. This should be a 2 position switch\\, preferably spring loaded\\. A PWM above 1700 means high\\, below 1300 means low\\. If no selector is set then you won\\'t be able to switch between parameters during flight or re\\-center the tuning knob"
msgstr ""

#: ../../source/docs/parameters.rst:137319
#: f37674581baf44c1a4da713a95650dcf
msgid "TUNE\\_RANGE: Transmitter tuning range"
msgstr ""

#: ../../source/docs/parameters.rst:137322
#: 073e98e152ff448ea5f133776d2542a2
msgid "This sets the range over which tuning will change a parameter\\. A value of 2 means the tuning parameter will go from 0\\.5 times the start value to 2x the start value over the range of the tuning channel"
msgstr ""

#: ../../source/docs/parameters.rst:137328
#: a40670b154614c1aabc312ae3625d647
msgid "TUNE\\_MODE\\_REVERT: Revert on mode change"
msgstr ""

#: ../../source/docs/parameters.rst:137331
#: def593ee72394ec0b47d7e86526ec32b
msgid "This controls whether tuning values will revert on a flight mode change\\."
msgstr ""

#: ../../source/docs/parameters.rst:137353
#: 86950adf3c6747b38f2673859fed78a4
msgid "TUNE\\_ERR\\_THRESH: Controller error threshold"
msgstr ""

#: ../../source/docs/parameters.rst:137356
#: 5498bbd777cd48afa7c547b16dc3ee89
msgid "This sets the controller error threshold above which an alarm will sound and a message will be sent to the GCS to warn of controller instability while tuning\\. The error is the rms value of the P\\+D corrections in the loop\\. High values in hover indicate possible instability due to too high PID gains or excessively high D to P gain ratios\\.\\-1 will disable this message\\."
msgstr ""

