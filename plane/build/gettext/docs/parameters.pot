#: ../../source/docs/parameters.rst:850
#: 9be44737b36b4ce1af6caeac81118ce1
msgid "THR\\_MIN: Minimum Throttle"
msgstr ""

#: ../../source/docs/parameters.rst:853
#: 885d7b78ab094c489ac2ddca649b4615
msgid "Minimum throttle percentage used in all modes except manual\\, provided THR\\_PASS\\_STAB is not set\\. Negative values allow reverse thrust if hardware supports it\\."
msgstr ""

#: ../../source/docs/parameters.rst:868
#: b63b0d8e8ba246099b00cf6e74763c7a
msgid "THR\\_MAX: Maximum Throttle"
msgstr ""

#: ../../source/docs/parameters.rst:871
#: 864cd86be86a4532a2a604a13763f8a8
msgid "Maximum throttle percentage used in all modes except manual\\, provided THR\\_PASS\\_STAB is not set\\."
msgstr ""

#: ../../source/docs/parameters.rst:886
#: 438d050daaee464f85e5dc025f723a3c
msgid "TKOFF\\_THR\\_MAX: Maximum Throttle for takeoff"
msgstr ""

#: ../../source/docs/parameters.rst:890
#: 564ffdc9bcda4c248b9cc697bee83a7b
msgid "The maximum throttle setting during automatic takeoff\\. If this is zero then THR\\_MAX is used for takeoff as well\\."
msgstr ""

#: ../../source/docs/parameters.rst:905
#: 8e03744f3d8f470aa65f8f415abb36fb
msgid "THR\\_SLEWRATE: Throttle slew rate"
msgstr ""

#: ../../source/docs/parameters.rst:908
#: 63c1bb3e5c9b4b538e80686b3cb9ca12
msgid "Maximum change in throttle percentage per second\\. Lower limit  based on 1 microsend of servo increase per loop\\. Divide SCHED\\_LOOP\\_RATE by approximately 10 to determine minimum achievable value\\."
msgstr ""

#: ../../source/docs/parameters.rst:923
#: 43f8931087674a7b8f4b685b2397960d
msgid "FLAP\\_SLEWRATE: Flap slew rate"
msgstr ""

#: ../../source/docs/parameters.rst:927
#: 6a33307488dd4c4c94e213d121c19088
msgid "maximum percentage change in flap output per second\\. A setting of 25 means to not change the flap by more than 25\\% of the full flap range in one second\\. A value of 0 means no rate limiting\\."
msgstr ""

#: ../../source/docs/parameters.rst:942
#: 52500ab288924828a1f0d4082af1cc69
msgid "THR\\_SUPP\\_MAN: Throttle suppress manual passthru"
msgstr ""

#: ../../source/docs/parameters.rst:946
#: 047a4a8eac894448aeebc9874622e171
msgid "When throttle is suppressed in auto mode it is normally forced to zero\\. If you enable this option\\, then while suppressed it will be manual throttle\\. This is useful on petrol engines to hold the idle throttle manually while waiting for takeoff"
msgstr ""

#: ../../source/docs/parameters.rst:968
#: 301adab15744428c8ddc75402f49fae3
msgid "THR\\_PASS\\_STAB: Throttle passthru in stabilize"
msgstr ""

#: ../../source/docs/parameters.rst:972
#: 3951b2119dbc425996e96442088391c0
msgid "If this is set then when in STABILIZE\\, FBWA or ACRO modes the throttle is a direct passthru from the transmitter\\. This means the THR\\_MIN and THR\\_MAX settings are not used in these modes\\. This is useful for petrol engines where you setup a throttle cut switch that suppresses the throttle below the normal minimum\\."
msgstr ""

#: ../../source/docs/parameters.rst:994
#: 352acd1159d245cf96db90e3c2968a2d
msgid "THR\\_FAILSAFE: Throttle and RC Failsafe Enable"
msgstr ""

#: ../../source/docs/parameters.rst:997
#: 9cc3675f56cb4881bec4535d253a8973
msgid "0 disables the failsafe\\. 1 enables failsafe on loss of RC input\\. This is detected either by throttle values below THR\\_FS\\_VALUE\\, loss of receiver valid pulses\\/data\\, or by the FS bit in receivers that provide it\\, like SBUS\\. A programmable failsafe action will occur and RC inputs\\, if present\\, will be ignored\\. A value of 2 means that the RC inputs won\\'t be used when RC failsafe is detected by any of the above methods\\, but it won\\'t trigger an RC failsafe action\\."
msgstr ""

#: ../../source/docs/parameters.rst:1010
#: 22b8b203fed34dbdacfbe5d7df4cc830
msgid "EnabledNoFailsafe"
msgstr ""

#: ../../source/docs/parameters.rst:1021
#: 8bd416a9555f4dee8318d9bc84bb1d5a
msgid "THR\\_FS\\_VALUE: Throttle Failsafe Value"
msgstr ""

#: ../../source/docs/parameters.rst:1024
#: 0b048df338f54a999e140161e5a54010
msgid "The PWM level on the throttle input channel below which throttle failsafe triggers\\. Note that this should be well below the normal minimum for your throttle channel\\."
msgstr ""

#: ../../source/docs/parameters.rst:1030
#: 79138e1099ec466dafcd725ca184aca7
msgid "925 to 2200"
msgstr ""

#: ../../source/docs/parameters.rst:1039
#: 850c200bd3db435394b0fcbd20f9c49e
msgid "TRIM\\_THROTTLE: Throttle cruise percentage"
msgstr ""

#: ../../source/docs/parameters.rst:1042
#: 367e54dd63fe4bb8a0f6e56c77a08c46
msgid "Target percentage of throttle to apply for flight in automatic throttle modes and throttle percentage that maintains AIRSPEED\\_CRUISE\\. Caution\\: low battery voltages at the end of flights may require higher throttle to maintain airspeed\\."
msgstr ""

#: ../../source/docs/parameters.rst:1057
#: a1f84a01812c4905afb5da72cbff2299
msgid "THROTTLE\\_NUDGE: Throttle nudge enable"
msgstr ""

#: ../../source/docs/parameters.rst:1060
#: ead08d4441784003ae54b881184c9d9a
msgid "When enabled\\, this uses the throttle input in auto\\-throttle modes to \\'nudge\\' the throttle or airspeed to higher or lower values\\. When you have an airspeed sensor the nudge affects the target airspeed\\, so that throttle inputs above 50\\% will increase the target airspeed from AIRSPEED\\_CRUISE up to a maximum of AIRSPEED\\_MAX\\. When no airspeed sensor is enabled the throttle nudge will push up the target throttle for throttle inputs above 50\\%\\."
msgstr ""

#: ../../source/docs/parameters.rst:1082
#: 79478bc1858045a88ac6c7986d3300a9
msgid "FS\\_SHORT\\_ACTN: Short failsafe action"
msgstr ""

#: ../../source/docs/parameters.rst:1085
#: 6c92371ff928427b8402863099bb7966
msgid "The action to take on a short failsafe event\\. A short failsafe event can be triggered instantly by loss of RC control or by throttle value \\(see THR\\_FS\\_VALUE\\)\\. If in CIRCLE or RTL mode this parameter is ignored\\. A short failsafe event in stabilization and manual modes will cause a change to CIRCLE mode if FS\\_SHORT\\_ACTN is 0 or 1\\, a change to FBWA mode with zero throttle if FS\\_SHORT\\_ACTN is 2\\, and a change to FBWB mode if FS\\_SHORT\\_ACTN is 4\\. In all other modes \\(AUTO\\, GUIDED and LOITER\\) a short failsafe event will cause no mode change if FS\\_SHORT\\_ACTN is set to 0\\, will cause a change to CIRCLE mode if set to 1\\, will change to FBWA mode with zero throttle if set to 2\\, or will change to FBWB if set to 4\\. Please see the documentation for FS\\_LONG\\_ACTN for the behaviour after FS\\_LONG\\_TIMEOUT seconds of failsafe\\. This parameter only applies to failsafes during fixed wing modes\\. Quadplane modes will switch to QLAND unless Q\\_OPTIONS bit 5\\(QRTL\\) or 20\\(RTL\\) are set\\."
msgstr ""

#: ../../source/docs/parameters.rst:1094
#: 6c24bb0d948641639d45e6308e7de07c
msgid "CIRCLE/no change(if already in AUTO|GUIDED|LOITER)"
msgstr ""

#: ../../source/docs/parameters.rst:1098
#: b3719f5021e8482ab6fb9f8be0cf9ece
msgid "FBWA at zero throttle"
msgstr ""

