msgstr ""

#: ../../source/docs/parameters.rst:2459
#: fe4df3f1632f405cba1a6e9c57ab186f
msgid "Use centered throttle in Cruise or FBWB to indicate trim airspeed"
msgstr ""

#: ../../source/docs/parameters.rst:2461
