msgstr ""

#: ../../source/docs/parameters.rst:85081
#: 7569347e03884deeb06eaac133ada3ed
msgid "Q\\_BACKTRANS\\_MS: SLT and Tiltrotor back transition pitch limit duration"
msgstr ""

#: ../../source/docs/parameters.rst:85084
