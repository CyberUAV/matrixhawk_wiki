msgid "ALT\\_SLOPE\\_MIN: Altitude slope minimum"
msgstr ""

#: ../../source/docs/parameters.rst:176
#: 275f864a58db4f4293d3b730ee62e6aa
msgid "This controls the minimum altitude change for a waypoint before an altitude slope will be used instead of an immediate altitude change\\. The default value is 15 meters\\, which helps to smooth out waypoint missions where small altitude changes happen near waypoints\\. If you don\\'t want altitude slopes to be used in missions then you can set this to zero\\, which will disable altitude slope calculations\\. Otherwise you can set it to a minimum number of meters of altitude error to the destination waypoint before an altitude slope will be used to change altitude\\."
msgstr ""

