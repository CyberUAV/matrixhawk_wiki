msgstr ""

#: ../../source/docs/parameters.rst:85144
#: f21bd199f8a84553b4fe44d282a1c43d
msgid "Q\\_NAVALT\\_MIN: Minimum navigation altitude"
msgstr ""

#: ../../source/docs/parameters.rst:85148
#: 9e8c4533ad784e0d90565cc39755ef49
msgid "This is the altitude in meters above which navigation begins in auto takeoff\\. Below this altitude the target roll and pitch will be zero\\. A value of zero disables the feature"
