msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:13
#: 8979946ca1de41b8a6af9779d217ed2d
msgid "STREAM RATES"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:14
#: 0137efaaa6e7407da5d39364fafe1308
msgid "The following stream rate parameters can be set for each instance of a MAVLink using serial port to determine how fast data is sent over the port(SERIAL1 will be used in the following as an example)"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:17
#: ae0e0effe8d542798c56b1130cbc76d7
msgid ":ref:`MAV1_ADSB<MAV1_ADSB>`: ADSB stream rate"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:18
#: 6bd798987dc04ffa887b7ea019d75209
msgid ":ref:`MAV1_EXT_STAT<MAV1_EXT_STAT>`: MAVLink Stream rate of SYS_STATUS, POWER_STATUS, MCU_STATUS, MEMINFO, CURRENT_WAYPOINT, GPS_RAW_INT, GPS_RTK (if available), GPS2_RAW_INT (if available), GPS2_RTK (if available), NAV_CONTROLLER_OUTPUT, FENCE_STATUS, and GLOBAL_TARGET_POS_INT"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:19
#: 70bdcaf67e8d4898ab4d448788af2d5a
msgid ":ref:`MAV1_EXTRA1<MAV1_EXTRA1>`: MAVLink Stream rate of ATTITUDE, SIMSTATE (SIM only), AHRS2, RPM, AOA_SSA, LANDING,ESC_TELEMETRY,EFI_STATUS, and PID_TUNING"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:20
#: 63e925056a7d498898475a46204cec7c
msgid ":ref:`MAV1_EXTRA2<MAV1_EXTRA2>`: MAVLink Stream rate of VFR_HUD"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:21
#: bb3c15d594f24822804f4e568e36a00a
msgid ":ref:`MAV1_EXTRA3<MAV1_EXTRA3>`: MAVLink Stream rate of AHRS, SYSTEM_TIME, WIND, RANGEFINDER, DISTANCE_SENSOR, TERRAIN_REQUEST, TERRAIN_REPORT, BATTERY2, GIMBAL_DEVICE_ATTITUDE_STATUS, OPTICAL_FLOW, MAG_CAL_REPORT, MAG_CAL_PROGRESS, EKF_STATUS_REPORT, VIBRATION, and BATTERY_STATUS"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:22
#: cdd89e36b00e40a4aff543e9f8da01c9
msgid ":ref:`MAV1_PARAMS<MAV1_PARAMS>`: MAVLink Stream rate of PARAM_VALUE"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:23
#: f876983e46bb48928d0473546140f3b6
msgid ":ref:`MAV1_POSITION<MAV1_POSITION>`: MAVLink Stream rate of GLOBAL_POSITION_INT and LOCAL_POSITION_NED"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:24
#: 3a327c7e77804068a87c294aea216e56
msgid ":ref:`MAV1_RAW_CTRL<MAV1_RAW_CTRL>`: MAVLink Raw Control stream rate of SERVO_OUT"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:25
#: 7dbdcc1f1c774a86979486093e5b416e
msgid ":ref:`MAV1_RAW_SENS<MAV1_RAW_SENS>`: MAVLink Stream rate of RAW_IMU, SCALED_IMU2, SCALED_IMU3, SCALED_PRESSURE, SCALED_PRESSURE2, SCALED_PRESSURE3 and AIRSPEED"
msgstr ""

#: ../../source/docs/common-mavlink-configuration.rst:26
#: d106632dfb0f4f348c3edf1a6f5daadd
msgid ":ref:`MAV1_RC_CHAN<MAV1_RC_CHAN>`: MAVLink Stream rate of SERVO_OUTPUT_RAW and RC_CHANNELS"
msgstr ""

