#: ../../source/docs/common-paramosd.rst:146
#: 814dd45113ca4aed97360a9a528f6c4c
msgid "Examples"
msgstr ""

#: ../../source/docs/common-paramosd.rst:148
#: 0ad218b29eb845e99d0763cb862563d2
msgid "To set OSD5 parameter1 to TRIM_THROTTLE, type :code:`osd param-show 5 1 TRIM_THROTTLE`"
msgstr ""

#: ../../source/docs/common-paramosd.rst:150
#: 60230e9b1a6e4f4cab178825e4e61deb
msgid "To set OSD6 parameter2 to FLTMODE1 using respective mnemonics, type :code:`osd param-set 6 2 FLTMODE1 FLIGHT_MODE`"
msgstr ""

#: ../../source/docs/common-paramosd.rst:152
#: de2f2d6fd79a4dd3af8f3cc1f28f4c14
msgid "To set OSD5 parameter2 to LIM_ROLL_CD, limiting range from 2000 - 6000 with increments of 100, type :code:`osd param-set 5 2 LIM_ROLL_CD 2000 6000 100`"
msgstr ""

#: ../../source/docs/common-paramosd.rst:154
#: d4fe34dd8add4307b96c78ae69ecf12c
msgid "To show what OSD6 parameter2 is set to, type :code:`osd param-show 6 2`"
msgstr ""

