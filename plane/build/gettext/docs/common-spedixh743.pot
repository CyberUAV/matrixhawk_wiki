#: 65f2c7b2350a4992ac52d4ab4aba5020
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:76
#: 845d406690e54aeaaae04eeb1f447f5b
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11 (CURR pin)"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:77
#: 2ad8cca91fc54dafa570e954f4c23a1f
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 11.0"
msgstr ""

#: ../../source/docs/common-spedixh743.rst:78
#: 14b035f3e18b4728903eefe9bda9570b
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 25 (depends on sensor used)"
msgstr ""

