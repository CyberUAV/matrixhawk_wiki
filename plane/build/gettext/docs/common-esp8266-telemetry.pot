#: 50a67e0143df4e8a8e9177796b5572f6
msgid "open a browser to `192.168.4.1 <http://192.168.4.1/>`__ and a simple web interface will appear like below"
msgstr ""

#: ../../source/docs/common-esp8266-telemetry.rst:108
#: 82d9cc97ecab41e9bcf7c23107681c03
msgid "click on the \"Setup\" link"
msgstr ""

