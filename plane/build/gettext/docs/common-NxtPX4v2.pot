msgstr ""

#: ../../source/docs/common-NxtPX4v2.rst:83
#: 63a7b537f6f0400aac13bd50ee80d8f7
msgid "The default RC input is configured on the UART5 by default. The SBUS pin is inverted and connected to RX5. Non SBUS,  single wire serial inputs can be directly tied to RX5 if SBUS pin is left unconnected. RC could  be applied instead at a different UART port such as UART2, UART4 or UART8, and set the protocol to receive RC data: ``SERIALn_PROTOCOL=23`` and change SERIAL6 _Protocol to something other than '23'."
msgstr ""

#: ../../source/docs/common-NxtPX4v2.rst:85
#: d6ec2c601c254d0a96450eb7cb5b3efc
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-NxtPX4v2.rst:87
#: c02a90835e154376bebe2db01024f668
msgid "FPort requires connection to the Tx5 of the UART and :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-NxtPX4v2.rst:89
#: 71bc625282664e7eac504ec433b4b477
msgid "CRSF/ELRS also requires a TXx5 connection, and automatically provides telemetry. Set  :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` = \"0\"."
msgstr ""

#: ../../source/docs/common-NxtPX4v2.rst:91
#: ff42307b38704d20933147c9065a8206
msgid "SRXL2 requires a connection to Tx5 and automatically provides telemetry.  Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` =  \"4\"."
msgstr ""

