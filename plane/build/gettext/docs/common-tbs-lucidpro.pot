msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:92
#: 269452ae13394c8481fec3cbdf39a9a2
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:93
#: 8ca43784792c4418910d665994fad30d
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:94
#: 6455380ae7ca4e0fa11d7a0ea91ed685
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 20"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:95
#: 8c4878f1f3904402bba8d43fc8a0e6f9
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 40"
msgstr ""

