#: 4c53f798adae4ea3bed31eee9ab365f4
msgid "FPort requires connection to TX2 and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` be set to “7”."
msgstr ""

#: ../../source/docs/common-geprc-taker-h743-bt.rst:52
#: 4a1c5da194bc4237982ed40635c18856
msgid "CRSF also requires a TX2 connection, in addition to R2, and automatically provides telemetry. Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>`"
msgstr ""

#: ../../source/docs/common-geprc-taker-h743-bt.rst:53
#: 132e7b14fd7e4c0190fac237904d3655
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry. Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to “4”. =3."
msgstr ""

