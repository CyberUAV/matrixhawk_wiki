#: ../../source/docs/common-underwater-sonar-analog.rst:5
#: 5a1632038e634200945b3502a7039ecf
msgid "Underwater Sonar (Analog)"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:7
#: 28f9f07e3a264ddaa653607c54b4b134
msgid "This page details the setup of a low-cost analog underwater sonar (aka \"fish finder\") and a digitizer to convert the analog readings into NMEA 0183 which can be read by ardupilot.  This setup allows measuring the depth of the water below a boat.  The sensor described has a maximum claimed a range of 300m and a relatively wide beam of 22deg."
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:9
#: 7946309033084adebc3502219adf010b
msgid "These instructions were provided by `OlavA at the bottom of this ardupilot.org blog post <https://discuss.ardupilot.org/t/mapping-a-lake-with-ardupilot/32401/34>`__"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:13
#: 2d0ca5cfea414fd0822a020df58343a8
msgid "*images courtesy of lowarnace.com and actisense.com*"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:16
#: 22588d9d57d74d62b4606c7578be8b8c
msgid "Recommended Hardware"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:18
#: f7a9fe68aa714a349243b357e3c967fa
msgid "`Lowrance HST-WSBL 83/200 kHz Transom Mount Transducer <https://www.lowrance.com/lowrance/type/sonar-transducers/hst-wsbl/>`__ available from many retailers including `amazon.com <https://www.amazon.com/Lowrance-HST-WSBL-Transom-Mount-Transducer/dp/B000KKB5YK>`__.  Other sensors may also work."
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:19
#: c048d66591e742289c6a2e4d81dab241
msgid "`DST-2 200kHz digitizer <https://www.actisense.com/product/dst-2/>`__ available from `many retailers <https://www.actisense.com/where-to-buy/>`__ including `Navstore.com <https://www.navstore.com/actisense-dst-2-200-active-dst-module-200-khz.html>`__ (`manuals here <http://www.actisense.com/media/?product=dst-2&type=downloads>`__)"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:22
#: e540ed98a0bc49fcbefcd3230f11b01e
msgid "Connecting and Configuring"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:24
#: da650194b5554efe8041ff2c79fb2621
msgid "The image below shows the pin-out of an airmar analog transducer, but the pinout is the same as for the Lowrance HST-WSBL"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:28
#: ad2fe2fc09054f73b70a07089425ed26
msgid "The Lowrance HST-WSBL pins should be connected to the pins on the right side of the DST-2, as shown below.   Note that the Lowrance HST-WSBL does not have a speed sensor so only pins 1 and 4-7 should be connected"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:32
#: 1c0ac70581294aa89d625f88e07ae032
msgid "The DST-2 requires a 10V to 28V power source, meaning it can be powered from a 3S or 4S lipo battery."
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:34
#: b9485c5237974066a39aeb1f0438b8c6
msgid "Next pins on the left side of the DST-2 (serial and RS-232 output) should be connected to the autopilot's telemetry/serial input. The easiest connection method is to connect the DST-2's 5V serial output directly to the telemetry port of the autopilot's Tx, Rx, and common ground.  It is best to check the DST-2 docs before connecting but below shows how the telemetry pins from a Pixhawk (or another autopilot) should be connected to the pins on the left side of the DST-2."
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:38
#: 8802bb18b62349de9167658a7028c7a5
msgid "Connect with a ground station to the autopilot and set the following parameters (these settings assume the first sensor is connected to Telem2/Serial2)"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:40
#: 65b7808101f44e9394df0cb37a4ca273
msgid ":ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:41
#: 325a498e97cc439d9b9795af2b878ffb
msgid ":ref:`SERIAL2_BAUD <SERIAL2_BAUD>` = 4 (4800 baud)"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:43
#: e8a68fe5698c4bb5b4465d127d2b5ccd
msgid "Then the following range finder related parameters should be set:"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:45
#: 5561d6cbfca240f896f72121a8a3f74c
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 17 (NMEA)"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:46
#: 309e4a59d83e4aa2a42fff67a2143a48
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.13"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:47
#: c3af5f801a3a48ab9aaa382061c28bd5
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 300 (i.e. 300m).  *This is the distance in meters that the rangefinder can reliably read.*"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:48
#: 7081ed36e04d4149ae825ecf195d0de6
msgid ":ref:`RNGFND1_ORIENT <RNGFND1_ORIENT>` = 25 (i.e. down) if mounted on a boat"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:51
#: 54e56d518f4449aeafc2186baad1f092
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-underwater-sonar-analog.rst:53
#: 8f1313a3af76436c9558b0a392e1b665
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""
