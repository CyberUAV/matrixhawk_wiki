#: ../../source/docs/common-cheerson-cxof.rst:9
#: 4ce88d15214442e08bc3a615e2d7a964
msgid "The Cheerson CX-OF optical flow sensor is a lightweight and low cost optical flow sensor which can be used to improve horizontal position control especially in GPS denied environments."
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:15
#: eb6a6c2e06234a2eb5901199329e8881
msgid "Where to Buy"
msgstr ""

