#: ../../source/docs/common-longbowf405wing.rst:72
#: 2d728ba3efc5474eae99d8e24c2c3cf8
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:74
#: f58dad9eeb5d4b7e93b4ff62f03f29c8
msgid "RC input is configured on the SBUS pin (inverted and sent to UART2_RX). It supports all RC protocols except serial protocols such as CRSF, ELRS, etc. Those devices can be connected to USART1 TX and RX, instead setting :ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>` = 23."
msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:77
#: 580cb72d7a5348cbaac97bfec1f4d64a
msgid "Fport can be connected to USART1 TX also, but will require an external bi-directional inverter and the :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` = 4 (HalfDuplex) set."
msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:80
#: ed2760be67a04f1b8f708a59742e63c2
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-longbowf405wing.rst:82
#: 2693eb9fc71d44908a108ad2fb65188d
msgid "The LongBowF405WING supports using its internal OSD using OSD_TYPE 1 (MAX7456 driver). External OSD support such DisplayPor is setup by default using UART5. Simultaneous use of the internal OSD and Displayport is allowed. See :ref:`common-msp-osd-overview-4.2` for more info."
msgstr ""

