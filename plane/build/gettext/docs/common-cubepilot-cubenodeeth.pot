msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:18
#: a16e185745f3465fbd7539dedf43cdc1
msgid "The `CubeNode ETH can be purchased from CubePilot resellers <https://www.cubepilot.org/#/reseller/list>`__"
msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:20
#: f89f9f6f0fc942d6a6dc718290719f09
