#: ../../source/docs/common-lightware-lw20-lidar.rst:5
#: 5fe3fad420a046d9bd3445ec6f76b3fd
msgid "LightWare SF20 / LW20"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:7
#: f145f5d59f4946d781046bfca47520a0
msgid "The `Lightware SF20 <https://lightwarelidar.com/shop/sf20-c-100-m/>`__ and `LW20 <https://lightwarelidar.com/shop/lw20-c-100-m/>`__ are small but long range (100m) and accurate range finders. There are two models, the LW20/Ser which uses a serial interface and LW20/I2C which uses an I2C interface."
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:13
#: b5a070bc71c14175803ed8f1092a3e51
msgid "Serial connection"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:15
#: 50f41c01767649189d1dc807630e3453
msgid "For a serial connection you can use any spare UART. Connect the RX line of the UART to the TX line of the Lidar, and the TX line of the UART to the RX line of the Lidar. Also connect the GND and 5V lines. You do not need flow control pins."
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:20
#: 35ce91a3193e43e0a0486dc0850846b5
msgid "The diagram below shows how to connect to SERIAL4."
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:24
#: ../../source/docs/common-lightware-lw20-lidar.rst:52
#: 1dba0e73493849879c97631dce6eba0d
#: 24d1c55d792f45dc9f1555c4292fd186
msgid "If using the caseless SF20 ensure the cable looks like below:"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:28
#: fac9801221e741b58835cfeac39bd6f9
msgid "You then need to setup the serial port and rangefinder parameters. If you have used the SERIAL4/5 port on the Pixhawk then you would set the following parameters if its the first rangefinder in the system (this can be done using the *Mission Planner* **Config/Tuning \\| Full Parameter List** page):"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:33
#: 3d4205c8150c4d5d88cb10c045a545f1
msgid ":ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:34
#: aa7f80fc1ab5476ba0873caae7873337
msgid ":ref:`SERIAL4_BAUD <SERIAL4_BAUD>` = 115 (115200 baud) for newer sensors, 19 (19200 baud) for sensors manufactured before mid 2018"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:35
#: de608c86a4d74e85b6ad78a2ab324bfc
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 8 (LightWareSerial)"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:36
#: ../../source/docs/common-lightware-lw20-lidar.rst:61
#: abe77a40cafe4ebd8456b1d0b15055de
#: 94f751113e904396bf6bae8ec4417d9b
msgid ":ref:`RNGFND1_SCALING <RNGFND1_SCALING>` = 1"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:37
#: ../../source/docs/common-lightware-lw20-lidar.rst:62
#: 09e910bca49b4435a0814675dc944fac
#: 011ae08bda544a2c845a017278ae4ce6
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.05"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:38
#: ../../source/docs/common-lightware-lw20-lidar.rst:63
#: 2f0bc11b9dab49e3975c477a335efa65
#: 1e05473c00df4c2f947ee3a511ad1c35
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = **95**.  *This is the distance in meters that the rangefinder can reliably read.*"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:39
#: ../../source/docs/common-lightware-lw20-lidar.rst:64
#: b41045f123154793bc76836c44a25b0e
#: 872028d97d4a41729af352fff1070859
msgid ":ref:`RNGFND1_GNDCLR <RNGFND1_GNDCLR>` = 0.1 *or more accurately the distance in metres from the range finder to the ground when the vehicle is landed.  This value depends on how you have mounted the rangefinder.*"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:41
#: b9501318caf94866a4ba698feccc896d
msgid "If you instead were using the Telem2 port on the Pixhawk then you would set :ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 9, and :ref:`SERIAL2_BAUD <SERIAL2_BAUD>` to 115 (115200 baud) or 19 (19200 baud)"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:43
#: d95005a043944846998f9bff3bbdd406
msgid "Note that you may need to use a separate 5V power supply for the Lidar on some flight boards. Refer to the power consumption in the manual for the Lidar and the limits for peripheral power on your autopilot."
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:46
#: afe82e089cf54eefa48efe77a6917760
msgid "I2C connection"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:48
#: 5d96bba676ed4e6ab4406a7f93294db3
msgid "Connect the SDA line of the Lidar to the SDA line of the I2C port on the Pixhawk, and the SCL line of the Lidar to the SCL line of the I2C port. Also connect the GND and 5V lines."
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:56
#: c5bdac35a1ec42938e1db2d1eb46dd3f
msgid "You then need to configure the rangefinder parameters as shown below (this cn be done suing the *Mission Planner* **Config/Tuning \\| Full Parameter List** page):"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:59
#: 17ec686aead14f59931d25f77631c6d8
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 7 (LightWareI2C)"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:60
#: 4d585b8ce57748c1a21f7035f8e02759
msgid ":ref:`RNGFND1_ADDR <RNGFND1_ADDR>` = 102 (I2C Address of lidar in decimal).  *Note that this setting is in decimal. The default address is 0x66 hexadecimal which is 102 in decimal.*"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:67
#: 0dabfbf9af664062a78035cf66b71215
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-lightware-lw20-lidar.rst:69
#: cc7e7ec61c1046289ad208f15d5962a2
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""
