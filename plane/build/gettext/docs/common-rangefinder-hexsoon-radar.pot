msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:24
#: 7443d91363504b54bdf9d577781c2480
msgid "Mount the radar to the vehicle so that the radar senses obstacles horizontally.  The power and communication wire should be to the right."
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:30
#: a7fc4aa384154a30bef7567d79764e40
msgid "Connect the radar to the autopilot's CAN port as shown above and set the following parameters assuming the radar is connected to CAN1:"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:32
#: 7d28915b83bc4706b77b4c8b453366dd
msgid ":ref:`CAN_P1_DRIVER <CAN_P1_DRIVER>` = 1 (First CAN driver)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:33
#: 73024e017b124c5290492b0a46c8d3a0
msgid ":ref:`CAN_P1_BITRATE <CAN_P1_BITRATE>` = 500000"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:34
#: a26c14fbd7fe46928d8d60b77a6d638d
msgid ":ref:`CAN_D1_PROTOCOL <CAN_D1_PROTOCOL>` = 14 (RadarCAN)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:35
#: 4cfb2bc454e74b83bd63951a0d654cc7
msgid ":ref:`PRX1_TYPE <PRX1_TYPE>` = 18 (Hexsoon Radar)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:36
#: 5f055dfef74241b09954ac915a66fd0b
msgid ":ref:`PRX1_YAW_CORR <PRX1_YAW_CORR>` = 0 (forward) if the radar is mounted pointing forwards"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:38
#: 17def0d225904dd2bbfa9bd6a28a2fc7
msgid "After setting the above parameters reboot the autopilot"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:41
#: e9d3385726f14b3789ad221eeedb5775
msgid "Connecting Multiple Radar"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:43
#: 0c00de6f50334a81abb7c7979ab81187
msgid "Up to 3 radar may be connected to a single autopilot.  Please follow these steps:"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:45
#: 69b98b386f6446f19255e3afc96bc374
msgid "Connect each radar's GND, CANL and CANH pins to one of the autopilot's CAN ports as shown above"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:46
#: 8784e921f04e40a389db28789b13460e
msgid "Connect each radar's GND and VCC pins to an external BEC providing between 5V and 28V"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:47
#: 57ccee74986144edb0b547e29e7bea31
msgid "Download and run the `configuration tool <http://www.hexsoon.com/en/download/download-11-748.html>`__ to set each radar's ID to a unique number"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:48
#: 1a35acd1da06413eac8eac700ec43614
msgid ":ref:`PRX2_TYPE <PRX2_TYPE>` = 18 (Hexsoon Radar)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:49
#: 9abefd7d4b824a419296be0ee47f42e5
msgid ":ref:`PRX2_YAW_CORR <PRX2_YAW_CORR>` = angle that the 2nd radar is mounted at relative to the forward direction of the vehicle"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:50
#: d5b50fe7ad674bada845bf945be854be
msgid ":ref:`PRX3_TYPE <PRX3_TYPE>` = 18 (Hexsoon Radar)"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:51
