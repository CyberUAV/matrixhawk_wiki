msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:96
#: 979d9ca895ed415db28e85bb5674ce95
msgid "The winch constantly estimates how much line has been deployed and will stop retracting line once this estimated line length has reached zero in order to protect the line from being broken.  This estimate is prone to drift however meaning that you may find it impossible to completely retract the line or (less likely) it may retract too far and break the line.  To avoid these issues the line length estimate should be periodically reset to zero using the following procedure:"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:98
#: 20c57c7125904be7af91dfd3eef74356
msgid "Power on the autopilot and winch"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:99
#: 5c896bc96d434fa08be5adf2fd5dc7b6
msgid "Connect with Mission Planner, open the Setup, Advanced screen and push the \"MAVLink Inspector\" button and check the current line length."
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:100
#: 350fb578e218475e80f4ec337a3335dc
msgid "Retract the line (perhaps using the RC6 tuning knob) to within 20cm or so of the ideal minimum length"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:101
#: 1dca9a8485714a2bb2e784941751b3e6
msgid "Open Mission Planner's Data, Servo/Relay tab, find the row for output 11"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:102
#: a384d96420174bc595987ff6ab2d7d3d
msgid "Push the \"High\" button to simultaneously retract the line and reset the line length to zero"
msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:103
#: 6758e45139d7401fa71a0f7034b29a82
msgid "Push the \"Low\" button to retracting the line"
msgstr ""

