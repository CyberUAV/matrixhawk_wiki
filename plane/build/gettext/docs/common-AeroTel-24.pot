msgstr ""

#: ../../source/docs/common-AeroTel-24.rst:30
#: 076c2b99bdd24c6ba14600d1a5f24680
msgid "**Connector:** JST-GH 6-Pin (Standard Telemetry)"
msgstr ""

#: ../../source/docs/common-AeroTel-24.rst:31
#: 113d50d621704d948cfa0bcf887a06eb
msgid "**Range:** > 300m (Standard WiFi) / > 1km (ESP-NOW Long Range)"
msgstr ""

