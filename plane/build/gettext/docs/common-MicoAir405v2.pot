#: ../../source/docs/common-MicoAir405v2.rst:81
#: ec8711ea838d42ecaab5a92e598f3eae
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-MicoAir405v2.rst:83
#: b28ffb67db434148b0bfafa834b29035
msgid "The default RC input is SBUS only on SBUS pin. PPM is not supported. Other RC protocols must use another UART port such as UART1 or UART4, and set its protocol to receive RC data: ``SERIALx_PROTOCOL=23`` and change :ref:`SERIAL6_PROTOCOL<SERIAL6_PROTOCOL>` to something other than its default protocol of '23'. If using CRSF/ELRS, UART1 should be used since it has full DMA. If using another UART for RC input:"
msgstr ""

#: ../../source/docs/common-MicoAir405v2.rst:85
#: 30adb2b250cf445b9b49f33e033ac0fb
msgid "FPort requires connection to the TX of the UART and ``SERIALx_OPTIONS`` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-MicoAir405v2.rst:87
#: 308eb77b6f524b4b9d22714c5915ea1e
msgid "CRSF also requires a TX connection, and automatically provides telemetry. Set ``SERIALx_OPTIONS`` to \"0\"."
msgstr ""

#: ../../source/docs/common-MicoAir405v2.rst:89
#: 1ddcb9929c704a5ebe82d5e5a28ffbb6
msgid "SRXL2 requires a connection to TX and automatically provides telemetry.  Set ``SERIALx_OPTIONS>`` to \"4\"."
msgstr ""

#: ../../source/docs/common-MicoAir405v2.rst:92
#: 1b1cd2d94cfb42eea76bb91c82b39cf6
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-MicoAir405v2.rst:94
#: 378d29db98d046e0bb725f728b4e052c
msgid "The MicoAir405v2 supports analog OSD using OSD_TYPE 1 (MAX7456 driver) using the CAM and VTX connectors. DisplayPort HD OSD via the DJI connector is enabled simultaneously by :ref:`OSD_TYPE2<OSD_TYPE2>` = 5."
msgstr ""

#: ../../source/docs/common-MicoAir405v2.rst:97
#: 3c30690145de4b7e839a75d2d4ed3a57
msgid "HD VTX Support"
msgstr ""

#: ../../source/docs/common-MicoAir405v2.rst:99
#: 146430e05ddf4f01bfd887260765e0d9
msgid "The SH1.0-6P connector supports a standard DJI HD VTX connection. Pin 1 of the connector is 9v so be careful not to connect this to a peripheral requiring 5v."
msgstr ""

