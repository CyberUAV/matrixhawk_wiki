#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:31
#: 9520a55fe3674a9ea674e65dc6270d5f
msgid "Uploading as Custom Firmware"
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:33
#: e8f2dc8838d94c628f2495a8524c5280
msgid "connect the ground station PC to the autopilot using a USB cable"
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:34
#: 4775fb3ec46e47efa540ae8653394ab4
msgid "select the COM port and baud rate (normally 115200) for the board.  If using the Mission Planner these are selected on the top right of the screen.  Do **not** press the Connect button"
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:35
#: 23ae8cfb7e0a4eb08685fc414d578f1f
msgid "go to the GCS's firmware install screen.  If using the Mission Planner select \"Initial Setup >> Install Firmware\""
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:36
#: ca793ea3179b41b7b172f7ddab146fab
msgid "click the \"Load custom firmware\" link and select the .apj file downloaded above.  If using the Mission Planner and the \"Load custom firmware\" link is not visible select \"Config/Tuning >> Planner\" and set the \"Layout\" drop-down to \"Advanced\"."
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:42
#: f1f195e412b347c5b2003f9463a0484b
msgid "following any instructions displayed regarding plugging/unplugging the board"
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:43
#: 0d62df3509414023b84476ac2a220a97
msgid "if all goes well some status should be displayed at the bottom of the screen.  i.e. \"erase...\", \"program...\", \"verify..\" and \"Upload Done\"."
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:46
#: e14cceada7134b6aae093c6593857d29
msgid "Testing"
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:48
#: a9b7de0c57794a7d9cae46f0b0bcc492
msgid "open the ground stations's flight data screen"
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:49
#: c75402665bf7401985f647b5fbb71e40
msgid "select the COM port (which will have changed compared to the NuttX versions) and baud (normally 115200)"
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:50
#: 7203549bc0b743a3b5c94d40160829d0
msgid "press the **Connect** button"
msgstr ""

#: ../../source/docs/common-loading-chibios-firmware-onto-pixhawk.rst:51
#: d75ff74f1fa94cc0a66b0d53cb20fec8
msgid "after parameters are downloaded, the HUD should update as you tilt the board"
msgstr ""

