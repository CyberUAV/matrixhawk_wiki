#: ../../source/docs/common-blitzh743pro.rst:80
#: 289fd5bf8eab4ddeace3c9c8433704ad
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:81
#: 983ab212c22d44afb59b54ff5f6487a0
msgid "RC input is configured on the R2 (UART2_RX) pin. It supports all RC protocols except PPM. See :ref:`common-rc-systems` for details for a specific RC system. :ref:`SERIAL2_PROTOCOL<SERIAL2_PROTOCOL>` is set to \"23\", by default, to enable this."
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:83
#: 7e91621a7183408585b39998f6591d3b
msgid "FPort requires connection to T2 and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:85
#: 30fa8854a3aa47189bacdede01d2fcdc
msgid "CRSF also requires a T2 connection, in addition to R2, and automatically provides telemetry. Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"0\"."
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:87
#: 46a3c25533e34acd99b4a3b8da4256b2
msgid "SRXL2 requires a connection to T2 and automatically provides telemetry.  Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:89
#: 71175d31686e48c68f62dced79ce1bd7
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:92
#: 2d826c2a3fff402fb5d82197c8f6d054
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:94
#: 17bb3fd2eadb46ef9d79470ec66fae1c
msgid "The autopilot  supports OSD using :ref:`OSD_TYPE<OSD_TYPE>` 1 (MAX7456 driver). The defaults are also setup to allow DJI Goggle OSD support on UART4. Both the internal analog OSD and the DisplayPort OSD can be used simultaneously by setting :ref:`OSD_TYPE2<OSD_TYPE2>` = 5"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:98
#: 79cc61adf9744ab69f130ed2ee69bed3
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:99
#: 17e3c9ffc389453f8d549b15fce91117
msgid "The BLITZ H743 Pro has 13 PWM outputs. The first 8 outputs support bi-directional DShot and DShot, as well as all PWM types. Outputs 9-10 support DShot, as well as all PWM types and outputs 11-12 only support PWM. Output 13 is pre-configured for serial LED."
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:101
#: 970531ae58fe4e46b51c71fa9cba51fd
msgid "The PWM are in in five groups:"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:104
#: ad9ab790cabf4337a0ee30ba98bc2d16
msgid "PWM 1-2 in group1"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:105
#: c68453ee82494e25834a1fb3f5faac88
msgid "PWM 3-6 in group2"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:106
#: c3e9b56ac75d4d6b9c25f0d4ea92f982
msgid "PWM 7-10 in group3"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:107
#: 3aa2bef470d34f4a8f3cf544208e2d00
msgid "PWM 11-12 in group4"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:108
#: ddc8d2967c40435f9254c2ad1ffbfea0
msgid "PWM 13 in group5"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:110
#: 60da09e740ec425c8c02c6cb544cfa0b
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot."
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:114
#: 04a61eee10d749a4ac41f23eb88a6ee0
msgid "for users migrating from BetaflightX quads, the first four outputs M1-M4 have been configured for use with existing motor wiring using these default parameters:"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:116
#: 80e548bfe384459688a3e912cc4cb312
msgid ":ref:`FRAME_CLASS<FRAME_CLASS>` = 1 (Quad)"
msgstr ""

#: ../../source/docs/common-blitzh743pro.rst:117
#: e1f51934e5794d22aeb98d44c04f9f5e
msgid ":ref:`FRAME_TYPE<FRAME_TYPE>` = 12 (BetaFlightX)"
msgstr ""

