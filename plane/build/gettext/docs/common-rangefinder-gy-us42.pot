#: ../../source/docs/common-rangefinder-gy-us42.rst:1
#: cb8ac4cf4174487cbcb12f5534d2c935
msgid ". _common-rangefinder-gy-us42:"
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:5
#: e350c6f60e454b47ba6f54d95a1d8a79
msgid "GY-US42v2 Sonar"
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:9
#: a53b5c1217844b8c9df7e17ac1493e42
msgid "The GY-US042v2 Sonar is a very inexpensive, short range (up to 4m) range finder primarily designed for indoor use but which has been successfully used outdoors on Copter. It does provide more consistent height control below 4m than many barometers."
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:11
#: bdea15fcc1d14fbba1d75e2180bff71d
msgid "This sensor is similar to the :ref:`common-rangefinder-maxbotixi2c`, but has the ability to operate in serial and triggered pulse modes (similar to :ref:`common-rangefinder-hcsr04`) in addition to i2c."
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:13
#: 571a889065bb408ea231d718435fa535
msgid "For I2C mode, set the :ref:`RNGFND1_TYPE<RNGFND1_TYPE>` = “2\" and no bridging of the three solder pads is required."
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:15
#: 2b6d233778d049909426b39e417a0e04
msgid "For Triggered Pulse mode, tie the center pad to \"L\" and set the :ref:`RNGFND1_TYPE<RNGFND1_TYPE>` = “30\"."
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:17
#: 44d84fa3110e4cd182bd38aa80e59960
msgid "For Serial Mode, tie the center pad to \"H\" and set  :ref:`RNGFND1_TYPE<RNGFND1_TYPE>` = “31\". And set the Serial Port used to communicate with it to ``SERIALx_PROTOCOL`` = \"9\" (Rangefinder) and ``SERIALx_BAUD`` = 9 (9600)."
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:19
#: a64519d1facd4054b52f6037b3f072c5
msgid "This device has a maximum useful range of 4m, so set -  :ref:`RNGFND1_MAX<RNGFND1_MAX>` = \"4\"."
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:21
#: 5edf97a455384001baf897f94a0f585b
msgid "Pinout:"
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:23
#: 363bc78ce5cc4b8897a54a25f59d8e83
msgid "\"CR\" pin is either the SCL (I2C mode), Serial RX, or Trigger input"
msgstr ""

#: ../../source/docs/common-rangefinder-gy-us42.rst:24
#: 8a52f776a8604a069f1b6e5ddc4dd570
msgid "\"DT\" pin is either the  SDA (I2C mode), Serail TX, or Echo output"
msgstr ""
