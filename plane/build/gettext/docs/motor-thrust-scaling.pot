#: ../../source/docs/motor-thrust-scaling.rst:5
#: daf7966c732046a39ed06bcc94fe7b6d
msgid "Motor Thrust Scaling"
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:7
#: 3bc8b38dbb244fee85047f1104630fac
msgid "QuadPlane includes *motor thrust scaling* which compensates for the non-linear thrust output of most ESCs and motors used in VTOL."
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:12
#: c709903555d0466c8bcd0c118f0eb654
msgid "The default curve should work for nearly all ESC/motor combinations. Normally the parameters should not be adjusted unless the vehicle’s actual thrust curve has been measured."
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:18
#: e3e3f912a6a1473c8b15c556b2c9fcdd
msgid "Thrust Curves"
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:20
#: fe83a76f0e3d4e5d8154541f816292a9
msgid "The curve is controlled by two parameters:"
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:22
#: f6ca27b9a0d045c8a9e18cfd7d1197cf
msgid ":ref:`Q_M_THST_EXPO<Q_M_THST_EXPO>` controls the shape of the thrust curve with \"0\" meaning a completely linear curve and \"1.0\" being very curved (see pictures below).  The default is \"0.65\" (the image below incorrectly states the default is 0.5)."
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:30
#: a36f0bfacb6e4f3f91466ad347b124c3
msgid ":ref:`Q_M_SPIN_MAX<Q_M_SPIN_MAX>` controls the point at which the thrust flattens out near its maximum.  This is set at 0.95 as default, which means 95% of full throttle."
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:35
#: f74541186f314f258a302aea03a4c4b4
msgid "Thrust Stands"
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:37
#: 34c980feaf884d3aa3dedc85b55b9365
msgid "The thrust stands listed below can be used to measure the PWM signal vs thrust output for a vehicle's specific motor, esc and battery"
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:39
#: 812e8e48e6904b0895d8eff4fd5852b5
msgid "`RCbenchmark.com thrust stands <https://www.rcbenchmark.com/pages/series-1580-thrust-stand-dynamometer>`__"
msgstr ""

#: ../../source/docs/motor-thrust-scaling.rst:40
#: 476147e860694e37a7dec5a58b4b6cda
msgid "`Turnigy thrust stand <https://hobbyking.com/en_us/turnigy-thrust-stand-and-power-analyser-v3.html>`__"
msgstr ""

