msgid "Outputs 5, 6, 7 and 8 in group3"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:86
#: 61f60ab99e7f40138e44bff656af8d9d
msgid "The 8 FMU PWM outputs are in 4 groups:"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:89
#: 22b271925c1b44b984034073a2b18dd6
