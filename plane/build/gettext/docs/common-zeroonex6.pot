#: ../../source/docs/common-zeroonex6.rst:74
#: 90914b01bffe4b83bf2592ab76ca1cf5
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:76
#: b173bc220be44f028e77bb46f152dd87
msgid "The X6 flight controller supports up to 16 PWM outputs. First 8 outputs (labeled 1 to 8) are controlled by a dedicated STM32F103 IO controller. The remaining 8 outputs (labeled 9 to 16) are the \"auxiliary\" outputs. These are directly attached to the STM32H753 FMU controller."
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:78
#: ffdb4c37536c47eebbbe013ccccc6eae
msgid "All 16 outputs support normal PWM output formats. All 16 outputs support DShot, except 15 and 16. Outputs 1-8 support BiDirectional DShot."
msgstr ""

#: ../../source/docs/common-zeroonex6.rst:80
#: 88f389860b7c4f2a93f8a7e4ae0aae19
msgid "The 8 IO PWM outputs are in 4 groups:"
msgstr ""

