#: ../../source/docs/common-matekf765-wing.rst:147
#: 5721982ea2f64280a9efb5787f04c274
msgid "this autopilot uses a high precision current sensor which is sensitive to ESC switching noise. Be sure to use the bypass capacitor provided. In some cases, the ESCs themselves will need additional 200-330uF low ESR capacitors on their power inputs, if they do not incorporate them already. See `Matek FAQs <http://www.mateksys.com/?p=5712#tab-id-12>`__ for more information."
msgstr ""

#: ../../source/docs/common-matekf765-wing.rst:150
#: 81d5bcfa67ee4448b780c1d18264a0e4
msgid "Alternate Configurations"
msgstr ""

#: ../../source/docs/common-matekf765-wing.rst:152
#: 95d1b587db7747de9bc20994211fe770
msgid "set :ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>` to \"1\" to enable RX6 pin as true UART input (see RC Input section above)"
msgstr ""

#: ../../source/docs/common-matekf765-wing.rst:153
#: 1ad059c58a58401287e38ad13eb27376
msgid "set :ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>` to \"2\" to change RTS7 and CTS7 pins to GPIO 1 and 2, respectively."
msgstr ""

#: ../../source/docs/common-matekf765-wing.rst:154
#: e2d3b654ebc24499a78a67907dc05d33
msgid "set :ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>` to \"3\" to enable both of the above."
msgstr ""

