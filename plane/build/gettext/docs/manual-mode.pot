#: ../../source/docs/manual-mode.rst:5
#: 98b130a0bf6a4255bd9881d5b612befa
msgid "MANUAL Mode"
msgstr ""

#: ../../source/docs/manual-mode.rst:7
#: a45dfe25ca904510ac2fc759676a0b55
msgid "Regular RC control, no stabilization. All RC inputs are passed through to the servo outputs set by their SERVOx_FUNCTION."
msgstr ""

#: ../../source/docs/manual-mode.rst:10
#: edab5b96b5cc467a8af2170d5338ff02
msgid "the :ref:`MAN_EXPO_ROLL<MAN_EXPO_ROLL>`, :ref:`MAN_EXPO_PITCH<MAN_EXPO_PITCH>`, and :ref:`MAN_EXPO_RUDDER<MAN_EXPO_RUDDER>` parameters will apply exponential to the stick inputs, if non-zero, in this mode. This is for users with transmitters which do not provide this function and desire to \"soften\" stick feel around neutral."
msgstr ""

#: ../../source/docs/manual-mode.rst:12
#: 93ed3ecd2319407ba85365c5a97fe993
msgid "This assumes that the RC channel is being used as a servo output function instead of one selected by its RCx_OPTION parameter. The only ways in which the input to a servo output function may be different from inputs in this mode is if a configured failsafe or geofence triggers, and Plane takes control."
msgstr ""
