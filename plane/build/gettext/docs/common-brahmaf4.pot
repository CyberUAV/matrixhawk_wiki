msgid "RC Input"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:45
#: a0a8b121b9034182b9f2d94dd0430894
msgid "RC input is configured by default on the R1 and T1 (UART1) pads (CRSF or ELRS). The SBUS pad is inverted and applied to R1."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:47
#: aca8e92194cf44a99fb7abfc457ab64c
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:48
#: 606c3b4cda8a4965be9c2c143c426bef
msgid "FPort requires connection to T1 and :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` be set to “7”."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:49
#: 160ef6d71c1541f2a92265c7ada1cae0
msgid "CRSF also requires a T1 connection, in addition to R1, and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to “0”."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:50
#: 1493d86779db47e7b1b684ef59b53b05
msgid "SRXL2 requires a connection to T1 and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to “4”."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:52
#: ba544be1fe0e4d3d9fb9c6f2e5da0a7d
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`Radio Control Systems <common-rc-systems>` for details."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:55
#: 41c9dca8a9754d029c58b63e9a2e6b98
msgid "OSD"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:56
#: 3ed4ef4c89954e82a87438d6c5242576
