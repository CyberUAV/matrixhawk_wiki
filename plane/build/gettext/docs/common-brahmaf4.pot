msgstr ""

#: ../../source/docs/common-brahmaf4.rst:57
#: 4ad0d6280a6240cba66a34a6f7c0407a
msgid "Simultaneous HD VTX OSD supportcan is configured on UART4 (DisplayPort)."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:60
#: 4594f2a6ad354f999aaff630d7df666b
msgid "PWM Outputs"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:61
#: a4e6ee4a325c4a3386019bf582b2e60c
msgid "The autopilot supports up to 9 PWM outputs (PWM 9 is defaulted to serial LED support). Outputs 1-4 are available via a standard ESC JST-SH connector and solder pads for M5-M8. All outputs support  all PWM types. PWM 1-4 and 6-9 support DShot. PWM 1-4 support bi-directional dshot."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:63
#: ea74f4e1ccdf46b7baf46f9322f75fdf
msgid "The PWM is in 5 groups:"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:66
#: 96631862f5304590a43ff001bdafd0af
msgid "PWM 1,2 in group1"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:67
#: c37b50bf76ca48b191386a8175edb854
msgid "PWM 3,4 in group2"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:68
#: a9e926119d87418c9b860a396db2b624
msgid "PWM 5   in group3"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:69
#: 755310923c4547ae9ae3cf45ff6cf42a
msgid "PWM 6,7 in group4"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:70
#: 454b3d8a20394d85bc1f1aef6b23eff6
msgid "PWM 8,9 in group5"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:72
#: 3d589d21f7aa4206824a901d86962546
msgid "Pads for Outputs 1-8 are available on bottom side of pcb"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:73
#: cbbd77136de742d7ad2718410f415186
msgid "ESC port is a jst-sh V-G-C-R3-1-2-3-4"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:75
#: 31414082873f411c8cc45f6a21fc0361
msgid "Channels within the same group need to use the same output rate. All channels in specific Timer groups are configured either as DSHOT or PWM, mixing of protocols within groups is not possible. Channel 9 is configured as NeoPixel by default but can be configured for and extra PWM output. PWM 8 cannot be used for DShot if PWM 9 is configured for NeoPixel."
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:78
#: b94ddc1c0d4e47b093b328f9d1c0f9fa
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:79
#: df592107a46543af84f4458083761b44
msgid "The board has a builtin voltage sensor and pin on ESC connector for external current sensor. Voltage sensor supports up to 6S LiPo."
msgstr ""

