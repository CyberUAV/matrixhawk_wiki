msgstr ""

#: ../../source/docs/common-modalai-voxl.rst:80
#: 4a4cf77a7cfb436ebc5960d18a688227
msgid ":ref:`EK3_SRC2_VELXY <EK3_SRC2_VELXY>` = 6 (ExternalNav)"
msgstr ""

