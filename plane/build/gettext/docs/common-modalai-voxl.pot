msgstr ""

#: ../../source/docs/common-modalai-voxl.rst:76
#: 155d2230e2e34b9eb1c44b878d7b7290
msgid ":ref:`EK3_SRC1_POSZ <EK3_SRC1_POSZ>` = 1 (Baro)"
msgstr ""

#: ../../source/docs/common-modalai-voxl.rst:77
#: fdd893fe5986409f9e46925021cf9db8
msgid ":ref:`EK3_SRC1_VELZ <EK3_SRC1_VELZ>` = 0 (None)"
msgstr ""

#: ../../source/docs/common-modalai-voxl.rst:78
#: 9803cfe28559479bb06ebe09f8b998c4
