#: ../../source/docs/common-MicoAir743v2.rst:56
#: 8b3e4404d52241b784e8efc981a34ad0
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:57
#: d6d4ab6713e448ee80e44031a6bb3aa7
msgid "The UART6  is compatible with all ArduPilot supported receiver protocols."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:59
#: ad85087777d5475c9b41aecde3e1a460
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:60
#: a12a156f93794781a09bc53b8c85d7a5
msgid "SBUS/DSM/SRXL connects to the RX6 pin."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:61
#: 264951d01083495f9836036eb44b77d2
msgid "FPort requires connection to TX6 . See FPort Receivers."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:62
#: a3862d63b39245e6b582e9d5a9c5dbbf
msgid "CRSF also requires a TX6 connection, in addition to RX6, and automatically provides telemetry."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:63
#: a85523c90f1f47fbbea68b827a81ebd1
msgid "SRXL2 requires a connection to TX6 and automatically provides telemetry. Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` to “4”."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:65
#: ce140a6eea3e431f82cfeaf19ff8016a
msgid "Any UART can also be used for RC system connections in ArduPilot and is compatible with all protocols except PPM. See :ref:`Radio Control Systems <common-rc-systems>` for details."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:68
#: c9c086f832e54226961639e7ffc48511
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:69
#: ab089cae0aef41ccb2954aca3c6b2304
msgid "The MicoAir743v2 supports onboard OSD using OSD_TYPE 1 (MAX7456 driver). Simultaneously, DisplayPort OSD is available on the HD VTX connector, set OSD_TYPE2 = \"5\"."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:72
#: a46a0c027dee4414a97e885d4503ae6e
msgid "VTX Support"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:73
#: a82c765895eb4246bd651afee3e999ff
msgid "The SH1.0-6P connector supports a DJI Air Unit / HD VTX connection. Protocol defaults to DisplayPort. Pin 1 of the connector is 9v so be careful not to connect this to a peripheral requiring 5v."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:76
#: fbdbe4055bf54ba4beae98a95c6e5594
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:77
#: ea86f72aaeca466ea59f6d7d7366b971
msgid "The MicoAir743v2 supports up to 11 PWM outputs. All the channels support DShot. Channels 1-8 support bi-directional DShot."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:79
#: 3f80df51b377489d93e14582d67fd351
msgid "PWM outputs are grouped and every group must use the same output protocol:"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:81
#: 9b256b8a6fb3455d9850df47a30b882d
msgid "1, 2, 3, 4 are Group 1"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:82
#: 649f6dc23bc04b369a5f50788d176fb3
msgid "5, 6 are Group 2"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:83
#: 385c893ce864477fa87dd199786c9894
msgid "7, 8, 11 are Group 3"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:84
#: 2463008b18d84678bbb4b090a59bb6f5
msgid "9, 10 are Group 4"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:86
#: 42596c160ea646a098a2912b9a17230a
msgid "Note: PWM11 is the \"LED\" pin. If this is configured for serial LED use then PWM 7 and 8 can only be used as serial LED also."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:89
#: 64ad817187cd40bb8913ff756693384d
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:90
#: 3ba219bc3b0840ea926959b88c9bf66f
msgid "The board has a internal voltage sensor and connections on the ESC connector for an external current sensor input. The voltage sensor can handle up to 6S LiPo batteries."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:93
#: 8cfab0adc724454bb86248268c282c4c
msgid "The default battery parameters are:"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:95
#: f084b2d6ec654a22bd1416a5dedb66f3
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:96
#: 837247b767084c42804e8f6ba501e23e
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:97
#: 6cf753fbacd4412781b344a64ff4b528
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 21.12"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:98
#: 998e5f1d8c4b4f09a28daa7979f10a21
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:99
#: c6b0ec961b074e93b4df7e008982977f
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 40.2"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:102
#: 3782cc419d55416e8414f5a698d6a8cb
msgid "Compass"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:103
#: c686c0bd18d24c5daf7a9f69bac1a4ee
msgid "The MicoAir743v2 has a built-in compass. Due to potential interference, the autopilot is usually used with an external I2C compass as part of a GPS/Compass combination and the internal compass disabled."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:106
#: d1a81100f0254b499fc11db7f8732331
msgid "BlueTooth"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:107
#: d17f261f55f1463e81aa767e093a2dbc
msgid "The MicoAir743v2 has an on board BlueTooth module connected to UART8(SERIAL8). The BlueTooth id is MicoAir743v2-xxxxxx and you can connect to it without pairing id."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:110
#: 1896cec971bc436289e38e3129da9b58
msgid "Firmware"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:112
#: 57f20ad47a324288ba97688ae6af133c
msgid "Firmware for this board can be found `here <https://firmware.ardupilot.org>`__ in sub-folders labeled “MicoAir743v2”"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:115
#: b8c7f3d40123401db2d7910238686efd
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:116
#: 799eace8692e41b7b59e40f7145ec319
msgid "Initial firmware load can be done with DFU by plugging in USB with the bootloader button pressed. Then you should load the \"arduXXXX_with_bl.hex\" firmware, using your favorite DFU loading tool."
msgstr ""

#: ../../source/docs/common-MicoAir743v2.rst:118
#: 0dd5c452a99644c9afc249a149ce0fa1
msgid "Once the initial firmware is loaded you can update the firmware using any ArduPilot ground station software. Updates should be done with the \"\\*.apj\" firmware files."
msgstr ""
