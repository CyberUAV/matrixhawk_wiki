#: ../../source/docs/flight-options.rst:12
#: 8af26897c5164e1282211b336d70552e
msgid "0"
msgstr ""

#: ../../source/docs/flight-options.rst:12
#: 2bd36f612a534860b06173b48fc23c92
msgid "Allows rudder input to be used in only MANUAL, STABILIZE, and ACRO modes. In VTOL modes, rudder input mixing can be controlled by the :ref:`STICK_MIXING<STICK_MIXING>` parameter."
msgstr ""

#: ../../source/docs/flight-options.rst:13
#: 51d07c27e6d847d2908f0d8659808513
msgid "1"
msgstr ""

#: ../../source/docs/flight-options.rst:13
#: 11192e33ebf041bd87e2e10f17353ed8
msgid "Forces center throttle stick to be :ref:`AIRSPEED_CRUISE<AIRSPEED_CRUISE>` instead of midway between :ref:`AIRSPEED_MAX<AIRSPEED_MAX>` and :ref:`AIRSPEED_MIN<AIRSPEED_MIN>` when using an airspeed sensor in FBWB and CRUISE modes."
msgstr ""

#: ../../source/docs/flight-options.rst:14
#: ce5cf9d2a5114a99a11acb71bb183107
msgid "2"
msgstr ""

#: ../../source/docs/flight-options.rst:14
#: f55e2f8106d546999d2feeae2c61df62
msgid "Disable the attitude checks for AUTOTAKEOFF and TAKEOFF mode start which must be less than +/-30 degrees roll and 45 degrees pitch."
msgstr ""

#: ../../source/docs/flight-options.rst:15
#: 4ead13cdf1ba45de8b401432b82df7a0
msgid "3"
msgstr ""

#: ../../source/docs/flight-options.rst:15
#: 137abebf71ec4331ad0ffd7de0b0988e
msgid "Forces target airspeed to :ref:`AIRSPEED_CRUISE<AIRSPEED_CRUISE>` in CRUISE and FBWB modes when airspeed sensor is being used, ignoring throttle stick position."
msgstr ""

#: ../../source/docs/flight-options.rst:16
#: e9d37d36c3f54848a84d6289dfe42ecb
msgid "4"
msgstr ""

#: ../../source/docs/flight-options.rst:16
#: 42a51fef70e141c0acb67283adb7459f
msgid "Climb to :ref:`RTL_ALTITUDE<RTL_ALTITUDE>` altitude before turning toward home in RTL."
msgstr ""

#: ../../source/docs/flight-options.rst:17
#: b1822efbb7c64f12be41c0c746e23238
msgid "5"
msgstr ""

#: ../../source/docs/flight-options.rst:17
#: ac7dc8bdedae484f9b47f54746bdce63
msgid "Enable :ref:`Yaw Damping Controller<yaw-controller-tuning>` to be active in ACRO mode."
msgstr ""

#: ../../source/docs/flight-options.rst:18
#: b12907ebaa6c4b7abb6b78eaccd92310
msgid "6"
msgstr ""

#: ../../source/docs/flight-options.rst:18
#: 0fb7fff0d1574a78a10d945a3b729b49
msgid "Suppress speed scaling during auto takeoffs to be 1 or less to prevent oscillations when not using an airspeed sensor."
msgstr ""

#: ../../source/docs/flight-options.rst:19
#: df33f872d8fd4707a7894ac2d4997f56
msgid "7"
msgstr ""

#: ../../source/docs/flight-options.rst:19
#: b22af05a566e43ada2c448fca9ab7357
msgid "Enable default airspeed EKF fusion for takeoff (Advanced users only)."
msgstr ""

#: ../../source/docs/flight-options.rst:20
#: 7f2cab49417c42f4aa63684d231d9d3a
msgid "8"
msgstr ""

#: ../../source/docs/flight-options.rst:20
#: 884d723e580c45dfa87ac66e4f662cf9
msgid "Remove :ref:`PTCH_TRIM_DEG<PTCH_TRIM_DEG>` offset on the GCS horizon to show pitch relative to AHRS trim (i.e. the attitude at which the autopilot was calibrated, unless manually changed)."
msgstr ""

#: ../../source/docs/flight-options.rst:21
#: 03cf566177f84a2ab2ee4f0cff52a806
msgid "9"
msgstr ""

#: ../../source/docs/flight-options.rst:21
#: 7500b29b305d46a7998c29e75f2cab54
msgid "Remove :ref:`PTCH_TRIM_DEG<PTCH_TRIM_DEG>` on the OSD horizon to show pitch relative to AHRS trim (i.e. the attitude at which the autopilot was calibrated, unless manually changed)."
msgstr ""

#: ../../source/docs/flight-options.rst:22
#: 49c01e3a86284747ae519d51957b3df0
msgid "10"
msgstr ""

#: ../../source/docs/flight-options.rst:22
#: e4b345aed8e8438caa373e6d428da80c
msgid "Adjust mid-throttle to be :ref:`TRIM_THROTTLE<TRIM_THROTTLE>` in non-auto throttle modes except MANUAL, instead of midway between MAX and MIN stick values (note that the RCx_TRIM value for the throttle channel (x) MUST BE set to center stick value)."
msgstr ""

#: ../../source/docs/flight-options.rst:23
#: 48a9b51462f54b0596b5f20d02cfa772
msgid "11"
msgstr ""

#: ../../source/docs/flight-options.rst:23
#: c5b369f24aa2464f859501c008766cee
msgid "Disable suppression of fixed wing rate gains in ground mode."
msgstr ""

#: ../../source/docs/flight-options.rst:24
#: 1e00f5f3fc514e92a135d85f219044b5
msgid "12"
msgstr ""

#: ../../source/docs/flight-options.rst:24
#: cdee6410820c499d90169a3fd5cbac6e
msgid "Enable FBWB style loiter altitude control if STICK_MIXING is enabled."
msgstr ""

#: ../../source/docs/flight-options.rst:25
#: 42ed705e63b24f31ae901a58d73fa905
msgid "14"
msgstr ""

#: ../../source/docs/flight-options.rst:25
#: b4453568418c4961b6d2eb52ce1604cf
msgid "In AUTO, climb to next waypoint altitude immediately instead of linear climb."
msgstr ""

#: ../../source/docs/flight-options.rst:26
#: b67161eae1864786bbb3c25427dc20a8
msgid "15"
msgstr ""

#: ../../source/docs/flight-options.rst:26
#: ff1540ad024842ec83b8325227521d9c
msgid "Allows auto flap operation in manual modes as well as auto-throttle modes."
msgstr ""

#: ../../source/docs/flight-options.rst:27
#: e4022528a8fd4933996c54b0275f6a95
msgid "16"
msgstr ""

#: ../../source/docs/flight-options.rst:27
#: 54afc69cd8ec4ca59d99849091bd5265
msgid "Enable full aerodynamic load factor-based roll limits. This should be enabled when an accurate and well calibrated airspeed sensor is used to impose the correct FBW roll limits when the aircraft is turning. Requires an enabled airspeed sensor and AIRSPEED_STALL set. WARNING: If your airspeed sensor is very inaccurate or fails, having this enabled may result in almost no roll maneuverability in FBW modes."
msgstr ""

#: ../../source/docs/flight-options.rst:30
#: d808a690b9e14e959372afee4711f0ee
msgid "Default is no options enabled (\"0\"). Setting the bit will enable that function. For example, if forcing target airspeed in FBWB and CRUISE modes is desired, a value of \"8\" (bit 3 = 1) would be set."
msgstr ""

#: ../../source/docs/flight-options.rst:32
#: c4a46389c4d74d5ba079d120cb1f73bf
msgid "Normally, PTCH_TRIM_DEG is subtracted from the AHRS pitch so that the artificial horizon shows pitch as if the autopilot was calibrated with aircraft level position set at PTCH_TRIM_DEG instead of flat. This normally results in the artificial horizon indicating 0 pitch when in cruise at desired cruise speed. PTCH_TRIM_DEG is the pitch trim that would be required in stabilized modes to maintain altitude at nominal cruise airspeed and throttle, and for most planes is 1-3 degrees positive, depending on the aircraft design (see :ref:`tuning-cruise`)."
msgstr ""
