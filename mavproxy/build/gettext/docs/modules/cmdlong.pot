#: ../../source/docs/modules/cmdlong.rst:3
#: 9f406a9d9e09471e8c544de53bdd97a6
msgid "Long Commands"
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:9
#: c20ca3c4cc3a4675a92d65e5c7513a9d
msgid "This module is a collection of ``command_long_send`` functions that may be useful to the user. It also adds the ``command_int`` function which allows sending MAVLink COMMAND_INT messages."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:14
#: 387bec34fcc84d4f8c5945528eb63bd0
msgid "Control"
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:20
#: 568c746c357e445c8f35a8584e67d511
msgid "If in automated flight mode, set the vehicles target speed to ``N`` m/s."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:27
#: 6531dc120bed4c16b2dab735d0ff476b
msgid "Set the target yaw of the vehicle to ``ANGLE`` (0-360), with a maximum angular speed of ``ANGULAR_SPEED`` (deg/sec). ``MODE`` is either 0 (absolute angle) or 1 (relative angle)."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:34
#: f25ccba90bb94cc4a13db241b1420030
msgid "Sends an automated takeoff command to the vehicle. It will consider the takeoff finished at ``ALTITUDE_IN_METERS`` m (relative)."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:41
#: 1124596e8fe749a0b35cfad2380d989c
msgid "Sets a desired vehicle velocity in a local north-east-down (x, y, z) coordinate frame. All velocities in m/s."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:48
#: b3a7c418cf3f404587400049b1677088
msgid "Sets a desired vehicle position in a local north-east-down (x, y, z) coordinate frame. All positions in m."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:55
#: 3511e85f9f544b35b2ee15c07b5c83ee
msgid "Set the desired attitude of the vehicle in quaternion format."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:61
#: 3285f25d1d2d4b688131ac8a1106ca30
msgid "Sets the target position according to the previous mouse click on the map and the target velocity in North-East-Down format (m/s). Uses a global frame."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:68
#: a5ec094d43bb4109bcbf67efbac67a8f
msgid "If in AUTO or GUIDED mode, pause the vehicle's travel."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:74
#: 891523a2287a4198a118f019bd30ce85
msgid "If in AUTO or GUIDED mode, resume the vehicle's travel."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:77
#: 25f6206646fd40eda26221ec3d58820f
msgid "Camera"
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:79
#: 25cadb6a50874f79a8ca08a0c9056698
msgid "Note the following commands are not processed by APM, rather they are meant for a companion computer which controls the camera."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:85
#: 0c82ee7b928d4f7d94d3e30609863dcf
msgid "Send a MAV_CMD_DO_DIGICAM_CONTROL Mavlink message. Parameters are: M1=Session control e.g. show/hide lens, M2=Zoom's absolute position, M3=Zooming step value to offset zoom from the current position, M4=Focus Locking, Unlocking or Re-locking, M5=Shooting Command, M6=Command Identity, M7=Empty."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:93
#: 4eea8ee64d8c4e399e9868239d75e731
msgid "Send an old-style MAV_CMD_DO_DIGICAM_CONTROL shooting command."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:99
#: e3e484394a02482e9d5678cb744bf03d
msgid "Send a MAV_CMD_DO_DIGICAM_CONFIGURE Mavlink message. The Parameters are: M1=Modes [P, TV, AV, M], M2=Shutter Speed, M3=F Stop number, M4=ISO Number, M5=Exposure type, M6=Command Identity, M7=Main engine cut-off time before camera trigger in seconds/10 (0 means no cut-off)."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:102
#: 37eee2ee85f44ef0a1bf4ff1feb82d9f
msgid "Systems"
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:108
#: 762e93f571ed43348976496238302bdb
msgid "Sends an action to the parachute. ``ACTION`` can be enable, disable or release."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:116
#: 39b4f587118c4c5da792bd171860703d
msgid "Sends an engine control command (MAV_CMD_DO_ENGINE_CONTROL). It can start or stop the engine. Otherwise the full set of options can be specified, with M1=1 or 0 for engine start/stop, M2=   0: Warm start, 1:Cold start. Controls use of choke where applicable, M3=Height delay (meters). This is for commanding engine start only after the vehicle has gained the specified height."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:123
#: 0dd262150e4943f6a8ee01a802aec98b
msgid "Send a general MAV_CMD_LONG message to the vehicle. ``COMMAND`` is the name of the command. The options follow in ``[arg1] [arg2] ...`` format."
msgstr ""

#: ../../source/docs/modules/cmdlong.rst:130
#: 945ea8f65a38496dbc1690b48391c0c8
msgid "Send a general MAV_COMMAND_INT message to the vehicle ``COMMAND`` is the name of the command prefixed with ``MAV_``. e.g. MAV_CMD_GUIDED_CHANGE_HEADING. The options follow separated by spaces."
msgstr ""

