#: ../../source/docs/modules/link.rst:3
#: d8361ff94710479f975f60d2d1b78502
msgid "Link Management"
msgstr ""

#: ../../source/docs/modules/link.rst:5
#: 89f249daa9664c7d99a13f05b336e121
msgid "The link module allows the user to add, remove and monitor the status of communications links to the APM. This can be done at any time."
msgstr ""

#: ../../source/docs/modules/link.rst:8
#: 8e74729149f94674b279a1a6f8b92b2a
msgid "It is useful for UAV systems that have multiple communications links. MAVProxy will automatically read the data from both links, no user intervention is necessary for link failover."
msgstr ""

#: ../../source/docs/modules/link.rst:12
#: 121806583a134fd2883ab0693fee7679
msgid "A link menu is available on the GUI console."
msgstr ""

#: ../../source/docs/modules/link.rst:14
#: 50bd4b5e0f0e4981aa62b97215cff9cd
msgid "For ease of management, links can have labels."
msgstr ""

#: ../../source/docs/modules/link.rst:17
#: fcc7e5249ace4bfb9e995465a3002c5a
msgid "link add"
msgstr ""

#: ../../source/docs/modules/link.rst:19
#: 2c0457cccf6849599fe73702f3ef7fd0
msgid "Add an additional communications link. This can be either a network address or serial port. For a serial port, the default baud rate is 57600. Use ``set baudrate xxx`` to change baud rate for any subsequent link add's."
msgstr ""

#: ../../source/docs/modules/link.rst:24
#: 16df1ce715c6498c871a27915d7ece7d
msgid "To add a label to a link, use ``:{\"label\":\"LinkName\"}`` after the link details. Note the link label must not have any spaces in it."
msgstr ""

#: ../../source/docs/modules/link.rst:35
#: 975c2cf087d44114b74dc65377adf76e
msgid "See the startup :ref:`section <mavproxy-quickstart>`  for full details on link types"
msgstr ""

#: ../../source/docs/modules/link.rst:38
#: 7a885107b1ab4ffa8f1cbc7762bba94b
msgid "link remove"
msgstr ""

#: ../../source/docs/modules/link.rst:40
#: 5cf0630941074676a77f48f8c0e4bb64
msgid "Remove a communications link. The ID or label of the link is used to identify the link to remove."
msgstr ""

#: ../../source/docs/modules/link.rst:49
#: 782604e4801542aaa0503c7342c61fb7
msgid "link list"
msgstr ""

#: ../../source/docs/modules/link.rst:51
#: ec78b7b043e54948a0b51f6bd3458123
msgid "List the active communications links, their ID's and labels (if applicable)."
msgstr ""

#: ../../source/docs/modules/link.rst:58
#: a86ebccffe59411e803cc8747f680259
msgid "link dataratelogging"
msgstr ""

#: ../../source/docs/modules/link.rst:60
#: 30cb831ded5b46cab9293e48fc1ee8cb
msgid "Start or stop datarate statistic logging. If active, the statistics are saved in \"dataratelog.csv\" in the same folder as the tlog."
msgstr ""

#: ../../source/docs/modules/link.rst:63
#: 6136909e90d840cb82afaf4fc010fd5a
msgid "The statistics are useful for profiling and testing low-bandwidth datalinks."
msgstr ""
