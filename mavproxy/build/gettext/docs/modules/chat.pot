#: ../../source/docs/modules/chat.rst:87
#: b7e2f3cafa4f408db6acc19ee0e166ea
msgid "Sample Conversation"
msgstr ""

#: ../../source/docs/modules/chat.rst:89
#: c06ceb084a0d4b9da4f6d8aef257c303
msgid "**Please takeoff to 50m**"
msgstr ""

#: ../../source/docs/modules/chat.rst:91
#: b9431916617a43feabcd18f49f9e65be
msgid "*The vehicle has been switched to Guided mode and given a takeoff command to reach an altitude of 50 meters above the home position.*"
msgstr ""

#: ../../source/docs/modules/chat.rst:93
#: a0d899a3862c441f969b0593635776ab
msgid "**Please set the disarm delay to 0**"
msgstr ""

#: ../../source/docs/modules/chat.rst:95
#: caf6e1351b5644949c7f205f3a5a3560
msgid "*The disarm delay has been set to 0 seconds for the Copter.*"
msgstr ""

#: ../../source/docs/modules/chat.rst:97
#: cfbd0da946a746c5aabaa766c05094b1
msgid "**the takeoff failed, please try again**"
msgstr ""

#: ../../source/docs/modules/chat.rst:99
#: 5882bc29b33346d18ff9ad756e56dce7
msgid "*I have sent the takeoff command again to reach an altitude of 50 meters above the home position.*"
msgstr ""

#: ../../source/docs/modules/chat.rst:101
#: e4d9088c2945480fbdc1610ba43dc023
msgid "**please fly West 100m**"
msgstr ""

#: ../../source/docs/modules/chat.rst:103
#: 61931cf69ae64d599c7d10e27dade12a
msgid "*The Copter has been commanded to fly 100 meters to the West at an altitude of 50 meters above home.*"
msgstr ""

#: ../../source/docs/modules/chat.rst:105
#: 5ce434c2bf214aec9fda1845b6e7c49f
msgid "**well done, can you return home now?**"
msgstr ""

#: ../../source/docs/modules/chat.rst:107
#: 640319c0408d40baa8310cadb3cfc9bc
msgid "*The Copter has been commanded to return to the launch (home) location.*"
msgstr ""
