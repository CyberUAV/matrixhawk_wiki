#: ../../source/docs/modules/signing.rst:3
#: c4e4d4ab96fc4769a4c720ddd7201d6f
msgid "Packet Signing"
msgstr ""

#: ../../source/docs/modules/signing.rst:9
#: 2e58306ce93645ec9994db6f1bcf27c9
msgid "The signing module sets up and controls the signing of packet with a key. In Mavlink 2.0, this is a feature that allows a vehicle to only accept commands from packets signed with the correct key. This is useful as it lowers the risk of a 3rd party gaining control over the vehicle."
msgstr ""

#: ../../source/docs/modules/signing.rst:14
#: 054e063a558b43c7a270f44091fe066a
msgid "Setup and Removal"
msgstr ""

#: ../../source/docs/modules/signing.rst:20
#: 29bf607131614827af75f2f54a9024db
msgid "Set the key to ``KEY`` on both MAVProxy and the vehicle. **This is sent in plaintext to the vehicle, so ensure this setup is done over a secure link.**"
msgstr ""

#: ../../source/docs/modules/signing.rst:23
#: a35443d27d7c4cef8b46b0fc09f8e231
msgid "All packets sent to the vehicle after this command will be accompanied with a SHA-512 hash of the key to confirm the packet's authenticity."
msgstr ""

#: ../../source/docs/modules/signing.rst:30
#: 5c0a6333f27249128fdfebbb68c752b6
msgid "Remove the signing key ``KEY`` from MAVProxy and the vehicle."
msgstr ""

#: ../../source/docs/modules/signing.rst:36
#: 1892ea2b7d6a4cc5b013a0caa842cb1d
msgid "Disable signing of packets with key ``KEY`` from MAVProxy. Does not affect the vehicle - it will still be expecting signed packets."
msgstr ""

#: ../../source/docs/modules/signing.rst:43
#: 4c8822b7a7974b5aa6041243bfe3f219
msgid "Enable signing of packets with key ``KEY`` from MAVProxy. Does not affect the vehicle."
msgstr ""
