#: ../../source/docs/modules/ublox.rst:3
#: d24e161ea1834daba48021aab1cdecab
msgid "uBlox GPS Management Module"
msgstr ""

#: ../../source/docs/modules/ublox.rst:9
#: b4d94c4cf904498e805ba902f9f30a1c
msgid "The ublox module allows the user to upload GNSS databases (almanacs) from the uBlox website to a uBlox GPS module. This is useful for getting a quicker position lock under poor signal conditions. See `here <https://www.u-blox.com/en/assistnow>`_ for details about this database."
msgstr ""

#: ../../source/docs/modules/ublox.rst:15
#: 295cd5f48d1b4f3bb6b796151c09d1db
msgid "To use the uBlox API you will need to create a file containing your API token in ``~/.mavproxy/ublox/api_token``."
msgstr ""

#: ../../source/docs/modules/ublox.rst:18
#: 323272ef90f248d78e616b94054933d8
msgid "ublox reset"
msgstr ""

#: ../../source/docs/modules/ublox.rst:20
#: 550965b760394fe8ae83cf70f7b4ee3a
msgid "This command reboots the GPS module. Also known as a \"cold start\""
msgstr ""

#: ../../source/docs/modules/ublox.rst:23
#: 26248b9f5dd34140a1be5c3c09355ad3
msgid "ublox status"
msgstr ""

#: ../../source/docs/modules/ublox.rst:25
#: 7455fd18d36341c8ac736ad5e9ff4abc
msgid "Returns the current status of the GPS"
msgstr ""

#: ../../source/docs/modules/ublox.rst:28
#: 4c23040fc8d0409d94b92adce651a428
msgid "ublox mga"
msgstr ""

#: ../../source/docs/modules/ublox.rst:30
#: 2f7dabdbad414f719cbaffb82d69b010
msgid "Upload the mga database from to the GPS module. It is assumed that ``offline.ubx`` and ``dbd.ubx`` are in the ``~/.mavproxy/ublox`` folder."
msgstr ""
