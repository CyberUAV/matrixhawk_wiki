msgid "Log Management"
msgstr ""

#: ../../source/docs/modules/log.rst:9
#: 6a9d9cc9a9254211b22bc2a22ca64231
msgid "Allows the user to manage the dataflash logs stored on the autopilot. Use ``log list`` to view a list of the logs on the autopilot and ``log erase`` to delete all logs on the autopilot."
msgstr ""

#: ../../source/docs/modules/log.rst:13
#: 0520e4748a724daeb057962f74cb5699
msgid "Use ``log download [lognumber] [filename]`` to start to download a specific log to the specified file name. ``log status`` to see the transfer status and ``log cancel`` to cancel the download."
msgstr ""
