#: ../../source/docs/modules/genobstacles.rst:3
#: 1f2578b3801d497fb04e833c3fb813fd
msgid "Obstacle Generator"
msgstr ""

#: ../../source/docs/modules/genobstacles.rst:10
#: dfd71291315f4dae81d1a846bbcecf02
msgid "Allows the user to send simulated obstacles to ArduPilot, in order to test object avoidance techniques. This module was originally developed for the 2018 UAV Outback Challenge."
msgstr ""

#: ../../source/docs/modules/genobstacles.rst:13
#: 4a264cca8ba14cb88f5e2c9af94504ff
msgid "When loaded, the user can right-click on the MAVProxy map to drop obstacles. These include birds, planes and clouds. These are sent to 127.0.0.1:45454 in ASTERIX format."
msgstr ""

#: ../../source/docs/modules/genobstacles.rst:16
#: f25dba3324054541944133dd2eb9f06e
msgid "The ``asterix`` module will receive these obstacles from 127.0.0.1:45454 and convert to a ``ADSB_VEHICLE`` MAVLink message and then on-send to ArduPilot."
msgstr ""

#: ../../source/docs/modules/genobstacles.rst:19
#: 91ad8f2fa1824f95adc154cfeac35de0
msgid "If ADSB avoidance is enabled, ArduPilot will then attempt to avoid the object."
msgstr ""
