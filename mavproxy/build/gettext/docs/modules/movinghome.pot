#: ../../source/docs/modules/movinghome.rst:5
#: b484cfa798f54cab97f52f8c013a7fcb
msgid "Movinghome"
msgstr ""

#: ../../source/docs/modules/movinghome.rst:7
#: 92390196d30543e093550d3e5c557b3d
msgid "Allows changing vehicle's home position to new GCS location, if the GCS position moves. Requires NMEA GPS attached to serial port of GCS."
msgstr ""

#: ../../source/docs/modules/movinghome.rst:14
#: 75506ed9f6464148882905ee305eeb7a
msgid "Usage"
msgstr ""

#: ../../source/docs/modules/movinghome.rst:16
#: ce12ccd69b9745f9a3fd0c331ac85c55
msgid "movinghome <status|on|off|radius|device|baud>"
msgstr ""

#: ../../source/docs/modules/movinghome.rst:18
#: 175840fc649a4ff9a8d2e656fa8270f2
msgid "on: enable position updates as GCS moves. If GSC moves beyond threshold, vehicle home will be updated to current GCS position."
msgstr ""

#: ../../source/docs/modules/movinghome.rst:19
#: 47a2a57cff044f39961faa3ba6663aba
msgid "off: disable home position updating"
msgstr ""

#: ../../source/docs/modules/movinghome.rst:20
#: ea380302b01c460190f8b6238b67d447
msgid "radius: threshold in meters that GCS must move to update home in vehicle."
msgstr ""

#: ../../source/docs/modules/movinghome.rst:21
#: e8adaf7321aa4644b1bb2bf04c2f7c84
msgid "status: status report"
msgstr ""

#: ../../source/docs/modules/movinghome.rst:22
#: 3bcbef05b5e7474296abeeaf35f1774f
msgid "baud: baudrate of serial port which is connected to NMEA GPS"
msgstr ""

#: ../../source/docs/modules/movinghome.rst:23
#: a367b51b90954ad8a0ce3c2482427fb1
msgid "device: name of serial port which is connected NMEA GPS"
msgstr ""
