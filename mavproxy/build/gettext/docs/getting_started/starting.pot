msgstr ""

#: ../../source/docs/getting_started/starting.rst:229
#: 5b403fc8144b424a80cce6d45a2eb1d3
msgid "-\\-state-basedir"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:231
#: 375344b5adbc44adbed4d2f8a931668d
msgid "The base directory will logs are stored, if it is not the current directory."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:235
#: 7204442513bb454faebace8e86a015bd
msgid "-\\-version"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:237
#: 782f962b63a84f209f110558c23e756e
