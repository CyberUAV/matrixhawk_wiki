msgstr ""

#: ../../source/docs/getting_started/starting.rst:218
#: e1a0db4ffccd4eb7a36a8e844029843f
msgid "Give the current mission a name. If used, the flight log will be stored as :file:`/Logs/aircraftname/missionname` rather than the default :file:`/Logs/aircraftname/currentdatetime`."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:223
#: 11c6800e3be842f18a8610a9d64d2291
msgid "-\\-daemon"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:225
#: 0c933e8091c2434fbef85292e4a01e82
