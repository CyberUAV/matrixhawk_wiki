msgstr ""

#: ../../source/docs/getting_started/starting.rst:186
#: 3e1362619904460bae9d2a05a80533c5
msgid "-\\-mavversion"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:188
#: 77c3aa6ba70843349b57baa29024cd87
msgid "Specify MAVLink version. Can be 1.0 or 2.0. Otherwise MAVProxy will autodetect the MAVLink version"
