#: ../../source/docs/getting_started/starting.rst:5
#: c3ed219837d347d2b1bd6515f6d8c28d
msgid "Startup Options"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:7
#: 6d63c832222a4d618977cc2448751350
msgid "There are no mandatory command line options for MAVProxy. An exception to this is the ``--master`` option if there is more than 1 APM connected to the system."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:11
#: e60385e2c8ff49edae8e1db85f4740b5
msgid "Note that MAVProxy can only connect to 1 vehicle at a time. If control of multiple vehicles is desired, multiple MAVProxy sessions should be used - one session for each vehicle."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:16
#: 9bb889f4933c497d8b2ee96179616cf2
msgid "-\\-master"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:18
#: f6b6b1d37780472fa92b1748fd67943c
msgid "Specifies which port (serial, USB or network address/port) the UAV is communicating on."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:21
#: 3b12a3b097144b8a85c7cfbf1ac07b7b
msgid "Multiple ``--master`` can be used. MAVProxy will sort the packets into a single stream automatically. This is useful if independent redundant links are being used."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:25
#: dd45eb9cdbce4cd7a8b85bb91e27526d
msgid "If an IP address is specified, it must be the local computer's IP address, or loopback address. The IP connection type (TCP or UDP) must be prefixed to the IP address."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:29
#: 8e42e3de4a414c4aa99d10e8bea4f77e
msgid "If a serial port is specified, an optional comma-separated baud rate may also be specified. If present, this overrides the rate given by ``--baudrate``."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:43
#: cc3187f7068448f68e8fb93c985e573b
msgid "If connecting to a remote IP address, the udpout or tcpout arguments should be used:"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:51
#: 815791859d3b445bbe55eb8879a855dc
msgid "-\\-quadcopter"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:53
#: e271010c029c4c75a9a8f56896fc7c09
msgid "Use quadcopter controls."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:56
#: c9636feabf734751b7a87c629c98cc60
msgid "-\\-baudrate"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:58
#: 4a4bea42bcd24cf2a96cf3e8dbfbdb53
msgid "Specify baudrate of ``--master`` and ``--out`` ports. Only applicable for serial links."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:62
#: 721da7b80c4c499a8048a3aa3d06c0e1
msgid "-\\-out"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:64
#: 500c9e202c884999991035ee21ed19fd
msgid "Forward the MAVLink packets to a remote device (serial, USB or network address/port). Useful if using multiple ground station computers or relaying the stream through an intermediate node."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:68
#: 75d5ecef8413434988ec9a8b69cb06e2
msgid "MAVlink usually uses port 14550 for IP-based packet forwarding, though other ports can be used if needed."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:71
#: e02063fd44644a6ebbe04774086b93b1
msgid "If a serial port is given (for example a radio device connecting an airborne MAVProxy instance with the GCS), a link-specific baud rate can be given after the device, delimited by a comma. This overrides the global default baudrate specified by ``--baudrate``."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:76
#: f63f833fb2e54503b3b0b331c8d88163
msgid "If forwarding to a network address via tcp or udp, this must be prefixed before the IP address."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:79
#: d863dc28b258415bac5c943d052e5b0b
msgid "A UDP broadcast can be made via the udpbcast:<ip>:<port> that starts as UDP broadcast then locks onto the first client that connects. <ip> specifies the valid client range. For example, udpbcast:192.168.2.255:14550 will connect to the first client in the 192.168.2.0 to 192.168.2.254 range on port 14550."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:93
#: ad174e83a3e942d692271be790d56f0c
msgid "-\\-sitl"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:95
#: 14400af65acf41338ad9e45338e56262
msgid "Host and port to send simulated RC input for the Software in the loop (SITL) simulator. Usually ``--sitl=127.0.0.1:5501``"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:98
#: 3c1284dd004740c0bcb98e417905bcc5
msgid "-\\-streamrate"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:100
#: 05a9231584ed4aa8b0851f838b721898
msgid "MAVLink stream rate."
msgstr ""

