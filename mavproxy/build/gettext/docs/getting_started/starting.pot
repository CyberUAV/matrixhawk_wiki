#: ../../source/docs/getting_started/starting.rst:125
#: 1c978cd6e5da427d90661411ab223a98
msgid "Name of MAVLink master logfile. Default is mav.tlog."
msgstr ""

#: ../../source/docs/getting_started/starting.rst:128
#: e8ae25cd1663491aa79c36066e5100ef
msgid "-\\-append-log"
msgstr ""

#: ../../source/docs/getting_started/starting.rst:130
#: d3f52739b2304a96a13a2dfbb63706c8
