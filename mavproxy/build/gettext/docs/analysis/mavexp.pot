#: ../../source/docs/analysis/mavexp.rst:3
#: 79abccc5ae0841f7b7c7debaaf23a968
msgid "MAVExplorer"
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:5
#: 7e5906d786704212a13c36c7db9cdf2d
msgid "The MAVExplorer tool is an interactive tool for graphing APM logfiles (tlogs or dataflash logs)."
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:7
#: a87660d5ef6240bcb2f4306270c10f5d
msgid "Under Linux, it can be accessed by:"
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:13
#: 1fedb4682748430e9b4d7a44906b1809
msgid "Under Windows, it can be found in the Start Menu with the rest of MAVProxy."
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:15
#: 405539023a974a3b8d581c433965acc2
msgid "Use the MAVExplorer->Open menu to open tlog or dataflash files to graph."
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:19
#: 3b638ba26fb54c4788c58ea38bc4b3b1
msgid "The Graphs menu will automatically populate based upon the available packets in the logfile."
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:21
#: 8cb843246c4f4087b9dbefb184930db3
msgid "To narrow down the log file to a particular phase of the logfile, select the relevant mode from the FlightMode menu. Any future graphs will only cover the selected section of the flight."
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:25
#: f1a8ec30086c4f3696ce8386d4bd0f1a
msgid "The Display menu contains methods for displaying a map of the GPS points of the logfile and reloading the logfile. Additionally there are methods for creating and saving custom graphs, using the same notation as with the :ref:`graph <mavproxy-modulegraph>` module in MAVProxy."
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:29
#: cbe5ff61c04f41f985342163c58b60bc
msgid "Saving custom graphs is not currently available on Windows."
msgstr ""

#: ../../source/docs/analysis/mavexp.rst:31
#: 338dc0cc07854243ae563ee8f99e3c71
msgid "More information about this program can be found in the `ArduPilot documentation <http://ardupilot.org/dev/docs/using-mavexplorer-for-log-analysis.html>`_."
msgstr ""
