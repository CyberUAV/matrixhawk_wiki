msgstr ""

#: ../../source/docs/parameters.rst:35430
#: d6dd0390013d4f07a0070bcb56b8cf60
msgid "Offset to apply to ESC numbers when reporting as ESC\\_TELEMETRY packets over MAVLink\\. This allows high numbered motors to be displayed as low numbered ESCs for convenience on GCS displays\\. A value of 4 would send ESC on output 5 as ESC number 1 in ESC\\_TELEMETRY packets"
msgstr ""

#: ../../source/docs/parameters.rst:35446
#: 3d5cba5e8aba438fbeaa400bd1b882a5
msgid "FENCE\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:35452
#: 6926e09b1a1f49cabc985bd66e2425c1
msgid "FENCE\\_ENABLE: Fence enable\\/disable"
msgstr ""

#: ../../source/docs/parameters.rst:35455
#: 1b8ebb22ae154e01ae5f4baa533683a7
msgid "Allows you to enable \\(1\\) or disable \\(0\\) the fence functionality\\. Fences can still be enabled and disabled via mavlink or an RC option\\, but these changes are not persisted\\."
msgstr ""

#: ../../source/docs/parameters.rst:35477
#: 067f04f3638947ee9c87f5910a862855
msgid "FENCE\\_ACTION: Fence Action"
msgstr ""

#: ../../source/docs/parameters.rst:35480
#: 2866777c80cc4323bbd459acf0e1448b
msgid "What action should be taken when fence is breached"
msgstr ""

#: ../../source/docs/parameters.rst:35489
#: 438ea18e2e4d4143a664be04e57e4867
msgid "Report Only"
msgstr ""

#: ../../source/docs/parameters.rst:35491
#: 7a9399d7b38b4dd681698af16818d0ff
msgid "RTL or Land"
msgstr ""

#: ../../source/docs/parameters.rst:35502
#: fdefa3a12b3941cdb85c9405431a56bf
msgid "FENCE\\_RADIUS: Circular Fence Radius"
msgstr ""

#: ../../source/docs/parameters.rst:35505
#: 5314ef0221cd4e11abb645d09d7c8f3e
msgid "Circle fence radius which when breached will cause an RTL"
msgstr ""

#: ../../source/docs/parameters.rst:35511
#: 7df2fa6c731043d1b3f4806c4cb29990
msgid "30 to 10000"
msgstr ""

#: ../../source/docs/parameters.rst:35520
#: 57b154cb91634b7b951120eca22fe969
msgid "FENCE\\_MARGIN: Fence Margin"
msgstr ""

#: ../../source/docs/parameters.rst:35523
#: 430db1ba3c73487682eeb6e7cdcffe36
msgid "Distance that autopilot\\'s should maintain from the fence to avoid a breach"
msgstr ""

#: ../../source/docs/parameters.rst:35538
#: f7a1cb0ea7ea4b218fa3ba162061537e
msgid "FENCE\\_TOTAL: Fence polygon point total"
msgstr ""

#: ../../source/docs/parameters.rst:35541
#: a1b20d646fc745a199a3bf3f8773e334
msgid "Number of polygon points saved in eeprom \\(do not update manually\\)"
msgstr ""

#: ../../source/docs/parameters.rst:35547
#: c1c97797044e4cc7806149a59609049f
msgid "1 to 20"
msgstr ""

#: ../../source/docs/parameters.rst:35556
#: d74a30021f444edeba3aff1e8035073a
msgid "FENCE\\_OPTIONS: Fence options"
msgstr ""

#: ../../source/docs/parameters.rst:35559
#: f3aba22d71bc47229145b5861b4fb78d
msgid "When bit 0 is set disable mode change following fence action until fence breach is cleared\\. When bit 1 is set the allowable flight areas is the union of all polygon and circle fence areas instead of the intersection\\, which means a fence breach occurs only if you are outside all of the fence areas\\."
msgstr ""

#: ../../source/docs/parameters.rst:35568
#: a376484b9fef4bd496ddeb047da21568
msgid "Disable mode change following fence action until fence breach is cleared"
msgstr ""

#: ../../source/docs/parameters.rst:35570
#: 5529568cb999420ab8b92ff4fdc81d7d
msgid "Allow union of inclusion areas"
msgstr ""

#: ../../source/docs/parameters.rst:35572
#: 2350a37700ec46eba61a582d5fd479f8
msgid "Notify on margin breaches"
msgstr ""

#: ../../source/docs/parameters.rst:35583
#: f4017bd7307944e7974ff65aa503a9d4
msgid "FENCE\\_NTF\\_FREQ: Fence margin notification frequency in hz"
msgstr ""

#: ../../source/docs/parameters.rst:35587
#: 9c4e876d8bc34037a4f62da7c43cba67
msgid "When bit 2 of FENCE\\_OPTIONS is set this parameter controls the frequency of margin breach notifications\\. If set to 0 only new margin breaches are notified\\."
msgstr ""

#: ../../source/docs/parameters.rst:35602
#: 7cf3ad8da8da496080825214d7d08e2d
msgid "FENCE\\_MARGIN\\_XY: Fence Horizontal Margin"
msgstr ""

#: ../../source/docs/parameters.rst:35605
#: 2ece6abd25554fe1856b518ea75ca243
msgid "Distance that autopilot\\'s should maintain from the fence in the horizontal plane to avoid a breach\\. If set to 0 then FENCE\\_MARGIN is used\\."
msgstr ""

#: ../../source/docs/parameters.rst:35621
#: 2b3719b9ef4247dba5dc1c172a450ec2
msgid "FFT\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:35627
#: 8f53831a20664b349f9194876daeca68
msgid "FFT\\_ENABLE: Enable"
msgstr ""

#: ../../source/docs/parameters.rst:35632
#: 4b3de6a06c6b4fcc81ce286ec445a2a6
msgid "Enable Gyro FFT analyser"
msgstr ""

#: ../../source/docs/parameters.rst:35654
#: 3460c7262f114c59aa208fc91ca04acf
msgid "FFT\\_MINHZ: Minimum Frequency"
msgstr ""

#: ../../source/docs/parameters.rst:35658
#: 0fd9850b56c84babbfdc4816f378610d
msgid "Lower bound of FFT frequency detection in Hz\\. On larger vehicles the minimum motor frequency is likely to be significantly lower than for smaller vehicles\\."
msgstr ""

#: ../../source/docs/parameters.rst:35664
#: 9e6dd5e3abbd475f83d9fa48c9012afd
msgid "20 to 400"
msgstr ""

#: ../../source/docs/parameters.rst:35673
#: f13076087c904cc5b3a9221d96c68aab
msgid "FFT\\_MAXHZ: Maximum Frequency"
msgstr ""

#: ../../source/docs/parameters.rst:35677
#: 0d6782fcc9cd4fbbade6c14cf183ad3d
msgid "Upper bound of FFT frequency detection in Hz\\. On smaller vehicles the maximum motor frequency is likely to be significantly higher than for larger vehicles\\."
msgstr ""

#: ../../source/docs/parameters.rst:35683
#: 6a819df9d3e147299c4dfa60eadc166e
msgid "20 to 495"
msgstr ""

#: ../../source/docs/parameters.rst:35692
#: 1121f255d58e46229c7172281cf068e7
msgid "FFT\\_SAMPLE\\_MODE: Sample Mode"
msgstr ""

#: ../../source/docs/parameters.rst:35697
#: 9a1cee2860d84480a16d47775ce9b40e
msgid "Sampling mode \\(and therefore rate\\)\\. 0\\: Gyro rate sampling\\, 1\\: Fast loop rate sampling\\, 2\\: Fast loop rate \\/ 2 sampling\\, 3\\: Fast loop rate \\/ 3 sampling\\. Takes effect on reboot\\."
msgstr ""

#: ../../source/docs/parameters.rst:35712
#: 019c8472a6fe40ff9c25124d5fdf3b82
msgid "FFT\\_WINDOW\\_SIZE: FFT window size"
msgstr ""

#: ../../source/docs/parameters.rst:35717
#: 5957f87f2c8e40ba8077462a79c71929
msgid "Size of window to be used in FFT calculations\\. Takes effect on reboot\\. Must be a power of 2 and between 32 and 512\\. Larger windows give greater frequency resolution but poorer time resolution\\, consume more CPU time and may not be appropriate for all vehicles\\. Time and frequency resolution are given by the sample\\-rate \\/ window\\-size\\. Windows of 256 are only really recommended for F7 class boards\\, windows of 512 or more H7 class\\."
msgstr ""

#: ../../source/docs/parameters.rst:35723
#: d06891822d614d11b08c6b1f3c20b93c
msgid "32 to 1024"
msgstr ""

#: ../../source/docs/parameters.rst:35732
#: 3a163e55a00044bbbb064be834c6f59e
msgid "FFT\\_WINDOW\\_OLAP: FFT window overlap"
msgstr ""

#: ../../source/docs/parameters.rst:35737
#: b4f88e78d6124849ad52ef127b3e383a
msgid "Percentage of window to be overlapped before another frame is process\\. Takes effect on reboot\\. A good default is 50\\% overlap\\. Higher overlap results in more processed frames but not necessarily more temporal resolution\\. Lower overlap results in lost information at the frame edges\\."
msgstr ""

#: ../../source/docs/parameters.rst:35743
#: 45e094480c2f47688029e8462faa6644
msgid "0 to 0.9"
msgstr ""

#: ../../source/docs/parameters.rst:35752
#: 1d825b67dbb64d1b9337beb1f74e2239
msgid "FFT\\_FREQ\\_HOVER: FFT learned hover frequency"
msgstr ""

#: ../../source/docs/parameters.rst:35756
#: 189f506e0d4f4e8aa6fba71338278837
msgid "The learned hover noise frequency"
msgstr ""

#: ../../source/docs/parameters.rst:35771
#: 97c286b8d3694cb4b4c8cd2c3b481df4
msgid "FFT\\_THR\\_REF: FFT learned thrust reference"
msgstr ""

#: ../../source/docs/parameters.rst:35775
#: 618b60bb3e1e4f90816b55587a2b6a11
msgid "FFT learned thrust reference for the hover frequency and FFT minimum frequency\\."
msgstr ""

#: ../../source/docs/parameters.rst:35781
#: 5ecf7423ba57433fbbacb03b9caf20df
msgid "0.01 to 0.9"
msgstr ""

#: ../../source/docs/parameters.rst:35790
#: 4e911554421d4900bfef3a453d1341eb
msgid "FFT\\_SNR\\_REF: FFT SNR reference threshold"
msgstr ""

#: ../../source/docs/parameters.rst:35794
#: 9c879507ad044b3eb217b75b65e1cc6b
msgid "FFT SNR reference threshold in dB at which a signal is determined to be present\\."
msgstr ""

#: ../../source/docs/parameters.rst:35800
#: 163f1982fa6a4f27bd862c65ea8f5404
msgid "0.0 to 100.0"
msgstr ""

#: ../../source/docs/parameters.rst:35809
#: 5ed1db606efd4f1d9dd8d2c35ec2cdc2
msgid "FFT\\_ATT\\_REF: FFT attenuation for bandwidth calculation"
msgstr ""

#: ../../source/docs/parameters.rst:35813
#: 1d469c28e4b24ceb89b9e3145c86800c
msgid "FFT attenuation level in dB for bandwidth calculation and peak detection\\. The bandwidth is calculated by comparing peak power output with the attenuated version\\. The default of 15 has shown to be a good compromise in both simulations and real flight\\."
msgstr ""

#: ../../source/docs/parameters.rst:35828
#: 90d8e18423df41b3be0a9dde1e535034
msgid "FFT\\_BW\\_HOVER: FFT learned bandwidth at hover"
