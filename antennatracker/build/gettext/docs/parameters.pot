msgstr ""

#: ../../source/docs/parameters.rst:44019
#: 39dcb50d6c82438b9275cbfd4c2f32a7
msgid "2 to 500"
msgstr ""

#: ../../source/docs/parameters.rst:44029
#: a9c6cdb6313d44ecad1e7d57611f9258
msgid "MAV Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:44035
#: e9c12a9d025f4db4a17c2a628f2aace6
msgid "MAV\\_SYSID: MAVLink system ID of this vehicle"
msgstr ""

#: ../../source/docs/parameters.rst:44039
#: d9298a04b2a54623bfd619c003f4d5c1
msgid "Allows setting an individual MAVLink system id for this vehicle to distinguish it from others on the same network\\."
msgstr ""

#: ../../source/docs/parameters.rst:44054
#: e18adfd1e75c487d8f20cb357587680c
msgid "MAV\\_GCS\\_SYSID: My ground station number"
msgstr ""

#: ../../source/docs/parameters.rst:44058
#: 80de39115bbe448993642a010616b6dc
msgid "This sets what MAVLink source system IDs are accepted for GCS failsafe handling\\, RC overrides and manual control\\. When MAV\\_GCS\\_SYSID\\_HI is less than MAV\\_GCS\\_SYSID then only this value is considered to be a GCS\\. When MAV\\_GCS\\_SYSID\\_HI is greater than or equal to MAV\\_GCS\\_SYSID then the range of values between MAV\\_GCS\\_SYSID and MAV\\_GCS\\_SYSID\\_HI \\(inclusive\\) are all treated as valid GCS MAVLink system IDs"
msgstr ""

#: ../../source/docs/parameters.rst:44073
#: 0634215359e644d784816187ee2322a9
msgid "MAV\\_GCS\\_SYSID\\_HI: ground station system ID\\, maximum"
msgstr ""

#: ../../source/docs/parameters.rst:44077
#: 646cdcaae70a469883614faf8a5da187
msgid "Upper limit of MAVLink source system IDs considered to be from the GCS\\. When this is less than MAV\\_GCS\\_SYSID then only MAV\\_GCS\\_SYSID is used as GCS ID\\. When this is greater than or equal to MAV\\_GCS\\_SYSID then the range of values from MAV\\_GCS\\_SYSID to MAV\\_GCS\\_SYSID\\_HI \\(inclusive\\) is treated as a GCS ID\\."
msgstr ""

#: ../../source/docs/parameters.rst:44092
