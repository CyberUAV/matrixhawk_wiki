#: f22867b728414c92aeaaa1d85a2d70af
msgid "**Cable_Loss** = 25dB/100m = 0.25dB per meter \\* 7 metres = \\ **1.75dB**"
msgstr ""

#: ../../source/docs/common-antenna-design.rst:364
#: a74fd35013e84464bd2db99c52072cb1
msgid "**Antenna_Gain** = **14dBi**"
msgstr ""

#: ../../source/docs/common-antenna-design.rst:366
#: e0c4451ee5a94063bb4805e555b4177d
msgid "**Output_Power** = **TX_Power** - **Cable_Loss** + **Antenna_Gain**"
msgstr ""

