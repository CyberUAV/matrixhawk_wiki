#: 7f354627e73141c28b0c364abccce62c
msgid "PWM 1 through 4 (M1 - M4) are in Group1"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:338
#: f54b998ced3d4ed9b4af52ea8ddd1d2c
msgid "PWM 5 through 8 (M5 - M8) are in Group2"
msgstr ""

#: ../../source/docs/common-luxf765-ndaa.rst:340
#: b1ed9e95081b4da7a518a379d6262ba1
msgid "The auxiliary PWM outputs are grouped as follows:"
