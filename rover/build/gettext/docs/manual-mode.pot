#: ../../source/docs/manual-mode.rst:5
#: 9e731887bbe6437b96e197b0f2d58522
msgid "Manual mode"
msgstr ""

#: ../../source/docs/manual-mode.rst:7
#: 967cf81367fa47e0afd6c0be4bd6375f
msgid "In Manual mode, the transmitter's steering and throttle sticks directly control the vehicle's throttle and steering output."
msgstr ""

#: ../../source/docs/manual-mode.rst:9
#: 723c1afa05bf40fa92bc9cd399a808b8
msgid "This mode does not require a position estimate (i.e. GPS is not required)."
msgstr ""

#: ../../source/docs/manual-mode.rst:10
#: bd89e9f4081244b199e0b28b3f991b8b
msgid "It is recommended to always have one :ref:`transmitter mode switch <common-rc-transmitter-flight-mode-configuration>` position assigned to this mode."
msgstr ""

#: ../../source/docs/manual-mode.rst:11
#: 7393d1d296ea4150a2d4f4e7c1a70b36
msgid "The throttle slew still applies. See the bottom of the :ref:`Tuning Speed and Throttle <rover-tuning-throttle-and-speed>` page for more details about the throttle slew limit."
msgstr ""

#: ../../source/docs/manual-mode.rst:12
#: 8c3a06654b8641e2b1148a5ee8940d68
msgid "Steering angle speed scaling can be enabled via the first bit of :ref:`MANUAL_OPTIONS<MANUAL_OPTIONS>`. This requires a ground speed estimate from one of many types of sensors."
msgstr ""

#: ../../source/docs/manual-mode.rst:13
#: eee2f761ff1c46dcb9994c65760ad9e9
msgid "Steering expo can be applied using :ref:`MANUAL_STR_EXPO<MANUAL_STR_EXPO>` to decrease transmitter steering control sensitivity around neutral."
msgstr ""
