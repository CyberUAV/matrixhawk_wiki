#: ../../source/docs/wheel-encoder.rst:5
#: 68ca024796f04f239dbf94f5b8a8dc49
msgid "Wheel Encoders"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:7
#: cfc87965a0e843cbb8e33de77dc2bf62
msgid "Rover supports up to two \"AB\" wheel encoders like those in `this Pololu motor <https://www.pololu.com/product/1442>`__ which can be used to improve position estimation especially when no GPS is used."
msgstr ""

#: ../../source/docs/wheel-encoder.rst:14
#: 3f2314f8cadc4ab79b45a4772eed39ae
msgid "Connection and Setup"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:19
#: 6507504980c44e2f826d0d361d008731
msgid "connect motor encoder's A and B outputs to the autopilot (A Pixhawk using AUX OUT 3,4,5 and 6 pins is shown for example above)."
msgstr ""

#: ../../source/docs/wheel-encoder.rst:20
#: 04018fb9fe9448e597b39eaf9406cba0
msgid "set those output's ``SERVOx_FUNCTION`` to -1 to allow them to be used as GPIO inputs. See :ref:`common-gpios` for more information. For the example above, set :ref:`SERVO11_FUNCTION<SERVO11_FUNCTION>`, :ref:`SERVO12_FUNCTION<SERVO12_FUNCTION>`, :ref:`SERVO13_FUNCTION<SERVO13_FUNCTION>`, and :ref:`SERVO14_FUNCTION<SERVO14_FUNCTION>` to \"-1\"."
msgstr ""

#: ../../source/docs/wheel-encoder.rst:21
#: 85f9021a44ce422e9aa425d4299226fd
msgid "set :ref:`WENC_TYPE <WENC_TYPE>` and :ref:`WENC2_TYPE <WENC_TYPE>` to 1 to enable reading from two wheel encoders"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:22
#: 8d85c6bba47a4b5892d3e35313554e86
msgid "set :ref:`WENC_CPR <WENC_CPR>` and :ref:`WENC2_CPR <WENC2_CPR>` to the counts-per-revolution of the encoder.  This is the number of \"pings\" the encoder will produce for each full revolution of the wheel"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:23
#: 7656dea404ce4f67afc77f8f7b0cb234
msgid "set :ref:`WENC_RADIUS <WENC_RADIUS>` and :ref:`WENC2_RADIUS <WENC2_RADIUS>` to the radius (in meters) of each wheel (i.e. 5cm radius would be 0.05)"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:24
#: 6347a6683e4c44a09adff0349f7dc92a
msgid "set :ref:`WENC_POS_X <WENC_POS_X>` and :ref:`WENC_POS_Y <WENC_POS_Y>` to define the first wheel's distance from the autopilot or COG (i.e. :ref:`WENC_POS_X <WENC_POS_X>` = 0.10, :ref:`WENC_POS_Y <WENC_POS_Y>` = -0.05 means the wheel is 10cm ahead and 5cm left of the autopilot)"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:25
#: 77961f54ac9c4aa9a71e95726b29e649
msgid "set :ref:`WENC2_POS_X <WENC2_POS_X>` and :ref:`WENC2_POS_Y <WENC2_POS_Y>` to define the second wheel's distance from the autopilot or COG"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:26
#: b23454064f7c4c419009f6b44bd0908d
msgid "disable :ref:`relays <common-relay>` by setting :ref:`RELAY1_PIN <RELAY1_PIN>` and :ref:`RELAY2_PIN <RELAY2_PIN>` to -1"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:28
#: 4d90c4d8507e471496da8c4c0eb74327
msgid "To enable position estimation using the wheel encoders the EKF3 must be used and configured as follows:"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:30
#: 0f596a13c733474ab549aa4b24834f21
msgid "set :ref:`AHRS_EKF_TYPE <AHRS_EKF_TYPE>` to 3 (means use EKF3)"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:31
#: e8a20d201e574dd7a38fc8e7267b7c7a
msgid "set :ref:`EK2_ENABLE <EK2_ENABLE>` to 0 (disable EKF2)"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:32
#: 85f3d79c58bd4a42bdd46b088c7d807b
msgid "set :ref:`EK3_ENABLE <EK3_ENABLE>` to 1 (enable EKF3)"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:33
#: 4db2e22c267c4c56a3a54e7be10d118e
msgid "set :ref:`EK3_SRC1_VELXY <EK3_SRC1_VELXY>` to 7 (\"WheelEncoder\")"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:34
#: 33e76924e995447896648688ca6a1a46
msgid "(optionally) set :ref:`EK3_SRC1_POSXY <EK3_SRC1_POSXY>` to 0 (\"None\") to disable use of GPS for horizontal position"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:35
#: beece810c57d4771a34f56f78110f496
msgid "(optionally) set :ref:`EK3_SRC1_VELZ <EK3_SRC1_VELZ>` to 0 (\"None\") to disable use of GPS for vertical velocity"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:37
#: 66e4f49bfe254682b54a2582a9f0b3e7
msgid "After making the above changes the autopilot should be rebooted"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:40
#: 159698dc3ae64fd5a848cd0bfb279a4f
msgid "Ground Testing"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:42
#: 849d8a68349e4577a730d65c7a8f5c9b
msgid "The ``WHEEL_DISTANCE`` MAVLink message shows the total distance travelled by each wheel in real time.  Mission Planner's MAVLink Inspector can be used which can be opened by pressing Ctrl-F and then pushing the \"MAVLink Inspector\" button."
msgstr ""

#: ../../source/docs/wheel-encoder.rst:47
#: 78bec5cb9a6e436b9d1f8657594e0146
msgid "DataFlash logging"
msgstr ""

#: ../../source/docs/wheel-encoder.rst:49
#: 47acf68f906940529ded86b1e52f4857
msgid "The wheel encoder data including total distance travelled by each wheel appears in the WENC dataflash log messages."
msgstr ""
