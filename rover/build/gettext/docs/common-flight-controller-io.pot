#: ../../source/docs/common-flight-controller-io.rst:188
#: 57b0662d46f44267bd8658965aeb78c9
#: d31b5de4c7284fd4966b4d2ed86b9e83
#: 51eb864b9f984a0a95eccd1129f28e95
#: 30da92db81444791a9047d58b81e7b0b
#: 0295054c62bc4837a38881df81a73625
