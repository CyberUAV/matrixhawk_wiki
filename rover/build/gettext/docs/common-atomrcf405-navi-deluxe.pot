msgstr ""

#: ../../source/docs/common-atomrcf405-navi-deluxe.rst:113
#: 3a2f93a7d73f494aa0a1af5cdc9e9044
msgid "DSM/SRXL connects to the RX6  pin"
msgstr ""

#: ../../source/docs/common-atomrcf405-navi-deluxe.rst:115
#: e370bb60a5a341589bc15f0843a66b62
msgid "FPort requires connection to TX2 and RX2 via a bi-directional inverter. See :ref:`common-FPort-receivers`."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi-deluxe.rst:117
#: 450050d4d5d148fea467cd632dc84260
msgid "CRSF/ELRS also requires a TX2 connection, in addition to RX2, and automatically provides telemetry."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi-deluxe.rst:119
#: 34071d2513e74e138bd5d7a83c8f015d
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry.  Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-atomrcf405-navi-deluxe.rst:121
#: 4212ee3c488c4e238d7b4f975c825e64
msgid "the 5v pin above the SBUS pin is powered when USB is connected. All other 5V pins are only powered when battery is present."
