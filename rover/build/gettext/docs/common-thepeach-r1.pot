#: ../../source/docs/common-thepeach-r1.rst:64
#: f949c79accff4b0c8e223f8c53b9d75c
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:66
#: 9ecbaedb0c07427782f4ffdf06157a2b
msgid "The RCIN pin, which by default is mapped to timer input, can be used for all ArduPilot supported receiver protocols, except CRSF/ELRS and SRXL2 which require a true UART connection. However, Fport, when connected in this manner, will only provide RC without telemetry"
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:68
#: 6f7eda318aa34433b2dc028887a245bf
msgid "To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 receivers, a full UART, such as SERIAL4(UART8) would need to be used for receiver connections. Below are setups using UART8. :ref:`SERIAL4_PROTOCOL<SERIAL4_PROTOCOL>` should be set to “23”."
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:70
#: b2ff6c862642433b9bb1006ead550be0
msgid "Fport would require :ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` be set to”15”"
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:71
#: 11c87bcd1a1e4764bab1c61f2c0c6ee0
msgid "CRSF would require :ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` be set to “0”"
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:72
#: 0bda1079b57446dba5a5225c97b135aa
msgid "SRXL2 would require :ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` be set to “4” and connects only the UART8 TX pin."
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:74
#: d0985b48a87f4b7f8c55a13ba6834aba
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`Radio Control Systems <common-rc-systems>` for details."
msgstr ""

