#: ../../source/docs/loiter-mode.rst:5
#: 2c6d1fb043b6416da8267f0d002a3862
msgid "Loiter Mode"
msgstr ""

#: ../../source/docs/loiter-mode.rst:10
#: db25b91667be4b078b120d16e0885399
msgid "Loiter mode allows boats to hold position in a strong current."
msgstr ""

#: ../../source/docs/loiter-mode.rst:12
#: 7d4a6d74310a4574a268b8cf5b3a70fb
msgid "The way this mode works is:"
msgstr ""

#: ../../source/docs/loiter-mode.rst:14
#: 14335adbd56d4d47b89e0bed943025d1
msgid "the user switches into Loiter mode and the vehicle’s current position, velocity and maximum deceleration are used to project a reasonable stopping point"
msgstr ""

#: ../../source/docs/loiter-mode.rst:15
#: 6d3ea619fbb2457a85a28de8c677aec2
msgid "while the boat is within the :ref:`LOIT_RADIUS<LOIT_RADIUS>` of the target it simply drifts"
msgstr ""

#: ../../source/docs/loiter-mode.rst:16
#: 2169b0cfc82e46f09b5eee7d892632a8
msgid "if/when the boat strays more than :ref:`LOIT_RADIUS<LOIT_RADIUS>` from the target it:"
msgstr ""

#: ../../source/docs/loiter-mode.rst:18
#: 12783ae3a36445e191fb05362edec637
msgid "rotates to point either directly towards the target or directly away from it (whichever results in less rotation)"
msgstr ""

#: ../../source/docs/loiter-mode.rst:19
#: 26aecd0f7daa4971828460e642467b57
msgid "drives/floats forwards or backwards at 0.5 m/s * the distance to the edge of the circle around the target, but at a speed no greater than :ref:`WP_SPEED<WP_SPEED>`."
msgstr ""

#: ../../source/docs/loiter-mode.rst:24
#: 669c94cd6847465da92ea0e20008182b
msgid "In order to obtain the optimum performance, the ESC deadband should be small. The :ref:`MOT_THR_MIN<MOT_THR_MIN>` can be used to compensate for ESC deadband. See this :ref:`section<rover-motor-and-servo-min-throttle>` for details."
msgstr ""
