#: ../../source/docs/rover-object-avoidance.rst:5
#: 21b9b0fde0a943ffb1d5c5730f7fd173
msgid "Archived: Object Avoidance"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:7
#: 43123abed12a42d3b7cb2e28f38a93f1
msgid "Rover supports two forms of object avoidance which can be enabled separately or simultaneously"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:9
#: 33cf2aafc4874c35a653854abdf8d302
msgid "\"dodge\" avoidance attempts to steer around obstacles in :ref:`Steering <steering-mode>`, :ref:`RTL <rtl-mode>`, :ref:`SmartRTL <smartrtl-mode>`, :ref:`Guided <guided-mode>` and :ref:`Auto <auto-mode>` modes"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:10
#: fb027edebb8b423ea275f51fb23b1570
msgid "\"simple\" object avoidance attempts to stop the vehicle before it hits objects in :ref:`Acro <acro-mode>`, :ref:`Steering <steering-mode>`, :ref:`Loiter <loiter-mode>` and :ref:`Guided <guided-mode>` modes"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:13
#: 97e67d51054b443684581bbcb8c85df1
msgid "\"Dodge\" Avoidance"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:21
#: 61a3e64ddf4a4dcd83cbd2ea24be6a48
msgid "Dodge only works with forward facing range finders (sonar/lidar).  360 degree lidar cannot be used for this method of avoidance"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:23
#: efa4d9d5331c48aa852a963f1a5896cc
msgid "One or two range finders should be mounted facing forward as described on the :ref:`range finder wiki pages <common-rangefinder-landingpage>`"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:24
#: 8513ee9950bb489b93b64df7f77edb8c
msgid "RNGFND_TRIGGR_CM specifies the distance in cm at which the vehicle will begin turning.  I.e. 100 will mean the vehicle will begin turning 1m from the object. Set this value to 0 if you want the vehicle to stop instead of going around the obstacle."
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:25
#: fddd815b031b44cb80655ee37b668386
msgid "RNGFND_TURN_ANGL controls the direction and aggressiveness of the turn.  Large positive or negative values (i.e. -450 or 450) cause turns up to the vehicle's maximum lateral acceleration (i.e. :ref:`ATC_TURN_MAX_G <ATC_TURN_MAX_G>`) while values near zero cause gentle turns.  Negative values cause the vehicle to turn left, positive causes a turn right."
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:26
#: 6c74a123adb74873a6b683a0493b96fd
msgid "RNGFND_TURN_TIME controls how many seconds the vehicle will continue turning after the object has gone out of view."
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:27
#: a5e79eb80c4c4b42812156162bb0a708
msgid "RNGFND_DEBOUNCE specifies how many consecutive readings are required to trigger the turn response.  A higher number reduces false positives but also adds a small lag in the response."
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:29
#: cc61a65d852c40f89e152d55e58d98fd
msgid "This \"dodge\" method of avoidance can only be activated in :ref:`Steering <steering-mode>`, :ref:`RTL <rtl-mode>`, :ref:`SmartRTL <smartrtl-mode>`, :ref:`Guided <guided-mode>` and :ref:`Auto <auto-mode>` modes."
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:32
#: 24e4ce6e72474d358a00e94c23cc34af
msgid "Simple Avoidance (Stopping)"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:37
#: 4b76e82c2b434f95b5b873b8b8401333
msgid "This form of avoidance attempts to stop the vehicle before hitting objects."
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:39
#: a1b0a43ce3294d1c8c5865f8360919cb
msgid "follow the normal :ref:`instructions for setting up rangefinders <common-rangefinder-landingpage>`"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:40
#: a932affbae3d492484e95adfd6389c22
msgid "if using regular lidar or sonar (i.e. not 360 degree lidar):"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:43
#: 4b4592fd81504cd2be53a00be11883fc
msgid "set ``RNGFNDx_ORIENT`` (for example :ref:`RNGFND1_ORIENT<RNGFND1_ORIENT>` ) to \"0\" for forward facing lidar and \"4\" for backwards facing lidar"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:44
#: 2439e960b5474e8e821f29e23d87af13
msgid "set ``PRX_TYPE`` = \"4\" to enable using range finders as \"proximity sensors\""
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:45
#: 73f00c3b16814acba3d114a6e2ee447d
msgid "set :ref:`AVOID_ENABLE <AVOID_ENABLE>` to \"7\" to enable avoidance using proximity sensors (and fences)"
msgstr ""

#: ../../source/docs/rover-object-avoidance.rst:48
#: aac6bef868e940329bc0dc75d7f06edd
msgid "This \"simple\" method of avoidance can only be activated in :ref:`Acro <acro-mode>`, :ref:`Steering <steering-mode>`, :ref:`Loiter <loiter-mode>` and :ref:`Guided <guided-mode>` modes."
msgstr ""
