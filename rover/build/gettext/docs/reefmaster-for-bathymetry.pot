msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:51
#: cd22ee36526e4121af3f3ffefb976406
msgid "The \"Import GPS Assets\" window should appear next, press the check button on the bottom right"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:52
#: a54392c4bff84846af6cc8df5a723ad9
msgid "Press the arrow on the top left to return to the main view"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:53
#: 26e29b9e343a496187db022b7781db3f
msgid "Under \"Tracks\", right-mouse-button-click on the new track and \"Add Track to Map Project\" >> \"New Project\".  The sonar data should appear on the map."
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:59
#: f7217e6f950845d8a1883700f92119c5
msgid "Creating 2D/3D maps"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:61
#: af1893dadde1410c89ec647b32c39e94
msgid "Under \"Project\", push \"Define Map Area\" and select an area with sonar data"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:66
#: 5329da8e43554fce88be8fc83c234837
msgid "Push \"Generate Map\" and \"Map View\" buttons to produce a 2D map"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:71
#: 2b65a3479299421ebbb3de5f3f3030ee
msgid "Push \"3D View\" to produce a 3D map"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:76
#: 9ff3666f13c94a4a9481b9a0822d5998
msgid "Push \"Export\" >> \"Export Map Project\" to create images or Google Earth KMZ files"
msgstr ""
