#: ../../source/docs/reefmaster-for-bathymetry.rst:5
#: 63a3273b3f8e483387d254fdfa6b0dc4
msgid "ReefMaster"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:10
#: f104e6159a344a19b299e35c86ac4ce0
msgid "`ReefMaster <https://reefmaster.com.au/>`__ is a popular tool for analysing sonar data.  This page provides steps for uploading sonar data collected by an ArduPilot drone boat to ReefMaster to produce 2D and 3D maps."
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:12
#: fc4454f7a8b642658c4a41d6e4a93268
msgid "Note that these instructions apply to boats with a sonar directly connected to the autopilot and the lidar is providing only simple distances.  ArduPilot does not yet support directly consuming sidescan or backscatter data from a sonar."
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:15
#: 9fa3e2da650c4cb5a1c5bc957e712a15
msgid "Steps before Mapping"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:17
#: da0d1bc406bd424889475c4f23e6cf41
msgid "The vehicle should be :ref:`setup as a boat <boat-configuration>` meaning :ref:`FRAME_CLASS <FRAME_CLASS>` should be set to \"2\" (Boat)"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:18
#: ebc9aafd3fd74c7c9902bd1f9b66baf3
msgid "The :ref:`sonar <common-underwater-sonars-landingpage>` should be directly connected to the autopilot with :ref:`RNGFNDx_ORIENT <RNGFND1_ORIENT>`  = \"25\" (Down)"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:19
#: eb3996bae14940f197cfa4cea8ae5ca8
msgid ":ref:`Onboard logs <common-downloading-and-analyzing-data-logs-in-mission-planner>` can be large so ensure the autopilot has a good quality SD card inserted with sufficient space (8GB or larger is a good choice)"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:22
#: 837de313b9cf41ee95b6cfda9ce2227f
msgid "Extract DPTH messages from the Onboard Log"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:24
#: 7d79c6df363b41b4bbfa1f87f3252b0b
msgid ":ref:`Download the Onboard Logs over MAVLink <common-downloading-and-analyzing-data-logs-in-mission-planner>` or eject the autopilot's SD card, insert it into your PC and directly copy the .BIN files from the APM/LOGS directory to your PC"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:25
#: 1ae1c441aec7402288732e30866dc077
msgid "Open the .BIN file using Mission Planner's Data >> DataFlash Logs >> Review a Log feature"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:26
#: 1aef5a77ad4740328c9bbfc156202564
msgid "Check the \"Data Table\" checkbox, then click anywhere on the data table's column header and select \"DPTH\" from the drop-down and push the \"Filter\" button"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:31
#: 6fcbe593e1a143c490f28538cdbc6b14
msgid "Right-mouse-button-click in the data area and select \"Export Visible\" and save to a .csv file"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:37
#: 0eb50b8f505e4232a4ebbfe32605eb14
msgid "Import to ReefMaster"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:39
#: 2df63a76ac4046fb862d904a127c1324
msgid "Open ReefMaster and create a new workspace"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:40
#: 3c5f1bd94266454aa4ee02e7378db371
msgid "Select File, Import Logs and Waypoints, Browse and select the CSV file produced above"
msgstr ""

