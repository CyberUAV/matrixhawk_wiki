#: 2d8995bd4bd543cb8f8b8d97d188d6ea
msgid "Latitude: 6"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:45
#: 91caf3c0716e40c1a960439f7cf9eca5
msgid "Longitude: 7"
msgstr ""

#: ../../source/docs/reefmaster-for-bathymetry.rst:46
#: a85270aaefb341cc9d1356391a307230
