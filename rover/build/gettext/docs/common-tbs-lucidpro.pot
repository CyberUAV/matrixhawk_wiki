#: ../../source/docs/common-tbs-lucidpro.rst:47
#: 55bd16aaae654715bf0fbf41130353d0
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:48
#: 4d0c843b13be4abba4f8c72b67799df1
msgid "RC input is configured by default on  SERIAL1. It supports all serial RC protocols except PPM and SBUS. For SBUS use SERIAL2, set its protocol to RCIN (\"23\") and change :ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>` to something other than RCIN (\"23\")."
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:50
#: bb299e6924914cc2b97d687cc606e485
msgid "If the receiver is FPort the receiver must be tied to the SERIAL1 TX pin, :ref:`RSSI_TYPE<RSSI_TYPE>` set to 3, and :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` must be set to 7 (invert TX/RX, half duplex)."
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:51
#: 23f0db86fb7e4228b499345b079b1220
msgid "For full duplex like CRSF/ELRS use both RX1 and TX1 and set :ref:`RSSI_TYPE<RSSI_TYPE>` also to 3."
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:54
#: d12f5120a2194e7b8e514314b65379a6
msgid "FrSky Telemetry"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:55
#: b3967977d73c4f778fb06a1e834060e9
msgid "FrSky Telemetry is supported using an unused UART, such as the TX4 pin (UART4 transmit). You need to set the following parameters to enable support for FrSky S.PORT:"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:59
#: 1240a6f0c50e493a8af1831d9ada315b
msgid ":ref:`SERIAL4_PROTOCOL<SERIAL4_PROTOCOL>` = 10"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:60
#: 0a42f44ddd5443f2b802f4353916818a
msgid ":ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` = 7"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:63
#: 690b5b78d77f46e6b32992d02e71fae7
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:64
#: 53723985bd494d03ba2e17935a140a4a
msgid "The TBS LUCID PRO supports OSD using the integrated OSD chip (MAX7456 driver) and simultaneously DisplayPort using TX3/RX3 on the HD VTX connector."
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:67
#: 0a7f89e22185452fbec389eae8c5c4de
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:68
#: 8375d31c44884f2a8e3c57042cfd25a7
msgid "The TBS LUCID PRO supports up to 6 PWM or DShot outputs. The pads for motor output M1 to M4 are provided on both the motor connector and on separate pads, plus M5-6 on a separate pads for LED strip and camera control."
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:72
#: 0ebdb376950b46049f89deb5e986b5c8
msgid "The PWM is in 3 groups:"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:75
#: 43ae664a0ec54077a5205d1762d5c00c
msgid "PWM 1-2   in group1"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:76
#: 7f80d37d071f4ce5b9e3b60aeb508585
msgid "PWM 3-4   in group2"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:77
#: 8d2f0db223874b79b29b47501ea689b6
msgid "PWM 5-6   in group3 (No DShot). PWM5 marked as \"CAMC\", PWM6 as \"LED\""
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:79
#: de559ad06bae4c89929de146994007e5
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-4 support bi-directional dshot."
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:84
#: 8e870f12494d439ba0df12aef5e1d700
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-tbs-lucidpro.rst:85
#: 59a288d3262e4a978af31476d684fb35
msgid "The board has a built-in voltage sensor and external current sensor input. The current sensor can read up to 130 Amps. The voltage sensor can handle up to 6S LiPo batteries."
msgstr ""

