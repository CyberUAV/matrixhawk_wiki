#: 190ede8ea9ff41d2af8ba4553920c17a
msgid "Hardware Watchdog"
msgstr ""

#: ../../source/docs/rover-failsafes.rst:114
#: 924673d330fa480dad45a2251791270c
msgid "See :ref:`common-watchdog` for details."
msgstr ""
