#: ../../source/docs/introduction.rst:5
#: 5ddc54eb9c5f4d929fdee7e82f67326b
msgid "Getting Started with Rover"
msgstr ""

#: ../../source/docs/introduction.rst:7
#: 781856b5f40443639c251d247f53d4b7
msgid "To start with Rover, you will first need a rover with a :ref:`ArduPilot compatible autopilot <common-autopilots>`. You can either select from a list of :ref:`ready-to-drive vehicles<common-rtf>` or  assemble your own (See below)."
msgstr ""

#: ../../source/docs/introduction.rst:14
#: e46fd888c923407a9172b832df0bfe46
msgid "Choosing a Ready-To-Drive Vehicle"
msgstr ""

#: ../../source/docs/introduction.rst:16
#: fd8759f0127a43f386de3a0567dbf32e
msgid "Opting for a :ref:`ready-to-drive vehicle <common-rtf>` means you'll receive a pre-configured and finely tuned rover that is prepared for its maiden drive. To operate it, you will need to :ref:`install a ground station <common-install-gcs>` and proceed to the :ref:`First Drive <rover-first-drive>` instructions. Prior to operating, it is important to follow the manufacturer's guidelines, especially related to safety."
msgstr ""

#: ../../source/docs/introduction.rst:22
#: b897411dd10e4d07bf63b6616cb39130
msgid "Regardless of using a pre-assembled or a Do-It-Yourself (DIY) vehicle, remember that autonomous vehicles can pose hazards! It's critical to adhere to recommended safety practices and pay attention to all safety warnings."
msgstr ""

#: ../../source/docs/introduction.rst:25
#: dc61b2cc353c4d699daa7089637ce582
msgid "Building Your Own Rover"
msgstr ""

#: ../../source/docs/introduction.rst:27
#: 4c5e3770892d47b6afe96275dd1f9178
msgid "If you are interested in building your own rover, the following references will guide you through the process:"
msgstr ""

#: ../../source/docs/introduction.rst:29
#: 8d844afe902c4ad9b1bb35f4e6982337
msgid "Start by familiarizing yourself with :ref:`Selecting a Frame <selecting-a-frame>` and :ref:`Choosing Hardware <choosing-hardware>` sections."
msgstr ""

#: ../../source/docs/introduction.rst:30
#: e5db38dd56804b99af0091ae50079c13
msgid "Then, proceed to the :ref:`Select an Autopilot Board <common-autopilots>` section to select an autopilot."
msgstr ""

#: ../../source/docs/introduction.rst:31
#: dd29e14c47be48b8abd33e8fec8fe9ed
msgid "After choosing a frame, autopilot, and required hardware, :ref:`Pick a Ground Control Station <common-choosing-a-ground-station>`."
msgstr ""

#: ../../source/docs/introduction.rst:32
#: c0c7a012f70c461c92887afab8234682
msgid "Navigate to :ref:`First Time Setup <apmrover-setup>` to begin the initial setup."
msgstr ""

#: ../../source/docs/introduction.rst:33
#: dd68d70b58024c388ab9a74b4036d474
msgid "Finally, consult :ref:`First Drive and Tuning <rover-first-drive>` for driving and tuning advice."
msgstr ""
