#: ../../source/docs/sailboat-modes.rst:5
#: 28cefb28b173423880a25fa634208b51
msgid "Modes"
msgstr ""

#: ../../source/docs/sailboat-modes.rst:7
#: 42140679bdee454f9fbb6b218d315730
msgid "This outlines the differences in sailboat behavior from the standard Rover :ref:`modes <rover-control-modes>`."
msgstr ""

#: ../../source/docs/sailboat-modes.rst:10
#: 716be1f2319440a08828cde7529e1759
msgid "Manual"
msgstr ""

#: ../../source/docs/sailboat-modes.rst:11
#: 7aa3ddfa2668468086a57877196311fc
msgid "Sail position is directly controlled by throttle position. Minimum throttle is sail fully in, maximum throttle is sail fully released. You may find the controller disarms when tacking to the left travelling upwind with the sails tight. If this is an issue disable :ref:`stick disarming <ARMING_RUDDER>`."
msgstr ""

#: ../../source/docs/sailboat-modes.rst:16
#: c438bc107e8344c8805e99b2d4f9cc28
msgid "ACRO"
msgstr ""

#: ../../source/docs/sailboat-modes.rst:17
#: 814668012b2344a3a56422c1c5718560
msgid "The Sail is automatically trimmed to the wind direction using the wind vane. A tack can be triggered from an aux switch; the vehicle will match its current angle to the true wind on the new tack. Note that the vehicle will only try to sail if the operator is requesting some forward speed with the throttle input. With 0 throttle input the vehicle will let out its sail in a attempt to stop."
msgstr ""

#: ../../source/docs/sailboat-modes.rst:23
#: 90d94471a4db466f836243db49282335
msgid "Loiter"
msgstr ""

#: ../../source/docs/sailboat-modes.rst:27
#: d46f4d1131394d6ba112ddf46e4db818
msgid "The vehicle will keep moving within the :ref:`loiter radius <LOIT_RADIUS>`."
msgstr ""

#: ../../source/docs/sailboat-modes.rst:31
#: 76896a9620e243f9aa0fce2fb5d4df9b
msgid "RTL"
msgstr ""

#: ../../source/docs/sailboat-modes.rst:32
#: 8260920d012a497ba543e4aba7a728c4
msgid "The vehicle will tack upwind back to the home location if required."
msgstr ""

#: ../../source/docs/sailboat-modes.rst:35
#: f2a245128774488fa2e3dc53860b6267
msgid "AUTO"
msgstr ""

#: ../../source/docs/sailboat-modes.rst:39
#: 52a8aca4cd2f40ac98170192bc12013d
msgid "The vehicle will tack upwind to reach the next waypoint if required. Note that if the vehicle has to tack it will not stay on the line between waypoints. While traveling upwind a tack can be triggered from an aux switch or by a maximum cross track error defined by ``WP_OVERSHOOT <WP_OVERSHOOT>``."
msgstr ""
