#: ../../source/docs/parameters.rst:1810
#: 8856425cb4ab465692b2733b0c2e8fdd
msgid "AHRS\\_GPS\\_USE: AHRS use GPS for DCM navigation and position\\-down"
msgstr ""

#: ../../source/docs/parameters.rst:1814
#: 713bc6afaaf7421ab256b35ffb1ca3e9
msgid "This controls whether to use dead\\-reckoning or GPS based navigation\\. If set to 0 then the GPS won\\'t be used for navigation\\, and only dead reckoning will be used\\. A value of zero should never be used for normal flight\\. Currently this affects only the DCM\\-based AHRS\\: the EKF uses GPS according to its own parameters\\. A value of 2 means to use GPS for height as well as position \\- both in DCM estimation and when determining altitude\\-above\\-home\\."
msgstr ""

#: ../../source/docs/parameters.rst:1825
#: 7c65fd9a325c4a5dad1c15a7f9f29147
msgid "Use GPS for DCM position"
msgstr ""

#: ../../source/docs/parameters.rst:1827
#: a8ee22ec738e49529fc5209dd217d9cf
msgid "Use GPS for DCM position and height"
msgstr ""

#: ../../source/docs/parameters.rst:1838
#: c9892e71ead04d4399590a1bf480cdda
msgid "AHRS\\_YAW\\_P: Yaw P"
msgstr ""

#: ../../source/docs/parameters.rst:1842
#: 29ecc0961b6441188a0f44fdecd84cb1
msgid "This controls the weight the compass or GPS has on the heading\\. A higher value means the heading will track the yaw source \\(GPS or compass\\) more rapidly\\."
msgstr ""

#: ../../source/docs/parameters.rst:1848
#: ../../source/docs/parameters.rst:1867
#: 7fa4aab4d9af410cb4be9d99bf044b39
#: 9fffdee98a67414d9a0eaae2b85dd569
msgid "0.1 to 0.4"
msgstr ""

#: ../../source/docs/parameters.rst:1857
#: 26febe505a134e6e8dd1384fe60570e1
msgid "AHRS\\_RP\\_P: AHRS RP\\_P"
msgstr ""

#: ../../source/docs/parameters.rst:1861
#: b75747544f374b21befada0ec0373097
msgid "This controls how fast the accelerometers correct the attitude"
msgstr ""

#: ../../source/docs/parameters.rst:1876
#: 9b3da7d85d834725a111742122b39dae
msgid "AHRS\\_WIND\\_MAX: Maximum wind"
msgstr ""

#: ../../source/docs/parameters.rst:1880
#: 62503f94926d4826b56fec5d74de0f11
msgid "This sets the maximum allowable difference between ground speed and airspeed\\. A value of zero means to use the airspeed as is\\. This allows the plane to cope with a failing airspeed sensor by clipping it to groundspeed plus\\/minus this limit\\. See ARSPD\\_OPTIONS and ARSPD\\_WIND\\_MAX to disable airspeed sensors\\."
msgstr ""

