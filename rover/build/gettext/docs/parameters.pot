msgid "BB Blue GP0 pin 5"
msgstr ""

#: ../../source/docs/parameters.rst:1499
#: 61466fc866df40d1b7a5f7339d51e090
msgid "AFS\\_WP\\_COMMS: Comms Waypoint"
msgstr ""

#: ../../source/docs/parameters.rst:1503
#: 4da456e6145d4b49b182e081491fb2fa
msgid "Waypoint number to navigate to on comms loss"
msgstr ""

#: ../../source/docs/parameters.rst:1509
#: f5b52679110b4a9ca67d114f9c4a2e68
msgid "AFS\\_WP\\_GPS\\_LOSS: GPS Loss Waypoint"
msgstr ""

#: ../../source/docs/parameters.rst:1513
#: 4a2e41dbb47e425d886d164304ad1915
msgid "Waypoint number to navigate to on GPS lock loss"
msgstr ""

#: ../../source/docs/parameters.rst:1519
#: 3bbb341cf1164334b24aaf057943097d
msgid "AFS\\_TERMINATE: Force Terminate"
msgstr ""

#: ../../source/docs/parameters.rst:1523
#: 8dd7123f59d54efba511e6523ee472bf
msgid "Can be set in flight to force termination of the heartbeat signal"
msgstr ""

#: ../../source/docs/parameters.rst:1529
#: f87d545e31b94578b3ab1aadf2199907
msgid "AFS\\_TERM\\_ACTION: Terminate action"
msgstr ""

#: ../../source/docs/parameters.rst:1533
#: 547908a140dc40a0867e67c36a24a0c7
msgid "This can be used to force an action on flight termination\\. Normally this is handled by an external failsafe board\\, but you can setup ArduPilot to handle it here\\. Please consult the wiki for more information on the possible values of the parameter"
msgstr ""

#: ../../source/docs/parameters.rst:1539
#: e94f5fc3b8c04c62ae68524c219911c6
msgid "AFS\\_TERM\\_PIN: Terminate Pin"
msgstr ""

#: ../../source/docs/parameters.rst:1543
#: da365c8d6781469cbf95b44c259f5e26
msgid "This sets a digital output pin to set high on flight termination\\. Some common values are given\\, but see the Wiki\\'s \\\"GPIOs\\\" page for how to determine the pin number for a given autopilot\\."
msgstr ""

#: ../../source/docs/parameters.rst:1583
#: d07046d901b24bd28f7fd62ac1cb7b3b
msgid "AFS\\_AMSL\\_LIMIT: AMSL limit"
msgstr ""

#: ../../source/docs/parameters.rst:1587
#: d203c676c0004ba1a65443c20fb2f993
msgid "This sets the AMSL \\(above mean sea level\\) altitude limit\\. If the pressure altitude determined by QNH exceeds this limit then flight termination will be forced\\. Note that this limit is in meters\\, whereas pressure altitude limits are often quoted in feet\\. A value of zero disables the pressure altitude limit\\."
msgstr ""

#: ../../source/docs/parameters.rst:1602
#: 8ccd6c4310c14cd888074a2d61cbd915
msgid "AFS\\_AMSL\\_ERR\\_GPS: Error margin for GPS based AMSL limit"
msgstr ""

#: ../../source/docs/parameters.rst:1606
#: c2899bbe93584523a9f4e7352ca63f36
msgid "This sets margin for error in GPS derived altitude limit\\. This error margin is only used if the barometer has failed\\. If the barometer fails then the GPS will be used to enforce the AMSL\\_LIMIT\\, but this margin will be subtracted from the AMSL\\_LIMIT first\\, to ensure that even with the given amount of GPS altitude error the pressure altitude is not breached\\. OBC users should set this to comply with their D2 safety case\\. A value of \\-1 will mean that barometer failure will lead to immediate termination\\."
msgstr ""

#: ../../source/docs/parameters.rst:1621
#: 7fc383fbe53c44ed81094c776249872a
msgid "AFS\\_QNH\\_PRESSURE: QNH pressure"
msgstr ""

#: ../../source/docs/parameters.rst:1625
#: 43dfcd5bc0ae488fb347777adee804a5
msgid "This sets the QNH pressure in millibars to be used for pressure altitude in the altitude limit\\. A value of zero disables the altitude limit\\."
msgstr ""

#: ../../source/docs/parameters.rst:1631
#: dcd7b7e7847649a49998bf7d73acf636
msgid "hectopascal"
msgstr ""

#: ../../source/docs/parameters.rst:1640
#: 0595ce97e4c14b438c7fa36eb5e8bc2b
msgid "AFS\\_MAX\\_GPS\\_LOSS: Maximum number of GPS loss events"
msgstr ""

#: ../../source/docs/parameters.rst:1644
#: 4b6c6e1990484b29a01089bb0439ffb0
msgid "Maximum number of GPS loss events before the aircraft stops returning to mission on GPS recovery\\. Use zero to allow for any number of GPS loss events\\."
msgstr ""

#: ../../source/docs/parameters.rst:1650
#: ccdce8d8762546699f4d722d6b9815c8
msgid "AFS\\_MAX\\_COM\\_LOSS: Maximum number of comms loss events"
msgstr ""

#: ../../source/docs/parameters.rst:1654
#: f1655be8e9f54621b6cdff180ce75fae
msgid "Maximum number of comms loss events before the aircraft stops returning to mission on comms recovery\\. Use zero to allow for any number of comms loss events\\."
msgstr ""

#: ../../source/docs/parameters.rst:1660
#: 2fcc067687494f68ba4428918066398c
msgid "AFS\\_GEOFENCE: Enable geofence Advanced Failsafe"
msgstr ""

#: ../../source/docs/parameters.rst:1664
#: a18cfcad28cc4cd98378f5b516ca3668
msgid "This enables the geofence part of the AFS\\. Will only be in effect if AFS\\_ENABLE is also 1"
msgstr ""

#: ../../source/docs/parameters.rst:1670
#: 4f68ec66ea86431dbbb5e1332bd7f81f
msgid "AFS\\_RC: Enable RC Advanced Failsafe"
msgstr ""

#: ../../source/docs/parameters.rst:1674
#: 67c4df6f6d4341f8bcd4c64dbe324249
msgid "This enables the RC part of the AFS\\. Will only be in effect if AFS\\_ENABLE is also 1"
msgstr ""

#: ../../source/docs/parameters.rst:1680
#: e39593e6457a4aaaae357c208f4808a3
msgid "AFS\\_RC\\_MAN\\_ONLY: Enable RC Termination only in manual control modes"
msgstr ""

#: ../../source/docs/parameters.rst:1684
#: 89210e915e7445c7af6cc6907bb6276e
msgid "If this parameter is set to 1\\, then an RC loss will only cause the plane to terminate in manual control modes\\. If it is 0\\, then the plane will terminate in any flight mode\\."
msgstr ""

#: ../../source/docs/parameters.rst:1690
#: e5fe6e90eb774b84b3877e8fc5d86fa8
msgid "AFS\\_DUAL\\_LOSS: Enable dual loss terminate due to failure of both GCS and GPS simultaneously"
msgstr ""

#: ../../source/docs/parameters.rst:1694
#: 200ad4b439a047ac9558f818b2a66fa9
msgid "This enables the dual loss termination part of the AFS system\\. If this parameter is 1 and both GPS and the ground control station fail simultaneously\\, this will be considered a \\\"dual loss\\\" and cause termination\\."
msgstr ""

#: ../../source/docs/parameters.rst:1700
#: c7ff8876a6d741ff84cde32e2da2939f
msgid "AFS\\_RC\\_FAIL\\_TIME: RC failure time"
msgstr ""

#: ../../source/docs/parameters.rst:1704
#: 9bd7f091af19496aa4796b67be18199a
msgid "This is the time in seconds in manual mode that failsafe termination will activate if RC input is lost\\. For the OBC rules this should be \\(1\\.5\\)\\. Use 0 to disable\\."
msgstr ""

#: ../../source/docs/parameters.rst:1719
#: eb269d0dbaa740948564e4f609ef206c
msgid "AFS\\_MAX\\_RANGE: Max allowed range"
msgstr ""

#: ../../source/docs/parameters.rst:1723
#: abfda6687e3a462f93a1e8641b465ef1
msgid "This is the maximum range of the vehicle in kilometers from first arming\\. If the vehicle goes beyond this range then the TERM\\_ACTION is performed\\. A value of zero disables this feature\\."
msgstr ""

#: ../../source/docs/parameters.rst:1729
#: ../../source/docs/parameters.rst:83261
#: 4b33a33246c04c6aae06286ae7d9949e
#: 854eadc9d7534eb0a7e3e2abd2c609ea
msgid "kilometers"
msgstr ""

#: ../../source/docs/parameters.rst:1738
#: dc8bbdcab602471c9f3d7b5cfdfb9df7
msgid "AFS\\_OPTIONS: AFS options"
msgstr ""

#: ../../source/docs/parameters.rst:1741
#: cfc3c562f544483ea54f399d6b42aa26
msgid "See description for each bitmask bit description"
msgstr ""

#: ../../source/docs/parameters.rst:1750
#: 684d2b74adcb47c7880d876307ab20a0
msgid "Continue the mission even after comms are recovered (does not go to the mission item at the time comms were lost)"
msgstr ""

#: ../../source/docs/parameters.rst:1752
#: d3d8ce35a12e465d9e06a5b5650a34e7
msgid "Enable AFS for all autonomous modes (not just AUTO)"
msgstr ""

#: ../../source/docs/parameters.rst:1754
#: fd37b7265c0b4f5cb2e85370cd08480c
msgid "Option to not jump to AFS_WP_COMMS if already in the return path"
msgstr ""

#: ../../source/docs/parameters.rst:1765
#: 86721fef827e4bd5b01d102437d4625c
msgid "AFS\\_GCS\\_TIMEOUT: GCS timeout"
msgstr ""

#: ../../source/docs/parameters.rst:1769
#: c8ec5cf58b5a437c9283eca55a0ad9dc
msgid "The time \\(in seconds\\) of persistent data link loss before GCS failsafe occurs\\."
msgstr ""

#: ../../source/docs/parameters.rst:1785
#: 7710f77b66b648398ab111902d48d055
msgid "AHRS\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:1791
#: ca63a8499e6e4cddb2046a69bb807b98
msgid "AHRS\\_GPS\\_GAIN: AHRS GPS gain"
msgstr ""

#: ../../source/docs/parameters.rst:1795
#: 0c7a9c85f37c40449a0ed1f8fd541045
msgid "This controls how much to use the GPS to correct the attitude\\. This should never be set to zero for a plane as it would result in the plane losing control in turns\\. For a plane please use the default value of 1\\.0\\."
msgstr ""

