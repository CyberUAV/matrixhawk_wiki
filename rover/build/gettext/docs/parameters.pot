#: ../../source/docs/parameters.rst:6971
#: ffcee0c742f8492f88efdaeaf8f54dfc
msgid "Battery capacity at which the low battery failsafe is triggered\\. Set to 0 to disable battery remaining failsafe\\. If the battery capacity drops below this level the vehicle will perform the failsafe specified by the BATT2\\_FS\\_LOW\\_ACT parameter\\."
msgstr ""

#: ../../source/docs/parameters.rst:6986
#: fb849eda49824b07a01b6c2ee2569905
msgid "BATT2\\_CRT\\_VOLT: Critical battery voltage"
msgstr ""

#: ../../source/docs/parameters.rst:6989
#: c0d43214ab794a699e3ceaa6561fe626
msgid "Battery voltage that triggers a critical battery failsafe\\. Set to 0 to disable\\. If the battery voltage drops below this voltage continuously for more then the period specified by the BATT2\\_LOW\\_TIMER parameter then the vehicle will perform the failsafe specified by the BATT2\\_FS\\_CRT\\_ACT parameter\\."
msgstr ""

#: ../../source/docs/parameters.rst:7004
