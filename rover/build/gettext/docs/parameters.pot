msgid "AUX\\_CH: Auxiliary switch channel"
msgstr ""

#: ../../source/docs/parameters.rst:1334
#: cac5e318fb534b92b0deba42eaeb8011
msgid "RC Channel to use for auxiliary functions including saving waypoints"
msgstr ""

#: ../../source/docs/parameters.rst:1340
#: 314ce04a8e214722a83ffa0f55c672fb
msgid "PIVOT\\_TURN\\_ANGLE: Pivot turn angle"
msgstr ""

#: ../../source/docs/parameters.rst:1343
#: 4b5a22fc55ab4bd8a8cf7d137172f8e1
msgid "Navigation angle threshold in degrees to switch to pivot steering\\. This allows you to setup a skid steering rover to turn on the spot in auto mode when the angle it needs to turn it greater than this angle\\. An angle of zero means to disable pivot turning\\. Note that you will probably also want to set a low value for WP\\_RADIUS to get neat turns\\."
msgstr ""

#: ../../source/docs/parameters.rst:1358
#: 27dc7ac7e29c486ea2f3381b0ecf65c0
msgid "PIVOT\\_TURN\\_RATE: Pivot turn rate"
msgstr ""

#: ../../source/docs/parameters.rst:1361
#: 7087e85b95eb40118cab75c5019cef37
msgid "Desired pivot turn rate in deg\\/s\\."
msgstr ""

#: ../../source/docs/parameters.rst:1377
#: 2f901b5d3fb645ceb84229bc8dbc7b07
msgid "VEHICLE Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:1383
#: 6243cd1bd0bb47bbb079bfe782a3980f
msgid "FLTMODE\\_GCSBLOCK: Flight mode block from GCS"
msgstr ""

#: ../../source/docs/parameters.rst:1386
#: 5314f93c67e94055aec1759ec3dbc371
msgid "Bitmask of flight modes to disable for GCS selection\\. Mode can still be accessed via RC or failsafe\\."
msgstr ""

#: ../../source/docs/parameters.rst:1429
#: aee512aced7e43078e5cfa1241cdf832
msgid "AFS\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:1435
#: e609119f50f0415c9aefcd95bd96a556
msgid "AFS\\_ENABLE: Enable Advanced Failsafe"
msgstr ""

#: ../../source/docs/parameters.rst:1439
#: 3cf193dcadcc45d9ae5f32199ec9450b
msgid "This enables the advanced failsafe system\\. If this is set to zero \\(disable\\) then all the other AFS options have no effect"
msgstr ""

#: ../../source/docs/parameters.rst:1445
#: 30da7e9b5ed44b7f9d0166f9c53b9272
msgid "AFS\\_MAN\\_PIN: Manual Pin"
msgstr ""

#: ../../source/docs/parameters.rst:1449
#: c453b08a7d0848e7b8c249495d37397a
msgid "This sets a digital output pin to set high when in manual mode\\.  See the Wiki\\'s \\\"GPIOs\\\" page for how to determine the pin number for a given autopilot\\."
msgstr ""

#: ../../source/docs/parameters.rst:1455
#: 091f6af76ba841039e08836bcfd9efa2
msgid "AFS\\_HB\\_PIN: Heartbeat Pin"
msgstr ""

#: ../../source/docs/parameters.rst:1459
#: eb2e7b1715f5486bbdd6acaff3e473f3
msgid "This sets a digital output pin which is cycled at 10Hz when termination is not activated\\. Note that if a FS\\_TERM\\_PIN is set then the heartbeat pin will continue to cycle at 10Hz when termination is activated\\, to allow the termination board to distinguish between autopilot crash and termination\\. Some common values are given\\, but see the Wiki\\'s \\\"GPIOs\\\" page for how to determine the pin number for a given autopilot\\."
msgstr ""

