#: ../../source/docs/common-geprc-takerf745.rst:70
#: 8b7f62e1e09e4ff6881a23dc6193d930
msgid "The TAKER F745 BT supports analog OSD using its internal OSD chip and simultaneously HD goggle DisplayPort OSDs via the HD VTX connector."
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:73
#: efe2bcaeefda4f6281535d1ff7cca762
msgid "VTX Support"
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:75
#: 86aecf7194804e7f90ff0fc37e8bebdc
msgid "The SH1.0-6P connector supports a standard DJI HD VTX connection. Pin 1 of the connector is 12v (or VBAT by solder pad selection) so be careful not to connect to devices expecting 5v."
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:78
#: ff2b58c3cb1b43259de0e024983899b9
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:80
#: f22522ca4a5141a9ace9b8fc22e9c8a7
msgid "The TAKER F745 BT supports up to 9 PWM outputs. The pads for motor output M1 to M4 are on the esc connector, M5-M8 are solder pads, plus M9 is defaulted for serial LED strip or can be used as another PWM output."
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:83
#: 48e4b586805649868c80356245d4d020
msgid "The PWM is in 4 groups:"
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:86
#: e263075f5f724053b1aed6b3757689a5
msgid "PWM 1-4 in group1"
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:87
#: 0f7734ca4c2d4d79bf10c1e721707759
msgid "PWM 5-6 in group2"
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:88
#: 13913058434f4e00924cdd13c3d7124e
msgid "PWM 7-8 in group3"
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:89
#: 0f11ba8c31ee4bb390cacc8f6e95ed8a
msgid "PWM 9 in group4"
msgstr ""

#: ../../source/docs/common-geprc-takerf745.rst:91
#: d1db44daf8664f6f94fa64b251d60969
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-4 support bi-directional DShot."
msgstr ""

