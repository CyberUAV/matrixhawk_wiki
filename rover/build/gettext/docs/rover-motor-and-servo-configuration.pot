msgid "Forward and reverse with brake"
msgstr ""

#: ../../source/docs/rover-motor-and-servo-configuration.rst:73
#: 071e07da12fe4d479c8262a35be43320
msgid "Forward and Reverse"
msgstr ""

#: ../../source/docs/rover-motor-and-servo-configuration.rst:75
