msgstr ""

#: ../../source/docs/common-vio-tracking-camera.rst:108
#: 2607a3261f1748aba6b75548e8b25692
msgid "`Jetson <https://github.com/IntelRealSense/librealsense/blob/master/wrappers/python/readme.md>`__ (Compiling from source is needed to get the Python wrapper ``pyrealsense2``)"
msgstr ""

#: ../../source/docs/common-vio-tracking-camera.rst:109
#: 85e17675ad3d4c9cadff1638ccebf369
msgid "`Odroid <https://github.com/IntelRealSense/librealsense/blob/master/doc/installation_odroid.md>`__"
msgstr ""

#: ../../source/docs/common-vio-tracking-camera.rst:110
#: 33cb130fd6df444ca09adfa5130f3ecd
