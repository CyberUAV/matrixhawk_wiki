#: a317823994fc4de299e4a4dd76143b15
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` 10"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:88
#: 337f1c8a4e83437a927a296dc0c63b0b
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 11"
msgstr ""

#: ../../source/docs/common-resoluteh7.rst:89
#: 86a0c65b96594bf9ba1aad1da0acc981
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 11.0"
