#: 1c56e7fe91b84d98a8fb7d0e16c86a18
msgid ":ref:`BATT_I2C_BUS<BATT_I2C_BUS__AP_BattMonitor_INA2xx>` = 1"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:98
#: 162350e52f15433e860bd51e4cc12b02
msgid ":ref:`BATT_I2C_ADDR<BATT_I2C_ADDR__AP_BattMonitor_INA2xx>` = 65 (For Low voltage (6S) Digital Power Module),= 69 (For High Voltage (12S/14S) Digital Power Module)"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:100
#: 416bcc9aaf454784a066bb2c6761f7e2
msgid "In Ardupilot 4.4 and later, the BATT_I2C_ADDR for Pixhawk 6X is default to be 0. This will perform an auto detection of the I2C address, and you do not need to change BATT_I2C_ADDR parameter."
msgstr ""

