#: 2fbe47d95fa946ac90feb3133d2095ec
msgid "The PixSurveyA1 supports up to 14 PWM outputs. All 14 outputs support all normal PWM output formats. All FMU outputs (9-14) support DShot."
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixSurveyA1.rst:306
#: 2f15f901a1d54f5b8d8d6143e29290bc
msgid "The 6 FMU outputs are in 4 groups:"
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixSurveyA1.rst:308
#: 284ffe4b32a7452b923c68c5ae3ce4ef
msgid "Outputs 9, 10, 11 and 12 in group1"
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixSurveyA1.rst:309
#: e4c92761c7974cf697e6c9107ab6eba5
msgid "Outputs 13 and 14 in group2"
msgstr ""

#: ../../source/docs/common-makeflyeasy-PixSurveyA1.rst:313
#: 5741cc7e57ab4e6c95d05428dfe6e645
msgid "FMU outputs within the same group need to use the same output rate and protocol. If any output in a group uses DShot then all channels in that group need to use DShot."
msgstr ""

