#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:5
#: f8fc8728a2f541beb8ac4287dff72546
msgid "LeddarTech LeddarVu8"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:7
#: 4a366da4ad8b414d99bb21bc74f6a97b
msgid "The `LeddarTech LeddarVu8 <https://leddartech.com/lidar/leddar-vu8-solid-state-lidar-sensor-module/>`__ is a long range (185m) lidar which provides 8 individual distances within a 16deg to 99deg field of view depending upon the model used.  ArduPilot always uses the shortest of the 8 distances provided."
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:14
#: 0349018c51124f6fbe9d31fbcdc8797a
msgid "Support for this sensor was released with Copter-4.0.4"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:17
#: b24316164c8c4fcab66206cb7a5de9a2
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:19
#: f4de47d3c1484a6d9653a338dba14a44
msgid "Any of the autopilot's spare serial ports may be used.  The diagram below shows how to connect the sensor's TX, RX and GND pins assuming Serial2 is used."
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:23
#: e2c8110830a847de82a59f8522e0ca3a
msgid "The lidar must be powered separately with a stable 12V source.  During testing the lidar was unable to reliably provide distances if the voltage dropped below 11V."
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:25
#: 0f038a97e12d4e799791eb0fac0f00c4
msgid "The following parameters should be set"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:27
#: e818f9ea593a4edf912b1ed069609ba9
msgid ":ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:28
#: 26c89da032454310ba81605f97e4ca0c
msgid ":ref:`SERIAL2_BAUD <SERIAL2_BAUD>` = 115 (115200 baud)"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:29
#: 06a3c89dde81475eb4c5b11223d53969
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 29 (LeddarVu8-Serial)"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:30
#: 4d0723d2c7c544558bd21072faeff407
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.15"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:31
#: f7f436b638c644dca91f1877f4f765dc
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 160.  *This is the distance in meters that the rangefinder can reliably read.*"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:32
#: ad619fa5c7fe4cc29bc3559f9d35181b
msgid ":ref:`RNGFND1_GNDCLR <RNGFND1_GNDCLR>` = 0.1 *or more accurately the distance in metres from the range finder to the ground when the vehicle is landed.  This value depends on how you have mounted the rangefinder.*"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:34
#: 551c6ce8584e4f20bb6bcc7b2e1aa290
msgid "If you instead were using the Serial4 port on the autopilot then you would set :ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 9, and :ref:`SERIAL4_BAUD <SERIAL4_BAUD>` to 115"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:37
#: 601735be44324b2e85e8fdfc1e403403
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:39
#: c4f01e6069894edebd7dff109429e539
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""
