#: ../../source/docs/common-skystarsH7.rst:162
#: feadbb6400844e7fb617649d16777160
msgid "PWM 7, 8 in group4"
msgstr ""

#: ../../source/docs/common-skystarsH7.rst:163
#: b7c5a8c5227f426d8ecdd16930a7c89e
