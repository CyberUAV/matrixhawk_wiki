#: ../../source/docs/common-stellarf4v2.rst:65
#: 9c97cb96283845a4940c41a7dfe54ae6
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:66
#: 57fd24eef2274bd1b4e6bbb7142e1f3c
msgid "StellarF4V2 supports using its internal OSD using OSD_TYPE 1 (MAX7456 driver). External OSD support such as DJI or DisplayPort can be used simultaneously and is preconfigured on SERIAL3 but can be supported on any spare UART. See :ref:`common-msp-osd-overview-4.2` for more info."
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:70
#: ca00a77fc7ee491c897955b71a4a18f0
