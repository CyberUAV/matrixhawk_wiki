#: 43bd4028a5a144bd9106e83c92fe2c26
msgid "Channels 1-4 support bi-directional DShot. Channels 5-8 marked as S1M5-S4M8 on the board. Channels 9-11 marked as S5-S7 on the board. PWM outputs are grouped and every group must use the same output protocol:"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:76
#: 57198808f48f4859897097d23c0e155e
msgid "1, 2, 3, 4  are Group 1;"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:77
#: e4cf42652ef9486b94da3c3ce86a99d7
msgid "5, 6, 7, 8  are Group 2;"
msgstr ""

#: ../../source/docs/common-stellarf4v2.rst:78
#: 517b039570724160a91e50a0000f0b69
msgid "9, 10, 11   are Group 3;"
msgstr ""

