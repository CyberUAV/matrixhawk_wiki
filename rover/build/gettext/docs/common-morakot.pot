#: ../../source/docs/common-morakot.rst:379
#: 559effac63204301b73386f7d76d01f8
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-morakot.rst:380
#: f1681684341b48adb0b2729c2f536eed
msgid "Initial firmware load can be done with DFU by plugging in USB with the bootloader button pressed. Then you should load the “XXX_bl.bin” firmware, using your favorite DFU loading tool. Once the initial firmware is loaded you can update the firmware using any ArduPilot ground station software. Updates should be done with the “\\*.apj” firmware files."
msgstr ""
