#: ../../source/docs/common-morakot.rst:346
#: 78b60f3fabc7455db36c2eb7477e9016
msgid "RC input is via SERIAL7(UART8) on the RC connector. Unidirectional protocols can be connected to R8. Bi-Directional Protocols will use the T8 pin also."
msgstr ""

#: ../../source/docs/common-morakot.rst:348
#: 5c27834f840248e8876f54808fbdee7c
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-morakot.rst:349
#: f8d9f8924b1e4dad97782c6767a70b9e
msgid "SBUS/DSM/SRXL connects to the RX8 pin."
msgstr ""

#: ../../source/docs/common-morakot.rst:350
#: 0c028f8c42d145bda9f04b3d821bd708
msgid "FPort requires connection to TX8. Set :ref:`SERIAL7_OPTIONS<SERIAL7_OPTIONS>` = 7"
msgstr ""

#: ../../source/docs/common-morakot.rst:351
#: 79c475c67c81450b8cd2b7514481cf0b
msgid "CRSF/ELRS also requires both TX8 and RX8 connections and provides telemetry automatically. In order to use the SBUS pin on the HD VTX connector, you must change SERIAL7_PROTOCOL to something other than \"23\" and set :ref:`SERIAL3_PROTOCOL\\ :raw-html-m2r:`<SERIAL3_PROTOCOL>` to \"23\"."
msgstr ""

#: ../../source/docs/common-morakot.rst:355
#: 0581cd4607f44cc0a1e9e7674b52df3f
msgid "PWM Outputs"
msgstr ""

#: ../../source/docs/common-morakot.rst:356
#: 48d559dafe294269a27bc51dcfc1e04d
msgid "The Morakot supports up to 9 PWM outputs. All are DSHot and Bi-Directional DShot capable"
msgstr ""

#: ../../source/docs/common-morakot.rst:358
#: c9aa54765e4246fa98d7ff9c76d8b053
msgid "The PWM is in 3 groups:"
msgstr ""

#: ../../source/docs/common-morakot.rst:360
#: 4b34c9759ccf48ce86fe0872f8d40bdf
msgid "PWM 1-4  in group1"
msgstr ""

#: ../../source/docs/common-morakot.rst:361
#: 9341c6ee2d4d4e36945067fdf3e20430
msgid "PWM 4-8  in group2"
msgstr ""

#: ../../source/docs/common-morakot.rst:362
#: 1260ab4f18ad4563b4e06a1df38f645d
msgid "PWM 9 (LED)  in group3"
msgstr ""

#: ../../source/docs/common-morakot.rst:364
#: ff467dc80538410d896d798946fcf0c6
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in that group need to use DShot."
msgstr ""

#: ../../source/docs/common-morakot.rst:367
#: 89406b4e7c624738ba2f1c89a971e814
msgid "Compass"
msgstr ""

#: ../../source/docs/common-morakot.rst:368
#: 9274300ee8ad4187bdfeb71d8f4445df
msgid "The Morakot has a built-in compass. Due to potential interference, the autopilot is usually used with an external I2C compass as part of a GPS/Compass combination and the internal compass disabled."
msgstr ""

#: ../../source/docs/common-morakot.rst:371
#: e9ad70a469bf425ead1637eeac8a6caa
msgid "OSD"
msgstr ""

#: ../../source/docs/common-morakot.rst:372
#: 960384a24bf9445d8c4bf5d2291e247d
msgid "DisplayPort OSD is enabled by default on the HD VTX connector."
msgstr ""

