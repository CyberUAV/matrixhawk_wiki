msgstr ""

#: ../../source/docs/common-foxeerf745aio.rst:148
#: 791de68c22144cbcb957ce4f03511a97
msgid "Barometer"
msgstr ""

#: ../../source/docs/common-foxeerf745aio.rst:150
#: c7c3939ddfcb4d8cb67f9c6b7848c8bd
msgid "The ReaperF745v2 does not have a builtin barometer, but you can attach an external barometer using I2C on the SDA and SCL pads or use GPS as the EKF3 Z source. The board will boot without either, but only non altitude information requiring modes can be used."
msgstr ""

#: ../../source/docs/common-foxeerf745aio.rst:153
#: 3530af16b5fa4fd88f763149cbb192dc
