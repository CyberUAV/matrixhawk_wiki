#: ../../source/docs/common-vl53l0x-lidar.rst:26
#: 2459664d18a044eeb9c9f56aba43a134
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-vl53l0x-lidar.rst:28
#: 4e727f8d91fd42e781b98786a1bc6380
msgid "Connect the VCC, GND, SDA and SCL lines of the lidar to the I2C port on the autopilot as shown below for the first rangefinder."
msgstr ""

#: ../../source/docs/common-vl53l0x-lidar.rst:32
#: 74c10c254a9b4f2fbd1a307808d263f7
msgid "Please set the rangefinder parameters as shown below (this can be done using the *Mission Planner* **Config/Tuning \\| Full Parameter List** page):"
msgstr ""

#: ../../source/docs/common-vl53l0x-lidar.rst:34
#: f703899b0eac4adf8572058ea294b293
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 16 (VL53L0X)"
msgstr ""

#: ../../source/docs/common-vl53l0x-lidar.rst:35
#: 570514252adc426c97d1fca3a149eb13
msgid ":ref:`RNGFND1_ADDR <RNGFND1_ADDR>` = 41 (I2C Address of lidar in decimal).  *The sensor's default I2C address is 0x29 hexadecimal which is 41 in decimal.*"
msgstr ""

#: ../../source/docs/common-vl53l0x-lidar.rst:36
#: a6e9195bbe914a52983a3f66844bf6d8
msgid ":ref:`RNGFND1_SCALING <RNGFND1_SCALING>` = 1"
msgstr ""

#: ../../source/docs/common-vl53l0x-lidar.rst:37
#: 578d74fb5ce642fd8d56c718b38f9e7a
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.05"
msgstr ""

#: ../../source/docs/common-vl53l0x-lidar.rst:38
#: 07e0cdaec3b643baa58e42375f1e3999
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = **1.2** for the VL53L0X, **3.6** for the VL53L1X.  *This is the distance in meters that the rangefinder can reliably read.*"
msgstr ""

#: ../../source/docs/common-vl53l0x-lidar.rst:39
#: 7474da6d5a90421388c565234b6597a9
msgid ":ref:`RNGFND1_GNDCLR <RNGFND1_GNDCLR>` = 0.1 *or more accurately the distance in meters from the range finder to the ground when the vehicle is landed.  This value depends on how you have mounted the rangefinder.*"
msgstr ""

