#: ../../source/docs/common-flywoo-h743.rst:55
#: 4622c075a0e84f44afbe346e76c4c212
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-flywoo-h743.rst:57
#: 14908c6a147c4ac3b40914cf1b43d771
msgid "RC input is configured by default via the USART2 RX input. It supports all serial RC protocols except PPM."
msgstr ""

#: ../../source/docs/common-flywoo-h743.rst:59
#: 46a67e2a0e4f4d5cbd75a2dcd3dc6bed
msgid "Note: If the receiver is FPort the receiver must be tied to the USART2 TX pin , RSSI_TYPE set to 3, and SERIAL2_OPTIONS must be set to 7 (invert TX/RX, half duplex). For full duplex like CRSF/ELRS use both RX1 and TX1 and set RSSI_TYPE also to 3."
msgstr ""

#: ../../source/docs/common-flywoo-h743.rst:64
#: 39b6a6f9fd254481b0bff2af8fbe4e0d
msgid "FrSky Telemetry"
msgstr ""

#: ../../source/docs/common-flywoo-h743.rst:66
#: 43525180708648e0b88c5ec6717e996c
msgid "FrSky Telemetry is supported using an unused UART, such as the T3 pin (UART3 transmit). You need to set the following parameters to enable support for FrSky S.PORT:"
msgstr ""

