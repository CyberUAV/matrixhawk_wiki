msgid "SERIAL2 = Telemetry2 = USART1"
msgstr ""

#: ../../source/docs/common-matekh743-wing.rst:82
#: 50524d8faa7048668fdeb5accacda832
msgid "SERIAL3 = GPS1 = USART2"
msgstr ""

#: ../../source/docs/common-matekh743-wing.rst:83
#: 9bd5c97d26114a1ebfc31c112ab68682
msgid "SERIAL4 = GPS2 = USART3"
msgstr ""

#: ../../source/docs/common-matekh743-wing.rst:84
