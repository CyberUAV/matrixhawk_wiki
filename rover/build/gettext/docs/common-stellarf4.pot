#: 84c8b1a3653e4664ade336f84962179c
msgid "The default RC input is configured on the UART2(SERIAL1) RX2 input and can be used for all ArduPilot supported unidirectional receiver protocols except PPM."
msgstr ""

#: ../../source/docs/common-stellarf4.rst:62
#: 77a4a73d2cf14d098ea04e5175035177
msgid "SBUS/DSM/SRXL connects to the RX2 pin."
msgstr ""

#: ../../source/docs/common-stellarf4.rst:63
#: 0d22a30892d94ff5a46f92b18953b6fa
msgid "CRSF also requires a TX2 connection, in addition to RX2, and automatically provides telemetry."
msgstr ""

