#: ../../source/docs/common-CUAV-7-Nano.rst:58
#: cf5d5c981f5c4787ba03a50808cad43a
msgid "RC input is configured on the RCIN pin, at one end of the servo rail, marked RCIN in the above diagram. All ArduPilot supported unidirectional RC protocols can be input here including PPM. For bi-directional or half-duplex protocols, such as CRSF/ELRS a full UART will have to be used. For example if SERIAL2 (UART5) is used for bi-directional RC, then:"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:60
#: ec201c3c91734e70ba287ef875fcbcfb
msgid ":ref:`SERIAL2_PROTOCOL<SERIAL2_PROTOCOL>` must be set to \"23\", and:"
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:62
#: 0a5e8b4fe24f4bb1a15229ff708da1a4
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:64
#: 94cafe40223942cab27b7f0030713e94
msgid "SBUS/DSM/SRXL connects to the R6 pin."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:66
#: 5ad4c2077faf4aebbbf44e7bc24dcb87
msgid "FPort requires connection to Tx and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:68
#: cb7bb59463254693b138b3469b8b63c7
msgid "CRSF/ELRS also requires a Tx connection, in addition to Rx, and automatically provides telemetry. Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"0\"."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:70
#: 3e5d0bbff4ab4771b6e22fde978523f1
msgid "SRXL2 requires a connection to Tx and automatically provides telemetry.  Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:72
#: ce4db0b4865a4b118b7ee62527813d57
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-CUAV-7-Nano.rst:75
