#: 61f5c6cd984042faa49fd8e1ddb4e6cf
msgid "**Create WP Circle** — Create a circle of waypoints."
msgstr ""

#: ../../source/docs/common-camera-control-and-auto-missions-in-mission-planner.rst:71
#: f07136ab1e78473a87e40a5c2a33dd30
msgid "**Area** — Displays the area of the current polygon (if defined)."
msgstr ""

#: ../../source/docs/common-camera-control-and-auto-missions-in-mission-planner.rst:72
#: 69b058e958dc422b905c54150ce206b6
msgid "**Create Spline Circle** — A circle where the altitude of waypoints follows a rising spline (relevant to flying vehicles)."
msgstr ""

#: ../../source/docs/common-camera-control-and-auto-missions-in-mission-planner.rst:74
#: 988674bbde204a50a5150e402dbbb18d
msgid "**Survey (Grid)** — Automatically create waypoints and camera control commands to survey a specified polygon."
msgstr ""

#: ../../source/docs/common-camera-control-and-auto-missions-in-mission-planner.rst:76
#: deb6967cbe494afeb24c599f9ae2af8e
msgid "**Survey (Gridv2)** — *Under construction!* This is a simpler grid control for creating a rectangular survey area."
msgstr ""

#: ../../source/docs/common-camera-control-and-auto-missions-in-mission-planner.rst:78
#: ff50fe510ac641a780f2a348f76b2513
msgid "**SimpleGrid** — A simple auto-created survey grid. No camera control is defined, so this must be added separately."
msgstr ""

#: ../../source/docs/common-camera-control-and-auto-missions-in-mission-planner.rst:81
#: 2905fac57800483b8ad07547e39c5b3c
msgid "The following sections include community-provided examples of automatic survey missions."
msgstr ""

#: ../../source/docs/common-camera-control-and-auto-missions-in-mission-planner.rst:87
#: dda5db93d641444186bb796cc4231886
