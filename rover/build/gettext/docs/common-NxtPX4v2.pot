#: f7d6775220ea49778494ede0a2c2122e
msgid "FPort requires connection to the Tx5 of the UART and :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-NxtPX4v2.rst:89
#: 0d9620a53c794cdb98afe6c7d182857b
msgid "CRSF/ELRS also requires a TXx5 connection, and automatically provides telemetry. Set  :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` = \"0\"."
msgstr ""

#: ../../source/docs/common-NxtPX4v2.rst:91
#: c4570647d7a0453a9ad1b521877e793d
msgid "SRXL2 requires a connection to Tx5 and automatically provides telemetry.  Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` =  \"4\"."
msgstr ""

