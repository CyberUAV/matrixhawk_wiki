#: 99b7ef8648054b74b8d4033b83da282b
msgid "Set :ref:`RNGFND1_MIN<RNGFND1_MIN>` = 0.02 (The UP-T101-Plus is set to 0.02 and the UP-T201 is set to 0.05)"
msgstr ""

