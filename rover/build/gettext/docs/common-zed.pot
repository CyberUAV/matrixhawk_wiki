msgid "DataFlash logging"
msgstr ""

#: ../../source/docs/common-zed.rst:82
#: 45d74d7f80cc4276ae9e2e60edd60e74
msgid "The ZED's visual odometry information will appear in the VISO dataflash log messages."
msgstr ""

#: ../../source/docs/common-zed.rst:83
#: feace3c18a864ab7b1e0c45843557b20
msgid "Distance to objects ahead of the vehicle will appear in the PRX messages."
msgstr ""

