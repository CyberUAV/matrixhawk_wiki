#: ../../source/docs/common-jhemcuf405pro.rst:52
#: 41d9a7e6616d473f92613a6ccb299e24
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:53
#: 6f586c507e4b466e89f5db4068f3a91e
msgid "RC input is best configured on the RX1/TX1 (USART1_RX/USART1_TX) pins due to having full DMA capability and being mostly easy to access for desoldering to enable DFU mode."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:55
#: 8c8aaad52f124cf184ab57b909763b5d
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:56
#: d29b8d808e904d60b3697ed6a248947b
msgid "FPort requires connection to T1 and :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` be set to “7”."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:57
#: e5e4ac58b55f416aba363d7cf9748143
msgid "CRSF also requires a T1 connection, in addition to R1, and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to “0”."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:58
#: 3060d5bbd1b745f4abe5e0cfb4e6cb7c
msgid "SRXL2 requires a connection to T1 and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to “4”. Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`Radio Control Systems <common-rc-systems>` for details."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:62
#: c7719d0e11de4bcfb268e3ba0478f34c
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:63
#: a0a7806127594232bcac6aef48995ddc
msgid "JHEMCUF405PRO supports OSD using its internal analog OSD (MAX7456). Simultaneous HD VTX OSD support is pre-configured on UART6 on the HD VTX connector."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:66
#: 26fc02bc28aa4b3da1f4070265ef084b
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:67
#: 3ff0fa104ea141c1a9edd9dfbb1ae253
msgid "JHEMCUF405PRO supports up to 5 motor/servo outputs. 4 motors and 1 LED strip (can be configured for another PWM output). Outputs are grouped and each group must use the same protocol. All outputs support PWM , DShot, and  outputs 1-2 support Bi-Direectional DShot."
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:70
#: e924b6b878b74a6d890cc916c89ac604
msgid "Output 1-2 Group 1"
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:71
#: 17359e5d76ec4e8b912e70a09849c23a
msgid "Output 3-4 Group 2"
msgstr ""

#: ../../source/docs/common-jhemcuf405pro.rst:72
#: 7deff97fcdc4416dba11f18f6a8d0f2f
msgid "Output 5/LED Group 3"
msgstr ""

