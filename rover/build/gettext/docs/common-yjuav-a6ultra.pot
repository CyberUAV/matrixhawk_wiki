msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-yjuav-a6ultra.rst:444
#: bf41bfb7e33546f4b98db049d4930fae
msgid "SBUS/DSM/SRXL connects to the RX1 pin."
msgstr ""

#: ../../source/docs/common-yjuav-a6ultra.rst:445
#: 994aefd985eb406aa647baf53127fb42
msgid "FPort requires connection to TX1 and RX1. See FPort Receivers."
msgstr ""

#: ../../source/docs/common-yjuav-a6ultra.rst:446
#: 95f1bfcd4a14402f8927d3609a2c443c
msgid "CRSF also requires a TX1 connection, in addition to RX1, and automatically provides telemetry."
msgstr ""

#: ../../source/docs/common-yjuav-a6ultra.rst:447
#: 25ccd123183446839c98efb693185894
msgid "SRXL2 requires a connection to TX1 and automatically provides telemetry. Set SERIAL4_OPTIONS to “4”."
msgstr ""

#: ../../source/docs/common-yjuav-a6ultra.rst:449
#: 519682cffdff402d93d1dc38d595ff54
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See Radio Control Systems for details."
