#: f25e2ce30a1a4bf7ac70e577e304ed6a
msgid "This requires a connection to a full UART port via its TX pin. The port should be set for half-duplex RC input:"
msgstr ""

#: ../../source/docs/common-rc-systems.rst:89
#: b4dae43b7cca44a0b85074d026e37727
msgid "using SERIAL2 as the port:"
msgstr ""

#: ../../source/docs/common-rc-systems.rst:91
