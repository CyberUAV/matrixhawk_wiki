#: ../../source/docs/rtl-mode.rst:5
#: 4b0c410fab6548ca9eaade502f18ec59
msgid "RTL Mode"
msgstr ""

#: ../../source/docs/rtl-mode.rst:7
#: 4b1edb28f2224e66b7166d20074cdf0d
msgid "RTL stands for Return-To-Launch.  When switched into RTL mode the vehicle will turn and attempt to directly return to the position where it was last armed (unless the home position has been changed via the ground station). Once at the destination it will hold position if a surface vehicle, or loiter/circle around the destination if it is a boat."
msgstr ""

#: ../../source/docs/rtl-mode.rst:9
#: fb656ca8d246425aaa95e2395b6e0015
msgid "The :ref:`RTL_SPEED <RTL_SPEED>` parameter can be used to set the speed (in meters/second) at which the vehicle will return to home.  By default this parameter is zero meaning it will use the :ref:`WP_SPEED <WP_SPEED>` (or :ref:`CRUISE_SPEED <CRUISE_SPEED>` for versions before Rover 4.0, if :ref:`WP_SPEED <WP_SPEED>` is 0)."
msgstr ""
