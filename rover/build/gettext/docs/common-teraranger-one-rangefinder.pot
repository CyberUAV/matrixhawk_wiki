#: ../../source/docs/common-teraranger-one-rangefinder.rst:77
#: 5ae1845f93014cf38eb108c339bbc442
msgid "``RNGFNDx_MAX``: This parameter sets the maximum distance in meters that the rangefinder is used by the autopilot."
msgstr ""

#: ../../source/docs/common-teraranger-one-rangefinder.rst:79
#: 51a39a6fbfc54708b1ec14692931e9ef
msgid "``RNGFNDx_MIN``: This parameter set the minimum distance in meters that the rangefinder is used by the autopilot."
msgstr ""

#: ../../source/docs/common-teraranger-one-rangefinder.rst:81
#: 81bdf6455e0347f392730960376ad97b
msgid "``RNGFNDx_ADDR``: 48 (for TeraRanger One) or 49 (for EVO series), 0 will disable the rangefinder setup."
msgstr ""

#: ../../source/docs/common-teraranger-one-rangefinder.rst:82
#: cb2c4f463bfe4ff4a62ca9ac1f796c68
msgid "``RNGFNDx_TYPE``: 14"
msgstr ""

#: ../../source/docs/common-teraranger-one-rangefinder.rst:83
#: fac05a18a1864b7d8d4af3185dbcef7e
msgid "``RNGFNDx_ORIENT``: 25 (for downward facing). If used for :ref:`Object Avoidance<common-object-avoidance-landing-page>` or ceiling distancing, instead of altitude ranging, mount and chose the appropriate orientatioin."
msgstr ""

