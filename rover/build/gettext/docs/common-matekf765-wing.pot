msgstr ""

#: ../../source/docs/common-matekf765-wing.rst:141
#: f092a4000ec24b32a911cd4e4071aa34
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 13"
msgstr ""

#: ../../source/docs/common-matekf765-wing.rst:143
