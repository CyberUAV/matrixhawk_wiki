#: ../../source/docs/common-ark-fpv.rst:344
#: 196f867d3af24273aaf01dd87d0bc950
msgid "RC input is configured on the RX6 (UART6_RX) pin. It supports all RC protocols except PPM. See :ref:`Radio Control Systems <common-rc-systems>` for details for a specific RC system. :ref:`SERIAL6_PROTOCOL<SERIAL6_PROTOCOL>` is set to “23”, by default, to enable this."
msgstr ""

#: ../../source/docs/common-ark-fpv.rst:347
#: 3e752301a8d1449fba093dfc6187e11c
msgid "SBUS/DSM/SRXL connects to the RX6 pin."
msgstr ""

#: ../../source/docs/common-ark-fpv.rst:348
#: 021240dcf07d457aa657163161d1742d
msgid "FPort requires connection to TX6 and :ref:`SERIAL6_OPTIONS<SERIAL2_OPTIONS>` be set to “7”."
msgstr ""

#: ../../source/docs/common-ark-fpv.rst:349
#: f1815e04810247399b02c2251ac4ccf0
msgid "CRSF also requires a TX6 connection, in addition to RX6, and automatically provides telemetry. Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>`"
msgstr ""

#: ../../source/docs/common-ark-fpv.rst:350
#: 29ea6c9ce7ef45279f8f62fbbc94b240
msgid "SRXL2 requires a connection to TX6 and automatically provides telemetry. Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` to “4”."
msgstr ""

