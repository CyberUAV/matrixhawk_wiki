msgstr ""

#: ../../source/docs/common-tmotor-h7-mini.rst:58
#: 0e9d0afadceb499587534f19f6217977
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-tmotor-h7-mini.rst:60
#: bba9313447c7452da96180cffe05d417
msgid "The T-Motor H7 Mini supports up to 5 PWM outputs. The pads for motor output M1 to M4 on the motor connectors and separate pads, plus M5 for LED strip or another PWM output."
msgstr ""

#: ../../source/docs/common-tmotor-h7-mini.rst:64
#: 93b5d87080844d4790ab354e9210a39c
msgid "The PWM is in 2 groups:"
msgstr ""

#: ../../source/docs/common-tmotor-h7-mini.rst:67
#: 6e49d9c00f8a427bbeec3cad7b40db9f
msgid "PWM 1-4 in group1"
msgstr ""

#: ../../source/docs/common-tmotor-h7-mini.rst:68
#: a82e23c777004176b5b55890d7c25da4
msgid "PWM 5 in group2"
msgstr ""

#: ../../source/docs/common-tmotor-h7-mini.rst:70
#: 0451f28f3fb94b0ab1e77131003ba07c
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-4 support bi-directional dshot."
msgstr ""

#: ../../source/docs/common-tmotor-h7-mini.rst:75
#: efef320798734d218ddec9835f9c8020
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-tmotor-h7-mini.rst:77
#: 05a968344d3842309043a2132e0cee06
msgid "The board has a builtin voltage and current sensor. The current sensor can read up to 130 Amps. The voltage sensor can handle up to 6S LiPo batteries."
msgstr ""

