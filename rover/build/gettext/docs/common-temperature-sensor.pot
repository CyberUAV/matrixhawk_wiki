msgstr ""

#: ../../source/docs/common-temperature-sensor.rst:10
#: 3edfad7c953b4e32b1bee38aed66b917
msgid "`MAX31865 <https://www.analog.com/media/en/technical-documentation/data-sheets/MAX31865.pdf>`__"
msgstr ""

#: ../../source/docs/common-temperature-sensor.rst:11
#: d4ba3787a8ae4512892d5cb5deef39df
msgid "`MCP9600 <https://ww1.microchip.com/downloads/en/DeviceDoc/MCP960X-Data-Sheet-20005426.pdf>`__"
msgstr ""

#: ../../source/docs/common-temperature-sensor.rst:12
#: a1f190c6b23e4e6aad07b5bbdb3d94f1
msgid "`TSYS01 <https://www.te.com/usa-en/product-G-NICO-018.datasheet.pdf>`__"
msgstr ""

#: ../../source/docs/common-temperature-sensor.rst:13
#: 0387723c1fc44b5b9aa3c2903ccd0d64
msgid "`TSYS03 <https://www.te.com/usa-en/product-CAT-DTS0001.datasheet.pdf>`__"
msgstr ""

#: ../../source/docs/common-temperature-sensor.rst:14
#: e8eb7a3a043d4a6db9957eb4011c1e95
msgid "`MLX90614 <https://media.melexis.com/-/media/files/documents/datasheets/mlx90614-datasheet-melexis.pdf>`__"
msgstr ""

#: ../../source/docs/common-temperature-sensor.rst:15
#: 3f529d9459814c598d9327ba89998a5b
