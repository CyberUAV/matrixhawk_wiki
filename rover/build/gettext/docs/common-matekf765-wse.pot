#: ../../source/docs/common-matekf765-wse.rst:58
#: e0934540d76d48a486abb20550688c98
msgid "Camera and Supply Switch"
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:60
#: f7cd4ceb2e1042d7975c0f590cf3a7b1
msgid "Switching between the two camera inputs, C1 (default on) or C2, and between on (default) and off of Vsw (jumper selectable selectable supply), can be implemented using the Relay function of ArduPilot and assigning the relays to an ``RCx_OPTION`` switch on the transmitter."
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:62
#: 293a5adc051540518057b06ba14118dd
msgid "Set the ``RELAYx_PIN`` to \"81\" for on/off of Vsw, and to \"82\" to control the camera switching. Then select an RC channel for control (Chx) and set its ``RCx_OPTION`` to the appropriate Relay (1-4) that you had set its pin parameter above."
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:65
#: a5a897075f8b4fa3992a0d83e82c2a3b
msgid "For example, use Channel 10 to control the camera switch using Relay 2:"
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:67
#: 00213200ce1c4b72b2d52f645ce82775
msgid ":ref:`RELAY2_PIN<RELAY2_PIN>` = \"82\""
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:68
#: 1ddf8e28cb95423ebf66752405b62cab
msgid ":ref:`RC10_OPTION<RC10_OPTION>` = \"34\" (Relay2 Control)"
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:70
#: a7322ea779dd48bf94fe36c4af9d8f95
msgid "setting Relay on/high assigned for Vsw will turn off that supply. Likewise, setting on/high for the Relay for camera, will switch from Camera 1 to Camera 2."
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:73
#: 578647fc39084a5d814d7292e82d3aa6
msgid "Default UART order"
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:75
#: 29207b300ec34c48adad12dedaaa3758
msgid "SERIAL0 = console = USB"
msgstr ""

#: ../../source/docs/common-matekf765-wse.rst:76
#: df34541332c7403a90d6d5ceada2bc4b
msgid "SERIAL1 = Telemetry1 = UART7 (support CTS and RTS signaling)"
msgstr ""

