#: ../../source/docs/reference-frames-hydrotek.rst:5
#: 14e9f02818fc496fbbc7409a710c50a4
msgid "HobbyKing Hydrotek"
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:10
#: 844315d7d4f44ce98bd36624c1bd2c8e
msgid "The HobbyKing Hydrotek is a relatively fast electric powerboat with self-righting feature (one pontoon fills with water while the other does not).  The rear motor rotates using a steering servo making it a good test of Rover's :ref:`vectored thrust <rover-vectored-thrust>` feature."
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:12
#: 1fd18b733fc14df9855200aae30275fe
msgid "The motor only spins forward and the boat drives best at speeds over 2m/s."
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:15
#: e1668a44dc004c79ab5c6c1590816dac
msgid "Parts List"
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:17
#: aa2ca02f48374234b6f4d3b185ea851a
msgid "`HobbyKing Hydrotek <https://hobbyking.com/en_us/h-king-marine-hydrotek-f1-tunnel-hull-racing-boat-arr-1.html>`__"
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:18
#: 4cbfb4218fce4d0f958d1ea046fbf638
msgid "3S battery with high discharge and no more than 11cm in length like the `Turnigy 2200mAh 3S 40C <https://hobbyking.com/en_us/turnigy-2200mah-3s-40c-lipo-pack.html>`__"
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:19
#: a2f44e559670403b83656b4132ecda74
msgid "Small autopilot like the `mRobotics Pixracer including GPS and telemetry radio <https://store.mrobotics.io/mRo-PixRacer-R14-Official-p/mro-pxrcr-r14-kit-mr.htm>`__"
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:20
#: ad4d78492b504385b4b36d44c654bbed
msgid "any 8 channel (or more) transmitter like the `Futaba T10J <https://www.futabarc.com/systems/futk9200-10j/index.html>`__"
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:25
#: afa6e022b8f84eefb748a642b6363459
msgid "Firmware used: Rover-3.3.1"
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:27
#: aea07651a29d4d85957c5023fffb5998
msgid "Parameter file: `HK-hydrotek-Rover331 <https://github.com/ArduPilot/ardupilot/blob/APMrover2-stable/Tools/Frame_params/HK-hydrotek-Rover331.param>`__"
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:29
#: 7639c890ac394fa1a3ada4194cc9041a
msgid "This parameter file can also be loaded using the Mission Planner's Config/Tuning >> Full Parameter Tree page by selecting \"HK-hydroteck-Rover331\" from the drop down on the middle right and then push the \"Load Presaved\" button."
msgstr ""

#: ../../source/docs/reference-frames-hydrotek.rst:33
#: 7eb5713d1c334298a32df57cde063c2e
msgid "The parameter file above includes setting the :ref:`COMPASS_ORIENT <COMPASS_ORIENT>` parameter \"4\" (Yaw 180) because the wiring was more convenient if the GPS arrow was pointing backwards"
msgstr ""
