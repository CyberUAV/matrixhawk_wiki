msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:24
#: e57eb54a71f7462d96d3a9559f2596c1
msgid "Mount the radar to the vehicle so that the radar senses obstacles horizontally.  The power and communication wire should be to the right."
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:30
#: d76766a39e344d379a93458774ce92bc
msgid "Connect the radar to the autopilot's CAN port as shown above and set the following parameters assuming the radar is connected to CAN1:"
msgstr ""

#: ../../source/docs/common-rangefinder-hexsoon-radar.rst:32
#: 9120c172723048e080f0c26197c8d2e1
msgid ":ref:`CAN_P1_DRIVER <CAN_P1_DRIVER>` = 1 (First CAN driver)"
