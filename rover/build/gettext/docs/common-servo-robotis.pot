#: ../../source/docs/common-servo-robotis.rst:26
#: db3840dd3a90407398974c77ff5c5a59
msgid "Configuring the Servos"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:28
#: 381eb26264f74e9693280b7a97c0354d
msgid "Before initial use the ID for each servo needs to be set using the DYNAMIXEL Wizard configuration tool."
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:30
#: b9840bc42ce14ee1bf67651c4e0d7d4f
msgid "`DYNAMIXEL Wizard 2.0 <http://emanual.robotis.com/docs/en/software/dynamixel/dynamixel_wizard2/>`__ is the latest DYNAMIXEL configuration tool supporting Windows / Linux / Mac OSX."
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:32
#: a13396466a80447792048d2e3d822a32
msgid "Visit `ROBOTIS' international download center <https://en.robotis.com/service/downloadpage.php?ca_id=10>`__ to download and install DYNAMIXEL Wizard 2.0\""
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:33
#: a8a21c8f7ef74e5e822ebbc201d66944
msgid "Attach the U2D2 to the servos as described in the `online manual <http://emanual.robotis.com/docs/en/parts/interface/u2d2/>`__"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:34
#: 997aaf84a16244599d419a42def758a7
msgid "Start the R+ Manager, connect to the appropriate COM port and set each servo's ID to a value from 1 to 16.  The number chosen for each servo should correspond to the servo number used to configure and control the servo.  For example if the ID is set to \"9\", the :ref:`SERVO9_MIN <SERVO9_MIN>`, :ref:`SERVO9_MAX <SERVO9_MAX>`, :ref:`SERVO9_FUNCTION <SERVO9_FUNCTION>`, etc parameters will be used to configure the servo."
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:37
#: 86084c8d03a64a79b2c1839f7014678e
msgid "Connecting and Configuring"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:42
#: 5e8e354efcc4472e944f1a333709a883
msgid "Connect one of the servos to any serial port on the autopilot.  In this example SERIAL4 is used but any serial port should work"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:43
#: 37df1166d3c741a48bcdaecdd564b839
msgid "Additional servos should be connected to the first by daisy chaining them as shown above"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:44
#: 1f459d16b8a34a19ac58bf33f6b3fb4a
msgid "Set the following parameters on the autopilot"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:46
#: 2713a1ce8089493a86dcab4b4c2e1b1b
msgid ":ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 19 (\"RobotisServo\")"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:47
#: b20597e49b8d41699d3eac1cb35fb751
msgid ":ref:`SERIAL4_BAUD <SERIAL4_BAUD>` = 57 (57600 baud)"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:48
#: 6ba5d5fb5f0d4ebf99d86cec2629a428
msgid ":ref:`SERIAL4_OPTIONS <SERIAL4_OPTIONS>` = 4 to enable half-duplex mode"
msgstr ""

