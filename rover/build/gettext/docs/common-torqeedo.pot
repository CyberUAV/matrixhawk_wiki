#: ../../source/docs/common-torqeedo.rst:69
#: a4fa22d63b44416d8f8aa643a9efa164
msgid "Configuration"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:71
#: 751856be128f4ae895b6b233fdc46df1
msgid "Please set the following parameters"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:73
#: 2cd370e984bc4d1baf3f0ef81f7c05c5
msgid "``TRQD_TYPE`` = 1 (Tiller) if the autopilot will be connected to the tiller connector or 2 (Motor) if connected to the motor connector"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:74
#: 37b9112aafff46b980c04d52e080b141
msgid ":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` = 39 (Torqeedo) if the Torqeedo is connected to serial port 1.  If another serial port is used please set the appropriate SERIALx_PROTOCOL parameter"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:75
#: 8a63c7598a4f4b35ae07bc113f1e7766
msgid ":ref:`SERIAL1_BAUD <SERIAL1_BAUD>` = 19 (19200 bps) if using serial port 1.  If another serial port is used please set the appropriate SERIALx_BAUD parameter instead"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:77
#: 9e850106065c447fb422e32521284c3e
msgid "If a serial port with flow control pins (clear-to-send and ready-to-send) is used no further parameter settings are required.  If serial port without flow-control is used then please set"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:79
#: ef3d1b1c359f40d5a8b9912f07a4e289
msgid "``TRQD_ONOFF_PIN`` = 54 (AUX5) and connect the autopilot's AUX5 pin to the interface's board's MOSFET"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:80
#: 4bd0d34bb35a4e8fb46d21ddfee3376c
msgid "``TRQD_DE_PIN`` = 55 (AUX6) and connect the autopilot's AUX6 pin to the RS485<->TTL converter's DE and RE pins"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:82
#: fe3e28304ec342bb88bdd936433f7c47
msgid "Battery voltage and current information are taken from the Torqeedo battery or motor by setting this parameter"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:84
#: 97e44b1233654336b06cb43a3d1501ad
msgid ":ref:`BATT_MONITOR <BATT_MONITOR>` = 23 (Torqeedo)"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:87
#: 4b2f004be2b44d028c1cbd90d9786bfd
msgid "Logging and Reporting"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:89
#: 8de09ad9ed2d4dee87b114a3a6147d11
msgid "Motor RPM and temperature along with battery voltage and current are reported to the ground station in real-time using the ESC_TELEMETRY_1_TO_4 mavlink message.  If using Mission Planner (and perhaps other ground stations) these values can be seen on the \"Data\" screen's \"Status\" tab in the \"esc3_curr\", \"esc3_rpm\", etc fields."
msgstr ""

#: ../../source/docs/common-torqeedo.rst:91
#: aac27e13b2404d44b8be4f7c1bb05745
msgid "By default \"TRQD\" messages are written to the onboard log at 10hz seconds and include:"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:93
#: acfd60ef01884cd9980104d07d98f083
msgid "Health : whether the autopilot is successfully controlling the motor"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:94
#: bab9cd3507da4c77a6174c52abf42266
msgid "DesMotSpeed : the latest desired motor from the pilot or autopilot expressed as a number from -1000 to +1000"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:95
#: 5dd48f1d78964400b9b75d86d853e4e3
msgid "MotSpeed : the latest requested speed sent to the motor as a number from -1000 to +1000"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:96
#: 05ee6973a87a4ab1a90b6a06660fed32
msgid "SuccCnt : the number of messages successfully consumed from the motor (this should rise steadily)"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:97
#: fbcb96db1e3c437fa917a1fd4e9d214d
msgid "ErrCnt : the number of bytes or messages that were corrupted or could not be processed (this should be a relatively low number)"
msgstr ""

#: ../../source/docs/common-torqeedo.rst:99
#: ef333c1ab2154b2891219a8903f6e380
msgid "The \"TRST\" log message (only available when using the \"Tiller\" connection) includes the Master error code, motor temperature, voltage, current, power (in Watts) and RPM along with the battery percentage state of charge, voltage and current."
msgstr ""

#: ../../source/docs/common-torqeedo.rst:101
#: 3d064d2a240a414da00e3268da8d3940
msgid "The \"TRSE\" log message (only available when using the \"Tiller\" connection) includes the motor type, battery capacity and software versions."
msgstr ""

#: ../../source/docs/common-torqeedo.rst:103
#: 37ba19792afe4d958b60467c48f26330
msgid "The \"TRMP\" log message (only available when using the \"Motor\" connection) includes the motor RPM, power (in Watts), voltage, current and temperature."
msgstr ""

#: ../../source/docs/common-torqeedo.rst:105
#: ecaaab0a0d2740f9be2522f012a68ade
msgid "This above log information can also be sent as text to the ground station by setting ``TRQD_OPTIONS`` = 3"
msgstr ""

