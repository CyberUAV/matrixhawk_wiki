#: ../../source/docs/acro-mode.rst:5
#: dc4df2ce3b29458a910b1ee18499172c
msgid "Acro Mode"
msgstr ""

#: ../../source/docs/acro-mode.rst:7
#: 9f2cc4944ad241299a54764beabaf58c
msgid "In Acro mode the user's steering stick controls the vehicle's turn rate and the throttle stick controls the vehicle's speed."
msgstr ""

#: ../../source/docs/acro-mode.rst:9
#: 85fe0163478b4642b74bf6369a954f0e
msgid "the :ref:`ACRO_TURN_RATE <ACRO_TURN_RATE>` parameter controls the maximum turn rate the user's steering stick can request. The turn rate varies linearly from zero to :ref:`ACRO_TURN_RATE <ACRO_TURN_RATE>` as the RC input varies from neutral to full deflection. Once the input returns to neutral, the vehicle will attempt to hold heading, compensating for external influences, ie. \"heading hold\"."
msgstr ""

#: ../../source/docs/acro-mode.rst:10
#: a8efb87c870a48b99f320618a28fffa6
msgid "the top speed is interpolated from the :ref:`CRUISE_THROTTLE <CRUISE_THROTTLE>` and :ref:`CRUISE_SPEED <CRUISE_SPEED>` parameters.  These parameters are described on the :ref:`Tuning Speed and Throttle <rover-tuning-throttle-and-speed>` page."
msgstr ""

#: ../../source/docs/acro-mode.rst:11
#: a94418a7d4c646f68d5fe22ee2afe320
msgid ":ref:`Object Avoidance <rover-object-avoidance>` is active in this mode (if configured)."
msgstr ""

#: ../../source/docs/acro-mode.rst:13
#: 00edd1966a6a43858e0c3c2a2690e358
msgid "This mode is perhaps the most useful mode for tuning the vehicle's :ref:`Steering Rate <rover-tuning-steering-rate>` controller."
msgstr ""
