msgid "ArduPilot Configuration"
msgstr ""

#: ../../source/docs/common-FPort-receivers.rst:31
#: 963ddd082e0d414f9f47c952a77b8f7b
msgid "Configuration depends on the autopilot and connection method."
msgstr ""

#: ../../source/docs/common-FPort-receivers.rst:33
#: c757d5fb3d1348d980d70a3fda598161
msgid "Any configuration change to a UART requires a re-boot to take effect. Reminder: UART numbers do not necessarily map to SERIALx numbers. Check the :ref:`board's description<common-autopilots>`"
msgstr ""

#: ../../source/docs/common-FPort-receivers.rst:36
#: db15b9f6a9a34ecdaad7ba5476469887
msgid "In general, F4 based autopilots using an external bi-directional inverter can use any UART with the following configuration:"
msgstr ""

#: ../../source/docs/common-FPort-receivers.rst:38
#: ../../source/docs/common-FPort-receivers.rst:44
#: 1979e1c81a3449df9ad90a31282efc88
#: 2e05a34c05fe49bd8538cbc369516aad
msgid "``SERIALx_PROTOCOL`` = 23"
msgstr ""

#: ../../source/docs/common-FPort-receivers.rst:39
#: 896271c11457482da693c1ce0b665544
msgid "``SERIALx_OPTIONS`` = 160 (enable pull-up/pull-downs on TX and RX pins for those external inverter circuits that may require it, won't affect those that do not need it)"
msgstr ""

#: ../../source/docs/common-FPort-receivers.rst:40
#: ../../source/docs/common-FPort-receivers.rst:46
