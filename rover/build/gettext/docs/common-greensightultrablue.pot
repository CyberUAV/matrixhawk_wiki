#: ../../source/docs/common-greensightultrablue.rst:963
#: 04a463cf4ee94b72bb215e21d122e8e4
msgid "The RCIN pin, which is physically mapped to UART8 and configured by default as SERIAL5, can be used for most ArduPilot supported unidirectional receiver protocols. For this reason :ref:`SERIAL5_PROTOCOL<SERIAL5_PROTOCOL>` defaults to “23” (RCIN)."
msgstr ""

#: ../../source/docs/common-greensightultrablue.rst:966
#: 5dccb4e5e13241e192c3f27c9c7fd3f8
msgid "PPM: Connect to the JP1 connector. PPM input is only supported on JP1 as it requires a special interrupt."
