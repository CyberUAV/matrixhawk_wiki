#: ../../source/docs/common-baro-external.rst:4
#: 5c5dfd52e61b412287584e468de0937d
msgid "Barometer (external)"
msgstr ""

#: ../../source/docs/common-baro-external.rst:12
#: 34a3467dc29641c09c6ce0e3fcd1645d
msgid "Most autopilots include a barometer directly on the autopilot but attaching an external barometer can be useful in order to place the barometer away from air pressure disturbances.  It can also allow monitoring the environmental or an internal component's temperature within a typical range of -40 - +85°C."
msgstr ""

#: ../../source/docs/common-baro-external.rst:16
#: a9aabb6664684ffe958c5552bdad6772
msgid "Copter users can partially reduce the effect of air pressure disurbances by enabling :ref:`Ground Effect Compensation <Copter:ground-effect-compensation>`"
msgstr ""

#: ../../source/docs/common-baro-external.rst:19
#: e4b737b9cb10425ebc24823910ad33f4
msgid "Where to Buy"
msgstr ""

#: ../../source/docs/common-baro-external.rst:21
#: c268e4965d9f4bb594f327108cdbfde0
msgid "`Beyond Robotix Air Data Module (Amphenol AUAV) <https://www.beyondrobotix.com/products/air-data-module>`_"
msgstr ""

#: ../../source/docs/common-baro-external.rst:22
#: 2dd91cab5464453c94aba5e6a83b204f
msgid "`BMP280 I2C from Adafruit <https://www.adafruit.com/product/2651>`__"
msgstr ""

