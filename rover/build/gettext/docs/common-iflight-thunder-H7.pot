#: ../../source/docs/common-iflight-thunder-H7.rst:93
#: af09be0fad0e40f9964ddc275265a64a
msgid "The iFlight Thunder H7 supports up to 9 PWM outputs. The pads for motor output M1 to M8 are provided in the motor connector, plus M9 on a separate pad for LED strip or another PWM output."
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:97
#: 55983dd4aa3a4d1db08f1827e3d4eb10
msgid "The PWM is in 5 groups:"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:100
#: 0f48ca888dc6450dabf0e8b969e009b5
msgid "PWM 1-2   in group1"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:101
#: 997aa081022440bd979b49394c09d99f
msgid "PWM 3-6   in group2"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:102
#: ba123532b419465384b0a11ed19e59e3
msgid "PWM 7-8   in group3"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:103
#: e9c903c6792c4cda9ebfe7a3f68f95c1
msgid "PWM 9     in group4"
msgstr ""

#: ../../source/docs/common-iflight-thunder-H7.rst:105
#: 9cb962b7066b4e3d89cafc675ddc0061
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-8 support bi-directional dshot."
msgstr ""

