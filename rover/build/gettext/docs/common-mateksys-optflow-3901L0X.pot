#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:5
#: cfc53c8f678a41f8835eeaf0f98b14ae
msgid "MatekSys Optical Flow 3901-L0X"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:9
#: 5c9aa83f30c149d1ae5b15901b0b96c8
msgid "The `MatekSys optical flow 3901-L0X sensor <http://www.mateksys.com/?portfolio=3901-l0x>`__ is a lightweight optical flow sensor including a short range lidar which uses the MSP protocol to communicate with the autopilot.  This can be used to improve horizontal position control especially in GPS denied environments."
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:17
#: 596a5a5df9434545ad05be2cd7d57f69
msgid "The lidar included with the sensor is very short range especially outdoors.  We strongly recommend using a :ref:`longer range lidar instead <common-rangefinder-landingpage>`."
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:20
#: 9de5fed4af7448c79b336ca6a0694e19
msgid "Where to Buy"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:22
#: 2fbacb974fda4c46836d5cee0b9c4129
msgid "The sensor is available from `Matekesys resellers <http://www.mateksys.com/?page_id=1212>`__"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:25
#: 86f32c263bba45f99ad1287b5d37f6c6
msgid "Connection to Autopilot"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:35
#: 320e232017f0487cbfdf6fef34cd35e5
msgid "The flow sensor should be mounted on the underside of the copter with the camera lens pointing downwards.  The small arrow near the camera lens should be pointing forwards"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:36
#: 9156c940517247b3b9ea59e83c3348c0
msgid "Connect the sensor to one of the autopilot's serial ports (e.g. Serial2 / Telem2)"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:37
#: b4269b736b9d463184661a2202347922
msgid "Set :ref:`FLOW_TYPE <FLOW_TYPE>` = 7 (MSP)"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:38
#: 5e7fb6069d2c4c8f966d137691ffa4a2
msgid "Set :ref:`FLOW_FXSCALER <FLOW_FXSCALER>` = -800"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:39
#: d069355f481f44d7982d0464a0a7e026
msgid "Set :ref:`FLOW_FYSCALER <FLOW_FYSCALER>` = -800"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:40
#: 905dbfe58ec74588ac85b0bcaaada63b
msgid "Set :ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 32 (MSP) (assuming sensor is connected to Serial2)"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:41
#: f1b2b285f54841c1a20b56923f6cce0f
msgid "Set :ref:`SERIAL2_BAUD <SERIAL2_BAUD>` = 115 (115200 bps) (assuming sensor is connected to Serial2)"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:43
#: 23172e03f9214aefa9ee83c8ed61021a
msgid "To use the onboard lidar (not recommended):"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:45
#: 28e880f6384242ceb1533a435585a2cf
msgid "Set :ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 32 (MSP)"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:46
#: 0da5574232b54dcc8c34273d51e95ff2
msgid "Set :ref:`RNGFND1_MAX <RNGFND1_MAX>` = 1.2 to set range finder's maximum range to 1.2m"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:49
#: e61ece78a7274b63a053c18bed6bf2a1
msgid "Additional Notes"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:51
#: dc000c39f9f24cd382fee55b10069177
msgid "As with all optical flow sensors, a range finder is required to use the sensor for autonomous modes including :ref:`Loiter <loiter-mode>` and :ref:`RTL <rtl-mode>`"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:52
#: bf059ce0b42740d78acf58a71d3e520f
msgid ":ref:`FlowHold <flowhold-mode>` does not require the use of a rangefinder but performance is generally worse than Loiter mode and is not recommended"
msgstr ""

#: ../../source/docs/common-mateksys-optflow-3901L0X.rst:53
#: e086fa00a75849dfae5b4efcc20146f5
msgid "Performance can be improved by setting the :ref:`sensors position parameters <common-sensor-offset-compensation>`.  For example if the sensor is mounted 2cm forward and 5cm below the frame's center of rotation set :ref:`FLOW_POS_X <FLOW_POS_X>` to 0.02 and :ref:`FLOW_POS_Z <FLOW_POS_Z>` to 0.05."
msgstr ""

