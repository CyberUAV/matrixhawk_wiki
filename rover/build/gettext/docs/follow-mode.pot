#: ../../source/docs/follow-mode.rst:5
#: bd22000b94454be5b2560496e83e53d4
msgid "Follow Mode"
msgstr ""

#: ../../source/docs/follow-mode.rst:10
#: 2ceb83db42e34524ab25fe61550b1368
msgid "When switched into Follow, the vehicle will attempt to follow another vehicle (or anything publishing its position) at a specified offset.  The lead vehicle's position must be published to the vehicle in Follow mode using a telemetry system as shown below. QGroundControl's application (QGC) for Android phones and computers has this feature in beta testing also, so instead of following a vehicle, it will follow the ground control station, similar to FOLLOW ME mode in Copter."
msgstr ""

#: ../../source/docs/follow-mode.rst:12
#: 0a06561b93ba450aacd8014e173a9b6d
msgid "In its simplest form, each vehicle has a telemetry radio with the same NETID, on one of their telemetry ports."
msgstr ""

#: ../../source/docs/follow-mode.rst:17
#: 399f89c9da4541b48687e612178b56c8
msgid "Vehicle A merely enters FOLLOW mode and it will attempt to follow Vehicle B, and vice-versa."
msgstr ""

#: ../../source/docs/follow-mode.rst:19
#: 9ad08c26cfe74686b96afa118114c9c3
msgid "If Vehicle A or B requires Ground Station Control, an additional Telemetry radio on a different NETID (YY) can be installed on another telemetry port on the vehicle controller, paired with the GCS's radio on that same NETID."
msgstr ""

#: ../../source/docs/follow-mode.rst:24
#: a75e295d484f4d46bb24bfb9a4dc921b
msgid "If using QGroundControl ensure the Application setting under the General tab ``Stream GCS Position`` is set to \"When in Follow Me Flight Mode\" or \"Always\".  Next connect to the vehicle and switch to FOLLOW Mode and it will then follow the computer/phone running QGC."
msgstr ""

#: ../../source/docs/follow-mode.rst:29
#: 320a8125d90a46a4a58649a1058d6bca
msgid "The following parameters can be used to tune Follow mode's performance:"
msgstr ""

#: ../../source/docs/follow-mode.rst:31
#: 4603f796d51547ceaa398f2af524bc94
msgid ":ref:`FOLL_ENABLE <FOLL_ENABLE>`: set to 1 to enable follow mode and refresh parameters."
msgstr ""

#: ../../source/docs/follow-mode.rst:32
#: e6e270eb492f4d53b6c60a4eb6e167a5
msgid ":ref:`FOLL_SYSID <FOLL_SYSID>`: MAVLink system id of lead vehicle (\"0\" means follow the first vehicle \"seen\")."
msgstr ""

#: ../../source/docs/follow-mode.rst:33
#: d59053dfbd404394868e5967faa78582
msgid ":ref:`FOLL_DIST_MAX <FOLL_DIST_MAX>`: if lead vehicle is more than this many meters away, give up on following and hold position (loiter if boat, stop if ground vehicle)."
msgstr ""

#: ../../source/docs/follow-mode.rst:34
#: 36cdd71772864cb0aead7b14e425788c
msgid ":ref:`FOLL_OFS_X <FOLL_OFS_X>`, :ref:`FOLL_OFS_Y <FOLL_OFS_Y>`, :ref:`FOLL_OFS_Z <FOLL_OFS_Z>` (not used in Rover) : 3D offset (in meters) from the lead vehicle. If they are zero, then the current vehicle's offset from the follow target at time of mode entry is used every time. These offsets can be altered via Mavlink and will take effect immediately. However, if they were originally zero and changed during FOLLOW MODE rather than during another mode, they will be reset to zero for the next entry into FOLLOW mode, until a reboot occurs and then the changed offsets will be restored."
msgstr ""

#: ../../source/docs/follow-mode.rst:35
#: 9b8bf865f6904498a56d4b2318ad107f
msgid ":ref:`FOLL_OFS_TYPE <FOLL_OFS_TYPE>`: set to 0 if offsets are North-East (NED), 1 if offsets are relative to lead vehicle's heading, see diagrams below."
msgstr ""

#: ../../source/docs/follow-mode.rst:36
#: 67d4ee7c6c474cda92d864024df3f19c
msgid ":ref:`FOLL_POS_P <FOLL_POS_P>`: gain which controls how aggressively this vehicle moves towards lead vehicle (limited by :ref:`WP_SPD<WP_SPD>`)"
msgstr ""
