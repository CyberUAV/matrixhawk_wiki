#: 83f77031aa2b4f008e84395e17115f85
msgid "The PWM is in 4 groups:"
msgstr ""

#: ../../source/docs/common-mambaH743v4.rst:107
#: 2c93dbd0c6bd46fc9cc0b7d04e5dcb46
msgid "PWM 1-4 in group1"
msgstr ""

#: ../../source/docs/common-mambaH743v4.rst:108
#: 2f70901712f14c89b5c9dc19bb1dfb21
msgid "PWM 5,6 in group2"
msgstr ""

#: ../../source/docs/common-mambaH743v4.rst:109
#: 1f9a2f241851468e9adfd1fa083354e3
msgid "PWM 7,8 in group3"
msgstr ""

#: ../../source/docs/common-mambaH743v4.rst:110
#: d5ae61473ece45b6bf7b19e731e84980
msgid "PWM 9 in group4"
msgstr ""

#: ../../source/docs/common-mambaH743v4.rst:112
#: 79fee87841f84563ad8fb3e0794189ed
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-8 support bi-directional DShot."
msgstr ""

