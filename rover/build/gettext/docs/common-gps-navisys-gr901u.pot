#: ../../source/docs/common-gps-navisys-gr901u.rst:10
#: 0695f61a649b485491193c1f831dbb55
msgid "Navisys GR-901U is an advanced RTK base station. Equipped with u-blox ZED-F9P engine, it features L1/L2 dual-band, centimeter-level accuracy and supports multiple satellite systems, including GPS, GLONASS, BeiDou, Galileo, and QZSS."
msgstr ""

#: ../../source/docs/common-gps-navisys-gr901u.rst:14
#: b215fcef118d42f8bdb92fb19fc667db
msgid "Navisys GR-901U is fully compatible with Ardupilot and provide high precision GPS data for UAV/drone applications. Simply plug Navisys GR-901U into a computer, it’s serving as an RTK Base in Ardupilot Mission Planner！"
msgstr ""

