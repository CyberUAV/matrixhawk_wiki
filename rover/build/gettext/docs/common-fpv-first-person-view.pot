msgstr ""

#: ../../source/docs/common-fpv-first-person-view.rst:53
#: 97af4faca5b7434a855f80f9b65eb5c9
msgid "FPV equipment on the vehicle should be placed as far away as possible from GPS and RC receiver to reduce the chance of interference."
msgstr ""

#: ../../source/docs/common-fpv-first-person-view.rst:57
#: cd989eecb584416487f5197000562d0c
msgid "Minim OSD setup through mission planner"
msgstr ""

#: ../../source/docs/common-fpv-first-person-view.rst:59
#: 6dcb43db06554f049fa14740c9761617
msgid "The MinimOSD set-up guide :ref:`can be found here <common-minim-osd-quick-installation-guide>`."
msgstr ""

#: ../../source/docs/common-fpv-first-person-view.rst:62
#: 8bd5b1ac66434c799a8de25aacbed5ad
msgid "Integrated OSD"
msgstr ""

#: ../../source/docs/common-fpv-first-person-view.rst:64
#: 0465a598f57e4bdbbc07685b43c5c1b7
msgid "Many autopilots now integrate the :ref:`OSD function<common-osd-overview>` on board, eliminating the need for an external device and reducing wiring."
msgstr ""

