#: ../../source/docs/common-gps-blending.rst:5
#: fc4a0cd7ba374ce2ac81855a013d93de
msgid "GPS Blending (aka Dual GPS)"
msgstr ""

#: ../../source/docs/common-gps-blending.rst:7
#: 8844ea917942466ca887c3e4352c7a55
msgid "GPS Blending combines the readings from two gpses. Using two GPSes reduces the chance of glitches affecting the vehicle."
msgstr ""

#: ../../source/docs/common-gps-blending.rst:13
#: b16411e5a4c54f6eb9a591edb4edcac5
msgid "Only GPSs that report position and speed accuracy can be used for blending.  All UBlox GPSs provide this extra information while GPSs using the NMEA protocol generally do not."
msgstr ""

#: ../../source/docs/common-gps-blending.rst:15
#: 0ade5749c8f749d0980419574b6d7557
msgid "Normally blending should be done with two GPSs from the same manufacturer because the scaling of the accuracy numbers varies and will lead to favouring one GPS over the other."
msgstr ""

#: ../../source/docs/common-gps-blending.rst:18
#: 39bef76fdc7a47c39ff9e744c519931c
msgid "Setup through the Ground Station"
msgstr ""

#: ../../source/docs/common-gps-blending.rst:20
#: 8485a3dd76974d0d9b7fa6259d726b64
msgid ":ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 5 / \"GPS\".  Alternatively telemetry port 1 or 2 can be used by setting :ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` or :ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` to 5."
msgstr ""

#: ../../source/docs/common-gps-blending.rst:21
#: 507e885167c1484283eaf97a056d1a79
msgid ":ref:`GPS2_TYPE <GPS2_TYPE>` = 1 / \"AUTO\" or the specific number corresponding to the type of GPS"
msgstr ""

#: ../../source/docs/common-gps-blending.rst:22
#: b02f8c18fc6640a9aa8163a72ddd8479
msgid ":ref:`GPS_AUTO_SWITCH <GPS_AUTO_SWITCH>` = 2 / \"Blend\".  Alternatively set to 1 / \"UseBest\" to only use the better GPS.  The better GPS is decided based on the GPS's self reported accuracy."
msgstr ""

#: ../../source/docs/common-gps-blending.rst:24
#: 6a00de5fe7f24cf8b0de7f84a2151271
msgid "After rebooting the board, the status, hdop and satellite count of both GPSs should be visible."
msgstr ""

#: ../../source/docs/common-gps-blending.rst:30
#: cdc4a48cf9e6413f9690254a15dc6c41
msgid "Dataflash logging"
msgstr ""

#: ../../source/docs/common-gps-blending.rst:32
#: 61dde29d4793474083346aa86f8ce5cf
msgid "The first GPS's data appears with an instance number of 0 in the GPS and GPA messages. (ie GPS[0].x, GPA[0].x messages) The second GPS's data appears with an instance number of 1 in the GPS and GPA messages. The blended GPS data appears with an instance number of 2 in the GPS and GPA messages."
msgstr ""

#: ../../source/docs/common-gps-blending.rst:36
#: b3b57d58b2a247d9acdbb28dae3ddf82
msgid "If using the Mission Planner, opening a dataflash log and clicking on \"Show Map\" will show both GPSs, the blended position and the EKF's final estimate (shown as \"POS\")"
msgstr ""

#: ../../source/docs/common-gps-blending.rst:42
#: b7dd1f95b86a4a86ac1946949ed225d5
msgid "Video"
msgstr ""

#: ../../source/docs/common-gps-blending.rst:44
#: 760a871ac60049fba0a5e1fc9160975e
msgid "Video of a heavily loaded IRIS using Blended GPS, optical flow and a lidar range finder"
