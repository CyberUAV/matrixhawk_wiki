#: 4e5790e40dfe443bafb1f0a1f9dfa7f2
msgid "Try graphing the:"
msgstr ""

#: ../../source/docs/common-diagnosing-problems-using-logs.rst:94
#: c9206dc0baad4d5aacb943ab46098d71
msgid "Dataflash log's CTUN Alt (altitude above home) or BAlt (Barometer altitude)"
msgstr ""

#: ../../source/docs/common-diagnosing-problems-using-logs.rst:95
#: 2c2eea59291f4f2dbd808d62a01fab68
msgid "Dataflash log's GPS Alt (altitude above sea level)"
msgstr ""

