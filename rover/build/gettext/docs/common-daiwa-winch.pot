msgstr ""

#: ../../source/docs/common-daiwa-winch.rst:65
#: a0f2bd73ba184078b06eab175ad3d756
msgid ":ref:`RC8_OPTION <RC8_OPTION>` = 44 (Winch Enable) to allow relaxing the winch by pulling the transmitter's channel 8 switch low"
msgstr ""

