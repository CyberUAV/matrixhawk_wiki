#: ../../source/docs/common-simple-object-avoidance.rst:53
#: 78486900749f4acaa96f566789306e79
msgid "SAFETY FIRST!"
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:55
#: f9659d4f787a473c9c0b0326f8e4eb0d
msgid "The avoidance algorithms have been constantly changing. While in most scenarios it will help the user keep the vehicle safe from any obstacles, or fence breaches; due to unknown sensor glitch, or other such problems, avoidance should be swiftly turned off mid-flight (especially while trying for the first time)."
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:56
#: 6c880adfaf6341d585bfd939869818a8
msgid "Set any vacant channel of your Transmitter to use RCx_OPTION parameter and set it to 40. For example, if channel 8 switch of your transmitter is vacant, set :ref:`RC8_OPTION<RC8_OPTION>` = 40."
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:57
#: aa4ce8b782044a5eb7fe6affdfee0b00
msgid "Toggling this switch to HIGH would switch on Proximity based avoidance and vice versa."
msgstr ""

