#: 3459969b6465463cabf1efaa5de781e7
msgid "set :ref:`PRX1_TYPE <PRX1_TYPE>` = \"4\" to enable using first range finder as a \"proximity sensor\""
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:77
#: 35fd2c6b92fb450ba6afda180f47c07e
msgid "Rover attempts to stop the vehicle before it hits objects in all modes except MANUAL."
msgstr ""

