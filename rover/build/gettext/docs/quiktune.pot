#: ../../source/docs/quiktune.rst:5
#: e49560f9602840ec9da53f10e9c9ec4b
msgid "QuikTune"
msgstr ""

#: ../../source/docs/quiktune.rst:10
#: 69fd750c0bfd4ff5ab700bdb3a09f8f3
msgid "The `Rover QuikTune <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_Scripting/applets/rover-quicktune.md>`__ Lua script simplifies the process of finding good gains for a vehicle's steering and speed controllers."
msgstr ""

#: ../../source/docs/quiktune.rst:12
#: daf00e92b0f14cf683578831e4f5ae27
msgid "The script should be run while the vehicle is circling in :ref:`Circle mode <circle-mode>`. It records the steering and throttle outputs and the resulting response (e.g. vehicle's turn rate and speed) for at least 10 seconds in order to calculate the feed-forward gains. The P and I gains are then set to a ratio of the feed-forward's. Once complete the gains are saved automatically."
msgstr ""

#: ../../source/docs/quiktune.rst:17
#: dc0b7466d50e4480bd1368617b681e3d
msgid "By default the gains will be tuned in this order:"
msgstr ""

#: ../../source/docs/quiktune.rst:19
#: e2e86b9db6c349828679dd4d61ceef4f
msgid ":ref:`ATC_STR_RAT_FF <ATC_STR_RAT_FF>`, then :ref:`ATC_STR_RAT_P <ATC_STR_RAT_P>` and I are set to ratios of the FF"
msgstr ""

#: ../../source/docs/quiktune.rst:20
#: a49a3888c17d477f833a20588f6ae9e7
msgid ":ref:`CRUISE_SPEED <CRUISE_SPEED>` and :ref:`CRUISE_THROTTLE <CRUISE_THROTTLE>`, then :ref:`ATC_SPEED_P <ATC_SPEED_P>` and I are set to ratios of the FF"
msgstr ""

#: ../../source/docs/quiktune.rst:22
#: 7a5a821f2f9f45a8aa94870f5d017a6a
msgid "The script will also adjust filter settings:"
msgstr ""

#: ../../source/docs/quiktune.rst:24
#: 551a901ed6fb4bf9adbe78e8c79d6646
msgid ":ref:`ATC_STR_RAT_FLTD <ATC_STR_RAT_FLTD>` and FLTT will be set to half of the :ref:`INS_GYRO_FILTER <INS_GYRO_FILTER>` value"
msgstr ""

#: ../../source/docs/quiktune.rst:27
#: 5305a08c87fe4a8887c1e2f551fd241d
msgid "Installing the Script"
msgstr ""

#: ../../source/docs/quiktune.rst:29
#: b91578b87736495dbd5d9fd9e97de16e
msgid "Set :ref:`SCR_ENABLE <SCR_ENABLE>` = 1 to enable scripting and then reboot the autopilot"
msgstr ""

#: ../../source/docs/quiktune.rst:30
#: c1b8f5a09fa1499790efee1de2fbbffd
msgid "Download `rover-quicktune.lua <https://raw.githubusercontent.com/ArduPilot/ardupilot/master/libraries/AP_Scripting/applets/rover-quicktune.lua>`__ to your PC"
msgstr ""

#: ../../source/docs/quiktune.rst:31
#: 924db6499f764d0c898fa6ffab0864ce
msgid "Copy the script to your autopilot's SD card's APM/scripts directory.  If using MP it may be easiest to use the Config, MAVFtp screen"
msgstr ""

#: ../../source/docs/quiktune.rst:37
#: bcef1b9539e64088a03c74cb52a425c2
msgid "Reboot the autopilot and set RTUN_ENABLE = 1"
msgstr ""

#: ../../source/docs/quiktune.rst:38
#: 6386644014634d4e93991281e5fe449e
msgid "If an RC switch will be used to start/stop the tune set RCx_OPTION = 300 where \"x\" is the RC input channel number.  Alternatively set one of Mission Planner's Aux Function tab's rows to \"Scripting1\""
msgstr ""

#: ../../source/docs/quiktune.rst:45
#: 41ef787a310046dab9dc4b0d64022446
msgid "Running QuikTune"
msgstr ""

#: ../../source/docs/quiktune.rst:47
#: c4f299bee6244ae998f96da5af1df6be
msgid "Go to an open area with good GPS reception"
msgstr ""

#: ../../source/docs/quiktune.rst:48
#: 50dd87269fc64012a4cf7de1fd1aba4a
msgid "Connect with a ground station (e.g Mission Planner or QGC) and ensure that the Messages tab can be seen.  This is where output from the tune will appear"
msgstr ""

#: ../../source/docs/quiktune.rst:49
#: 59d93fb1774346be92a35ae972b84b07
msgid "Move the RC switch to the low position OR push MP's Aux Function's \"Low\" button"
msgstr ""

#: ../../source/docs/quiktune.rst:50
#: 80553623b8b64cdaad83f3c42b1f9112
msgid "Optionally set :ref:`CIRC_SPEED <CIRC_SPEED>` to about half the vehicle's maximum speed"
msgstr ""

#: ../../source/docs/quiktune.rst:51
#: ee4208d856ee4ea599d22221c1c66576
msgid "Arm the vehicle, drive to an open area and switch to :ref:`Circle mode <circle-mode>`"
msgstr ""

#: ../../source/docs/quiktune.rst:52
#: 0742f6796e8c4d768588a71689eba621
msgid "Begin the tune by moving the RC switch to the middle position OR push MP's Aux Function's \"Mid\" button"
msgstr ""

#: ../../source/docs/quiktune.rst:53
#: 038b0f8b005e4680ba6a6bb07b84f65b
msgid "Monitor the progress of the tune using the GCS's Messages tab"
msgstr ""

#: ../../source/docs/quiktune.rst:54
#: b8d572eaddf9489a96b47d92ad88d0a5
msgid "If the RC steering and throttle sticks are moved from their center position the tuning will be paused until a few seconds after they are moved back to their center position"
msgstr ""

#: ../../source/docs/quiktune.rst:55
#: f14c291ad0204113929825ffacc9ddb8
msgid "If the vehicle begins oscillating violently cancel the tune by moving the RC switch to the low position OR push MP's Aux Function's \"Low\" button"
msgstr ""

#: ../../source/docs/quiktune.rst:56
#: 2caec265cee84ab5b58176ec414cf3b7
msgid "Once the tune has completed the new gains will be saved automatically"
msgstr ""

#: ../../source/docs/quiktune.rst:57
#: cfb6bc8646c8430fb6961d75097475e1
msgid "Drive the vehicle home and disarm"
msgstr ""

