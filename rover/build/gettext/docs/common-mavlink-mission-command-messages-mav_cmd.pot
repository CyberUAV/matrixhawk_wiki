#: 32a975bf4699489dbd1d67a295f05b90
msgid "Delays the start of the next \"``_DO_``\\ \" command until the vehicle is within the specified number of meters of the next waypoint."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1103
#: 506acc9021664d569e0efc8900a3d151
msgid "This command does not stop the vehicle: it only affects DO commands."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1160
#: 089e9f19c0ee4694bc987d4ae0065b45
msgid "Mission PlannerSettings for CONDITION_DISTANCE command"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1162
#: f71cd834b2c04f0e95e06d6fce7397b2
msgid "In the example above, Command #4 (``DO_SET_ROI``) is delayed so that it only starts once the vehicle is within 50m of waypoint #5."
msgstr ""

