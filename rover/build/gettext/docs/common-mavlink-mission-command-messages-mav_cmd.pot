#: 24132b1cb1fa4269a436dc74ce3acbc6
msgid "Jump to the specified :ref:`MAV_CMD_JUMP_TAG<MAV_CMD_JUMP_TAG>` item in the mission list. The jump tag command can be repeated, either a specified number of times before continuing the mission, or it can be repeated indefinitely."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:935
#: a09dcc9d44fc4c1a94cc8d4132242834
msgid "There can be a maximum of 15 jump_tag commands in a mission after which new DO_JUMP_TAG commands are ignored."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:997
#: b45753cc63d146cf849eb8638ddfe470
