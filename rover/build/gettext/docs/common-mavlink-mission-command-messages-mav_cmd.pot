msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:918
#: bd5b8a24038c449a99592c54e6cfa92e
msgid "MAV_CMD_DO_JUMP_TAG"
msgstr ""

