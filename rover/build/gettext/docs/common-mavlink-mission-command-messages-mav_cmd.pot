msgid "In the example above, the vehicle would fly back-and-forth between waypoints #3 and #4 a total of 3 times before completing the mission. This is because the DO_JUMP_TAG redirects the vehicle to JUMP_TAG #565 twice."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1002
#: 4038f7480c7e40f2bf3bb1e769af62d5
msgid "Conditional commands"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1004
#: 4574a5569f9d4e71bdac9f52600b50b3
msgid "Conditional commands control the execution of \\_DO\\_ commands. For example, a conditional command can prevent DO commands from executing based on a time delay, until the vehicle is at a certain altitude, or at a specified distance from the next target position."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1009
#: a56b8d64f6ff4dbcabaaeebaeec3144a
msgid "A conditional command may not be complete before reaching the next waypoint. In this case, any unexecuted \\_DO\\_ commands associated with the last waypoint will be skipped."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1016
#: 6bf2c07d14bd495b89ddcd834dbe4fd6
msgid "MAV_CMD_CONDITION_DELAY"
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1020
#: d6b870b8026a4e7b9c8b4dd788b2f630
msgid "After reaching a waypoint, delay the execution of the next conditional \"_DO_\" command for the specified number of seconds (e.g. :ref:`MAV_CMD_DO_SET_ROI <mav_cmd_do_set_roi>`)."
msgstr ""

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1026
#: 60d6abf6316141ee8c29e53f46716d33
msgid "This command does not stop the vehicle. If the vehicle reaches the next waypoint before the delay timer completes, the delayed \"_DO_\" commands will never trigger."
msgstr ""

