msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:46
#: 612a1ee68839400592fe7dde8755045c
msgid "The default RC input is configured on UART2, and all ArduPilot compatible protocols, except PPM and SBUS, are supported. SBUS support is provided via the HD VTX connector on SERIAL1 and but requires the protocol be set to :ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>` = \"23\" and to change :ref:`SERIAL2_PROTOCOL<SERIAL2_PROTOCOL>` to something other than '23'."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:48
#: fc53d99a201e4ed38cd042e70afb8194
msgid "PPM is not supported"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:49
#: bb1e109e4fa14d77ba8d36e502a9372a
msgid "FPort requires an external bi-directional inverter (see :ref:`common-fport-receivers`)"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:50
#: c3a8845d42f34edaaf778dffdb359ed2
msgid "CRSF requires connection to TX2 and automatically supports telemetry"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:51
#: b72c1acbba124570bb55da415c83c26d
msgid "DSM/SRXL connects to the RX2 pin, but SBUS would still be connected to SBUS."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:52
#: d7a71ace5a07458ab4475e3bd4db2e95
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry. Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to “4”."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:55
#: dded8d2be8e94a6f8e6a5ba914a0d897
msgid "FrSky Telemetry"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:56
#: 0ea722a633454c0caa6fe5037b522ff1
msgid "FrSky Telemetry can be supported using a spare UART's transmit pin. For example, you could set the following parameters to enable support for FrSky S.PORT on SERIAL4"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:58
#: 37ba908441fb402caaf75f757cc62061
msgid ":ref:`SERIAL4_PROTOCOL<SERIAL4_PROTOCOL>` 10"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:59
#: 2026518881304128b216df7e903fda92
msgid ":ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` 7"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:62
#: 9514a52ceca441ccad48053f997e7674
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:63
#: 11cca9c4d4054641b09b17accba8a780
msgid "The BROTHERHOBBYF405v3 supports OSD using OSD_TYPE 1 (MAX7456 driver). Simultaneously, DisplayPort HD VTX connections can be made to UART3 (included on the HD VTX connector)."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:66
#: b44ff819be57474f86a2ebf35faf5b39
msgid "VTX Support"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:67
#: 0aef1035f2da446a904fb11a09d2aca6
msgid "The SH1.0-6P connector supports a standard DJI HD VTX connection. Pin 1 of the connector is 10v so be careful not to connect anything that could be damaged by this voltage."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:71
#: 12ce9d09997e4119b008c40178246b2f
msgid "PWM Outputs"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:72
#: af569ee89f6847a79e3376b52722a68f
msgid "The BROTHERHOBBYF405v3 supports up to 9 PWM outputs. Outputs 1-4 are on the ESC connector, while the others are available via solder pads."
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:74
#: e48a1166590d449fbadbe3011541e4ae
msgid "Channels 1-8 support DShot. Channels 1-4 support bi-directional DShot."
msgstr ""

