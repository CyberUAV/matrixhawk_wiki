#: ../../source/docs/common-rcmap.rst:13
#: 573800eb8774427996939f629a102ca7
msgid "By default the RC input channels are:"
msgstr ""

#: ../../source/docs/common-rcmap.rst:16
#: 772fc297a43546f59a8d891e885a5cfe
msgid "Channel 1: Roll input"
msgstr ""

#: ../../source/docs/common-rcmap.rst:17
