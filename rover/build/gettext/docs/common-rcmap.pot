msgstr ""

#: ../../source/docs/common-rcmap.rst:19
#: cccb53febf13472ab546905005594262
msgid "Channel 4: Yaw input"
msgstr ""

#: ../../source/docs/common-rcmap.rst:22
#: 88cf1520725345dcb10cfc8b6063cb51
msgid "These can be changed by setting the  :ref:`RCMAP_ROLL <RCMAP_ROLL>`, :ref:`RCMAP_PITCH <RCMAP_PITCH>`, :ref:`RCMAP_THROTTLE <RCMAP_THROTTLE>` and :ref:`RCMAP_YAW <RCMAP_YAW>` parameters using the *Mission Planner*'s **Config/Tuning \\| Full Parameter Tree** (or Full Parameter List) as shown below."
msgstr ""

#: ../../source/docs/common-rcmap.rst:27
#: a4ebe94ad98c484b94331c8163b658c5
msgid "After changing any of these parameters the autopilot should be rebooted."
msgstr ""

