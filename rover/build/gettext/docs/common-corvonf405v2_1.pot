msgid "Pinouts"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:35
#: 609506c1ebfd4b0fbb6460dc2f8a1b36
msgid "UART Mapping"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:36
#: 4db3b5cd7af04451a256153be867e436
msgid "SERIAL0 -> USB"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:37
#: 96066f473251439ab4d5be980a9ae96a
msgid "SERIAL1 -> UART1 (MAVLink 2,DMA-enabled)"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:38
#: b3ac1bde318542bf9db9a040cac9f9ee
msgid "SERIAL2 -> UART2 (DJI - VTX, TX only is DMA Enabled)"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:39
#: b37fe6429c0b4c99823de49bec21dbef
msgid "SERIAL3 -> UART3 (GPS)"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:40
#: 08902e1d64c04694a36d6f5c2c7d0cb6
msgid "SERIAL4 -> UART4 (MAVLink2,TX only is DMA Enabled)"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:41
#: 8cb8655acd00475792d95b0da688956b
msgid "SERIAL5 -> UART5 (ESC Telemetry,RX 5 only pinned out)"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:42
#: ab5058c13ec449dda0cdd2c23288fc7a
msgid "SERIAL6 -> UART6 (RCin, RX6 is inverted from SBUS pin, RX only is DMA Enabled)"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:45
#: b9b426711ec549e0b54b897e19238925
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:46
#: 215a892aacdc42c9b5d0269cce743620
msgid "The default RC input is configured on the UART6_RX input which is inverted from the SBUS pin. Other RC  protocols  should be applied at UART1 which has DMA, and set the :ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>` ='23' and change :ref:`SERIAL6_PROTOCOL<SERIAL6_PROTOCOL>` to something other than '23'."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:48
#: c65b9309e91d4989aa1ea9b28191f8df
msgid "CRSF/ELRS also requires a TX1 connection, in addition to RX1, and automatically provides telemetry."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:49
#: 4fa353372d224f8c8815c1bd4272f971
msgid "FPort requires connection to TX1 and :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` set to \"7\". See :ref:`common-FPort-receivers`."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:50
#: 97476a3ee5ca4db48e0986e6726711eb
msgid "SRXL2 requires a connection to TX2 and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to “4”."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:53
#: 09530ff6ff42462b9836d7f11b57a6de
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:54
#: 26c30e872a8b49beafd13226f0bae0c6
msgid "The CORVON405V2.1 supports analog OSD via its internal MAX7456. Simultaneous external HD OSD support is preconfigured on SERIAL6. See :ref:`common-msp-osd-overview-4.2` for more info."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:57
#: 89dc5538a3e845c09fbdb07383f045d4
msgid "VTX Support"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:58
#: 88a6f8185dd74fdd8b92af043791aff9
msgid "Both Analog and HD VTX connectors are provided. Pin 1 of the connector is 9v so be careful not to connect this to a peripheral unable to support that voltage."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:61
#: 0742586fb8484d88ae98fe6ac59bed3a
msgid "PWM Outputs"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:62
#: 1282ab62f2244641952dd6aec312f579
msgid "The CORVON405V2.1 supports up to 10 PWM outputs. Channels 1-8 support DShot. Channels 1-4 support bi-directional DShot."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:64
#: 893451517b2b43a7a49714e9dd97e8cc
msgid "PWM outputs are grouped and every  group must use the same output protocol: 1,2,5,6 are group1 3, 4 are group 2 7,8 are group 3 9,10 are in group 4"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:71
#: e2abb62de7cf494e85373f12b942445d
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:72
#: c134bd8fa7784c6fbcb686a0cdb8f6c8
msgid "The board has an internal voltage sensor and connections on the ESC connector for an external current sensor input. The voltage sensor can handle up to 6S LiPo batteries."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:74
#: c59ada1020eb431d9a7643fe9348070b
msgid "The default battery parameters are:"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:76
#: e76bc409c62f48bdba631f9420b99d9f
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:77
#: 9adf590f764547d49b524e4f7289e46b
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 10"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:78
#: a4231870594c402c8d92bec578b8f642
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11 (CURR pin)"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:79
#: f51d1f3a58d64e059a5b9a5b21fbbed3
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 21.2"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:80
#: c7793d87fce74a05bc6bad2e0968db06
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 40.2"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:83
#: d2a9cac809484e86b0e3beb009c62363
msgid "Compass"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:84
#: e4cd1c8a893a40ebaf95cf6b8f358211
msgid "The CORVON405V2.1 does not have a built-in compass, but you can attach an external compass using I2C on the SDA and SCL connector."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:87
#: 67050a56198f414ba749b007da7684b9
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:88
#: d3641b17c6cc494baa7ff0da27046f36
msgid "Firmware for these boards can be found `here <https://firmware.ardupilot.org>`__ in sub-folders labeled CORVON405V2.1."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:90
#: a5e679835c974c71a25e366e89b29dea
msgid "Initial firmware load can be done with DFU by plugging in USB with the bootloader button pressed. Then you should load the \"with_bl.hex\" firmware, using your favorite DFU loading tool."
msgstr ""

#: ../../source/docs/common-corvonf405v2_1.rst:92
#: ab2e98cf8e274117a510d780aefc09a0
msgid "Once the initial firmware is loaded you can update the firmware using any ArduPilot ground station software. Updates should be done with the \"\\*.apj\" firmware files."
msgstr ""
