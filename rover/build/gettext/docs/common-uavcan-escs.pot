#: a9ab7420136647deb066d613e6173766
msgid "Connecting to the Flight Controller"
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:35
#: f7e3760149d5483dbef67e656a53a4c9
msgid "One ESC (it does not matter which) should be connected to the autopilot's CAN port using a 4-pin DF13 to 4-pin DroneCAN adapter cable. Each subsequent ESC should be connected to the previous using a 4-pin DroneCAN cable.  The final ESC should have a CAN bus terminator plugged into one of its 4-pin DroneCAN ports."
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:41
#: 136703bc94ca478bbe637cb013c977f7
msgid "An FTDI Cable connection to the ESC's debug port is only required for set-up if the ESC does not present its parameters via DroneCAN. In that case, contact the manufacturer for detailed instructions."
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:43
#: da70bbf78ed54fd4a50b36f205157066
msgid "Preferably, the ESC can be configured via CAN bus using the :ref:`DroneCAN GUI Tool <common-uavcan-gui>`."
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:46
#: 4d0e1a8327444264a179b7bb00cd9416
msgid "Autopilot Setup"
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:48
#: 2a3ddcbdf300410c8a2984fd20eaea47
msgid "There are several parameters that determine which autopilot servo/motor channels are sent to the DroneCAN ESCs: For the examples below, the values are shown for DroneCAN driver #1 using CAN Port #1"
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:51
#: c3372a05488849c69dcfad3427b89d07
msgid ":ref:`CAN_P1_DRIVER<CAN_P1_DRIVER>` = 1, which assigns driver1 to port1"
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:52
#: f7f8c96d33dc4e4c979f89e1ec494818
msgid ":ref:`CAN_D1_PROTOCOL<CAN_D1_PROTOCOL>` = 1 (DroneCAN protocol)"
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:53
#: 74ec4357d161409f8d43ade010688371
msgid ":ref:`CAN_D1_UC_NODE<CAN_D1_UC_NODE>` - which is the node ID of the autopilot sending the commands to the ESCs so that there can be differentiation between multiple sources on the CAN bus. This is normally automatically set during discovery, but can be altered for advanced configurations (multiple sources on the bus)."
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:54
#: a01cec92b21f4b548f3c0306e9de1e90
msgid ":ref:`CAN_D1_UC_ESC_BM<CAN_D1_UC_ESC_BM>` - bitmask that determines which autopilot servo/motor output signals are sent to the DroneCAN ESCSs"
msgstr ""

#: ../../source/docs/common-uavcan-escs.rst:55
#: fdb9eca6b2c349e48b2cb53b487e38e3
msgid ":ref:`CAN_D1_UC_ESC_RV<CAN_D1_UC_ESC_RV>` - bitmask that designates which autopilot servo/motor outputs have reversible DroneCAN ESCs, allowing both positive and negative control values to be sent."
msgstr ""

