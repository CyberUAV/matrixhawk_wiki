#: ../../source/docs/common-leds-pixhawk.rst:162
#: 9b495fd8b4f5433e9a33120df0c39003
msgid "**Flashing red and blue**: Initializing gyroscopes. Hold the vehicle still and level while it initializes the sensors."
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:165
#: cfd3f0ff0b8c40c2a8589dfb1765361e
msgid "**Flashing blue**: Disarmed, no GPS lock found. Autopilot, loiter and return-to-launch modes require GPS lock."
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:168
#: 5875b78a22af4d5b88c606e12015b98a
msgid "**Solid blue**: Armed with no GPS lock"
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:170
#: c02d19b70acf422796ef131049ce53da
msgid "**Flashing green**: Disarmed (ready to arm), GPS lock acquired. Quick double tone when disarming from the armed state."
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:173
#: e94e6624160c422cab7fc30ca68209f2
msgid "**Fast Flashing green**: Same as above but GPS is using SBAS (so should have better position estimate)."
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:176
#: 7494b40399b44a43b2ddbaf1080ccc9d
msgid "**Solid green - with single long tone at time of arming:** Armed, GPS lock acquired. Ready to fly!"
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:179
#: 1a2479277e87412fbbd55cba503e19c6
msgid "**Double flashing yellow:** Failing pre-arm checks (system refuses to arm)."
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:182
#: d225104768ab41c69ded390f984a2721
msgid "**Single Flashing yellow:** Radio failsafe activated"
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:184
#: a4600a1c069c4fdb81f1104415712ccd
msgid "**Flashing yellow - with quick beeping tone**: Battery failsafe activated"
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:187
#: d5bbd2713e7e4349a5f4b179babbef55
msgid "**Flashing yellow and blue - with high-high-high-low tone sequence (dah-dah-dah-doh):** GPS glitch or GPS failsafe activated"
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:189
#: c3368d25e5f647b1b0a2486882df489d
msgid "**Flashing red and yellow - with rising tone:** EKF or Inertial Nav failure"
msgstr ""

#: ../../source/docs/common-leds-pixhawk.rst:192
#: 90c0b99690d34b50b6caa6a348923705
msgid "**Flashing Red, Blue and Green**: Copter ESC Calibration mode entered. See :ref:`esc-calibration`"
msgstr ""

