#: d7e9c98001704983a3cfb1c156b2d241
msgid "Supported Gimbals"
msgstr ""

#: ../../source/docs/common-camera-gimbal.rst:16
#: 86e5550e6a9c49a4a9c5f7cdbf5ba626
msgid "Any servo gimbal accepting PWM input should work.  Specific examples include"
msgstr ""

