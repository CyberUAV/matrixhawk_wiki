#: ../../source/docs/common-MicoAir743.rst:97
#: 266ed4918c654b39aabeb076845f9cf0
msgid "1, 2, 3, 4 are Group 1"
msgstr ""

#: ../../source/docs/common-MicoAir743.rst:98
#: c67b3e24ef2b4dbea6eb697589e239bd
msgid "5, 6 are Group 2"
msgstr ""

#: ../../source/docs/common-MicoAir743.rst:99
#: 4d5d5fbc47f64a47b5ee9c81bf5c27d6
msgid "7, 8, 9, 10 are Group 3"
msgstr ""

