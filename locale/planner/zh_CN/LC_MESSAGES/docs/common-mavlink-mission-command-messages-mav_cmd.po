#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1163
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1239
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1317
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1387
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1457
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1531
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1590
