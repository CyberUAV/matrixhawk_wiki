#: ../../source/docs/common-spedixf405.rst:27 ab8deed467eb40cf91173facb22cb615
msgid "Pinout"
msgstr "引脚定义"

#: ../../source/docs/common-spedixf405.rst:32 3c6f3f4ab5874cb59dec7a0e41672e77
msgid "UART Mapping"
msgstr "UART 映射"

#: ../../source/docs/common-spedixf405.rst:34 51b81162e90d4c79bdacec78abb606f3
msgid "SERIAL0 -> USB"
msgstr "SERIAL0 -> USB"

#: ../../source/docs/common-spedixf405.rst:35 3c3f45acb86c4b099f73c928f25cee84
msgid "SERIAL1 -> UART1 (MSP DisplayPort, DMA-enabled)"
msgstr "SERIAL1 -> UART1（MSP DisplayPort，已启用 DMA）"

