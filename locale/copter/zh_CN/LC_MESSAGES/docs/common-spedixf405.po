msgid "SERIAL2 -> UART2 (SBUS/Spare)"
msgstr "SERIAL2 -> UART2（SBUS/备用）"

#: ../../source/docs/common-spedixf405.rst:37 d85e6c8082bf4f09856a6fd9171fd057
msgid "SERIAL3 -> UART3 (RCin, DMA-enabled)"
msgstr "SERIAL3 -> UART3（RC 输入，已启用 DMA）"

#: ../../source/docs/common-spedixf405.rst:38 cce2e033b0f64f01b04984ea46c789fc
msgid "SERIAL4 -> UART4 (GPS)"
msgstr "SERIAL4 -> UART4（GPS）"

#: ../../source/docs/common-spedixf405.rst:39 d2c3fd6a8879450f84970fe277ac9420
