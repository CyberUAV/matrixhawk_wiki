msgid ""
"An increase in the values of :ref:`ATC_ANG_PIT_P <ATC_ANG_PIT_P>` and "
":ref:`ATC_ANG_RLL_P <ATC_ANG_RLL_P>`."
msgstr ""

#: ../../source/docs/autotune.rst:118 9dbdd045f2994753a16503fe3439d66c
msgid ""
":ref:`ATC_RAT_PIT_D <ATC_RAT_PIT_D__AC_AttitudeControl_Multi>` and "
":ref:`ATC_RAT_RLL_D <ATC_RAT_RLL_D__AC_AttitudeControl_Multi>` are larger"
" than :ref:`AUTOTUNE_MIN_D <AUTOTUNE_MIN_D>`."
msgstr ""

#: ../../source/docs/autotune.rst:120 27a63370a7194eefaa7dabe9de9481ed
msgid ""
"AutoTune will attempt to tune each axis as tight as the aircraft can "
"tolerate. In some aircraft, this can be unnecessarily responsive. A guide"
" for most aircraft:"
msgstr ""

#: ../../source/docs/autotune.rst:122 88d31486df964a06af7858a4e2ad96da
msgid ":ref:`ATC_ANG_PIT_P <ATC_ANG_PIT_P>` should be reduced from 10 to 6"
msgstr ""

