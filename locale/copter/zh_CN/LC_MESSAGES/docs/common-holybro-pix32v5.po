msgstr "4 个 SPI 总线"

#: ../../source/docs/common-holybro-pix32v5.rst:53
#: 4f840c96c0fb442a8a5227ab0025015a
msgid "1 internal high speed SPI sensor bus with 4 chip selects and 6 DRDYs"
msgstr "1 个内部高速 SPI 传感器总线，4 个片选和 6 个 DRDY"

#: ../../source/docs/common-holybro-pix32v5.rst:54
#: 075dc18941c54e1bba774909f5220e28
msgid ""
"1 internal low noise SPI bus dedicated for Barometer with 2 chip selects, no"
" DRDYs"
msgstr "1 个内部低噪声 SPI 总线专用于气压计，2 个片选，无 DRDY"

#: ../../source/docs/common-holybro-pix32v5.rst:55
#: 9e717175eceb48a69a263ea64ba1ada4
