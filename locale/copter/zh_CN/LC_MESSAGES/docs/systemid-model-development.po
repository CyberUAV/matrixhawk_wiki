#: ../../source/docs/systemid-model-development.rst:63
#: 9575cf1a230c4bf5a8c43edae4af7514
msgid "Force torque allocation matrix"
msgstr "力矩分配矩阵"

#: ../../source/docs/systemid-model-development.rst:65
#: a9f0bb9ae38c4f5e81ff98b16b3ffc9f
msgid ""
"where :math:`d` represents the arm length between the respective propeller "
