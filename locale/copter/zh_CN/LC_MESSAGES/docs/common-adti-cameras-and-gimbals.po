msgstr ":ref:`CAM1_SERVO_ON <CAM1_SERVO_ON>` = 1850"

#: ../../source/docs/common-adti-cameras-and-gimbals.rst:34
#: bcc522f9abcc42689fd852dab93ae05b
msgid ":ref:`SERVO13_FUNCTION <SERVO13_FUNCTION>` = 10 (CameraTrigger)"
msgstr ":ref:`SERVO13_FUNCTION <SERVO13_FUNCTION>` = 10（相机触发）"

#: ../../source/docs/common-adti-cameras-and-gimbals.rst:36
#: 9a35e631f62e4840a5e40a1de5fd8983
msgid ""
"To control the camera shutter using a :ref:`Relay <common-relay>` set the "
"following parameters.  These parameters assume the autopilot's AUXOUT 5 is "
"connected to the camera's shutter trigger"
msgstr ""
"使用 :ref:`继电器 <common-relay>` 控制相机快门，请设置以下参数。假设飞控的 AUXOUT 5 连接至相机快门触发器："

#: ../../source/docs/common-adti-cameras-and-gimbals.rst:38
#: 9b382f574a5b4eee9213ada13399fe6d
msgid ":ref:`CAM1_TYPE <CAM1_TYPE>` = 2 (Relay)"
msgstr ":ref:`CAM1_TYPE <CAM1_TYPE>` = 2（继电器）"

#: ../../source/docs/common-adti-cameras-and-gimbals.rst:40
#: e3c914a398b446d19842f8989983fb8b
msgid ":ref:`CAM1_RELAY_ON <CAM1_RELAY_ON>` = 0 (Low)"
msgstr ":ref:`CAM1_RELAY_ON <CAM1_RELAY_ON>` = 0（低电平）"

#: ../../source/docs/common-adti-cameras-and-gimbals.rst:41
#: fa8f8ea43f0e4011a965a2ecdb312758
msgid ":ref:`RELAY1_PIN <RELAY1_PIN>` = 54 (AUXOUT5)"
msgstr ":ref:`RELAY1_PIN <RELAY1_PIN>` = 54（AUXOUT5）"

#: ../../source/docs/common-adti-cameras-and-gimbals.rst:42
#: 5c024e87d55d4b4aa729ae3f79d59f91
