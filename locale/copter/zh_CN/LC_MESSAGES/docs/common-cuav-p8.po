#: ../../source/docs/common-cuav-p8.rst:5 2ae07faa4dae4215a0667593cbbb20ad
msgid "CUAV P8 Radio"
msgstr "CUAV P8 电台"

#: ../../source/docs/common-cuav-p8.rst:9 185e7179709c4218bcda00d969025e31
msgid ""
"P8 Radio is a remote data transmission module for drones; it has a remote "
"data transmission capability of 60KM+;"
msgstr "P8 电台是一款无人机远程数传模块；具有 60KM+ 的远程数传能力；"

#: ../../source/docs/common-cuav-p8.rst:11 462520e33d4940c68d76a790600b2ac7
msgid ""
"Its transmission rate is as high as 375Kbps, and it supports multiple "
"working modes such as point-to-point, point-to-multipoint, and relay "
"communication; for various application scenarios."
msgstr "其传输速率高达 375Kbps，支持点对点、点对多点和中继通信等多种工作模式；适用于各种应用场景。"

#: ../../source/docs/common-cuav-p8.rst:15 dff6f568591a421ca33528531ce90097
msgid "Key Features"
msgstr "主要特性"

#: ../../source/docs/common-cuav-p8.rst:17 068166b21e384a19a3ab896e8956d98f
msgid "Long range >60km（depending on the antenna and use environment)."
msgstr "远距离 >60km（取决于天线和使用环境）。"

#: ../../source/docs/common-cuav-p8.rst:18 4f4ff4fe80734e3ebe7b671bdb0d3504
msgid "Supports point-to-point, point-to-multipoint, and repeater modes."
msgstr "支持点对点、点对多点和中继模式。"

#: ../../source/docs/common-cuav-p8.rst:19 8db57b8f092c4d4cbfc31896e63301a1
msgid "1 Watt (+30dBm) transmit power."
msgstr "1 瓦（+30dBm）发射功率。"

#: ../../source/docs/common-cuav-p8.rst:20 6abc2ed09e9f4dbb9227c6a4e5304e4d
msgid "Up to 345Kbps transfer rate."
msgstr "最高 345Kbps 传输速率。"

#: ../../source/docs/common-cuav-p8.rst:21 0eb2d3e45e3e4ca796d755e0ee8f558f
msgid "Supports 12v~60V operating voltage."
msgstr "支持 12V~60V 工作电压。"

#: ../../source/docs/common-cuav-p8.rst:22 5dd4f62bb2164301af35b535ca588035
msgid "Unit can operate either as ground station modem or aircraft modem."
msgstr "设备可作为地面站调制解调器或飞机调制解调器运行。"

#: ../../source/docs/common-cuav-p8.rst:23 bdc036fc1974427581a974ca5029589d
msgid "Independent power supply for more stable operation."
msgstr "独立供电，运行更稳定。"

#: ../../source/docs/common-cuav-p8.rst:27 109e76ea910a4a099b6a35d6cdd2ac4e
