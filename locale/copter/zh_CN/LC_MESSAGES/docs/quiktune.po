msgid ""
":ref:`ATC_RAT_RLL_P<ATC_RAT_RLL_P__AC_AttitudeControl_Multi>` and "
":ref:`ATC_RAT_RLL_I<ATC_RAT_RLL_I__AC_AttitudeControl_Multi>`"
msgstr ""

#: ../../source/docs/quiktune.rst:21 ffc330e1ffe548f7b541a38ed8ef8cee
msgid ":ref:`ATC_RAT_PIT_D<ATC_RAT_PIT_D__AC_AttitudeControl_Multi>`"
msgstr ""

#: ../../source/docs/quiktune.rst:22 e5c003e66ab24d908bc939a089e69a57
msgid ""
":ref:`ATC_RAT_PIT_P<ATC_RAT_PIT_P__AC_AttitudeControl_Multi>` and "
