msgid "2000"
msgstr "2000"

#: ../../source/docs/traditional-helicopter-archived-tuning.rst:163
#: d9c9bd27400b482dbec707598ff51c0e
msgid "RATE_YAW_P"
msgstr "RATE_YAW_P"

#: ../../source/docs/traditional-helicopter-archived-tuning.rst:163
#: 5d1f6ac783b044bb9b4441d0af54fef9
