msgstr ":ref:`AFS_ENABLE<AFS_ENABLE>`：1"

#: ../../source/docs/advanced-failsafe-configuration.rst:322
#: 39fc9ea8f56c4c19a0c00aef51e40e83
msgid ""
":ref:`AFS_WP_COMMS<AFS_WP_COMMS>`: waypoint number for OBC comms hold "
"followed by two minute loiter, then return to airfield home"
msgstr ":ref:`AFS_WP_COMMS<AFS_WP_COMMS>`：OBC 通信中断时保持盘旋两分钟，然后返回机场 Home 点的航点编号"

#: ../../source/docs/advanced-failsafe-configuration.rst:324
#: 9bf91c491031460e9096e48852bd999b
msgid ""
":ref:`AFS_WP_GPS_LOSS<AFS_WP_GPS_LOSS>`: waypoint number to loiter in "
"place for 30 seconds, followed by return to airfield home"
msgstr ":ref:`AFS_WP_GPS_LOSS<AFS_WP_GPS_LOSS>`：原地盘旋 30 秒后返回机场 Home 点的航点编号"

#: ../../source/docs/advanced-failsafe-configuration.rst:326
#: afe59acdc25e4432b14b2698e9ce1dd2
msgid ":ref:`AFS_TERM_ACTION<AFS_TERM_ACTION>`: 42"
msgstr ":ref:`AFS_TERM_ACTION<AFS_TERM_ACTION>`：42"

#: ../../source/docs/advanced-failsafe-configuration.rst:327
#: b1fca03dcf0844b78638a532b10c4a34
msgid ":ref:`AFS_AMSL_LIMIT<AFS_AMSL_LIMIT>`: 914"
msgstr ":ref:`AFS_AMSL_LIMIT<AFS_AMSL_LIMIT>`：914"

#: ../../source/docs/advanced-failsafe-configuration.rst:328
