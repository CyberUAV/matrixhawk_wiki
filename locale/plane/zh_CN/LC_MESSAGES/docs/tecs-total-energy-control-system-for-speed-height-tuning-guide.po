msgid ""
":ref:`TECS_SPD_OMEGA <tecs-total-energy-control-system-for-speed-height-"
"tuning-guide_tecs_spd_omega>` (definition above)"
msgstr ""
":ref:`TECS_SPD_OMEGA <tecs-total-energy-control-system-for-speed-height-"
