msgstr "ZT6 (IR): rtsp://192.168.144.25:8554/video1"

#: ../../source/docs/common-siyi-zr10-gimbal.rst:118
#: 09a1371bbb8e48178163ce9ca048d2ad
msgid "ZT6 (rgb): rtsp://192.168.144.25:8554/video2"
msgstr "ZT6 (rgb): rtsp://192.168.144.25:8554/video2"

#: ../../source/docs/common-siyi-zr10-gimbal.rst:120
#: 52343fa7dde3446ab35c91e1d35985a1
msgid ""
"If connected to a PC, `VLC <https://www.videolan.org/>`__ can be used to "
"test the feed"
msgstr "若连接至 PC，可使用 `VLC <https://www.videolan.org/>`__ 测试视频流"

#: ../../source/docs/common-siyi-zr10-gimbal.rst:122
#: 3a7e732ac2684a5ebbe158b2faf41cac
