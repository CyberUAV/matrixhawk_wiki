msgid "MAVProxy is released under the GNU General Public License v3 or later."
msgstr "MAVProxy以GNU通用公共许可证v3或更高版本发布。"

#: ../../source/index.rst:62 5b3a2c4619dc45e09132501fed293d75
msgid "Core Team"
msgstr "核心团队"

#: ../../source/index.rst:64 e13f98dab142460b9ea6e51b315e0b2b
msgid ""
"MAVProxy is maintained by `Andrew Tridgell <https://github.com/tridge>`_, "
"`Peter Barker <https://github.com/peterbarker>`_ and `Stephen Dade "
"<https://github.com/stephendade>`_"
msgstr ""
"MAVProxy由 `Andrew Tridgell <https://github.com/tridge>`_、`Peter Barker "
"<https://github.com/peterbarker>`_ 和 `Stephen Dade "
"<https://github.com/stephendade>`_ 维护。"

