msgstr "SPI"

#: ../../source/docs/modules/devop.rst:36 6a855824737a41f983f294fe25aca139
msgid "To write to the SPI bus"
msgstr "写入 SPI 总线"

#: ../../source/docs/modules/devop.rst:42 c136c4a16f1547c0b35c7a1205c64b8e
