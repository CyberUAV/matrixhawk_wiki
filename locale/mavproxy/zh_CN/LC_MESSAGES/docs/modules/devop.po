#: ../../source/docs/modules/devop.rst:3 09ab7923b06d41dd91a85ea2efe2ad07
msgid "Direct Comms with SPI/I2C bus"
msgstr "与 SPI/I2C 总线的直接通信"

#: ../../source/docs/modules/devop.rst:9 001866420a51434fa28028b0d321c1c4
msgid ""
"This module allows for development operations. Specifically the ability to "
"read and write directly to the SPI and I2C buses."
msgstr "该模块用于开发操作，具体提供直接读写 SPI 和 I2C 总线的能力。"

#: ../../source/docs/modules/devop.rst:13 496a2cfd641146d387155e81bdb46081
msgid "I2C"
msgstr "I2C"

#: ../../source/docs/modules/devop.rst:15 b7a2c49fc2c849b2b615d32d7dd38314
msgid "To write to the I2C bus"
msgstr "写入 I2C 总线"

#: ../../source/docs/modules/devop.rst:21 eed2ede8375b421786c91821ece04c1d
msgid ""
"Where name= device name, bus=i2c bus #, address=device address, "
"regstart=register to start at, count=number of bytes to write, <bytes>=the "
"bytes to send."
msgstr ""
"其中 name=设备名，bus=I2C "
"总线编号，address=设备地址，regstart=起始寄存器，count=写入字节数，<bytes>=要发送的字节数据。"

#: ../../source/docs/modules/devop.rst:24 a540447cf6c64ed2bb759d33ca82ce0c
msgid "To read from the I2C bus"
msgstr "从 I2C 总线读取"

#: ../../source/docs/modules/devop.rst:30 1c417fef6a24453ca3a896fbb0c63b27
msgid ""
"Where name= device name, bus=i2c bus #, address=device address, "
"regstart=register to start at, count=number of bytes to write."
msgstr "其中 name=设备名，bus=I2C 总线编号，address=设备地址，regstart=起始寄存器，count=写入字节数。"

