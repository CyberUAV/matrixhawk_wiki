#: ../../source/docs/modules/park.rst:5 75cb6642a3484d8dadafd0b65f71a69e
msgid "Park Warning"
msgstr "停泊警告"

#: ../../source/docs/modules/park.rst:7 2fd9b46298b948c7909bd50c3dc58452
msgid ""
"Provides a GCS warning if a vehicle (usually loitering) moves outside a "
"preset distance in any 3D direction from when set."
msgstr "当飞行器（通常处于盘旋状态）在任意三维方向上偏离设定位置超过预设距离时，向地面站发出警告。"

#: ../../source/docs/modules/park.rst:15 2f93ca570dc6475c84f9b9fb699a3416
msgid "Usage"
msgstr "使用方法"

#: ../../source/docs/modules/park.rst:17 515606fa25c443cdb94d1baa8048eed5
msgid "park <status|on|off|radius>"
msgstr "park <status|on|off|radius>"

#: ../../source/docs/modules/park.rst:19 b9f0211dbe0b4bbf992a3f184880d388
msgid "on: enable , set current position"
msgstr "on：启用，设置当前位置"

#: ../../source/docs/modules/park.rst:20 f0a5ed6bd4944845a219923ac5f2a51f
msgid "off: disable (default)"
msgstr "off：禁用（默认）"

#: ../../source/docs/modules/park.rst:21 cb27360e615146c5a290bbf69b6c6ddf
msgid ""
"radius: 3D distance in meters from set position to send warning to GCS "
"(default = 2m)"
msgstr "radius：从设定位置到发送地面站警告的三维距离（单位：米，默认 2 米）"

#: ../../source/docs/modules/park.rst:22 861254cdff0349e8bda7ce2bd4262f50
msgid "status: status of park module"
msgstr "status：park 模块状态"
