msgid "FTP"
msgstr "FTP"

#: ../../source/docs/modules/ftp.rst:11 62a28b6034a041e3928051da4ac8c8b7
msgid "this module is loaded by default"
msgstr "该模块默认加载"

#: ../../source/docs/modules/ftp.rst:13 aca083c9280a40bcaf68946314d9c313
msgid "This allows the rapid transfer of files to/from the SD card"
msgstr "允许快速向 SD 卡传输文件或从 SD 卡传输文件"

#: ../../source/docs/modules/ftp.rst:15 5a35eb7a92c746988ac2f7c7a88ecbcd
msgid "Usage: ftp <list|get|put|rm|rmdir|rename|mkdir|crc>"
msgstr "用法：ftp <list|get|put|rm|rmdir|rename|mkdir|crc>"

#: ../../source/docs/modules/ftp.rst:17 ba2a08b47e4d45b09db6ec268d3e7eff
msgid "list: list directory contents"
msgstr "list：列出目录内容"

#: ../../source/docs/modules/ftp.rst:18 ba6e5c1712194af19bf5d766950b4b5e
msgid "get: download a file"
msgstr "get：下载文件"

#: ../../source/docs/modules/ftp.rst:19 e6642968332c49b39e611129b613eb26
msgid "put: write a file"
msgstr "put：上传文件"

#: ../../source/docs/modules/ftp.rst:20 4bf001d98dfe44549df53a1b183ca8b2
msgid "rm: remove a file"
msgstr "rm：删除文件"

#: ../../source/docs/modules/ftp.rst:21 fcf4431345404536b4198224e75671ea
msgid "rmdir: remove an empty directory"
msgstr "rmdir：删除空目录"

#: ../../source/docs/modules/ftp.rst:22 d2ca0bd4da73426dacaee797a45b906d
msgid "rename: rename a file"
msgstr "rename：重命名文件"

#: ../../source/docs/modules/ftp.rst:23 96d3f2f6fb814d91b031e042d90e7fb3
msgid "mkdir: create a directory"
msgstr "mkdir：创建目录"

#: ../../source/docs/modules/ftp.rst:24 1ebd86ee8748417dbbf6c0a9ad0e3f40
msgid "crc: check a files CRC validity"
msgstr "crc：校验文件 CRC 有效性"
