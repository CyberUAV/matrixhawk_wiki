#: ../../source/docs/modules/GPSInput.rst:3 dd6dbe9371504f988c809b43b205fdb4
msgid "GPS Input"
msgstr "GPS 输入"

#: ../../source/docs/modules/GPSInput.rst:9 bcea1d8f0af34c989795c2f783db4e59
msgid ""
"The GPSInput module allows for GPS_INPUT message support. It will listen on "
"a local udp port for json messages and pass them on to the connected flight "
"controller."
msgstr "GPSInput 模块支持 GPS_INPUT 消息。它将在本地 UDP 端口上监听 JSON 格式消息，并将其传递给已连接的飞控。"

#: ../../source/docs/modules/GPSInput.rst:11 ad0e20ea31dc49b5b0a6871b39fa7fb2
msgid "It requires the ``GPS1_TYPE`` parameter to be set to 14 (MAVLink)."
msgstr "需要将 ``GPS1_TYPE`` 参数设置为 14（MAVLink）。"

#: ../../source/docs/modules/GPSInput.rst:14 7d1b3e8a4fcf48e2a4624d9c0f92a49a
msgid "GPSInput.port"
msgstr "GPSInput.port"

#: ../../source/docs/modules/GPSInput.rst:16 c9358beaedc24bf68e0322c8ca4ebcf1
msgid "Changes the UDP port that is being listened on:"
msgstr "更改监听的 UDP 端口："

