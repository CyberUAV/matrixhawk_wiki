#: ../../source/docs/modules/ppp.rst:3 5baba68ee32e4d58abc7b9932c0db557
msgid "PPP Link"
msgstr "PPP 链路"

#: ../../source/docs/modules/ppp.rst:9 4df15bb8d3dd4c90814b94aac6571fc8
msgid ""
"The pp module provides a generic data transfer channel within the Mavlink "
"stream, which can be used by the pppd program."
msgstr "pp 模块在 MAVLink 数据流中提供通用数据传输通道，可供 pppd 程序使用。"

#: ../../source/docs/modules/ppp.rst:13 80e4ab9221034e2389dff450ae62b2e7
msgid "Starting and Stopping"
msgstr "启动与停止"

#: ../../source/docs/modules/ppp.rst:19 076b5fb2cc1e42b1baa9edc3099a8c5d
msgid "Starts the ppp link and a ppp daemon (pppd)."
msgstr "启动 ppp 链路和 ppp 守护进程（pppd）。"

#: ../../source/docs/modules/ppp.rst:25 9ac6a5626147490d9f3eb52f71582697
msgid "Stops the ppp link and daemon."
msgstr "停止 ppp 链路和守护进程。"

#: ../../source/docs/modules/ppp.rst:31 46bc387676024a9483b352004f9cfcac
msgid "Prints the current status of the ppp link to the console."
msgstr "将 ppp 链路的当前状态打印到控制台。"
