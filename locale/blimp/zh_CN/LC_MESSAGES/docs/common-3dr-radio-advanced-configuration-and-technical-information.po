msgstr "LBT_RSSI 设置"

#: ../../source/docs/common-3dr-radio-advanced-configuration-and-technical-information.rst:435
#: 8a3a5b0cd40a453da9ee3bebc04937a8
msgid "the MAX_WINDOW setting"
msgstr "MAX_WINDOW 设置"

