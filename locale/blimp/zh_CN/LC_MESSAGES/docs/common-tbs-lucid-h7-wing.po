#: 9c31d81305d340869a65d6bc9fd84453
msgid "SERIAL1 -> UART1 (RX1 is SBUS in HD VTX connector)"
msgstr "SERIAL1 -> UART1（RX1 为高清 VTX 连接器上的 SBUS 输入）"

