#: fb69892e9ed342bd91f0e4f8972d46b5
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"

#: ../../source/docs/common-CUAV-7-Nano.rst:103
#: 0369c4c59d3e4494b2447cb1097b5349
msgid "Then reboot."
msgstr "然后重启。"

#: ../../source/docs/common-CUAV-7-Nano.rst:105
#: 2e320b75196143b3bf1d1c136f5558c1
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` 9"
msgstr ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` 9"

#: ../../source/docs/common-CUAV-7-Nano.rst:106
#: 69635d2cb481410f98f51cc72dc1616d
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 8"
msgstr ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 8"

#: ../../source/docs/common-CUAV-7-Nano.rst:107
#: 3ecfb08a268d44a39deb68633a23dbab
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 31.0"
msgstr ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 31.0"

#: ../../source/docs/common-CUAV-7-Nano.rst:108
#: 4ea47f7d7e1a4330ad9ea425656f9c2a
