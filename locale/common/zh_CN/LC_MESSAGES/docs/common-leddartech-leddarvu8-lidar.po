#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:29
#: 06a3c89dde81475eb4c5b11223d53969 5840b0bcd351486b85c8086237cf1713
#: d8cf27b7f88349dfbf41ca6a4f1a1c99 e13c007680294f098dcc51c6564ddcb3
#: e3c8da18fc3d4f9eb4d13e0d12aa5937
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 29 (LeddarVu8-Serial)"
msgstr ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 29（LeddarVu8-Serial）"

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:30
#: 0527a5ddb14b4c2fbfee55710460e25b 4d0723d2c7c544558bd21072faeff407
#: cba7a902d7614496aea9b7ae57bb82c4 e0e393b11fea4cf2a7be7487d45b0f75
#: e4dc1ab5f8ad441980aa65eb253c70e7
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.15"
msgstr ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.15"

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:31
#: 32c11f7dce294a6890c17df421619364 511b32a3a2ea40af8a769c2cfe78e709
#: 57f070c111ad424c82946cd05127617c 8333c0cae60644d5892b51917d087c7c
#: f7f436b638c644dca91f1877f4f765dc
msgid ""
":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 160.  *This is the distance in meters "
"that the rangefinder can reliably read.*"
msgstr ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 160。*这是测距仪可以可靠读取的距离（米）。*"

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:32
#: 13750857878d4447bb348150f2e22941 6526cd20a0624eda8a3cc7d8bacabd15
#: 7fb7bec30d3b4ccebebcad9796231d7e ad619fa5c7fe4cc29bc3559f9d35181b
#: f0b4164037984ace8926b2c8ec5601f7
msgid ""
":ref:`RNGFND1_GNDCLR <RNGFND1_GNDCLR>` = 0.1 *or more accurately the "
"distance in metres from the range finder to the ground when the vehicle is "
"landed.  This value depends on how you have mounted the rangefinder.*"
msgstr ""
":ref:`RNGFND1_GNDCLR <RNGFND1_GNDCLR>` = 0.1 "
"*或更精确地，飞行器降落时测距仪到地面的距离（米）。该值取决于测距仪的安装方式。*"

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:34
#: 0b209ffc42504122bfdf1c9f46801a02 24de78c3bb1c4c719f1c7b713ca900bb
#: 551c6ce8584e4f20bb6bcc7b2e1aa290 a4c7bb10650442a5adfefdfdd868fc97
#: abb29eb66f1e4dbba71e9a9331cd6563
msgid ""
"If you instead were using the Serial4 port on the autopilot then you would "
"set :ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 9, and :ref:`SERIAL4_BAUD "
"<SERIAL4_BAUD>` to 115"
msgstr ""
"如果改用飞控的 Serial4 端口，则应设置 :ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = 9，以及 "
":ref:`SERIAL4_BAUD <SERIAL4_BAUD>` 为 115"

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:37
#: 3af79f5d07cd4c48a4c084cde5772fda 601735be44324b2e85e8fdfc1e403403
#: 7f0b993e5fa544358952f9a3ca8a774a b69ebf16a7cb4135881f16b459511d02
#: f288a4c2453d42f3a7f08dbfc51e3393
msgid "Testing the sensor"
msgstr "测试传感器"

#: ../../source/docs/common-leddartech-leddarvu8-lidar.rst:39
#: 06edecd0b613482893fceeb31071e861 7bc2359bf7654da3a43f6e7d04ec3ae9
#: 97f077135d6447338d687ba4dbca94ce b533bee8eaf241a1abe67dc3ff5c4d27
#: c4f01e6069894edebd7dff109429e539
msgid ""
"Distances read by the sensor can be seen in the Mission Planner's Flight "
"Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr "传感器读取的距离可在 Mission Planner 飞行数据界面的状态标签页中查看。请注意查找 「rangefinder1」。"
