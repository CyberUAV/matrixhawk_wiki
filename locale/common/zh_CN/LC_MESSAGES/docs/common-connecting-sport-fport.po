msgstr "Fport：``SERIALx_PROTOCOL`` = 23，``SERIALx_OPTIONS`` = 4（半双工）"

#: ../../source/docs/common-connecting-sport-fport.rst:40
#: 6fd1e31d7b234061aaec9a43d90d0f02 782339fffee34ae0b0fa5b4ea8e2a9b3
#: a7a89eae46894631aec6091b299be03a b7082f7d712b4acaa41e2cca7da7cf71
#: b92158f51e6a4f1a8383cba3e1ecce9f bb53d60db8ea4fa0b0ecfaf385c70007
