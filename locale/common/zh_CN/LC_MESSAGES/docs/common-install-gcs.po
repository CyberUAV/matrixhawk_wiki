msgid "Installing Ground Station (GCS) software"
msgstr "安装地面站（GCS）软件"

#: ../../source/docs/common-install-gcs.rst:7 23d0bcd639ac4ca482f9baf3e7eb13a2
#: 3fc3ef65f94d4f8da4e874531fa46de0 5f4f2c60ac95427ba6ade52c54014304
