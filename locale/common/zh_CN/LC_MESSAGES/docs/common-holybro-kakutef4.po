#: 8ff8ca6b17714bb4bf5b6803995ca578
msgid "SERIAL1 -> UART6 (Telem1)"
msgstr "SERIAL1 -> UART6（Telem1）"

#: ../../source/docs/common-holybro-kakutef4.rst:59
