#: 63e1a2ee246d4896bced93abbff59744 a31d1de9832c4146936c95c0a2cafb5a
#: c33cedb45d704ec7bb41b22e1f46ed8e e89733a22f34478cb4e81b8251f340bb
msgid ""
"DSM/SRXL connects to the RX2  pin, but SBUS would still be connected to "
"SBUS."
msgstr "DSM/SRXL 连接至 RX2 引脚，SBUS 仍连接至 SBUS 引脚。"

#: ../../source/docs/common-atomrcf405-navi.rst:105
#: 1514868691c246cbb97e25c42347ce89 1dda189458a043d98968944d68ccc748
