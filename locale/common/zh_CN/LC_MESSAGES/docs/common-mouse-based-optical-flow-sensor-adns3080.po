#: ../../source/docs/common-mouse-based-optical-flow-sensor-adns3080.rst:96
#: 517ff5350eb145d4b4ca7b723b9886e3 d547b8a4ad5042bba890b888b77583ea
#: e5a53ddf27284f438a64159d69091ffe ecad5fa41a90417dbda6079cb80f7a36
