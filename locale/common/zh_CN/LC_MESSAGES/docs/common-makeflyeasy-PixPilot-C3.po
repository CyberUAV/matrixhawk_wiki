msgid ""
"CRSF would require :ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` be set to \"0\"."
msgstr "CRSF 需将 :ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` 设置为 「0」。"

#: ../../source/docs/common-makeflyeasy-PixPilot-C3.rst:377
#: 1a42556fbbbb412fa6401cca07df9930 842502eaeee2439e922184dcf88190b7
#: 8968ebbe86aa4092b8fd76eee3b9beaf a4a56a8649fb44d0a1ebaeb756b58e50
