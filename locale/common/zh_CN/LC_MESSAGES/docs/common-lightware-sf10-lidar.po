#: ../../source/docs/common-lightware-sf10-lidar.rst:125
#: 2538e97744c848169796a7fa9b0102e3 83653e2094234f95a64fbc0e7523a154
#: 8b3bcbbc4f5344faa6d44aabea1fe122 df90799e7e714bf3b473df822282d66d
#: f3c27a4578ed49b1b7ef16e5862b7811
msgid ""
":ref:`RNGFND1_SCALING <RNGFND1_SCALING>` = **9.76** (for SF10A), **19.531** "
"(for SF10B), **39.06** (for SF10C), **46.87** (for SF11C)"
msgstr ""
