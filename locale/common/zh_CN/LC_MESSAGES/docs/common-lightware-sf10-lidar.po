#: f3509be955314e97bc156d5b583acda5
msgid "Pixhawk and SF10 Rangefinder: I2CConnection"
msgstr "Pixhawk 与 SF10 测距仪：I2C 连接"

#: ../../source/docs/common-lightware-sf10-lidar.rst:81
#: 14d810bacb0e4052acffe9cc3d0ea313 75e01a64b7c3475dadab7ad51f42de5b
#: 8cec5efa6db54ac8841726353c5230fc c72b63553ef642a69e5364cbee6b9157
#: edb610eeeca147fa840ad98669ef71ff
msgid ""
"You then need to configure the rangefinder parameters as shown below (this "
"is done in the *Mission Planner* **Config/Tuning \\| Full Parameter List** "
"page):"
msgstr "然后需要按如下所示配置测距仪参数（在 *Mission Planner* **配置/调参 \\| 完整参数列表** 页面进行）："

#: ../../source/docs/common-lightware-sf10-lidar.rst:85
#: 1712f6bd62c14e79ac7984d5fa3432b6 60c099d694c94562b82086ac7575d3c6
#: 67efdb6746284d9b82d4e4b74bbcf6d2 bbfc00f5e5ba4f9b852f705764aa778e
#: ede912ad5f994f4da2c1eb09d5fc332f
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 7 (LightWareI2C)"
msgstr ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 7（LightWareI2C）"

#: ../../source/docs/common-lightware-sf10-lidar.rst:86
#: 2dcea101716e44cea8fd6105dbaaebb2 306d3f68e4b047a2b4e403e6d4352df9
#: 6cbcb8f948a245738d197e10df9d2352 932270ad63b94a9b864fcdb0afbeeff7
#: d448da47d306427993525a2c4d9e4199
msgid ""
":ref:`RNGFND1_ADDR <RNGFND1_ADDR>` = 102 (I2C Address of lidar in decimal)."
"  *Please note that this setting is in decimal and not hexadecimal as shown "
"in the lidar settings screen. The default address is 0x66 which is 102 in "
"decimal.*"
msgstr ""
":ref:`RNGFND1_ADDR <RNGFND1_ADDR>` = 102（十进制的激光雷达 I2C "
"地址）。*请注意该设置为十进制，而非激光雷达设置界面中显示的十六进制。默认地址为 0x66，即十进制 102。*"

#: ../../source/docs/common-lightware-sf10-lidar.rst:92
#: 029cb2922c8848a1afeb720337f9a8bd b267f3eb5c84457199fd6436e019796d
