#: ../../source/docs/common-limited-firmware.rst:29
#: 15fb339e7f564a379ddc7ae8c99ff01f 2a1336f9067e49f89257839bc0f2597d
#: 31281c98318845bd9612453f98443d7a 3626d7d9767348d9bc310562627ea33b
