#: ../../source/docs/common-uavcan-setup-advanced.rst:17
#: 7ea1528501b74ecb989e8c5298dfe530 ac5804d15b164baf8bf24856ec9bc34d
#: e380f64fd7fe4579ae34afb86148290f ed3f4530700a4f2eb8c78c3017f33c82
