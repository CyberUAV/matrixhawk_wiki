#: ../../source/docs/common-configuring-a-telemetry-radio-using-mission-planner.rst:22
#: 4ff14f5fe8c041ed8148724a097bf2d5 792aed1b119c4912a1544740217852a4
#: 7a19e39022dc4158a280b8daa7f8726d ab25558901614191bc3ee33cb646f134
#: cf35e4ead0f6465db8739d1931596e7b f9d37a0c9d4346839fe9fe09ce4c328a
msgid "To make changes:"
msgstr "进行更改："

#: ../../source/docs/common-configuring-a-telemetry-radio-using-mission-planner.rst:24
#: 62523e85de91479bb66dc327f3a1d31c 62cb97406dc546a68bd7e1c4e908d2c1
#: aabdc228855a41e98eeb939308aaf694 b50598ee67294089978f076f1c54a9b6
#: e901b691f6864ad2b73c67d28a879060 f4024f5ba46442ea99d54d02f37f7c01
