#: 8c5dfbfc2a644e9390b0ecc297f7c47a
msgid ""
"LUA scripts have the ability to access and change ArduPilot parameters setup"
" by the firmware."
msgstr "LUA脚本能够访问和更改固件设置的ArduPilot参数。"

#: ../../source/docs/common-scripting-parameters.rst:9
#: 61c24d95edca43ebaae5dd805f4f3768
msgid "for example: ::"
msgstr "例如：::"

#: ../../source/docs/common-scripting-parameters.rst:13
#: 2ae848d02e5448edabe80f0cfd0db267
msgid ""
"will retrieve the SCR_ENABLE parameter and assign it to the variable "
"\"parameter\""
msgstr "将获取SCR_ENABLE参数并将其赋值给变量「parameter」"

#: ../../source/docs/common-scripting-parameters.rst:15
