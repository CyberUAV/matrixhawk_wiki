#: ../../source/docs/common-rangefinder-maxbotix-analog.rst:41
#: 6df0568586834978b455672eaa9ac482 6f44bacd040d4dcfb6532be1fd068995
#: 97258814d5ac45c39fa83291803965b5 9c9343394ecf490e8a19d4d972df0a7b
