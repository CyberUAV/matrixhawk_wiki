#: ../../source/docs/common-xfrobot-gimbal.rst:59
#: 977e702802e244bdb3157c5478309281 cb77880937814593a59d9106ea022a37
#: de1af93c4b9944a2bb9a1b1b9eafb0b2 eb35b76d39964e52b9727fc600452cb5
msgid ""
":ref:`MNT1_RC_RATE <MNT1_RC_RATE>` to 60 (deg/s) to control speed of gimbal "
"when using RC targeting"
msgstr ":ref:`MNT1_RC_RATE <MNT1_RC_RATE>` 设为 60（度/秒），用于控制使用 RC 瞄准时云台的转动速度"

#: ../../source/docs/common-xfrobot-gimbal.rst:62
#: 5961480516a441da80af575f8ccaaec5 5a3bf819893042d4b0dd6963fe4c45cd
#: 6d161a9186634301ac1a0e67bee99588 fca586b3202d49278db5a519ef590edd
msgid ""
":ref:`RC8_OPTION <RC8_OPTION>` = 163 (\"Mount Yaw Lock\") to switch between "
"normal yaw operation and locking mount heading with RC channel 8 (in RC "
"Targeting mode only)."
msgstr ""
":ref:`RC8_OPTION <RC8_OPTION>` = 163（\"Mount Yaw Lock\"），用于通过 RC 通道 8 "
"在正常偏航操作与锁定云台航向之间切换（仅在 RC 瞄准模式下）。"
