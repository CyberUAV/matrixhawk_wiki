#: ../../source/docs/common-camera-trigger-seagull-map2.rst:72
#: 3ed004b2e9fb4bbf8409479c828206a7 4ac9823703484d6eb05925603f01504b
#: 789fc29914e441278ee794bda35a932b e7e6578798b44000980bbf69ed77b374
#: ea1c70696147422f9feebe5cf08da2e0
