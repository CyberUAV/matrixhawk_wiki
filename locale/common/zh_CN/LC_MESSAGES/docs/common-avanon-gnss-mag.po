#: ../../source/docs/common-avanon-gnss-mag.rst:7
#: 0cac6a9dc7d54b819c051e90a705b688 343deb5c155844aa806c09027a2a254b
#: 6111155e1fef4b7699979e824cdf64bb a18cc33f02ca4493a453e1960379cc62
