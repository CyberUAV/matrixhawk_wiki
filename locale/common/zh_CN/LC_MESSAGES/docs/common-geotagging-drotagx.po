#: 01ef1ac559104e3a8042e9f897ecba91 0e3d1493bccf4dc793c8e23fab76399b
#: 169790216aee487596fe2dd4028d9c9d 274587bced2645ffb1cb8110fce3dddf
#: 2c35b21518c4440f9690fa6d4e1d845e
msgid ":ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>`: 1"
