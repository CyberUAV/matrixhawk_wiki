#: ../../source/docs/common-NxtPX4v2.rst:127 dc0a6b180f054b79809255f1da952396
msgid "Compass"
msgstr "罗盘"

#: ../../source/docs/common-NxtPX4v2.rst:129 64a7a2156aa743ebbdf25fd2f9bee404
msgid ""
"The NxtPX4v2 does not have a built-in compass, but you can attach an "
"external compass using I2C on the SDA and SCL connector."
msgstr "NxtPX4v2 没有内置罗盘，但可通过 SDA 和 SCL 接头使用 I2C 连接外置罗盘。"

