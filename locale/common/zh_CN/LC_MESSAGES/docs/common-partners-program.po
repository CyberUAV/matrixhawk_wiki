#: ../../source/docs/common-partners-program.rst:24
#: 0fd5a5d4a6754817abd58003dfde05a2 10c7276575b4465abe690714c8d92975
#: 39ccb23fd8454cbfa7880938751b1c4d 3d683b4b02024aad9e4c88f05b6b5fa6
#: 4812107783d34100a541c75ca6de5f54 4d939c0667fe4985ac23013d1fbae8e8
