#: ../../source/docs/common-partners-program.rst:59
#: 035b5a7a589c4d299bcba722bebc7ceb 0e1c42bfad1844bf95582f678af83c6a
#: 2f682abcdd0d462ebe4e69ceebfd361e 536804387d1241ba9c85362dc6979b3c
