#: ../../source/docs/common-partners-program.rst:39
#: 0782155aa7ea463eaebf0785dc3ab58b 08e4dd3f923148aeb7e1c4ab6b7c0389
#: 08e6d2774dc0496bb7d06721d11d724b 1de2ccc8992d465993445fadd54d1e1e
#: 2b1f58e335c3430d973fb4006cfbbfaf 5ffd6367041b45d39d33486e75d9eb00
