msgid "PPM encoders"
msgstr "PPM 编码器"

#: ../../source/docs/common-ppm-encoders-new.rst:7
#: 02cdfa1be81141c9ae5c1704aa963572 38589fecb80b4905a0a30acd004d1ad2
