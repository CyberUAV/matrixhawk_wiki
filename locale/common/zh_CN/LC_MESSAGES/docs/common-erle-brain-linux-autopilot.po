msgid ""
"*Erle-Brain 1 (*Discontinued*)*: The first Open-Source Linux Autopilot that "
"runs ArduPilot and ROS natively."
msgstr "*Erle-Brain 1（* 已停产 *）*：首款原生运行 ArduPilot 和 ROS 的开源 Linux 飞控。"

#: ../../source/docs/common-erle-brain-linux-autopilot.rst:16
#: 1e93c1931f4b4831a5a85ef5b9f15dc9 33791a89ed0d4aee8a8a468da0deeff6
