#: ../../source/docs/common-powering-the-apm2.rst:11
#: 1dc84006d379434a82c5c043e31ebb24 59fe72e747aa417594323fdeddeae13f
#: 5bb534054f404ef28954e465aaf391a2 85b8aaa9b5e44a1489c1de677a3003d1
#: ffb0382ba4114dac8bc93a2d73c492ee
