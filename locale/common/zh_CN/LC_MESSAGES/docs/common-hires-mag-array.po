#: 8fc3a476b99145ad86fc3325ee31d5bd a2ef29b7a4384070a890a98ed98dcd7d
#: d4449f89ebc840e1a21b25ca995f1f91
msgid "And could be suspended below a vehicle as shown below:"
msgstr "可以悬挂在飞行器下方，如下图所示："

#: ../../source/docs/common-hires-mag-array.rst:17
#: 64eceac1dd7f41348588a5180eac09d1 74e375454fb44507a341edb38c7cfd8c
#: ccae5f6d925f46b986254b0ba1d8d8a9 d16ff9052aad4b91b735bd1f7b1c4519
