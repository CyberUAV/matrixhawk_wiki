msgid "DroneCAN Magnetometer Array"
msgstr "DroneCAN 磁力计阵列"

#: ../../source/docs/common-hires-mag-array.rst:7
#: 2c6e730212f7497f85b5f96c8bd7b17a 4b0249fe96a0463fbc7556924afa685d
#: 765599bc4532487fac7475b9bfefad38 bafd0cc6e52140febb38ef26668f31a1
#: de419c94747f40f3a6c45615f66c5759
msgid ""
"ArduPilot can be used to create a multiple magnetomer array using DroneCAN "
"compasses. This could be useful as a suspended device for geophysical "
"surveys or other uses."
msgstr "ArduPilot 可使用 DroneCAN 罗盘创建多磁力计阵列。这可用于地球物理调查或其他用途的悬挂设备。"

#: ../../source/docs/common-hires-mag-array.rst:9
#: a3d663c083e149118ecfbb03ae7a5028 ade2ddc7bce546e5a30d96f88dd3169f
