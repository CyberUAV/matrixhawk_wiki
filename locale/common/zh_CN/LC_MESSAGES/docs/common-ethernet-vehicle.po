msgstr "云台相机设置"

#: ../../source/docs/common-ethernet-vehicle.rst:65
#: 06a60c6cdad54fb89f4fbfb63140725a 2444ebefcad8488ba7aa51a49b5044a6
#: 371bce01b43d4029b0adf444a91b36df d746d9f37ac945729b7b28738a1ce7f2
#: e4a7d37b90a34e87b96e1982a790043d
