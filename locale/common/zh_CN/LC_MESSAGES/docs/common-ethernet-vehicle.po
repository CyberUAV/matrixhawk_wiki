msgid "The Tower of Babel: Physical wiring"
msgstr "巴别塔：物理接线"

#: ../../source/docs/common-ethernet-vehicle.rst:139
#: 1ce4c5394fec4cb18c8a6f5ba2571dd8 4f204020ea8249ff924d5bab1680101a
