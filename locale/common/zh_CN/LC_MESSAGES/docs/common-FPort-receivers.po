#: c0dae6923d624454b56e23981bc04f84 d28500397a7147a9a72b6a428dcc3140
#: db87222ec06f40e7bf650cfa78b70d8b e5418aea8832406ba350d8eb2eeb3a02
msgid "``SERIALx_PROTOCOL`` = 23"
msgstr "``SERIALx_PROTOCOL`` = 23"

#: ../../source/docs/common-FPort-receivers.rst:39
#: 1360b4d59ff643f89a1a21ce5fc65d4d 48143d2144984b72ab8736d47ec1cc04
#: 896271c11457482da693c1ce0b665544 9ab489d0ebaa452cbd972c5fe0c5c9eb
#: c9199c41ab7c481081ef44c6a664a9d5 ffb13a0e8f5f46eea3358f5062e220e7
msgid ""
"``SERIALx_OPTIONS`` = 160 (enable pull-up/pull-downs on TX and RX pins for "
"those external inverter circuits that may require it, won't affect those "
"that do not need it)"
msgstr ""
"``SERIALx_OPTIONS`` = 160（为可能需要的外部电平转换电路启用 TX 和 RX 引脚上的上拉/下拉，对不需要的电路不影响）"

#: ../../source/docs/common-FPort-receivers.rst:40
#: ../../source/docs/common-FPort-receivers.rst:46
#: ../../source/docs/common-FPort-receivers.rst:55
