#: 502750c283cc4eb38374268632cc215e 5f0ac27feb814710afae13b08d6dcc37
#: 8122c84f0d3f46068b44d82ff4a6928a 9319e487f735492ab199b347238f5ec3
#: aa79ef24d1ad494c848ee1000102ab6b b426de963cdb46ddb15dad6b9373a53d
#: d6f2e7b2d44d4ee086e29b9242340965 d930b51aa734498bb48f8e58084ba5dc
#: e1f80f1cd05a4d5ba9aa78cde2e80dc5 f4f1412d2fc5400ba8dd8d140bbe157f
#: f5002d78f3824e999ef8fa1d312576d6
msgid "Now set your RSSI parameters accordingly:"
