#: ../../source/docs/common-joystick.rst:30
#: ../../source/docs/common-joystick.rst:32 49f5fd78463a4365a0972367633acc99
#: 53340d6c4fd24e89aa4b0ec07875c34c 59f9faa3e5d448dd8e2b56e0f4dc5036
#: e8d2a1c99fa642569ac204f2186952d6 f8c0474e7c3c4130a0ae3fc3b29d1a2c
