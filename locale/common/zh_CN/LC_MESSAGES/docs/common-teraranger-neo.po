#: e6c0e967a1a84d2ea8e58d4738a046a6
msgid "Set :ref:`RNGFND1_ORIENT<RNGFND1_ORIENT>` = 25 (down)"
msgstr "设置 :ref:`RNGFND1_ORIENT<RNGFND1_ORIENT>` = 25（朝下）"

#: ../../source/docs/common-teraranger-neo.rst:40
#: 25febb4ce0b64a52b24c7fabe906b5fe 32c6b453e3c64cf58c78c3a1a832acd1
