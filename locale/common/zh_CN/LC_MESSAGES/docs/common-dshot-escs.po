#: ../../source/docs/common-dshot-escs.rst:41 025855b6a7d64f30987f78cf12462b02
#: 0ef9c9ffc4914db0b4c3702cf5a5aad9 311653daf0cf45c783e67b452da5d7fc
#: 8a72daf1a3874d1ca3034f2ca4535f73 adf1d1b64be04cdaa88cf05659769bb8
