#: ../../source/docs/common-ibus-telemetry.rst:58
#: 1009fc22c2c740ecafc3821e2bfb977c 2e666475674b4f87ab18b0a432aba1b7
#: 9ecbe5270cf34b1f8034b030ee0c0d65 cd6c8b47e8de49dcb6be687169820806
#: d5b887c61121403aa33a49eba788102d e82257a3ebb04241a59aabadb1973d62
