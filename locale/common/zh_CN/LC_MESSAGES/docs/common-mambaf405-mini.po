#: ../../source/docs/common-mambaf405-mini.rst:66
#: 1d77bb36b07c4d3796d534c73b4e1eba
msgid "SERIAL3 -> USART3 (User, TX has DMA capability, on DJI AIR connector)"
msgstr "SERIAL3 -> USART3（用户，TX 具有 DMA 能力，位于 DJI AIR 接口）"

#: ../../source/docs/common-mambaf405-mini.rst:67
#: 7e58e0bdbed647db9f7acf2d96109cee
msgid "SERIAL4 -> UART4  (User, TX has DMA capability)"
msgstr "SERIAL4 -> UART4（用户，TX 具有 DMA 能力）"

