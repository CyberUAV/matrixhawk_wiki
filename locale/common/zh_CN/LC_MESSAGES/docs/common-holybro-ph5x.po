#: acb2b5dbaeae4f239604a9669ef8f57b e320baadb32746f68693f3a01a94ab9d
msgid ""
"FPort would require :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>` be set to "
"\"15\"."
msgstr "FPort 需要将 :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>` 设置为 「15」。"

#: ../../source/docs/common-holybro-ph5x.rst:103
#: 7a38728238ec4ca5b5936cdbf89b7895 bbbfeddbce744933802017c91865b8a8
#: c2d2792bdff842aaace3ec90f56de08c cef41f4ea67248b0bb1efbf13ea3b6af
#: d638a973618145058272a8b167a9002c e374a8aed2dc4515bacf6c1ac6c83b99
