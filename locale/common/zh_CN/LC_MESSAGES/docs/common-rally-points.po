#: 6d900331c9c64967a72c4c6fb8eedbee 799870c21b5f48cebef4ea2a18d9080a
#: bdd960c970144a1e9a4955d524cbfda5 e9e1b3235982406c87a37fcb45c1cd02
msgid "Repeat for all desired Rally points!"
msgstr "对所有需要的集结点重复以上操作！"

#: ../../source/docs/common-rally-points.rst:57
#: 14e303c9daa3477f8ebedec7d279d739 7e74d0a04c7049f180663ce1ce3a3398
#: b38b128a21ed4d119957208997a51752 d185ecb27477405d8b9b0b23571151de
