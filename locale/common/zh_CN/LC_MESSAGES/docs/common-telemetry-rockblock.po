#: ../../source/docs/common-telemetry-rockblock.rst:56
#: 42027bd7687541db97dbe399128379e0 78aa54591d5e42fb84a30db5392d9e29
#: 7aaf6ba2baa5478a8cbcbb8095f7b510 960be9c2fcb64c209cdc73cd046dbe41
#: ba2a4f326a0046d1ac679dfd195bf451
