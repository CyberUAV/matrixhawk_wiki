msgstr "点击「Set local node ID」字段旁的检查按钮"

#: ../../source/docs/common-hobbywing-dronecan-esc.rst:66
#: 3ea02d7398634ca0b53c23fbc988a375 632358c84f644c96be41fa3a4f121671
#: 69b50480bf4643918348c1be86179820 a4a0ef4f65d94de19d7638304bea573a
#: b413e651f12241dda82cad2702020b4d
msgid "Select Panels, Hobbywing ESC Panel"
msgstr "选择 Panels，Hobbywing ESC Panel"

#: ../../source/docs/common-hobbywing-dronecan-esc.rst:67
#: 20f1410dc6694f10bb392e8a7e6ada1b 43855f1042604915b17f57350dc9de93
#: 51610cd429f64100827d4a5a6071b3db 9d850e3f5a7f478e866f828720e71bca
#: cc5da480cb1249419a950b80461633cf
