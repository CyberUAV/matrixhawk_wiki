#: ../../source/docs/common-MicoAir405v2.rst:128
#: 327f882323cb4ac6a76feca0519bb060
msgid "Compass"
msgstr "罗盘"

#: ../../source/docs/common-MicoAir405v2.rst:130
#: e8dc439e0a384c0796cf819b84341635
msgid ""
"The MicoAir405v2/Mini do not have a built-in compass, but you can attach an "
"external compass using I2C on the SDA and SCL connector."
msgstr "MicoAir405v2/Mini 没有内置罗盘，但可通过 SDA 和 SCL 接头使用 I2C 连接外置罗盘。"

#: ../../source/docs/common-MicoAir405v2.rst:133
#: 87ec5eab87a14ca99e7883a636cd117b
