#: 860760d630244f9fa977661247a6bf9e e64463cd8bb742249e9fe39a5ae2b4fe
msgid ""
"Connect to the dAISy2's COM port at 38400 baud and press <ESC> to view the "
"setup menu"
msgstr "以 38400 波特连接 dAISy2 的 COM 端口，按 <ESC> 查看设置菜单"

#: ../../source/docs/common-ais.rst:44 0cf5432da729493ebd73a2f53caf43d9
#: 2398f144486849f6a9b0c1afff8f099b 3c0649c807024aecaff7885676e71e33
#: 7274ac893b8445428ef34bf2ac8b6aa2 bab01be15e5e46d08157caa7123559ad
msgid ""
"Type \"3\" to enable the serial port.  \"38400 8N1 serial output (NMEA HS w/"
" adapter)\" should be displayed"
msgstr "输入 `3` 启用串口，应显示 `38400 8N1 serial output (NMEA HS w/ adapter)`"

#: ../../source/docs/common-ais.rst:45 13728b75c40947689b5d167e57ced890
#: 52ae2cc1a1bf4bd08af0daa4bf51f21c 6408620220c7485697dfe36261f708b3
#: 78ff7c0c2c374bdc96924caa0f247189 d2aba1e622c24cfbbac3af608f016480
msgid "Type \"#\" to save this change and retain this baudrate on boot"
msgstr "输入 `#` 保存更改，并在启动时保留该波特率"

#: ../../source/docs/common-ais.rst:46 1c1faf9c24fd4a4fad8854e5628795fc
#: 37022b4420784d17b88cdc4f134eef0e 61b3c7846c7e4de89250be01c7c1131f
#: 661277812aea4834a9687a887c598b4c db16ac021718413fba1615de9e763133
msgid ""
"Type \"T\" to enable entering a test NMEA message and then copy-paste this "
"message, \"!AIVDM,1,1,,A,3815;hUw00wfUdHMPfQ4s8WT0D`r,0*00\", or hit "
"\"Enter\" and use the default location"
msgstr ""
"输入 `T` 启用输入测试 NMEA "
"消息，然后复制粘贴此消息：`!AIVDM,1,1,,A,3815;hUw00wfUdHMPfQ4s8WT0D\\`r,0*00`，或直接按回车键使用默认位置"

#: ../../source/docs/common-ais.rst:52 1afd110e97f54c1c97c81f7e1b8e304a
#: 61f1bd3683fb4b0aba399ea8592c7390 cf7221066135474ba67899a755fd85e0
#: d30fca2c202148d3ae123c639996e796 d806c1d0622a4b67b4ce74e9b642e267
msgid ""
"Connect to the autopilot with Mission Planner (or another ground station) "
"and a boat should appear on the South West coast of England"
msgstr "使用 Mission Planner（或其他地面站）连接飞控，英国西南海岸应显示一艘船"

#: ../../source/docs/common-ais.rst:58 330d580995294253bfc3d40c92a8e6c2
