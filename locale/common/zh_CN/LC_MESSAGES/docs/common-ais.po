msgstr "飞控配置"

#: ../../source/docs/common-ais.rst:31 6fd13b6343864befad36c18a78f688fb
#: 79d74260e9bc4c578d0511d0b78341e7 92c7496536c94a17b1ab04109d16560a
#: ad47def6894948569eb43e1f96180968 d2de485c07f64a919d7939862a05cffc
msgid ""
"Connect to the autopilot with a ground station and set these parameters and "
"then reboot the autopilot"
msgstr "使用地面站连接飞控，设置以下参数后重启飞控"

#: ../../source/docs/common-ais.rst:33 0591c35b3db944479d9c542898b801ce
#: 5079dd4f38d54e948172491ded1ca42e 62f6349fff624397871dccd9bbe84a7d
#: e555988a67ee4d528de39f2f4960f4bd f00dcb574a454d778ba118ec7a699748
msgid ":ref:`AIS_TYPE <AIS_TYPE>` = 1 (NMEA AIVDM message)"
msgstr ":ref:`AIS_TYPE <AIS_TYPE>` = 1（NMEA AIVDM 消息）"

#: ../../source/docs/common-ais.rst:34 4741aaa377b340b6aa1021f940581a82
#: 845f64c70f9e43ba8c0a70181b142ae3 8513e2ffdd254ba4a9cad8b82f34431f
#: 90f5d0b063d24e9ba12125025b65032c b36a719e7ddb4444a920031114561e5d
msgid ""
":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` = 40 (AIS) if the sensor is "
"connected to serial port 1.  If another serial port is used please set the "
"appropriate SERIALx_PROTOCOL parameter"
msgstr ""
":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` = 40（AIS），如果传感器连接到串口 "
"1。如使用其他串口，请设置相应的 SERIALx_PROTOCOL 参数"

#: ../../source/docs/common-ais.rst:35 08371a3e5db64fccbdfe854934f83004
#: 293b9f5821524dac9df84301042ea4d4 34d565ca87614976918ebde0d0b15499
#: 99a45acfa8f04bb0bbe63ec3833b529f a5841fcb8ab04a19818d0e9a9ca5530e
msgid ""
":ref:`SERIAL1_BAUD <SERIAL1_BAUD>` = 38 (38400 bps) if using serial port 1."
"  If another serial port is used please set the appropriate SERIALx_BAUD "
"parameter instead"
msgstr ""
":ref:`SERIAL1_BAUD <SERIAL1_BAUD>` = 38（38400 bps），如使用串口 1。如使用其他串口，请设置相应的 "
"SERIALx_BAUD 参数"

#: ../../source/docs/common-ais.rst:36 39416b5e1203491e96239aeaad3d7ea8
#: 6031f717995f457cbcc6b6764ac37d7b 6541ed124a7c4ce3a446bce17596cd2c
#: 70fb2fecba56417eac3265df4d4b96a5 c85c1a1c02fa4576b1f7271aeb4a9507
msgid ""
":ref:`MAV1_ADSB <MAV1_ADSB>` = 5 to enable sending AIS mavlink messages to "
"the ground station over Serial0 (the USB port).  If a telemetry radio is "
"used the ``MAVx_ADSB`` param corresponding to its stream should also be set "
"to 5(Hz).(Streams are numbered from first in order of Serial ports "
"configured for MAVLink, MAV1 the first, MAV2 the second, etc.)"
msgstr ""
":ref:`MAV1_ADSB <MAV1_ADSB>` = 5，启用通过 Serial0（USB 口）向地面站发送 AIS mavlink "
"消息。如使用数传电台，其对应数据流的 ``MAVx_ADSB`` 参数也应设为 5(Hz)。（数据流按配置为 MAVLink 的串口顺序编号：MAV1 "
"为第一个，MAV2 为第二个，依此类推。）"

#: ../../source/docs/common-ais.rst:39 189093a873684597a4485ff78329eea0
#: 2d140e03657d434a8d574f8af82f5c10 45a9dcca0a4a4fd0972971c623756168
