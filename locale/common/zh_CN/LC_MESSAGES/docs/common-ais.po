#: c67436c440044cdf949efe6a0645a418 fbf98b66c1024a30995c038d55e5a6a2
msgid "Connect dAISy2 to your PC using a USB cable"
msgstr "使用 USB 线将 dAISy2 连接到电脑"

#: ../../source/docs/common-ais.rst:42 0f44039e994e45a49ebbeaf4a50b547a
