#: ../../source/docs/common-rangefinder-nra24.rst:38
#: ../../source/docs/common-rangefinder-nra24.rst:56
#: 116ba2adda9e474eb0060b1f0fbe2982 268340947de7455499b45b0fba19a8e9
#: 2eb5ca8a92264be4a3c966bf535441bb 3380050c53e74386ad187162b3edb3fb
#: 3c83266624da491a9b0e23dfe4ee8f0d 67e2210d8a1c4d90b4879f60e96b5e80
#: 80e842f6f1d3404cb582e26a6d0af436 a3c3b01c96de4a19b82a051789e5165a
