msgid ""
":ref:`CAN_P2_BITRATE <CAN_P2_BITRATE>` = 500000 (Or as set in NSM tools)"
msgstr ":ref:`CAN_P2_BITRATE <CAN_P2_BITRATE>` = 500000（或按 NSM 工具中的设置）"

#: ../../source/docs/common-rangefinder-nra24.rst:35
#: 308df00b28a549ef9f72d9b453ed342f b6a2547a8eed46f88bafe0a1680c2dda
