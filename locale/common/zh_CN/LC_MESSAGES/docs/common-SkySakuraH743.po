#: a425fb4debf2462f9169d8cd4be9e181
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 34"
msgstr ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 34"

#: ../../source/docs/common-SkySakuraH743.rst:103
#: 469959800ea542c2a4c5859e78d2e5e4
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11"
msgstr ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 11"

#: ../../source/docs/common-SkySakuraH743.rst:104
#: bca722f9799444fbb683ea7b452b9a9d
