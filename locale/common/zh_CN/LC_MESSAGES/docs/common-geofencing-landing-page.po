#: 35032dc6744145bd9dab042f5fa65f70 dd00f95a02724eeeb6a93cf19a025535
msgid "Guided to return point"
msgstr "Guided 模式返回点"

#: ../../source/docs/common-geofencing-landing-page.rst:91
#: 6ec84c2e4cf24c7ca7c1dfd16f5ebf9a d6b9ba75e61a4881a73927bfdf323759
