#: ../../source/docs/common-hott-telemetry.rst:5
#: db95dd67c3e54b4a93810136816c7d56
msgid "HOTT Telemetry"
msgstr "HOTT 数传"

#: ../../source/docs/common-hott-telemetry.rst:7
#: cbfc6cc33f194c32ac4704950f63b85a
msgid ""
"Plane-4.0.0 (and higher), Copter-4.0.4 (and higher) and Rover-4.1.0 (and "
"higher) support Graupner HOTT telemetry."
msgstr ""
"Plane-4.0.0（及更高版本）、Copter-4.0.4（及更高版本）和 Rover-4.1.0（及更高版本）支持 Graupner HOTT "
"数传。"

#: ../../source/docs/common-hott-telemetry.rst:13
#: 733d5f3b85e249b59853446781a69c9a
msgid "Wiring and Setup"
msgstr "接线与设置"

#: ../../source/docs/common-hott-telemetry.rst:15
#: 02c4170f393e4fbc8a9abe9237eed2e1
msgid ""
"Connection to the autopilot is via any UART port's TX input, although one "
"without RTS/CTS flow control is simpler to configure, since flow control is "
"not required."
msgstr "通过任意 UART 口的 TX 引脚连接到飞控，不带 RTS/CTS 流控的端口配置更简单，因为该协议不需要流控。"

#: ../../source/docs/common-hott-telemetry.rst:19
#: 7c0f6903e3304ab3914da9c966ab1b1f
msgid "To enable HOTT telemetry, for example on the first TELEM port SERIAL1:"
msgstr "例如，在第一个 TELEM 口 SERIAL1 上启用 HOTT 数传："

#: ../../source/docs/common-hott-telemetry.rst:21
#: 98be0c30e6314d35b40aa97f3d1f13e0
msgid ":ref:`SERIAL1_BAUD <SERIAL1_BAUD>`  set to 19 (for 19.2KBaud)"
msgstr ":ref:`SERIAL1_BAUD <SERIAL1_BAUD>` 设置为 19（19.2KBaud）"

#: ../../source/docs/common-hott-telemetry.rst:22
#: 16df42b99c274dc48bbd0b9306ec37eb
msgid ":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` set to 27 (HOTT)"
msgstr ":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` 设置为 27（HOTT）"

#: ../../source/docs/common-hott-telemetry.rst:23
#: 149611b6a10f4785bcfcbbc8bd31eef7
msgid ":ref:`SERIAL1_OPTIONS <SERIAL1_OPTIONS>` set to 4 (Half Duplex)"
msgstr ":ref:`SERIAL1_OPTIONS <SERIAL1_OPTIONS>` 设置为 4（半双工）"

#: ../../source/docs/common-hott-telemetry.rst:24
#: a6fea707b2d64e618c4179bd58b2a22c
msgid ""
":ref:`BRD_SER1_RTSCTS <BRD_SER1_RTSCTS>` set to 0 to disable flow control "
"(optional)"
msgstr ":ref:`BRD_SER1_RTSCTS <BRD_SER1_RTSCTS>` 设置为 0 以禁用流控（可选）"
