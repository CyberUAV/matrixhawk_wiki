#: ../../source/docs/common-thecubepurple-overview.rst:12
#: 221f397d0fa44704b7a14195e14245f6 467156b343c44e3dba27d35ca9acdfad
#: 82bd6883fbfb4d03ac41d8c7eb771ae8 d1ee80d850d548fca91290c863e20ddf
