#: be4c37c0edb647939546093aa63c522f ee239033ce72413eb3275b3970449227
msgid "Single IMU sensor"
msgstr "单个 IMU 传感器"

#: ../../source/docs/common-thecubepurple-overview.rst:17
#: 556a635462f74ab39f5cfde168695a43 82467480ec694570a780534af1cc16b1
#: 9c00b4929d4046d2bf4c39358dfd4b1b 9e5a0b7c689d4638b644c2a66352a101
#: d046943b5bfc41298272043d8f87f354 e2c74a1df74b41bea2f66764ae323a6d
