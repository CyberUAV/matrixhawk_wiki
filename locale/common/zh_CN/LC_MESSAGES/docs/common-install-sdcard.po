msgid "Loading Firmware via SD Card"
msgstr "通过 SD 卡加载固件"

#: ../../source/docs/common-install-sdcard.rst:9
#: 02d4dc6451ed4b8e9ece0cab73d38b7e 880b274746024df5b4174152f9facf5f
#: 947f27324c3e40a68b9a51c6c6a997cc a2d0a191c8684d58bd8cae848351b2ef
