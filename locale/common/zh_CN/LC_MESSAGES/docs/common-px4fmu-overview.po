#: f09d22f1de3b4fcb9fd8cdeb60b1c035 fcef348a437d41069b09b7bb98a15315
msgid "This \"pin\" is not brought out for separate user access."
msgstr "此「引脚」未引出供用户单独访问。"

#: ../../source/docs/common-px4fmu-overview.rst:165
#: 1a53d1b59fdf444aafb970282c0f9b46 499b6ff007fc47299ee4ece839cd46f0
#: 4f12b9c9690d47e0a2af8a4bbfd110aa 5a7eaaf94c834edabbb011bcfb197dee
#: 809e6e44dc864da8b2990948eb5f96b3 a90d84ba11d94349922ad14dbfd686c6
#: ce6cb4c28c294443897fbd7d8291dafb fd758b3456dd45e8b1937153100f4ec7
msgid ""
"This pin is separate from the Pin 10 high voltage analog pin on the PX4FMU "
"listed above which can also be used as a battery voltage monitor."
msgstr "此引脚与上述 PX4FMU 上的引脚 10 高电压模拟引脚分开，后者也可用作电池电压监测。"

#: ../../source/docs/common-px4fmu-overview.rst:169
#: 2a36d8db3eb14316ad5aa3ca365b4521 af5d170e87bb4e54add354dcb19ee595
#: b3de03070cc5460e87c2c7fc23ea66cf d54ea5ffc97a42a2a1f7007f98bf0340
