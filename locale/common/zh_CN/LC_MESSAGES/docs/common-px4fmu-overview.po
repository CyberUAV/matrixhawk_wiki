#: ../../source/docs/common-px4fmu-overview.rst:207
#: 0beca3f16f9f47e98d3cfa4b3864d7c2 308a007604de463c8c4adcbe4e66d245
#: 3d42961294b248a2a7c4cd3d14c0d699 e2f001f70e3e40cb9b12ac7e2ef2a8c0
