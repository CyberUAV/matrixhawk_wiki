#: ../../source/docs/common-px4fmu-overview.rst:203
#: 2087a82d3fb84ab5b8dd926d9c377173 825eb25bff95453f971087d4c5a5e634
#: f8fc84435e084e599b2e98c30d2a646a fd361e10c62f451b8f3aec003d9860b1
msgid "**Pin 114**: IO Relay pin 2"
msgstr "**引脚 114**：IO 继电器引脚 2"

#: ../../source/docs/common-px4fmu-overview.rst:205
#: 10738bef942844c0b056c864a13b39bb a53e0a4f938c4f65bf6ad11dab38ca49
#: a72dfcb7d8b34a2e89d551235664b221 fe2c943ddc4e474986620867cd1d0ae2
