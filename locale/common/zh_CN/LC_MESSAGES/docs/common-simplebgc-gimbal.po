msgid ""
"In your Ground Control Station set the following parameters, if using the "
"first mount connected to Serial2 as shown above:"
msgstr "在地面站中设置以下参数，假设使用上图所示连接到Serial2的第一个云台："

#: ../../source/docs/common-simplebgc-gimbal.rst:30
#: 055bf57b73aa47c489ab68167171bf2f 48027d109f5c48cc96f850cd571ffa1c
#: 69d2fbc7d540428eaa37d93198eddb50 6ba403bd6a9c4a3faa2f85f98132c549
#: 84516a2bcaf54c23900fdb14f602a261
msgid ":ref:`MNT1_TYPE <MNT1_TYPE>` to 3 (\"AlexMos-Serial\")"
msgstr ":ref:`MNT1_TYPE <MNT1_TYPE>` 设为3（「AlexMos-Serial」）"

#: ../../source/docs/common-simplebgc-gimbal.rst:31
#: 2c2360e3bff145cd93c510d9715cec56 86123191b2da4d42a08a8913107c736d
#: c03892a99e034356879bfc2f14d4002e c39362913c5e417387c00fc4e1b171ba
#: f0f70ae65cb54ab0bed9544cfd2350fb
