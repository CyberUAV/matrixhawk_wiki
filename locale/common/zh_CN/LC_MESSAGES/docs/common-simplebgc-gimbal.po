#: b4891db23e15436da0bb1a6e6b68daed
msgid ""
"More details can be found in the `software user manual "
"<https://www.basecamelectronics.com/files/v3/SimpleBGC_32bit_manual_2_6x_eng.pdf>`__."
msgstr ""
"更多详情请参见 `软件用户手册 "
"<https://www.basecamelectronics.com/files/v3/SimpleBGC_32bit_manual_2_6x_eng.pdf>`__。"

