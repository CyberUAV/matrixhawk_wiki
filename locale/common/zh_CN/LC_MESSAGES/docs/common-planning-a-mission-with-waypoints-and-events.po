#: ../../source/docs/common-planning-a-mission-with-waypoints-and-events.rst:81
#: ../../source/docs/common-planning-a-mission-with-waypoints-and-events.rst:86
#: 018ee49ec1c24482a57ac9744e8a1ade 0f9d52c959e542c491d0ae385fb340ab
#: 2193bc316b7b498f8a88f3ea3540d517 4498cd206699480aba487bd708d94633
#: 87a254cbd0c14957a64ae6ed1426ee4b 8dac330abd7646fda9b8c6565a561195
