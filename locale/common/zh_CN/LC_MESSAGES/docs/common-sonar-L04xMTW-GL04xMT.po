msgstr "支持的声呐型号："

#: ../../source/docs/common-sonar-L04xMTW-GL04xMT.rst:12
#: 8b26f01a125b4b4cbe57f610d786edce
msgid "L041MTW, GL041MT (min 5cm range, max 6m range)"
msgstr "L041MTW、GL041MT（最小5cm量程，最大6m量程）"

#: ../../source/docs/common-sonar-L04xMTW-GL04xMT.rst:13
#: 90b38baabcf147328c3f7c49608ec9db
msgid "L042MTW, GL042MT (min 2cm range, max 2m range)"
msgstr "L042MTW、GL042MT（最小2cm量程，最大2m量程）"

