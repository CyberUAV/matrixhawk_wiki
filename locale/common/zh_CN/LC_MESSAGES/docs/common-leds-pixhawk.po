msgid ""
"**Flashing red and yellow - with rising tone:** EKF or Inertial Nav failure"
msgstr "**红黄交替闪烁——伴随上升音调：** EKF 或惯导故障"

#: ../../source/docs/common-leds-pixhawk.rst:192
#: 24ac49db4bc54cd697f833cccf60c964 5da69042cd544fcdaf25c195d146fcbd
#: 5dd7c240bfe64f9682c10a556cc6326b 779496af057340e7aaafb31c992489a7
