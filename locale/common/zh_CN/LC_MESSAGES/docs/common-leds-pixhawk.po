msgid "**Single Flashing yellow:** Radio failsafe activated"
msgstr "**单闪黄色：** 遥控失控保护已激活"

#: ../../source/docs/common-leds-pixhawk.rst:184
#: 52d881b8438a4e3e888302dcf8e851fe 694c11581359452d9e5c8f9517fcf8c2
#: a16e9a29685c41ea984b711ac08e927a a4600a1c069c4fdb81f1104415712ccd
#: ad9639ae66124022a8a63c7329a89599 e47689031b55413c88a1dd13b9e9049b
msgid ""
"**Flashing yellow - with quick beeping tone**: Battery failsafe activated"
msgstr "**黄色闪烁——伴随快速蜂鸣声**：电池失控保护已激活"

#: ../../source/docs/common-leds-pixhawk.rst:187
#: 3dfd2fabc68b4013bad6db5e27fc115f 5ef58bb308a344b3a2aff56b31e5711d
#: 892960bf502244f78a51e70308d12351 8dcb34b832434bc5820a892e62692780
#: d5bbd2713e7e4349a5f4b179babbef55 fe0e65ee705d4781a868f6941582c0a7
msgid ""
"**Flashing yellow and blue - with high-high-high-low tone sequence (dah-dah-"
"dah-doh):** GPS glitch or GPS failsafe activated"
msgstr "**黄蓝交替闪烁——伴随高高高低音序列（嗒嗒嗒嗒）：** GPS 干扰或 GPS 失控保护已激活"

#: ../../source/docs/common-leds-pixhawk.rst:189
#: 382af073818b49a8a9981a429259a4b7 826747a67627487186c171360290dc46
#: 9397f0513ab44646aad4795d5463e4e1 9fd2bacfd0fa4adcbb667eaa63d0e5a4
