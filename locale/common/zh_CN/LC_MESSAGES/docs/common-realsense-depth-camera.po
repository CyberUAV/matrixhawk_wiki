#: ../../source/docs/common-realsense-depth-camera.rst:137
#: 73c3d14ab09e4cd18615bc4ea6871e5f 778a54a4c71e4a238fd38aaaa2435a79
#: e4b7831faac04aee8f369e14a0adbe52
msgid ""
"Test process: Take-off -> AltHold / Loiter -> Move toward the obstacle."
msgstr "测试流程：起飞 -> AltHold / Loiter -> 向障碍物飞行。"

#: ../../source/docs/common-realsense-depth-camera.rst:139
#: 1a5a4163f7f34e4698c8487f8dd18f19 4bd5ae83ff6745d0a50ebd795b9cd764
#: 82275e0dcb4247e88bb37dd7ab254de2
