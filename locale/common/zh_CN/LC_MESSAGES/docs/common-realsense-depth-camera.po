#: a0e3f61f11a44bcf9dde3c1bc2c3c117
msgid ""
"After the cloning process is finished, there will be a prompt declaring "
"success, press enter to continue."
msgstr "克隆过程完成后，将出现成功提示，按回车继续。"

#: ../../source/docs/common-realsense-depth-camera.rst:64
#: 510e2e5ff83e41018d2d6d26e0c4e1c5 5c71a43a4beb421bb31b71344381b589
#: d06356dcfdfb4d72ae8289af5a51bf1c
