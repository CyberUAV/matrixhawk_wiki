#: ../../source/docs/common-generating-motor-diagrams.rst:119
#: 119ebd6573444c4bb003e07d31575ced 1a04e06236354972b9fb351af12228f6
#: 1c62723d055744a1ad420cd635dafeec 26f50f13cad142f3829405df0e448912
#: 37e9d91a594a439c8be2c25be4955cf9 453868e720a64875bee459336d3b02c6
