#: ../../source/docs/common-prearm-safety-checks.rst:378
#: ../../source/docs/common-prearm-safety-checks.rst:414
#: ../../source/docs/common-prearm-safety-checks.rst:432
#: 6031a3d2b7ad484aa4009e2a43e49680 98d8bc216be74dbaa990cd0d1a104286
#: ad9fe634176c4cca85ba17a80de4733b ecf90eefb51544dca5b26964f9281fa8
msgid "**Airspeed not healthy**"
msgstr "**Airspeed not healthy**"

#: ../../source/docs/common-prearm-safety-checks.rst:381
