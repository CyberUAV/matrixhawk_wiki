#: ../../source/docs/common-prearm-safety-checks.rst:395
#: ../../source/docs/common-prearm-safety-checks.rst:431
#: ../../source/docs/common-prearm-safety-checks.rst:449
#: 3924d10f14264803ac43b69188233c44 76d0de67f0754c52bd99cbbd0ca7499c
#: 7d810b79fa8d464f99b7d81830a519bc 9869bf05e7564842b6e3b5dc10c06409
