#: 757476eee138483096778e207b5544f3 a1232e0d87e34105a35080953ad54c5e
msgid "Airspeed:"
msgstr "空速："

#: ../../source/docs/common-prearm-safety-checks.rst:376
#: ../../source/docs/common-prearm-safety-checks.rst:412
#: ../../source/docs/common-prearm-safety-checks.rst:430
#: 578de4a140ff48edbc18f9e93e058a26 a617d1f1853c4701a34866153e8b43d2
