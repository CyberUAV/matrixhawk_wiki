#: fdea073c49e140fe9ccd1118f323122d
msgid ""
"StellarF4V2 supports up to 11 PWM/Dshotg outputs. PWM1-4 outputs support Bi-"
"Directional DShot."
msgstr "StellarF4V2 支持最多 11 路 PWM/DShot 输出。PWM1-4 输出支持双向 DShot。"

#: ../../source/docs/common-stellarf4v2.rst:73
#: 2a869799a23643b590f8f2039d2e471e 43bd4028a5a144bd9106e83c92fe2c26
#: 68607ba72be743d7ab9ba6fbc688a68b 6aeb5723a0884b70a0fdc70759c6c784
#: ebcad344ec82490facc87a0244269310
msgid ""
"Channels 1-4 support bi-directional DShot. Channels 5-8 marked as S1M5-S4M8 "
"on the board. Channels 9-11 marked as S5-S7 on the board. PWM outputs are "
"grouped and every group must use the same output protocol:"
msgstr ""
"通道 1-4 支持双向 DShot。通道 5-8 在板上标为 S1M5-S4M8。通道 9-11 在板上标为 S5-S7。PWM "
"输出分组，每组必须使用相同的输出协议："

