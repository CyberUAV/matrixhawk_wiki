#: c68dffca76a9459e9317bb0fcf859c44
msgid ""
"CRSF also requires a TX2 connection, in addition to RX2, and automatically "
"provides telemetry."
msgstr "CRSF 除需要 RX2 外还需要 TX2 连接，并自动提供数传。"

#: ../../source/docs/common-stellarf4v2.rst:61
#: 0db9bcf0fdcd4f0586623391f5354523 90d71ff3495d4c429fbbcdc000e05fef
#: d5e1564489af4a7a9cea721e843c48d6 d8c6da7aaf0549b3b78baa4817140741
#: e140b1645cc642f68900b6bded1e4734
msgid ""
"FPort requires connection to TX2 and :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>`"
" set to \"7\". See :ref:`common-FPort-receivers`."
msgstr ""
"FPort 需要连接到 TX2，并将 :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` 设为 \"7\"。参见 "
":ref:`common-FPort-receivers`。"

#: ../../source/docs/common-stellarf4v2.rst:62
#: 04c2774aa012407980f630a830cf5471 147ab87cf78840bc9730734535087273
