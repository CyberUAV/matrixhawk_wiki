msgstr "设置 SERVO5_FUNCTION=70 或 RC5_FUNCTION=70，使通道 5 输出油门"

#: ../../source/docs/common-CHUCK-overview.rst:43
#: 1efecdd77b44462fbebcc6d6fe898d74 33029ef90ad14147a10cd7f53d8b23e8
#: 7bdfd5d7336a42c9a3e834e74dc8b2e4 995bcb9aa668488b81baca42b63f0a8f
