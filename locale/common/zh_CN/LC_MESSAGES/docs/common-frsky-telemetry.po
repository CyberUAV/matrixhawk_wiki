#: ../../source/docs/common-frsky-telemetry.rst:65
#: 0eded3ff63524ed6af5ffa6f22fedb13 36cee474aa244cd8a4b1d2a90625257f
#: 5bbc685b20b04762aa4f875cd1638d0b 9b383e74f67048ceb8b1f0a6aa8b7833
