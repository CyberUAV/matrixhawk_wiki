#: ../../source/docs/common-teraranger-tower-objectavoidance.rst:9
#: 049a26a89125463f8060e12f973cf2d8 7a7f15d97f134d559deba4c63cd880ae
#: 820d18d9b7814f92ac12a0ad0b46cb29 f185b3414ab94dae92ed714f4f9e4a41
