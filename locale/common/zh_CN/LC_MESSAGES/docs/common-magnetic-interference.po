#: ../../source/docs/common-magnetic-interference.rst:85
#: ../../source/docs/common-magnetic-interference.rst:87
#: 6f498eb7209e4f9ba55db2f9294d9ad7 773c90d6ead64b4bb7b51dcf4eb69494
#: a0140881d0194fd7a248407e85072c74 a9dbf5223fa346c2975b6714dc5f5c67
