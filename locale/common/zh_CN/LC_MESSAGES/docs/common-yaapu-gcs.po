#: d029ef4fd15a4b07b0a2210449be00ac
msgid ""
"Once the Yaapu LUACGS script is exited, then other scripts, like the Yaapu "
"Telemetry script will restart."
msgstr "退出 Yaapu LUACGS 脚本后，其他脚本（如 Yaapu 数传脚本）会重新启动。"

#: ../../source/docs/common-yaapu-gcs.rst:35 1bf4d418bb834a8eb4a9877c2f4b3c8c
#: 74d94764f7c343a7902e31fe281386e4 87aafc0f148c49538c61726b8ace79f6
