#: e83b48f7859d48dea38d044bb26f8d69
msgid "Loading firmware using SSBL"
msgstr "使用 SSBL 烧录固件"

#: ../../source/docs/common-loading-firmware-onto-chibios-only-boards.rst:147
#: 2ee59026d5d64c0a948deb1f3da99287 52ef94b7c31442f19460a66d26918e03
