#: ../../source/docs/common-efi.rst:85 219b748162dc4f8a8e239f2d80d5cfe2
msgid "DLA Setup"
msgstr "DLA 设置"

#: ../../source/docs/common-efi.rst:87 46cf1bf4ccc8420f8d767c33a97cbb74
msgid ""
"Driver is provided via a :ref:`LUA <common-lua-scripts>` script. See LUA "
