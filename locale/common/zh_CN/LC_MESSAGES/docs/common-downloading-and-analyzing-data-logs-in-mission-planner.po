#: ../../source/docs/common-downloading-and-analyzing-data-logs-in-mission-planner.rst:52
#: 5f5de9cf0ad3434b8e13c1842f487c7e 69245af5ada24e84b14ae994b0d40458
#: 6a5449ed9b184aeebd836f2d2a5932ac 7ec6e20a54574065ad9c0e6303e6fae9
#: c578352b9db54c3f9025794affe8ab31 e9b563ccaf31440b900b8fc59dc3ac20
msgid "Check card contacts."
msgstr "检查SD卡触点。"

#: ../../source/docs/common-downloading-and-analyzing-data-logs-in-mission-planner.rst:53
#: 54d4f996568540de91a90adcc5f72cc7 85cea171cdd2428f9cf28491853f2484
#: 860f2657b3644fcfbc9c0e24a37f87fa 90d8a319d527459eb3894e731eb2865e
#: a9dc40150c294e12919643fc23cf03a5 eb99a45ee0484a8fae72d0dc6cd629fe
msgid "Some cards are problematic, try using a different one."
