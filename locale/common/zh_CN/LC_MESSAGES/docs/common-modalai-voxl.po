#: 70f52a63bd5b49ee8f7783707af6e5f6 aec96dea14f4439c901fbd3cb882b699
#: fa730a94c2024659be644cffa0733d4f
msgid ""
"Set :ref:`VISO_POS_X <VISO_POS_X>`, :ref:`VISO_POS_Y <VISO_POS_Y>`, "
":ref:`VISO_POS_Z <VISO_POS_Z>` to the camera's position on the drone "
"relative to the center-of-gravity.  See :ref:`sensor position offset "
"compensation <common-sensor-offset-compensation>` for more details"
msgstr ""
"设置 :ref:`VISO_POS_X <VISO_POS_X>`、:ref:`VISO_POS_Y "
"<VISO_POS_Y>`、:ref:`VISO_POS_Z <VISO_POS_Z>` 为相机相对于飞行器重心的位置。详见 "
":ref:`传感器位置偏移补偿 <common-sensor-offset-compensation>`"

#: ../../source/docs/common-modalai-voxl.rst:60
