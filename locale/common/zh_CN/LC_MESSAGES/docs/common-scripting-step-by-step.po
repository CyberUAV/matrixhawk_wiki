#: ../../source/docs/common-scripting-step-by-step.rst:42
#: ../../source/docs/common-scripting-step-by-step.rst:57
#: 0431d9dcc75343afbc4b7a8f9e16516a 8bed886be6a14094b27c0cfc7ddd0196
#: a71ab0ee18cd456985f554513384e95d c7d1575b8654425eb0ce9f41d20f29e3
