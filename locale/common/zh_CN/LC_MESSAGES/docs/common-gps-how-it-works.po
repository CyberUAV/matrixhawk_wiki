#: 6d96478e231043a2ad9f62a5bc98e01d d1e8d1584d1d46e987051396b7f5d2c7
#: e9f18232941e4e65b9642c9f500875f3
msgid "Extreme Multipath (Backyards or between buildings flights) : 83 %"
