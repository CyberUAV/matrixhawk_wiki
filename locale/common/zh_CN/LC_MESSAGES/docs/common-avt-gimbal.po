#: f93758c784874621bdc7d47a2ac3fa06
msgid "Pilot Control"
msgstr "飞手控制"

#: ../../source/docs/common-avt-gimbal.rst:38 5114b18e3e3a401dafaf35e4d4efac6f
#: 787e405cff124020a2f23041d0e08e6d 7e52a574f9e14b4a8decbe3cc8a2c6fa
#: d936b53d3a06406893bbadd5e4a2a6de
msgid ""
"To control the gimbal's lean angles from a transmitter set the RC controls "
"for roll, pitch, or yaw using ``RCx_OPTION`` 212 (Mount1 Roll), 213 (Mount1 "
"Pitch), 214 (Mount1 Yaw) for the first mount,."
msgstr ""
"要用遥控器控制云台的倾斜角度，可使用 ``RCx_OPTION`` 212（Mount1 Roll）、213（Mount1 "
"Pitch）、214（Mount1 Yaw）为第一个云台设置横滚、俯仰或偏航的 RC 控制。"
