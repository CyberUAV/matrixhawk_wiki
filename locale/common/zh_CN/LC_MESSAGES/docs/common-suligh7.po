#: e569ca9dce1f488886706512c5d40b2c e6dbddc6270d4d60aa1391013a7949fb
msgid "The SBUS_IN pin is internally tied to the RCIN pin."
msgstr "SBUS_IN 引脚在内部与 RCIN 引脚相连。"

#: ../../source/docs/common-suligh7.rst:60 11d110936f42431ab20d6af21e9c7aa1
