#: 3e1f922ceb294e628784443b05ae5194 d86fc76c579547efa00c718f420b396d
#: e19b736ae23e4a20b39ff44f999da6ea eb68576012734249afa5e612c2b87ec6
msgid ""
"The RCIN pin, which by default is mapped to a timer input, can be used for "
"all ArduPilot supported receiver protocols, except CRSF/ELRS and SRXL2 which"
" require a true UART connection. However, FPort, when connected in this "
"manner, will only provide RC without telemetry."
msgstr ""
"RCIN 引脚默认映射为定时器输入，可用于所有 ArduPilot 支持的接收机协议，但 CRSF/ELRS 和 SRXL2 除外（这两种协议需要真正的"
" UART 连接）。但 FPort 以此方式连接时，仅提供 RC 而无数传。"

#: ../../source/docs/common-suligh7.rst:51 06f38986045b4056a52e8062bd1b70cb
#: 444e42521ec14229b3e0ea594ab421f6 8ad016036cad4903bc5f596aa5197cf3
#: b95a187a3d8e41979f1b112af7c6eb04 df1cdca501a94b2e95e993de3f37fcc0
msgid ""
"To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 "
"receivers, a full UART, such as SERIAL5 (UART8) would need to be used for "
"receiver connections. Below are setups using Serial5."
msgstr ""
"要使用 Fport、CRSF 和 SRXL2 接收机中的 CRSF 及内嵌数传功能，需要使用一个完整的 UART（例如 SERIAL5 "
"(UART8)）来连接接收机。以下是使用 Serial5 的设置。"

#: ../../source/docs/common-suligh7.rst:54 4a0f82f8f772413d934f7dfcb244338d
#: 73acd599e10240379c82e6da1412fdbc 80fd453cadb94c1bb3980cff3b16e217
#: c350fae0267b4ca392a8593e02a8b020 e103fc17693f4c939bc35b8012b1b8f8
msgid ":ref:`SERIAL5_PROTOCOL<SERIAL5_PROTOCOL>`  should be set to “23”."
msgstr ":ref:`SERIAL5_PROTOCOL<SERIAL5_PROTOCOL>` 应设置为 “23”。"

#: ../../source/docs/common-suligh7.rst:55 5140b2a1a2a840f68bbf696e5b2f2489
#: 7aff92c740a44a68b1a714b0a29af4e6 84ab70a9eb5a4d69bd8e2c06c3157b81
#: 94b79ea8859b4d4fb8f3b224189d9ac3 bf937822c4214f3ebc8b8e686c3a8ef7
msgid ""
"CRSF would require  :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>`  set to “0”."
msgstr "CRSF 需要将 :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>` 设置为 “0”。"

#: ../../source/docs/common-suligh7.rst:56 194ee74f018849d2ad5272f0085e897b
#: 1d492a9e914c4295bf30589406d16f23 84e99f7410c64f0ca08b039d1bd4ebca
#: 9ab3d7cf81f1441db5f4bcb5901b618c fbe826ed6d204503ae07e08897b1632b
msgid ""
"SRXL2 would require :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>` set to “4”. And "
"only connect the TX pin."
msgstr ""
"SRXL2 需要将 :ref:`SERIAL5_OPTIONS<SERIAL5_OPTIONS>` 设置为 “4”，并且只连接 TX 引脚。"

#: ../../source/docs/common-suligh7.rst:58 001c00f1516f418c855093cb5199a72f
