#: ../../source/docs/common-external-ahrs-vectornav.rst:11
#: 17e854e97dc149b790e27f8fff19ec7e 6f6b8668b2dc4feca35ad957e619c7d7
#: 758f95685dcf44799f513560cdb32568 bb7a7ac8f3d2440399b3c4b57a9bedb4
#: fcf69cc873d449f88551f695b946db5a
