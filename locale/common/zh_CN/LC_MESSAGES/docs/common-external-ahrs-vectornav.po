msgstr "更高精度的航向、俯仰和横滚估计"

#: ../../source/docs/common-external-ahrs-vectornav.rst:12
#: 1767650fdaf147449741dd19f079905b 5ab9257c6c084810aa56d16b1fbf2e13
#: 7a0d7cf2ee194774a50df86ba378b7c8 9cca8d076a1a486ea1c2dfbad9c7b375
#: e4b22138792d4774ab620c32167341d5
msgid "More robust and reliable GNSS positioning"
msgstr "更可靠的 GNSS 定位"

#: ../../source/docs/common-external-ahrs-vectornav.rst:13
#: 2c434dbeda3c4f6b918b990272c9c09d 2dcae989e6a14f3c9adbc76ea5d9cef7
#: 6376b6175ae0481187fb821429afc79f 63ada977aaf04c9b83eacf90c4087c34
#: fec273262ef34fb48e7d97f39c0645b9
