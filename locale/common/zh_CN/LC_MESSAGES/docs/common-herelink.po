msgstr "点击返回箭头按钮返回设置"

#: ../../source/docs/common-herelink.rst:68 2bffa8ccd9a54916abc806817d74ca9d
msgid "Scroll down to \"Developer Options\" and enable \"USB debugging\""
msgstr "向下滚动到 「Developer Options」 并启用 「USB debugging」"

#: ../../source/docs/common-herelink.rst:69 4f11af167fe74ab6aec69373e1f3f857
msgid "Connect the Herelink to a PC via USB cable"
msgstr "通过 USB 线将 Herelink 连接到 PC"

#: ../../source/docs/common-herelink.rst:70 45bf783e01b44f47a0c4b7457f1968be
