msgstr ":ref:`BATT_AMP_OFFSET<BATT_AMP_OFFSET__AP_BattMonitor_Analog>` 0.008"

#: ../../source/docs/common-omnibusf7.rst:94 e0428c84f4414a5783c692004501b5e3
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 12"
msgstr ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 12"

#: ../../source/docs/common-omnibusf7.rst:96 f7c3df2b844f464fa008ec5218038e82
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 10.925"
msgstr ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 10.925"

#: ../../source/docs/common-omnibusf7.rst:98 f6254d8d457e476c9c34a606fbf9b885
msgid ""
":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` 58.0 (note, "
"this value is valid if using Matek Systems FCHUB A5 current sensor)...will "
"need to be calibrated to match actual current if using another make of PDB "
"board)"
