msgstr "OSDn_ALTITUDE 将显示最大高度"

#: ../../source/docs/common-osd-overview.rst:126
#: 3d7590f9cc1a4951af49b42899c31e6b 534c1f1e60064b85bd17edb48d21fbca
#: 942e6ff4f69f4651a8e8e90176f4654b b09b63899cf94948b1b2774f6bcdac75
#: dd44a8a9fd1a476eb98b712cc5a56f64
msgid "OSDn_BAT_VOLT will display min voltage"
msgstr "OSDn_BAT_VOLT 将显示最低电压"

#: ../../source/docs/common-osd-overview.rst:127
#: 121bac0f9f2a4e1dad3bea394b00b1b3 b6b65c84027f4568badf8fc2aacfea8b
#: b74073042b1745baa0bdbf361c10037a d4dc6540c2ec4ccc9b76ecc50a7ad65e
#: f99166d25fcf4b7eb371ed116a9f5f2c
msgid "OSDn_CURRENT will display max current"
msgstr "OSDn_CURRENT 将显示最大电流"

#: ../../source/docs/common-osd-overview.rst:128
#: 0e78951a5512424b800ca2566716de05 18af2d2e278c493e9e4bfed3acf4cb68
#: 7d890d3923184b858fdd5d52a31b06be 96164b79f01d4d8b8eecdfe8d41e05ba
#: bee4fc0eec5d481a80576cffb75e4a73
msgid ""
"OSDn_GSPEED will display max ground speed (or airspeed if ``OSDn_ASPEED_EN``"
" is set to 1)"
msgstr "OSDn_GSPEED 将显示最大地速（或空速，若 ``OSDn_ASPEED_EN`` 设置为 1）"

#: ../../source/docs/common-osd-overview.rst:129
#: 006f456a004849ac92218ba1cff738b3 da71eedf24934d7b97e12b72c1048553
#: f2752d2e00ec4d91a0641c22f6a209b2 f398e8d5390f479d88044fcee163cb99
#: f9df3d092f374c02a04c9d39ef37e192
