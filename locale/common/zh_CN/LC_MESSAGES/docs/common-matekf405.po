msgid ""
"SRXL2 requires a connection to T2 and automatically provides telemetry.  Set"
" :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` to \"4\"."
msgstr ""
"SRXL2 需要连接到 T2，并自动提供数传。将 :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` 设为 「4」。"

#: ../../source/docs/common-matekf405.rst:101 244273face364b54a06f68f17cb9483d
#: 5228004f3c8141d79187a72a2906ec6d 5ef82717bf004d21bfe2ec48df092fa2
