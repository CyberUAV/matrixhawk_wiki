msgstr "启动中"

#: ../../source/docs/common-ie24-fuelcell.rst:73
#: 015ff3a9fb4b41cebdd91d690ff05c2b 53a8129cc5534a4685516c72fda95c68
#: 73ed33eb18044996ad0fd7c78ea634c6 a3202f19d0394bfc9fbde4c10e96cab8
#: d68c6fbed5dc417284c6b64bcf6f4c1f
