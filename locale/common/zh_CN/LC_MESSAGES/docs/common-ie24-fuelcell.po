#: 160e878deefe4b03823b80125ad5f1ad 355b4b0a84194520805c1f53448046b5
#: 3d6a1bc0e1d34f6b8ff48cbd9a673f92 6fbac58c214c4c568201cc780e43e18c
#: 791be62435c5490a892adabd9f3f45d9
msgid ""
"The fuel cell reports status over the telemetry.  The status levels are:"
msgstr "燃料电池通过数传报告状态。状态级别为："

#: ../../source/docs/common-ie24-fuelcell.rst:72
#: 4c53b62c044048e694053f8546fa9ba3 76197f0fe31d46028b5600ac3d16c119
#: 94893e2c3c054103af7c8239a1e73f87 9e448215984b4b71b5b873cf02e39495
#: a44383e2b1bf4797860925a35a6c3660
