#: 73c98b258a5a40679f4d44a4010e7aa3 879deed983d54901b9be69f1f88d0c8d
#: af2397713666465ab63ddd0f45656635 f2b6ca3c550c4cde9bfbd523f19ce25f
msgid "Power"
msgstr "电源"

#: ../../source/docs/common-installing-3dr-ublox-gps-compass-module.rst:99
#: 1638f2dae36849ab8df2b1289234d8c1 2e649e1509ff4008961672d13a14325b
