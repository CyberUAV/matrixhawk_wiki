#: ../../source/docs/common-toshiba-can-escs.rst:67
#: ../../source/docs/common-toshiba-can-escs.rst:69
#: ../../source/docs/common-toshiba-can-escs.rst:72
#: 002ac0d3cbc5482fa75dfbff067222ce 44ea6722814c4790975d164cbc8fbf84
#: 537fbad69a0e481f9502a365d3d425f7 a9c3dbae8e0f415f97841887dcbdb2c8
msgid "ESC Temperature"
msgstr "电调温度"

#: ../../source/docs/common-toshiba-can-escs.rst:68
