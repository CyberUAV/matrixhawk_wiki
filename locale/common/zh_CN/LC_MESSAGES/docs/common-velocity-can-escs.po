msgid "Up to 18S (75V) battery packs"
msgstr "支持最高 18S（75V）电池组"

#: ../../source/docs/common-velocity-can-escs.rst:14
#: 3790f1642b8b43a0a0571df2db51a4cf 94c4c2c4118a4cef91ff1d31d3c9541f
#: a2d0e807c0b64875a54f52295f5b442a bc1b6f99feb04d35b61475f3a271b705
