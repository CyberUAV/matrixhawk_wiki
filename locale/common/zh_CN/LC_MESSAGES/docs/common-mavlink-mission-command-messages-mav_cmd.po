#: 80db760845b54539a9423f151796c341 b3f7ceab48574e1db229a87009164fa0
#: b4b5c8f8195b4171b2752a6dc072e895 c89738960f724794b221e9a642a03417
msgid "MAV_CMD_NAV_DELAY"
msgstr "MAV_CMD_NAV_DELAY"

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1113
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:281
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:324
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:494
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:974
#: 0f7ae48b11664d0b9a8bb049446112c8 7a12355339004106a632120d537d04dc
#: 80b96383aea54096ad5839e348fbdc1e b633bdf600bd4ee2b37ab4a4c62733a2
#: c6e30d7f85d849dc88f69b353d363eab ca2caadbe3654dc38a917c8cd7ea80c0
msgid "Supported by: Copter, Rover, Plane."
msgstr "支持的飞行器：Copter、Rover、Plane。"

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:498
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:978
#: 8d553709f42e4ebeae99303bbd3daab4 d522d99e287c45dba34a34fb9eb5251b
msgid ""
"After reaching this waypoint, delay the execution of the next mission "
"command until either the time in seconds has elapsed or the time entered(in "
"the future) is reached. Execution of the next mission item then occurs. For "
"Copters, they will loiter until then, and Rovers hold position."
msgstr ""
"到达此航点后，延迟执行下一条任务指令，直到经过指定秒数或到达指定时间（将来某时刻）。然后继续执行下一条任务项。Copter 在此期间悬停，Rover "
"保持位置。"

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1039
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:1177
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:289
