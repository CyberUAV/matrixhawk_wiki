#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:888
#: 6799642e34004222833fec85b5fd5519 a00ff0d6bd47421397ca71a58bc33281
msgid "The Mission Planner screenshot shows the path the vehicle will take."
msgstr "Mission Planner 截图显示了飞行器将要飞行的路径。"

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:888
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:890
#: 4b45a1d0194142deb757b8fc2a17e3db 9f37992e89e44da3a06e6c2fe7a950b4
msgid ""
"The 1 second delay at the end of Waypoint #1 causes the vehicle to stop so "
"Spline command #2 begins by taking a sharp 90degree turn"
msgstr "航点 #1 末尾的 1 秒延迟导致飞行器停止，因此样条指令 #2 从急转 90 度开始"

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:890
#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:892
#: b047497067564e418ce032f59e915cc3 fbf1a514b8a040a28bd4de95f6c3a333
msgid ""
"The direction of travel as the vehicle passes through Spline Waypoint #3 is "
"parallel to an imaginary line drawn between waypoints #2 and #4"
msgstr "飞行器经过样条航点 #3 时的飞行方向与航点 #2 和 #4 之间的假想连线平行"

#: ../../source/docs/common-mavlink-mission-command-messages-mav_cmd.rst:892
