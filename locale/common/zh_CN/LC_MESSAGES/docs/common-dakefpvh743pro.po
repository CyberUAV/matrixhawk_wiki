#: da25f1ecd356447c9fe63a53ff695dc7 f7f2b995cfbe459e9de42e3e03ba0583
msgid "OSD Support"
msgstr "OSD 支持"

#: ../../source/docs/common-dakefpvh743pro.rst:121
#: ../../source/docs/common-dakefpvh743pro.rst:122
#: 495927afce504138950c523683d38b0b 5c27fdf0dbfc4d76b71cbea00cdc39cd
#: a237a2a15f8c475692f00292d337dd06 c99670671f4a4dbcacb27d262bdf08e0
#: d951af98368e479c974c85568cc76953 ec85e5a686a3450590c35a2a26da7cc0
msgid ""
"The DAKEFPVH743/Pro has an onboard OSD using a MAX7456 chip and is enabled "
"by default. The CAM1/2 and VTX pins provide connections for using the "
"internal OSD. Simultaneous DisplayPort OSD is also possible and is "
"configured by default."
msgstr ""
"DAKEFPVH743/Pro 配备基于 MAX7456 芯片的板载 OSD，默认已启用。CAM1/2 和 VTX 引脚提供内置 OSD "
"的连接接口，同时也支持 DisplayPort OSD（默认配置）。"

#: ../../source/docs/common-dakefpvh743pro.rst:123
