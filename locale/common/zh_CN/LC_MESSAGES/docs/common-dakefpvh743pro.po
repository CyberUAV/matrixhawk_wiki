#: bc81611655b94a09a55c4419a85ec1e7 d4383f9fc9fe41d4b8ce9b59ae5c8b50
msgid "Camera control"
msgstr "相机控制"

#: ../../source/docs/common-dakefpvh743pro.rst:113
#: ../../source/docs/common-dakefpvh743pro.rst:114
#: 4092d0d58e5a4cf7a8479cc2ee775190 892e6651a3454055abccdba40cc1f624
