#: d0b3a89c0090490db279b17090a4ccc9 e27ba9475cfb46d7ae9f3678aa961c97
msgid "RC Input"
msgstr "RC 输入"

#: ../../source/docs/common-dakefpvh743pro.rst:58
#: ../../source/docs/common-dakefpvh743pro.rst:59
#: 07a607bc3d7b48f1b7a33604c66feb43 1fe5f56fdafe4ad597ed85c6e8a2e59e
#: 2edc5bc0c5364a16947be0b855c5321f ab2e7328059b46fea9bef0a335f878d6
#: e2520c9b22ad40b09a1b6aac104e4eb5 fc80d8f2701a41239be4eb076f6bcb5c
msgid ""
"RC input is configured by default via the USART5 RX input. It supports all "
"unidirectional serial RC protocols except PPM . The SBUS pin is inverted and"
" tied to R5 for SBUS support."
msgstr ""
"RC 输入默认通过 USART5 RX 引脚配置，支持除 PPM 之外的所有单向串行 RC 协议。SBUS 引脚经过反相后连接到 R5，用于支持 "
"SBUS。"

