#: ../../source/docs/common-longbowf405wing.rst:59
#: 2971e71189af4a719d348d80fcb24da4
msgid ""
"The UARTs are marked Rn and Tn in the above pinouts. The Rn pin is the "
"receive pin for UARTn. The Tn pin is the transmit pin for UARTn."
msgstr "上述引脚图中的 UART 标记为 Rn 和 Tn。Rn 引脚为 UARTn 的接收引脚，Tn 引脚为 UARTn 的发送引脚。"

#: ../../source/docs/common-longbowf405wing.rst:63
#: d05cb4a6d70c4cf38824134b1c390ca5
msgid "SERIAL0 -> USB"
msgstr "SERIAL0 -> USB"

#: ../../source/docs/common-longbowf405wing.rst:64
#: b3ee14d50b9e4caab91201aad605f716
msgid "SERIAL1 -> USART1 (User) (DMA capable)"
msgstr "SERIAL1 -> USART1（用户）（支持 DMA）"

#: ../../source/docs/common-longbowf405wing.rst:65
#: 4e293c4316e249868ad07259c4d46e20
msgid ""
"SERIAL2 -> USART2 (RX tied to inverted SBUS RC input, but can be used as "
"normal UART if :ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>` = 1)"
msgstr ""
"SERIAL2 -> USART2（RX 连接到反向 SBUS RC 输入，但如果 "
":ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>` = 1 可作为普通 UART 使用）"

#: ../../source/docs/common-longbowf405wing.rst:66
#: 43d8da526a104b9880db617e132d2075
msgid "SERIAL3 -> UART3 (GPS) (TX DMA capable)"
msgstr "SERIAL3 -> UART3（GPS）（TX 支持 DMA）"

