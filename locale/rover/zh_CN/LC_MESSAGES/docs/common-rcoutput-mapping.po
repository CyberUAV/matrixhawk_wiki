#: ../../source/docs/common-rcoutput-mapping.rst:42
#: 6dac612e6537411ebde683a06a5104f6
msgid ""
":ref:`SERVO2_FUNCTION <SERVO2_FUNCTION>` change from 34 (aka \"motor2\", "
"back-left) to 36 (motor #4, back-right)"
msgstr ""
