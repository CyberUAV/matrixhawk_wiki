msgid "ADC Pin13 -> ADC IN2 3.3V Sense"
msgstr "ADC 引脚 13 -> ADC IN2 3.3V 感测"

#: ../../source/docs/common-radiolinkpix6.rst:581
#: 499f0ec66570440fab611643c3efeff5
msgid "Analog 3.3V RSSI input pin = 103"
msgstr "模拟 3.3V RSSI 输入引脚 = 103"

