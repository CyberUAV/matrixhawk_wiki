msgstr ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 18"

#: ../../source/docs/common-radiolinkpix6.rst:556
#: a0e84c26314c42679082ed722b46360c
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 24"
msgstr ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 24"

#: ../../source/docs/common-radiolinkpix6.rst:559
#: d3ee74a9ef8546db8e1109df3bc7f6aa
msgid "Power2 port(I2C)"
msgstr "Power2 接口（I2C）"

#: ../../source/docs/common-radiolinkpix6.rst:561
#: ac7561cb210f440a9ced282ba4dd7b34
msgid "The parameters should be set.:"
msgstr "应设置以下参数："

#: ../../source/docs/common-radiolinkpix6.rst:563
#: 7daf8a91df0f4db7a393beb74947f189
