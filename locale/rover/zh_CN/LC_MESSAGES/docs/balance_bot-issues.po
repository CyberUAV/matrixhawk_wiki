msgstr ":ref:`COMPASS_USE <COMPASS_USE>` = 1"

#: ../../source/docs/balance_bot-issues.rst:73
#: b789ab99be0442de845dd3bee495c735
msgid ":ref:`COMPASS_ENABLE <COMPASS_ENABLE>` = 1"
msgstr ":ref:`COMPASS_ENABLE <COMPASS_ENABLE>` = 1"

