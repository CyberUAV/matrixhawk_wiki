#: 26530abd1ef940d6a63f2e04febbfc89
msgid "SERIAL6 = USER = UART4"
msgstr "SERIAL6 = 用户 = UART4"

#: ../../source/docs/common-matekh743-wing.rst:86
#: 07572ae310f749ab91b4210924464545
msgid ""
"SERIAL7 = USER = UART6 (TX only unless :ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>`"
