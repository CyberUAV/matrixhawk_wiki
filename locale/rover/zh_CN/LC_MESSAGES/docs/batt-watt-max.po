msgstr "``MOT_BAT_WATT_TC=1``"

#: ../../source/docs/batt-watt-max.rst:25 3f16ab9a99df4a8d8923f2270b5a1a6b
msgid "``MOT_BAT_WATT_TC=2``"
msgstr "``MOT_BAT_WATT_TC=2``"

#: ../../source/docs/batt-watt-max.rst:25 61c83f234c9249f48e0e9a05b1540553
msgid "``MOT_BAT_WATT_TC=5``"
msgstr "``MOT_BAT_WATT_TC=5``"

#: ../../source/docs/batt-watt-max.rst:27 4fe42836069b4c86860c5bb82265a1a0
msgid "1.1 1.5 2 5 10"
msgstr "1.1 1.5 2 5 10"

