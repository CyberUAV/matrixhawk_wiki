#: 5e8a1b90b74b4b8895b0badf66c3443e
msgid "The 6 auxiliary PWM outputs are in 2 groups:"
msgstr "6 路辅助 PWM 输出分为 2 组："

#: ../../source/docs/common-makeflyeasy-PixPilot-V3.rst:388
#: 0edb8f6b30204d8784702bf5adb7ef72
msgid "PWM 1, 2, 3 and 4 in group1"
msgstr "PWM 1、2、3 和 4 在第 1 组"

#: ../../source/docs/common-makeflyeasy-PixPilot-V3.rst:389
#: 74a24c1369334328a42693d53e4f74c4
