#: ../../source/docs/common-thecubeyellow-overview.rst:40
#: 94d5dabdbd9d448f8e925448fee15512
msgid "Three redundant IMUs (accels, gyros and compass)"
msgstr "三冗余 IMU（加速度计、陀螺仪和罗盘）"

#: ../../source/docs/common-thecubeyellow-overview.rst:41
#: 7633142e6dfc4310bc000860bd4c29f1
msgid ""
"ICM 20649 integrated accelerometer / gyro, MS5611 barometer on base board"
msgstr "底板上的 ICM 20649 集成加速度计/陀螺仪、MS5611 气压计"

#: ../../source/docs/common-thecubeyellow-overview.rst:42
#: c595748e309e4c49bff5b0616ee2bd5f
msgid ""
"InvenSense ICM20602 IMU,ICM20948 IMU/MAG, MS5611 barometer on temperature "
"controlled, vibration isolated board"
msgstr "InvenSense ICM20602 IMU、ICM20948 IMU/MAG、MS5611 气压计（温控减震板）"

#: ../../source/docs/common-thecubeyellow-overview.rst:43
#: 8fa413698ab34409a36497d9a3130442
msgid "All sensors connected via SPI."
msgstr "所有传感器通过 SPI 连接。"

#: ../../source/docs/common-thecubeyellow-overview.rst:45
#: 1d1bdaba72e54d9b848afe1deb9aab4b
