msgid "STM32F777VIT6 Cortex®-M7 Core (with DPFPU)"
msgstr "STM32F777VIT6 Cortex®-M7 内核（带 DPFPU）"

#: ../../source/docs/common-thecubeyellow-overview.rst:35
#: cd6f690643804d2a917d85ad454f9f69
msgid "216 Mhz/512KB RAM/2 MB Flash"
msgstr "216 MHz/512KB RAM/2 MB Flash"

#: ../../source/docs/common-thecubeyellow-overview.rst:36
#: 2d77611ca61a4edca6c1543ace76c213
msgid "32 bit STM32F103 failsafe co-processor"
msgstr "32 位 STM32F103 失控保护协处理器"

