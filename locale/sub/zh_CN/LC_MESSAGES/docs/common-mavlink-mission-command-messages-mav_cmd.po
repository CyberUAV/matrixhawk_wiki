#~ msgid "Disarm the motors."
#~ msgstr "上锁电机。"

#~ msgid "The command supports disarming on the ground and in flight."
#~ msgstr "该指令支持在地面和飞行中上锁。"

#~ msgid "The motors will disarm automatically after landing."
#~ msgstr "降落后电机将自动上锁。"

#~ msgid ""
