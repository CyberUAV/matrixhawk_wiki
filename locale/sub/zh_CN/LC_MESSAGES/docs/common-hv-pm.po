#: ../../source/docs/common-hv-pm.rst:5 a6b3d126bc41470db2c5bf8d4d047dfe
msgid "CUAV HV PM (High voltage power module)"
msgstr "CUAV HV PM（高压电源模块）"

#: ../../source/docs/common-hv-pm.rst:7 8c1d1b09b4b645c99236bdae4dc7dbf5
msgid ""
"The CUAV HV PM module is a new high voltage voltage power module "
"independently developed by CUAV with the following features:"
msgstr "CUAV HV PM 模块是 CUAV 自主研发的新型高压电源模块，具有以下特性："

#: ../../source/docs/common-hv-pm.rst:9 0740d2d2def24e50810328c8f693ac52
msgid "High voltage input: 10v-60v (3S~14S battery)"
msgstr "高压输入：10V-60V（3S～14S 电池）"

#: ../../source/docs/common-hv-pm.rst:10 bdbe9c51dbfe4559b29516216604d6a9
msgid ""
"Highly accurate battery monitor: * voltage detection accuracy: +-0.1v * "
"current detection accuracy: +-0.4A"
msgstr "高精度电池监测：电压检测精度 ±0.1V，电流检测精度 ±0.4A"

#: ../../source/docs/common-hv-pm.rst:13 5c4b54ec7e1f422bad45d1c5d81f96e5
msgid "Bec (5v) max current: 5A"
msgstr "BEC（5V）最大电流：5A"

#: ../../source/docs/common-hv-pm.rst:14 336785c9642b4ae58b1b973e94a1ee11
msgid "Max current measurement: 60A"
msgstr "最大电流测量：60A"

#: ../../source/docs/common-hv-pm.rst:15 d8e287fc402a4b1b80fff46bebfa5823
msgid "Max allowable output current(ESC/MOTOR PORT): 60A"
msgstr "最大允许输出电流（ESC/电机端口）：60A"

#: ../../source/docs/common-hv-pm.rst:18 819f710a72cc4eec958b4f0ac6af4dac
msgid "Enabling the HV PM"
msgstr "启用 HV PM"

#: ../../source/docs/common-hv-pm.rst:23 cbf04468041747f2bfabd69c352545a7
msgid "Set Monitor：Anglog Voltage and Current"
msgstr "设置 Monitor：模拟电压和电流"

#: ../../source/docs/common-hv-pm.rst:24 aa3654c557d0426e8cadbc1a97437d00
msgid "Set Sensor：CUAV HV PM"
msgstr "设置 Sensor：CUAV HV PM"

#: ../../source/docs/common-hv-pm.rst:25 a4e995615f5b40e5811705fb443bfa4f
msgid ""
"Set APM Ver：CUAV v5 or Pixhawk4(for V5 series flight control selects CUAV "
"v5)"
msgstr "设置 APM Ver：CUAV v5 或 Pixhawk4（V5 系列飞控选择 CUAV v5）"

#: ../../source/docs/common-hv-pm.rst:26 3217ecf22cfc4c858bcb9eb7505a7ac1
msgid "Click on other interface to write parameters"
msgstr "点击其他界面以写入参数"

#: ../../source/docs/common-hv-pm.rst:27 ../../source/docs/common-hv-pm.rst:32
#: ../../source/docs/common-hv-pm.rst:37 05f8f363976b4fcea1b087c28324e77f
#: 1d4c824105d6476ab349dfdaa9490e4d d40a858e45a249578f71e9877325c982
msgid "Restart Mission Planner and autopilot"
msgstr "重启 Mission Planner 和飞控"

#: ../../source/docs/common-hv-pm.rst:29 83edd15cfc9e491cbdb53d2a662bdb97
msgid ""
"You can also enable it by setting the following parameters (shown for first "
"battery monitor)."
msgstr "也可通过设置以下参数启用（以第一个电池监测为例）。"

#: ../../source/docs/common-hv-pm.rst:31 327e98e174cf42f28615da0e223f318c
msgid ""
":ref:`BATT_MONITOR<BATT_MONITOR>` to 4 to Set to analog voltage and current."
msgstr ":ref:`BATT_MONITOR<BATT_MONITOR>` 设置为 4，即模拟电压和电流。"

#: ../../source/docs/common-hv-pm.rst:33 e46157cc0a2a4608bdb5c2604637e68a
msgid ""
":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` to 0 (for CUAV "
"V5)."
msgstr ""
":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` 设置为 0（CUAV V5）。"

#: ../../source/docs/common-hv-pm.rst:34 a52b003f1c3d425fbe14872039276cce
msgid ""
":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` to 1 (for CUAV "
"V5)."
msgstr ""
":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 设置为 1（CUAV V5）。"

#: ../../source/docs/common-hv-pm.rst:35 ddc3b7440a974c94b47320e55570c36e
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` to 18"
msgstr ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 设置为 18"

#: ../../source/docs/common-hv-pm.rst:36 6349695c57da4d0b9b5329575ea43ae7
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` to 24"
msgstr ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` 设置为 24"
