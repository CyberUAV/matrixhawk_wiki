#~ " 0 到 1 之间的小数圈数，大于 1 的圈数必须为整数。"

#~ msgid ""
#~ "The radius of the circle is "
#~ "controlled by the command parameter. A"
#~ " radius of 0 will result in the"
#~ " copter loitering at the location and"
