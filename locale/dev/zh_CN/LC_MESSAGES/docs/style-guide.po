msgstr "_cms"

#: ../../source/docs/style-guide.rst:548 55dcab1aa84f4083a43cf156efffb402
msgid "Valid for internal values"
msgstr "适用于内部值"

#: ../../source/docs/style-guide.rst:549 957b1e81d5084fc28f65e27314124ef9
msgid "Volts"
msgstr "电压"

#: ../../source/docs/style-guide.rst:550 83b5677810ca4db89b7df3ac8665bd74
