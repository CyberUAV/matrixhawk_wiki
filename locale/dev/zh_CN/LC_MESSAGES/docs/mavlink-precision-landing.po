msgid "Precision Landing"
msgstr "精准降落"

#: ../../source/docs/mavlink-precision-landing.rst:7
#: 0c2c49b6730242f7989830ee9bc1698d
msgid ""
"Copter, QuadPlane and Rover support Precision Landing using the MAVLink "
"`LANDING_TARGET "
"<https://mavlink.io/en/messages/common.html#LANDING_TARGET>`__ message."
msgstr ""
"Copter、QuadPlane 和 Rover 支持使用 MAVLink `LANDING_TARGET "
"<https://mavlink.io/en/messages/common.html#LANDING_TARGET>`__ 消息实现精准降落。"

#: ../../source/docs/mavlink-precision-landing.rst:9
#: ce69a67ec0e54f8286f1aec20037aef0
msgid "References:"
msgstr "参考资料："

