#: ../../source/docs/mavlink-mavftp.rst:5 cc2f9a2d419448d5b4a6036428635618
msgid "MAVFTP"
msgstr "MAVFTP"

#: ../../source/docs/mavlink-mavftp.rst:7 5a93fa723ed749f180415ac434829b12
msgid ""
"MAVFTP supports common FTP operations including uploading, downloading, "
"removing and creating files on the :ref:`autopilot file system "
"<filesystems>`"
msgstr "MAVFTP 支持常见的 FTP 操作，包括在 :ref:`飞控文件系统 <filesystems>` 上上传、下载、删除和创建文件。"

#: ../../source/docs/mavlink-mavftp.rst:9 e1947ce7143b45ba9d187fcdb66cf8b0
msgid ""
"The `official mavlink.io documentation is here "
"<https://mavlink.io/en/services/ftp.html>`__ and contains the detailed "
"sequence of messages that should be passed between the GCS/companion "
"computer and autopilot"
msgstr ""
"`官方 mavlink.io 文档请见此处 "
"<https://mavlink.io/en/services/ftp.html>`__，其中包含地面站/伴随计算机与飞控之间应传递的消息的详细时序。"

#: ../../source/docs/mavlink-mavftp.rst:11 f2b5c58cff7b452691a88e62e6fddc27
msgid "Common uses for using MAVFTP include:"
msgstr "MAVFTP 的常见用途包括："

#: ../../source/docs/mavlink-mavftp.rst:13 4fbf4e23a7f641f88ca3630e4e82b5e4
msgid ":ref:`Uploading firmware to the autopilot <common-install-sdcard>`"
msgstr ":ref:`向飞控上传固件 <common-install-sdcard>`"

#: ../../source/docs/mavlink-mavftp.rst:14 f144d47921754446a7f413840b234082
msgid ":ref:`Uploading Lua scripts <copter:common-lua-scripts>`"
msgstr ":ref:`上传 Lua 脚本 <copter:common-lua-scripts>`"

#: ../../source/docs/mavlink-mavftp.rst:15 d56e4f8afa5743d8adfd6e9440f84791
