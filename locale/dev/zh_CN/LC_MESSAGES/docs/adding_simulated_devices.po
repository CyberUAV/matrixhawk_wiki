#: ../../source/docs/adding_simulated_devices.rst:396
#: fbf8904d05c2421cb2dbaa2e16a421f8
msgid "Then set up the simulated payload by doing the following:"
msgstr "然后通过以下步骤设置仿真载荷："

#: ../../source/docs/adding_simulated_devices.rst:398
#: 6786c0546e61478596ee6f255193ef99
msgid "param set :ref:`SIM_SLUP_ENABLE <SIM_SLUP_ENABLE>` 1"
msgstr "param set :ref:`SIM_SLUP_ENABLE <SIM_SLUP_ENABLE>` 1"

#: ../../source/docs/adding_simulated_devices.rst:399
#: 75b6e5cf3e6e4ca2938db0214aff98bc
msgid "optionally set other simulated payload features:"
msgstr "可选择设置其他仿真载荷特性："

#: ../../source/docs/adding_simulated_devices.rst:401
#: 774db0b130c84da18a85bb480f9c2e81
msgid ""
":ref:`SIM_SLUP_LINELEN <SIM_SLUP_LINELEN>`: the length of the line between "
"vehicle and payload (in meters)"
msgstr ":ref:`SIM_SLUP_LINELEN <SIM_SLUP_LINELEN>`：飞行器与载荷之间绳索的长度（米）"

#: ../../source/docs/adding_simulated_devices.rst:402
#: 44a30d69aa2343a4b3eff3788a53e9af
msgid ":ref:`SIM_SLUP_SYSID <SIM_SLUP_SYSID>`: system id of the payload"
msgstr ":ref:`SIM_SLUP_SYSID <SIM_SLUP_SYSID>`：载荷的系统 ID"

#: ../../source/docs/adding_simulated_devices.rst:403
#: 2384d39b003f4b8493121bb3a9f832f7
msgid ""
":ref:`SIM_SLUP_WEIGHT <SIM_SLUP_WEIGHT>`: weight of the payload (in kg)"
msgstr ":ref:`SIM_SLUP_WEIGHT <SIM_SLUP_WEIGHT>`：载荷重量（千克）"

#: ../../source/docs/adding_simulated_devices.rst:404
#: c368ee27daef43fb84a96e9345022317
msgid ""
":ref:`SIM_SLUP_DRAG <SIM_SLUP_DRAG>`: payload surface area drag.  Higher "
"values will cause the payload to be affected more by wind"
msgstr ":ref:`SIM_SLUP_DRAG <SIM_SLUP_DRAG>`：载荷表面积阻力。值越大，载荷受风的影响越大"

#: ../../source/docs/adding_simulated_devices.rst:406
#: e250f92a672844ffbacf6b42ea1ba9b6
msgid "optionally add simulated wind:"
msgstr "可选择添加仿真风："

#: ../../source/docs/adding_simulated_devices.rst:408
#: 36a45aab7d8d42f3b1b21f40ae7b2bf3
msgid ""
"param set :ref:`SIM_WIND_DIR <SIM_WIND_DIR>` 90 (to add wind blowing from "
"east to west)"
msgstr "param set :ref:`SIM_WIND_DIR <SIM_WIND_DIR>` 90（添加从东向西吹的风）"

#: ../../source/docs/adding_simulated_devices.rst:409
#: c45ddbe74eab4072a6581fe339848122
msgid "param set :ref:`SIM_WIND_SPD <SIM_WIND_SPD>` 4 (to add 4m/s of wind)"
msgstr "param set :ref:`SIM_WIND_SPD <SIM_WIND_SPD>` 4（添加 4m/s 的风）"

#: ../../source/docs/adding_simulated_devices.rst:411
