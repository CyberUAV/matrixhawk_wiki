#: 06c9683a13bd4846b908c8622953b887
msgid ""
"bit1:body roll rate, bit2:body pitch rate, bit3:body yaw rate, "
"bit7:throttle, bit8:attitude"
msgstr "bit1:机体横滚速率, bit2:机体俯仰速率, bit3:机体偏航速率, bit7:油门, bit8:姿态"

