#: f2e74abd712c4e65a3dde9dae464aa01
msgid "``message COMMAND_LONG 0 0 176 0 1 6 0 0 0 0 0``"
msgstr "``message COMMAND_LONG 0 0 176 0 1 6 0 0 0 0 0``"

#: ../../source/docs/mavlink-get-set-flightmode.rst:99
#: bf50bc9c89a54240bd914e875751c0b9
msgid ""
"Copter: change to RTL mode (6) Plane: change to FBWB mode (6) Rover: change "
"to Follow mode (6)"
msgstr "多旋翼：切换到 RTL 模式（6）；固定翼：切换到 FBWB 模式（6）；地面车：切换到 Follow 模式（6）"

#: ../../source/docs/mavlink-get-set-flightmode.rst:105
#: 2a9ba1afb4fa455286f9f1a38a4fb679
msgid "Set the Flightmode to Loiter, RTL or Land with COMMAND_INT"
msgstr "通过 COMMAND_INT 将飞行模式设置为 Loiter、RTL 或 Land"

#: ../../source/docs/mavlink-get-set-flightmode.rst:107
#: 2484e23ba00a4ffb9c462c9a993dc314
msgid ""
"The flight mode may be changed on some vehicle types to Loiter, RTL or Land "
"by sending a `COMMAND_LONG "
"<https://mavlink.io/en/messages/common.html#COMMAND_LONG>`__ with the "
"command field set to one of the following:"
msgstr ""
"对于某些飞行器类型，可通过发送 `COMMAND_LONG "
"<https://mavlink.io/en/messages/common.html#COMMAND_LONG>`__（将 command "
"字段设置为以下其中之一）将飞行模式更改为 Loiter、RTL 或 Land："

#: ../../source/docs/mavlink-get-set-flightmode.rst:109
#: 55ebbbb62f304259bd2315a4365b5812
msgid ""
"Loiter: `MAV_CMD_NAV_LOITER_UNLIM "
"<https://mavlink.io/en/messages/common.html#MAV_CMD_NAV_LOITER_UNLIM>`__"
msgstr ""
"Loiter：`MAV_CMD_NAV_LOITER_UNLIM "
"<https://mavlink.io/en/messages/common.html#MAV_CMD_NAV_LOITER_UNLIM>`__"

#: ../../source/docs/mavlink-get-set-flightmode.rst:110
#: f42b0d470d2a40f08d297cad6a36baa6
msgid ""
"RTL: `MAV_CMD_NAV_RETURN_TO_LAUNCH "
"<https://mavlink.io/en/messages/common.html#MAV_CMD_NAV_RETURN_TO_LAUNCH>`__"
msgstr ""
"RTL：`MAV_CMD_NAV_RETURN_TO_LAUNCH "
"<https://mavlink.io/en/messages/common.html#MAV_CMD_NAV_RETURN_TO_LAUNCH>`__"

#: ../../source/docs/mavlink-get-set-flightmode.rst:111
#: ed91ae62ca994b6da19f6643c2701583
msgid ""
"Land: `MAV_CMD_NAV_LAND "
"<https://mavlink.io/en/messages/common.html#MAV_CMD_NAV_LAND>`__ or "
"`MAV_CMD_NAV_VTOL_LAND "
"<https://mavlink.io/en/messages/common.html#MAV_CMD_NAV_VTOL_LAND>`__"
msgstr ""
"Land：`MAV_CMD_NAV_LAND "
"<https://mavlink.io/en/messages/common.html#MAV_CMD_NAV_LAND>`__ 或 "
"`MAV_CMD_NAV_VTOL_LAND "
"<https://mavlink.io/en/messages/common.html#MAV_CMD_NAV_VTOL_LAND>`__"

