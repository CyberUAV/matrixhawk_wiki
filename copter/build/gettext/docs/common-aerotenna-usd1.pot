#: 61e76db1a51d4b099057e78e40531b21
msgid ":ref:`CAN_D1_PROTOCOL<CAN_D1_PROTOCOL>` =  7 (USD1 protocol for driver 1)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:42
#: d47f998104ea48dbae34f3fe9e1fe86f
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 33 (USD1_CAN)"
msgstr ""

#: ../../source/docs/common-aerotenna-usd1.rst:49
