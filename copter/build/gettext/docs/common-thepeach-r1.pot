msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:81
#: 369570325a614a02ba359dde17d61c28
msgid "The 6 FMU PWM (AUX) outputs are in 2 groups and also support DShot:"
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:83
#: ef45938ee9f94776a7dfb36aedc198d6
msgid "AUX 1, 2, 3 and 4 in group1"
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:84
#: 8650a2b3292c4ba698abd99a446f5fc4
msgid "AUX 5 and 6 in group2"
msgstr ""

#: ../../source/docs/common-thepeach-r1.rst:86
#: 1abd32d25f3e49dfab93381286570a5f
msgid "FMU outputs within the same group need to use the same output rate and protocol. If any output in a group uses DShot then all channels in that group need to use DShot."
msgstr ""

