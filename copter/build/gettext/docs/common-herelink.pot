#: ../../source/docs/common-herelink.rst:31
#: 45ccf529d7924c5ea067d5449fd5bd13
msgid "Ethernet Connectivity"
msgstr ""

#: ../../source/docs/common-herelink.rst:33
#: 5d226df80c15456298a8308ecc3a08fc
msgid "Instead of using a UART serial connection to connect the autopilot to the AirUnit, an Ethernet virtual serial connection may be used"
msgstr ""

#: ../../source/docs/common-herelink.rst:35
#: 269068464a5d421d9040eff8819ee473
msgid "An example of the setup of the Herelink in a networked ArduPilot vehicle system is detailed in :ref:`common-ethernet-vehicle` but a short form of the instructions is below"
msgstr ""

#: ../../source/docs/common-herelink.rst:40
#: 1aa97c8385384affb4107ebc04246ec2
msgid "Connect the AirUnit and autopilot using an :ref:`ethernet adapter <common-ethernet-adapters>`.  The wiring for the AirUnit when used with a BotBlox SwitchBox is shown above but CubePilot's CubeLAND 8-Port Switch can also be used"
msgstr ""

#: ../../source/docs/common-herelink.rst:41
#: cd42d9c429464fe2b7bc88e70afbd1e2
msgid "Ensure the AirUnit and autopilot are on the same subnet (e.g the first 3 octets of the IP address match, 4th octet is different)"
msgstr ""

#: ../../source/docs/common-herelink.rst:43
#: ab1719fa83b34a66a3cf66ceccfdcf07
msgid "Herelink AirUnit's IP address is 192.168.144.10, GroundUnit's is 192.168.144.11"
msgstr ""

#: ../../source/docs/common-herelink.rst:44
#: 4784f3987883412fb7ce79c94afbadd6
msgid "Set the autopilot's :ref:`NET_ENABLE<NET_ENABLE>` = 1 and reboot to enable networking"
msgstr ""

#: ../../source/docs/common-herelink.rst:45
#: aec7a621ccf44309a0611bf48b51fd58
msgid "Set the autopilot's IP address using :ref:`NET_IPADDR0<NET_IPADDR0>`, :ref:`NET_IPADDR1<NET_IPADDR1>`, :ref:`NET_IPADDR2<NET_IPADDR2>`, :ref:`NET_IPADDR3<NET_IPADDR3>` (e.g. 192.168.144.14)"
msgstr ""

#: ../../source/docs/common-herelink.rst:47
#: f4c41e059bcd474b96861bf6f23e9857
msgid "Create a serial connection over ethernet for MAVLink telemetry"
msgstr ""

#: ../../source/docs/common-herelink.rst:49
#: 636d042633334b199168ac6e8362dcf7
msgid "Set :ref:`NET_P1_TYPE<NET_P1_TYPE>` = 1 (UDP Client) and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-herelink.rst:50
#: e90feafd3d23450d8edec0e4e08217ff
msgid "Set :ref:`NET_P1_IP0<NET_P1_IP0>`, :ref:`NET_P1_IP1<NET_P1_IP1>`, :ref:`NET_P1_IP2<NET_P1_IP2>`, :ref:`NET_P1_IP3<NET_P1_IP3>` to the Herelink AirUnit's IP address (e.g. 192.168.144.11)"
msgstr ""

#: ../../source/docs/common-herelink.rst:51
#: d8816e698c1047b18b416c23e31623ec
msgid "Set :ref:`NET_P1_PORT<NET_P1_PORT>` = 14550 (port that AirUnit listens on)"
msgstr ""

#: ../../source/docs/common-herelink.rst:52
#: d7ac5dbe7b1849eebe73f3704d27a2e3
msgid "Set :ref:`NET_P1_PROTOCOL<NET_P1_PROTOCOL>` = 2 (MAVLink2)"
msgstr ""

#: ../../source/docs/common-herelink.rst:54
#: 7e97243999bc4f009a49671770dedf1c
msgid "For information on how to include a camera gimbal to the system, please see the individual wiki pages for the :ref:`Siyi <common-siyi-zr10-gimbal>`, :ref:`Topotek <common-topotek-gimbal>` and :ref:`ViewPro <common-viewpro-gimbal>` gimbals"
