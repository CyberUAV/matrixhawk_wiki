msgstr ""

#: ../../source/docs/common-packetdigital-mppt.rst:25
#: 1f50404949c9475d88ba0cb1e52a55a6
msgid "Size: 60.96mm x 53.34mm x 17.4mm (LxWxH)"
msgstr ""

#: ../../source/docs/common-packetdigital-mppt.rst:26
#: 1f2855f020ad4f1e9b5dc51a12e45a88
