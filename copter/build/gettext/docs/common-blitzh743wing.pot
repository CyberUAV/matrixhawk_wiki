msgstr ""

#: ../../source/docs/common-blitzh743wing.rst:145
#: bcc621d2cf9a4f5f81465b9e80f84cd1
msgid "These are set by default in the firmware and shouldn't need to be adjusted"
msgstr ""

#: ../../source/docs/common-blitzh743wing.rst:148
#: c238a6e988e1485ba35f2b8212a2c948
msgid "Compass"
msgstr ""

#: ../../source/docs/common-blitzh743wing.rst:150
#: 2fc22eb7303b457eb1abc714bd927627
msgid "The BLITZ Wing H743 does not have a builtin compass, but you can attach an external compass to I2C pins."
msgstr ""

#: ../../source/docs/common-blitzh743wing.rst:154
#: 48c39dc3f46c41e3b7197307ad0af86e
msgid "Firmware"
msgstr ""

