#: ../../source/docs/ground-effect-compensation.rst:5
#: 669d18e83549470abc762a1f87fc4f6b
msgid "Ground Effect Compensation"
msgstr ""

#: ../../source/docs/ground-effect-compensation.rst:7
#: f9032f3d5c474f50b52069acb4976a7e
msgid "Copter includes ground effect compensation which reduces the weighting of the barometer (in favour of the accelerometers) when the vehicle is likely taking off or landing.  This reduces the bounce sometimes seen when landing vehicles with short legs compared to the length of their propellers."
msgstr ""

#: ../../source/docs/ground-effect-compensation.rst:9
#: 3f8fd0477dba487eab869422b1f205ee
msgid "If your vehicle is not suffering from the bounce on landing it's best to leave this feature disabled because it slightly increases the risk of high vibration levels upsetting the altitude estimate."
msgstr ""

#: ../../source/docs/ground-effect-compensation.rst:12
#: 2404dd11ef0447008c6c73a5a6a7a45c
msgid "Setup"
msgstr ""

#: ../../source/docs/ground-effect-compensation.rst:14
#: 3edb866d48144f128a213a00a394c844
msgid "Connect to the autopilot using your ground station (i.e. Mission Planner) and set the :ref:`GND_EFFECT_COMP <GND_EFFECT_COMP>` parameter to \"1\"."
msgstr ""

