#: ../../source/docs/common-camera-trigger-seagull-rec.rst:5
#: f861548fe6564a778552fed02077009b
msgid "Camera Triggering using Seagull REC"
msgstr ""

#: ../../source/docs/common-camera-trigger-seagull-rec.rst:10
#: a1f04c2925f34d8481e79c234570c8e2
msgid "`Seagull REC <https://www.seagulluav.com/product/seagull-rec/>`__ provides everything needed to connect a Pixhawk to a supported Sony MultiPort™ equipped camera in order to automate camera shutter triggering. The current list of compatible cameras `can be found here <https://www.seagulluav.com/product/seagull-rec/>`__"
msgstr ""

#: ../../source/docs/common-camera-trigger-seagull-rec.rst:12
#: 1ebb901884ea423cb086b4bd02165d56
msgid "The board supports three shutter trigger modes:"
msgstr ""

#: ../../source/docs/common-camera-trigger-seagull-rec.rst:14
#: 77bc94cbe1374ac0a98976fbe5f661c2
msgid "**AF-T** (\"AutoFocus-Trigger\", with 1 second pre-focus followed by trigger)"
msgstr ""

#: ../../source/docs/common-camera-trigger-seagull-rec.rst:15
#: c1e83b1248d04c0a9a072ce0ec1742cc
msgid "**IS-T** (\"Instant-Trigger\", instant trigger as soon as camera locks focus)"
msgstr ""

#: ../../source/docs/common-camera-trigger-seagull-rec.rst:16
#: caa56fffac8844968a3a85f034f4f9d4
msgid "**Manual** (\"Three stage trigger control\", neutral-focus-trigger)"
msgstr ""

#: ../../source/docs/common-camera-trigger-seagull-rec.rst:18
#: 0f53df6b8f2b4d30ae5e9ddd5d15f573
msgid "Seagull REC also supports **\"Video RECORD\", \"ZOOM\", \"Timelapse Triggering\" and \"Camera ON/OFF\"**."
msgstr ""

#: ../../source/docs/common-camera-trigger-seagull-rec.rst:20
#: 7dd52587c7494cca9c61c03f77a8dca5
msgid "More detailed instructions on how to setup REC are provided in the `Seagull REC Manual <https://www.seagulluav.com/manuals/Seagull_REC-Manual.pdf>`__ as well as `REC Support <https://www.seagulluav.com/seagull-rec-support/>`__ page."
msgstr ""

#: ../../source/docs/common-camera-trigger-seagull-rec.rst:22
#: 8a68b3e6d5c84c8b9942642afde35279
msgid "TIP:   The REC is only compatible with \"**Sony MULTI**\" cameras"
msgstr ""
