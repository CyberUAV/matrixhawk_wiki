#: ../../source/docs/common-dakefpvf405.rst:60
#: 161d6bbe8a22470a9d75549ced2e7b8b
msgid "RC input is configured by default via the USART2 RX input. It supports all unidirectional serial RC protocols except PPM and SBUS. The SBUS pin is inverted and applied to R2 for SBUS support."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:62
#: f5f7033113a041e7870909e1a86cbd15
msgid "FPort requires an external bi-directional inverter attached to T2 and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` set to 4 (half-duplex).  See :ref:`common-FPort-receivers`."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:63
#: 2bce125a64034a50ba4a03b1565e25b4
msgid "CRSF/ELRS uses RX2/TX2."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:64
#: 32a5bd41b4174040bfcce4eb48eec130
msgid "SRXL2 requires a connection to T2 and automatically provides telemetry.  Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:67
#: 94b8efe944c646fda06a51e7a728792c
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:68
#: abc856450429408db9d36c23ddffd355
msgid "The DAKEFPV F405 supports up to 7 PWM or DShot outputs. The pads for motor output M1 to M6 are provided on both the motor connectors and on separate pads."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:71
#: 97ef62f4f49740f4bd38ba761e995a4c
msgid "The PWM is in 4 groups:"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:74
#: 5928cda181d742509c8490308a6f941a
msgid "PWM 1-2    in group1"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:75
#: 5c085c2c89904c5ca50953cfdc5ef34a
msgid "PWM 3-4    in group2"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:76
#: 5d7101d8017e4364b0657f3529a6953d
msgid "PWM 5-6    in group3"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:77
#: 789bde66edff49b48a2b458581e4bbc7
msgid "PWM 7(LED) in group4 (set as Serial LED output function by default)"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:79
#: cdc6372b51ab47e4a483553affff4918
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot."
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:84
#: aa6745f3cc1f4c30bde28478e6771101
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-dakefpvf405.rst:85
#: 954204cf985c40218e0ecf266df56d18
msgid "The board has a built-in voltage sensor and external current sensor input. The current sensor can read up to 130 Amps. The voltage sensor can handle up to 8S LiPo batteries."
msgstr ""

