#: ../../source/docs/common-lightware-sf45b.rst:5
#: 39b6c98260684d188b23884ef90d2511
msgid "LightWare SF45/B 350 Lidar"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:7
#: 4d6ebb5c36fb433ea7bb3f27bff3e28a
msgid "The `Lightware SF45/B lidar <https://lightwarelidar.com/collections/lidar-rangefinders/products/copy-of-sf45-b-50m>`__ is a small (about 50g) scanning lidar (up to 350 deg) with a 50m range"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:14
#: 7af4f08532da463589b548e62cbf5a9b
msgid "Mounting the SF45/B"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:16
#: 49de04a405d74959b60a814ddc88a2fb
msgid "The SF45/B should be mounted on the top or bottom of the vehicle so that the lidar scans horizontally.  Ideally the number of vehicle parts (GPS mast, vehicle legs, etc) that obstruct the lidar's view should be reduced to a minimum"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:19
#: 1c034e8a61194e2fa19f9b30a8fe5fbf
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:24
#: 8dcde1b53970481ea1e3aeb12d1dc974
msgid "The lidar can be connected to any serial port but if powering the sensor directly from the autopilot (i.e without a BEC) ensure the port can provide the required 300mW of current.  Many Pixhawk compatible autopilots can provide more power to Serial1 than other ports meaning this may be the best choice."
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:27
#: c0775d6ffd7748ab9a72c36c456d1d87
msgid "Configuration through the Ground Station"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:28
#: 53c794e7801a416f845f949e3e3a43fb
msgid "Example setup below shown for first proximity sensor:"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:30
#: 295f2a30fcc84c55bcf9be1cf197ef12
msgid ":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` = \"11\" (\"Lidar360\") if using Serial1"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:31
#: 57c843c53e3d4b1d9619a6a3e4a2d816
msgid ":ref:`SERIAL1_BAUD <SERIAL4_BAUD>` =  \"115\" if using Serial1"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:32
#: bf4259f259e748be8e0ef3b2d14ddbf3
msgid ":ref:`PRX1_TYPE <PRX1_TYPE>` = \"8\" (LightwareSF45B)"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:33
#: 0d7b31398bb84c1ca00849554bea0ff5
msgid ":ref:`PRX1_ORIENT <PRX1_ORIENT>` = \"0\" if mounted on the top of the vehicle, \"1\" if mounted upside-down on the bottom of the vehicle"
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:34
#: e8219915d4ea4a6581d738a96fc0477d
msgid ":ref:`PRX1_YAW_CORR <PRX1_YAW_CORR>` allows adjusting for the forward direction of the lidar.  For example, if the lidar is facing forward this parameter can be left as 0.  If facing backwards it should be set to 180."
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:35
#: c0b44a4a04834714b90126b857ef7be0
msgid ":ref:`PRX1_IGN_ANG1 <PRX1_IGN_ANG1>` and :ref:`PRX1_IGN_WID1 <PRX1_IGN_WID1>` parameters allow defining zones around the vehicle that should be ignored.  For example to avoid a 20deg area to the right, set :ref:`PRX1_IGN_ANG1 <PRX1_IGN_ANG1>` to 90 and :ref:`PRX1_IGN_WID1 <PRX1_IGN_WID1>` to 20."
msgstr ""

#: ../../source/docs/common-lightware-sf45b.rst:37
#: 01270748741f4fa88181f8655f0d4cb4
msgid "More details on using this sensor for object avoidance on Copter can be found :ref:`here <common-object-avoidance-landing-page>`."
msgstr ""

