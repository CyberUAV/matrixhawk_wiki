#: ../../source/docs/common-brushed-motors.rst:5
#: 2a0953073dba460da127a4837599f11e
msgid "Brushed Motors"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:7
#: 88081f886d164233864262e1b64eabcb
msgid "ArduPilot supports multiple methods to control brushed motors"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:9
#: 47e09c6edd3f4fb5887c05711d91500f
msgid "Brushed motor ESCs that support RC PWM input (PWM signals that are 1ms to 2ms in width) are the easiest to use because no special configuration is required and the rest of this document can be ignored.  Most hobby grade RC Car ESCs are of this type"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:11
#: 98716597b0174c51a30ef6d6e2a342f3
msgid "\"Brushed\" motors accept a duty cycle to control the speed but only spin in one direction"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:16
#: e46e486e2a88437092a3a62d451887c5
msgid "Verified Motor Drivers"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:18
#: 4a8cef4e546c425b9a96a667f12ffb28
msgid "`Sabertooth Dual 32A Motor Driver  <https://www.dimensionengineering.com/products/sabertooth2x32>`__ supports \"Normal\" when the Sabertooth is in RC Mode"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:19
#: 86f1508554224f7b84ab2da9bae1bb59
msgid "`Pololu G2 High-Power Motor Driver <https://www.pololu.com/product/2991>`__ supports \"BrushedWithRelay\""
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:20
#: 5c1c774bfa6a45c59fe4782e7e56213b
msgid "`Pololu DRV8838 Motor Driver <https://www.pololu.com/product/2990>`__ supports \"BrushedWithRelay\""
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:21
#: b81ec916e8624076ae812303ded3b0fb
msgid "`RoboClaw 2x7A Motor Controller <https://www.pololu.com/product/3284>`__ supports \"Normal\" when the Roboclaw is in RC Mode"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:22
#: c2dba0553ff6484f89c7bd7c13885524
msgid "`L298N Motor Driver <https://www.amazon.com/s?k=l298n+motor+driver>`__ - see :ref:`configuration note below<l298n_note>`."
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:23
#: c50470dffc70400ca01bea37a838de10
msgid ":ref:`SkyRocket <copter:skyrocket>` drones use \"Brushed\" motors"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:26
#: 4b08d711e1c54bbb96c5b054c1d878f8
msgid "Connection and Configuration"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:28
#: f07f838ef9534c4c8ff17a7a3b815d87
msgid "Connect the motor drivers / ESCs to the autopilot's output pins just as you would for regular brushless ESCs but note the warning at the bottom regarding mixing brushed outputs with servos"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:31
#: 5cb37365faa94cee80054e010d2aeaae
msgid "Set :ref:`MOT_PWM_TYPE <MOT_PWM_TYPE>` = 3 for \"Brushed\" and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:32
#: 907926c176e44eb3a75d8be19eba946b
msgid "Set :ref:`RC_SPEED <RC_SPEED>` = 16000 to set the refresh rate to 16k (other values from 1000 to 20000 are possible)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:36
#: 0ec0ffe33b8e458f8ea2a4bb351cf4ed
msgid "in some ground control stations, attempting to set MOT_PWM_FREQ above its normal 50 to 490hz range will require the user to acknowledge this \"out of range\" setup in order to set the parameter. This is to prevent accidental misconfiguration for brushless ESCs."
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:41
#: 30d1ebb0747a449eb03ac6fc71870856
msgid "If the autopilot will also control servos (which use regular RC PWM) take care that the servos are not in the same \"PWM output group\" as any motor outputs.  The grouping is only documented on some of the :ref:`AutoPilot Hardware Options <common-autopilots>` pages but for a regular Pixhawk or Cube autopilot MAIN OUT 1 ~ 4 are in group1 meaning that if any brushed motors are configured for MAIN OUT 1 to 4 then servos must be connected to output 5 or higher"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:45
#: d68e79b9f4d546de84317888d5d0d715
msgid "ArduPilot does not currently support controlling both brushed and brushless **motors** at the same time"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:52
#: 2a4f8dd0a35147ab9c744707e2bf8e00
msgid "If using \"Brushed with Relay\" to control an L298N motor driver, two relay outputs are required for each motor, one of which must be inverted."
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:54
#: f922ce8ad9a647e39dcf00807ebac06a
msgid "Set the following servo parameters:"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:56
#: df7cbd20a75f4df9a38dc8a56dd48b40
msgid ":ref:`MOT_PWM_TYPE<MOT_PWM_TYPE>` = 3"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:57
#: c65b1ae1bc334d0a893bc98277ca28a8
msgid ":ref:`SERVO1_FUNCTION<SERVO1_FUNCTION>` = 73 (\"ThrottleLeft\" or 70 for \"Throttle\")"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:58
#: 3e257c6ea379460c8868547db0debcd0
msgid ":ref:`SERVO3_FUNCTION<SERVO3_FUNCTION>` = 74 (\"ThrottleRight\" or unused)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:60
#: bcc58709651c4a0fa440250bd202ac2d
msgid "Then configure the relays:"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:62
#: 780726e9940240b9853dd8495c7bfcd5
msgid ":ref:`RELAY1_FUNCTION<RELAY1_FUNCTION>` = 5 (connect to IN1)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:63
#: 0a52908bbc374b3ab4931fcb12ba5ad7
msgid ":ref:`RELAY1_PIN<RELAY1_PIN>` = 50 (Pixhawk/Cube AUX1)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:64
#: e5a7374f5053443c98bb71e72be91ecd
msgid ":ref:`RELAY2_FUNCTION<RELAY2_FUNCTION>` = 5 (connect to IN2)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:65
#: 2975ae3893d04646b1e1ddd1f6875bb2
msgid ":ref:`RELAY2_PIN<RELAY2_PIN>` = 51 (AUX2)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:66
#: 8e06c21d2fbb4fe88d5a6caf9034590c
msgid ":ref:`RELAY2_INVERTED<RELAY2_INVERTED>` = 1"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:68
#: c80bee5514bd49bca7731c2b927949a5
msgid "Additionally, if using \"ThrottleRight\" (74):"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:70
#: 659f274900af489e9b69a1137bd7f1ff
msgid ":ref:`RELAY3_FUNCTION<RELAY3_FUNCTION>` = 6 (connect to IN3)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:71
#: 8b9f2928c2754d588796c3bb2750a869
msgid ":ref:`RELAY3_PIN<RELAY3_PIN>` = 52 (AUX3)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:72
#: 9506b4d2d6f747ba98314c39dbce6fce
msgid ":ref:`RELAY4_FUNCTION<RELAY4_FUNCTION>` = 6 (connect to IN4)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:73
#: ae4f4f07e57e40fcac67223c39f7bc9b
msgid ":ref:`RELAY4_PIN<RELAY4_PIN>` = 53 (AUX4)"
msgstr ""

#: ../../source/docs/common-brushed-motors.rst:74
#: 974c4ad5fc714f9abca9060255d78cf6
msgid ":ref:`RELAY4_INVERTED<RELAY4_INVERTED>` = 1"
msgstr ""
