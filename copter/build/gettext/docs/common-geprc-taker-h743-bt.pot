#: 6fe4f615e25b40b29db99a82bf9a21e7
msgid "FPort requires connection to TX2 and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` be set to “7”."
msgstr ""

#: ../../source/docs/common-geprc-taker-h743-bt.rst:52
#: ec4b6772bd564c408d7b7966307a1845
msgid "CRSF also requires a TX2 connection, in addition to R2, and automatically provides telemetry. Set :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>`"
