#: ../../source/docs/common-cuav-v5nano-overview.rst:127
#: 9eb96f9da931466f8783c322891283a9
msgid "CRSF requires a full UART connection, so should be connected to TELEM1(USART2) or TELEM2(USART3). Set the appropriate SERIAL1 or SERIAL2 options to 0."
msgstr ""

#: ../../source/docs/common-cuav-v5nano-overview.rst:130
#: 7061c2218433419e812b6f5848a8b1da
