msgstr ""

#: ../../source/docs/precision-landing-irlock.rst:107
#: 9921650dd6fa458e851eede952732ce9
msgid "Setup the vehicle with one of the flight modes set to Land (as of the time this wiki page was written, the precision landing function only operates in Land mode)."
msgstr ""

#: ../../source/docs/precision-landing-irlock.rst:111
#: 16f72a9ac3034516b28c62a55a4b3a68
msgid "Place the IR beacon on the ground and take-off to approximately 10m above the target. Switch the vehicle to Land. If everything is working properly, the copter should move toward the IR beacon. A successful demo is shown below (using an older firmware)."
msgstr ""

#: ../../source/docs/precision-landing-irlock.rst:118
#: a1ced75b398448908cdc5c3a9e4695a3
msgid "Be prepared to retake control if there are sudden unexpected movements (Change mode to Stabilize, AltHold or Loiter)."
msgstr ""

#: ../../source/docs/precision-landing-irlock.rst:121
#: 2ca073ff2caa48859d4bb90a97a4a5b2
msgid "If the vehicle does behave appropriately, download the dataflash logs and examine the PL messages."
msgstr ""

#: ../../source/docs/precision-landing-irlock.rst:124
#: fd656385170c4b429e0a325aa5f47f01
msgid "If the \"Heal\" (meaning health) field is not \"1\" then there may be a communication issue between the autopilot and IR-LOCK sensor."
msgstr ""

#: ../../source/docs/precision-landing-irlock.rst:125
#: 5369e2ad45574e1abeaf7d6ab9dc9140
msgid "If the \"TAcq\" (meaning Target Acquired) field is not \"1\" then the sensor is not seeing the target."
msgstr ""

#: ../../source/docs/precision-landing-irlock.rst:126
#: 953013bdd570422b972cdfd86f62fa73
