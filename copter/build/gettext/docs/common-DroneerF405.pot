#: a0b439adbb76480a83f93acb8efd3c3a
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:53
#: dc4c8d3ba47d44c18ff6969e5c4bf4ae
msgid "The SBUS pin (SBU), is passed by an inverter to RX2 (UART2 RX), which can be used for all ArduPilot supported receiver protocols, except PPM, CRSF/ELRS, and SRXL2. CRSF/ELRS and SRXL2 require the RX2 and TX2s pin be connected instead of the SBUS pin."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:55
#: 80fcc196b913460fafd165401cfbc3da
msgid "SRXL2 requires :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` be set to “4”."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:56
#: 5ee3f6583e994d80beee6d1d61fbde7a
msgid "Fport should be connected to TX2 via a bi-directional inverter and :ref:`SERIAL2_OPTIONS<SERIAL2_OPTIONS>` be set to “4”. See :ref:`common-connecting-sport-fport`."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:58
#: 68e24a709d624d4dad3df24badeb9964
msgid "Any UART can also be used for RC system connections in ArduPilot and is compatible with all protocols except PPM (SBUS requires external inversion on other UARTs). See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:61
#: fcdd46618a01410380eb48bd4c5aa622
msgid "FrSky Telemetry"
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:62
#: ba702b230030426c89583fe0018d5fe8
msgid "FrSky Telemetry is supported using the Tx pin of any UART. You need to set the following parameters to enable support for FrSky S.PORT (example shows SERIAL3)."
msgstr ""

#: ../../source/docs/common-DroneerF405.rst:65
#: 6cb373dcea424ca6a3e72ccac1eb3d7a
msgid ":ref:`SERIAL3_PROTOCOL<SERIAL3_PROTOCOL>` = 10"
msgstr ""

