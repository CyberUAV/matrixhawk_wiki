#: 25b1a001c05141f39a7a477c1a339595
msgid "Copter 3.4.x"
msgstr ""

#: ../../source/docs/archived-tricopter.rst:8
#: f016ebaf72b047f3aa8c879d6bc216b1
msgid ":ref:`MOT_YAW_SV_ANGLE <MOT_YAW_SV_ANGLE>`: tail servo's maximum lean angle in degrees.  This allows for the rear motor's thrust to be adjusted appropriately depending upon the lean angle.  The default is 30 degrees.  \"0\" would mean the tail servo can only point directly up (which would not allow the vehicle to fly), \"90\" means the tail servo can point horizontally."
msgstr ""

#: ../../source/docs/archived-tricopter.rst:10
#: 7034a8bd45e4407e82fb6ecae90243eb
msgid "The channel used for the tail servo can be changed from its default (channel 7) by setting the appropriate SERVOx_FUNCTION to 39.  For example the :ref:`Pixracer <common-pixracer-overview>` only has 6 output channels so the tail servo can be moved to output channel 5 by setting :ref:`SERVO5_FUNCTION <SERVO5_FUNCTION>` to 39."
msgstr ""

#: ../../source/docs/archived-tricopter.rst:12
#: fd181562dfc641c9b3c836e1921e0197
msgid "See Copter 3.3 section below for more parameters that can be adjusted."
msgstr ""

#: ../../source/docs/archived-tricopter.rst:15
#: f9e69a26d4bc44b38c985c1dda6e58c5
msgid "Copter 3.3.x"
msgstr ""

#: ../../source/docs/archived-tricopter.rst:17
#: 8c6cc43db7334420ad636e8da43f0d6b
msgid "``MOT_YAW_SV_MIN <MOT_YAW_SV_MIN>``: tail servo's lowest PWM value before binding occurs."
msgstr ""

#: ../../source/docs/archived-tricopter.rst:18
#: 9b93340c961c484c8ad5b59e042b1e21
msgid "``MOT_YAW_SV_MAX <MOT_YAW_SV_MAX>``: tail servo's highest PWM value before binding occurs."
msgstr ""

#: ../../source/docs/archived-tricopter.rst:19
#: 66688dd1b8ec439e8347099c38830ebb
msgid "``MOT_YAW_SV_TRIM <MOT_YAW_SV_TRIM>``: tail servo's PWM value close to what is required to keep the tail from spinning."
msgstr ""

#: ../../source/docs/archived-tricopter.rst:20
#: 6355fb05fc3248f3abf6995e51e586b8
msgid "``MOT_YAW_SV_REV <MOT_YAW_SV_REV>``: tail servo's reverse setting.  +1 = servo moves in default direction, -1 to reverse direction of movement."
msgstr ""

#: ../../source/docs/archived-tricopter.rst:23
#: 55a168c989584e2a8a43217f2ff0b4b2
msgid "Copter 3.2.1 (and earlier)"
msgstr ""

#: ../../source/docs/archived-tricopter.rst:25
