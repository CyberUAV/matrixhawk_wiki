#: ../../source/docs/common-brotherhobbyf405v3.rst:81
#: 881686e6707e4695927eee5b8692ecfb
msgid "PWM 3-4  in group2"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:82
#: 910cdf3f132b4431b3db099e49adbc45
msgid "PWM 5-6  in group3"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:83
#: d5ca50d6da044fa986b9725865af8b6b
msgid "PWM 7-8  in group4"
msgstr ""

#: ../../source/docs/common-brotherhobbyf405v3.rst:84
#: 1de901b7a1e04538b974496d59c02ecd
msgid "PWM 9    in group5 (LED pad)"
msgstr ""

