#: ../../source/docs/common-ark-fpv.rst:398
#: 10c7c27a9088448f889a920a9acc4ce6
msgid "Using the Debug Port as a Serial Port"
msgstr ""

#: ../../source/docs/common-ark-fpv.rst:399
#: c8e1a756aefa4fbf89a1b999b9bba8f9
msgid "The debug connector includes USART3, which is configured as a debug console by default. To use it as a regular serial port (SERIAL8), modify `hwdef.dat <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_HAL_ChibiOS/hwdef/ARK_FPV/hwdef.dat>`_ to add USART3 to the end of the SERIAL_ORDER list:"
msgstr ""

