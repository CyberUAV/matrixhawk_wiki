#: 12e32fb457bd439796f698dade7182ef
msgid "SERIAL_ORDER OTG1 UART7 UART5 USART1 USART2 UART4 USART6 OTG2 USART3"
msgstr ""

#: ../../source/docs/common-ark-fpv.rst:403
#: 8aa7b8530caa4e1aae6504e1770d23c0
msgid "And remove the debug console lines:"
msgstr ""

#: ../../source/docs/common-ark-fpv.rst:405
#: c6c858f3ab0c493a8edfdebbbd3f4118
