#: 13208a42d21d4924adb36f6afc759a5f
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 37"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:90
#: 11e7d1032aa54f74ae1eafea5273d354
msgid "Compass"
msgstr ""

#: ../../source/docs/common-brahmaf4.rst:91
#: 33facf386e5a4ebfb948b34920fcfcfb
msgid "The autopilot does not have a built-in compass, however you can attach an external compass using I2C on the SDA and SCL pads."
