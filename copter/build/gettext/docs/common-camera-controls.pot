#: 5f163cb966b041aea22f622dd36ffc16
msgid "set :ref:`RC6_OPTION <RC6_OPTION>` = 9 (\"Camera Trigger\") to take a picture"
msgstr ""

#: ../../source/docs/common-camera-controls.rst:36
#: 16590698e0fe40adb0e424b367d81611
msgid "set :ref:`RC7_OPTION <RC7_OPTION>` = 166 (\"Camera Record Video\") to start/stop recording video"
msgstr ""

#: ../../source/docs/common-camera-controls.rst:37
#: b74dc8b915704e92b78383a4a24a39b7
msgid "set :ref:`RC8_OPTION <RC8_OPTION>` = 167 (\"Camera Zoom\") to zoom in or out"
msgstr ""

#: ../../source/docs/common-camera-controls.rst:38
#: ffaf71e70f15462aa95f0860bd944281
msgid "set :ref:`RC9_OPTION <RC9_OPTION>` = 168 (\"Manual Focus\") to focus in or out"
msgstr ""

#: ../../source/docs/common-camera-controls.rst:39
#: 603418d9427c44b7a21383f006ae54e6
msgid "set :ref:`RC10_OPTION <RC10_OPTION>` = 169 (\"Auto Focus\") to auto focus"
msgstr ""

