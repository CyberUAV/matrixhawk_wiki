#: ../../source/docs/common-rangefinder-sf02.rst:5
#: 74c7333f8d624360a34bf8d13ca3d026
msgid "Lightware SF02 Rangefinder"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:7
#: b0e88c3b1a2d4306adfe5db41fe8a581
msgid "The `Lightware SF02 <http://documents.lightware.co.za/SF02%20-%20Laser%20Rangefinder%20Manual%20-%20Rev%2012.pdf>`__ is lightweight laser rangefinder module that provides fast and accurate distance measurements up to 40 meters (130 feet). In `tests by the development team <https://diydrones.com/profiles/blogs/testing-laser-rangefinders-with-arduplane>`__ the sensor has produced very reliable distance measurements for long and short ranges even on fast moving vehicles."
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:15
#: c63784c0f51c46838072b515cda1db37
msgid "Connecting to the Pixhawk"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:17
#: 50d8a7ca2d7a486cafd9ab56343820bf
msgid "The SF02's Analog Out pin should be connected to the Pixhawk's 3.3V ADC (analog to digital converter) as shown below.  The Pixhawk will provide the regulated 5V power supply the sensor requires."
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:25
#: b8cee00acc004badb2386cecf1f46ed0
msgid "Setup through the mission planner"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:27
#: 98fdd0935eee45a7a1bdcb909303f42b
msgid "To configure Copter, Plane or Rover to use the LIDAR-Lite, please first connect with the Mission Planner and then open the Config/Tuning >> Full Parameter List page and set:"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:31
#: 0ff83a01fb27442b87c41d27bd791acd
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 37 (i.e. 40m max range - 3m buffer.  This buffer is required so the flight code can detect when there is nothing in range)"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:32
#: 61b66b15b3a34793a80b644059e6a3c5
msgid ":ref:`RNGFND1_PIN <RNGFND1_PIN>` = \"14\" (2nd pin of 3.3V ADC connector)"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:33
#: 74b65cc80e1b4480887db13c6f9aa1fc
msgid ":ref:`RNGFND1_SCALING <RNGFND1_SCALING>` = \"12.12\" (ie. 40m / 3.3v = 12.12) **"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:34
#: 8897908d774b444ebb3372ea4c58f863
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = “1\" (Analog)"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:35
#: 32bdaa8539ef400d8c767ce095a2febd
msgid ":ref:`RNGFND1_RMETRIC <RNGFND1_RMETRIC>` = \"0\" (non-ratiometric, shown incorrectly in the diagram below)"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:38
#: cb442428fe2d47959e01cc039d0d740e
msgid "** The default range for an SF02 is 33m / 3.3V = 10 m/V"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:44
#: f9c151fc160947b9b550950b74d62088
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-rangefinder-sf02.rst:46
#: 444160b689564abc9e9dd277e244720e
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look closely for \"rangefinder1\"."
msgstr ""
