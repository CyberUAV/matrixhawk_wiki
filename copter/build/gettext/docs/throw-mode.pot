#: ../../source/docs/throw-mode.rst:5
#: 0730145dab064db791c7e28b84c17d85
msgid "Throw Mode"
msgstr ""

#: ../../source/docs/throw-mode.rst:7
#: ef4b2500fca34d558ec9e9c6bae4d753
msgid "This slightly dangerous flight mode allows the pilot to throw the vehicle into the air (or drop the vehicle) in order to start the motors. Once in the air, this mode does not accept any input from the pilot.  This mode requires valid position information (GPS, Optical Flow, Beacon,etc.)."
msgstr ""

#: ../../source/docs/throw-mode.rst:12
#: 371bba41b31e4815be92748b6442b6ad
msgid "This flight mode is available for multirotors only."
msgstr ""

#: ../../source/docs/throw-mode.rst:16
#: 39e5c6efba804c1abcb343ba54a88c96
msgid "Use with caution!  It is dangerous to get close to an armed multicopter as is required to throw the vehicle.  It is recommended to takeoff normally instead of using throw mode whenever possible."
msgstr ""

#: ../../source/docs/throw-mode.rst:22
#: d1dce9a2a976480294dfc9dc2a674969
msgid "How To Use"
msgstr ""

#: ../../source/docs/throw-mode.rst:24
#: e52fa8e605bb47eea9a4b1a60cf06c7b
msgid "Disarm copter"
msgstr ""

#: ../../source/docs/throw-mode.rst:25
#: 497de701a20949c6af468b36d90482e7
msgid "Switch to throw mode"
msgstr ""

#: ../../source/docs/throw-mode.rst:26
#: 15b780a841b14e58a9117a77deb2af13
msgid "Check GPS light is green"
msgstr ""

#: ../../source/docs/throw-mode.rst:27
#: 619d9eb02ef541b7945d63d408869a59
msgid "Arm copter and listen for ready tune (if vehicle has a buzzer).  The motors will not spin by default."
msgstr ""

#: ../../source/docs/throw-mode.rst:28
#: ff7cdad6bdbf4d0d8f39a47fcb3036dc
msgid "Pick up the vehicle and throw it up and away from you (it must climb by 50cm/s and reach a total speed of 5m/s)"
msgstr ""

#: ../../source/docs/throw-mode.rst:29
#: 67ff062e783647e79056305c8f45d090
msgid "Once the vehicle has stopped, switch the flight mode to Loiter (or other mode) to retake manual control"
msgstr ""

#: ../../source/docs/throw-mode.rst:31
#: 3ed8290de2be48d7b69c697ecf50cf84
msgid "The motors should start when the vehicle reaches the apex of it's trajectory. After the motors start this flight mode will first try to control it's attitude (return to level and stop rotating), then stop descending and finally it will attempt to stop moving horizontally."
msgstr ""

#: ../../source/docs/throw-mode.rst:35
#: 623494cdcf3d4f1ba8c94b6300a13600
msgid "Settings"
msgstr ""

#: ../../source/docs/throw-mode.rst:36
#: bdb86d41a11d4318912c7e59ffa71d67
msgid ":ref:`THROW_TYPE <THROW_TYPE>`: set to 0 if throwing the vehicle up, 1 if dropping the vehicle.  If dropping, drop from a height of at least 10m."
msgstr ""

#: ../../source/docs/throw-mode.rst:37
#: fff25784843f4270bf11470dde6ec2c0
msgid ":ref:`THROW_MOT_START <THROW_MOT_START>`: controls whether the motors will spin slowly or not at all while waiting for the throw (0 = stopped, 1 = spinning slowly).  The default is 0 (will not spin after arming)."
msgstr ""

#: ../../source/docs/throw-mode.rst:38
#: 006ff36879df4a3cb1990ef62f389853
msgid ":ref:`THROW_NEXTMODE <THROW_NEXTMODE>`: the vehicle will switch into this flight mode after stopping (Auto, Guided, RTL, Land and Brake are support).  Set to \"Throw\" (the default) to simply remain in Throw mode and wait for the pilot to switch modes manually"
msgstr ""

#: ../../source/docs/throw-mode.rst:39
#: 5dbf9e6764a14e8a92b1b17b4d662a51
msgid ":ref:`THROW_ALT_MIN<THROW_ALT_MIN>` and :ref:`THROW_ALT_MAX<THROW_ALT_MAX>`: set the altitude limits for THROW mode launch. Throw must happen above the minimum and below the maximum altitude above home after arming. Useful for plane or balloon drop launches, allowing arming on ground to establish home altitude, then rising in secondary release vehicle and dropping to launch."
msgstr ""

#: ../../source/docs/throw-mode.rst:45
#: ee6da04d79104f819a8e63c7ef2b89df
msgid "Log Analysis"
msgstr ""

#: ../../source/docs/throw-mode.rst:46
#: f76c47d7877b422da9a435bf72e6bd18
msgid "During the throw, THRO messages are written to the :ref:`dataflash log <common-downloading-and-analyzing-data-logs-in-mission-planner>`.  These can be useful in diagnosing problems in case the motors failed to start as part of a throw.  The graph below shows a successful throw in which the overall velocity climbs above 5m/s and the vertical velocity is over 0.5m/s."
msgstr ""
