msgstr ""

#: ../../source/docs/parameters.rst:3534
#: f6587746e85644808cec62a99c5ea5b4
msgid "Waypoint number to navigate to on GPS lock loss"
msgstr ""

#: ../../source/docs/parameters.rst:3540
#: 471b85fe298141dba562a3139863e0b0
msgid "AFS\\_TERMINATE: Force Terminate"
msgstr ""

#: ../../source/docs/parameters.rst:3544
#: 1dbaece352174660aa20f5c389473acd
msgid "Can be set in flight to force termination of the heartbeat signal"
msgstr ""

#: ../../source/docs/parameters.rst:3550
#: 8a80fd63e19a4f7f9b7523562da2a042
msgid "AFS\\_TERM\\_ACTION: Terminate action"
msgstr ""

#: ../../source/docs/parameters.rst:3554
#: c38616d3534a477c87918c43d2923a74
msgid "This can be used to force an action on flight termination\\. Normally this is handled by an external failsafe board\\, but you can setup ArduPilot to handle it here\\. Please consult the wiki for more information on the possible values of the parameter"
msgstr ""

#: ../../source/docs/parameters.rst:3560
#: ddbe0c914df34925b24388365bd805d7
msgid "AFS\\_TERM\\_PIN: Terminate Pin"
msgstr ""

#: ../../source/docs/parameters.rst:3564
#: 2ec8b7f524294c9a9ccc4480288daac2
msgid "This sets a digital output pin to set high on flight termination\\. Some common values are given\\, but see the Wiki\\'s \\\"GPIOs\\\" page for how to determine the pin number for a given autopilot\\."
msgstr ""

#: ../../source/docs/parameters.rst:3604
#: 5b8b17e26eee4eb293f21db728e6a348
msgid "AFS\\_AMSL\\_LIMIT: AMSL limit"
msgstr ""

#: ../../source/docs/parameters.rst:3608
#: b921e99b37e54faf93973f7ea9d0ed78
msgid "This sets the AMSL \\(above mean sea level\\) altitude limit\\. If the pressure altitude determined by QNH exceeds this limit then flight termination will be forced\\. Note that this limit is in meters\\, whereas pressure altitude limits are often quoted in feet\\. A value of zero disables the pressure altitude limit\\."
msgstr ""

#: ../../source/docs/parameters.rst:3623
#: a350ba51e1844a7e8b52298d641cd9f8
msgid "AFS\\_AMSL\\_ERR\\_GPS: Error margin for GPS based AMSL limit"
msgstr ""

#: ../../source/docs/parameters.rst:3627
#: 8aa3b7a53eaf486ebed008c4c5924675
msgid "This sets margin for error in GPS derived altitude limit\\. This error margin is only used if the barometer has failed\\. If the barometer fails then the GPS will be used to enforce the AMSL\\_LIMIT\\, but this margin will be subtracted from the AMSL\\_LIMIT first\\, to ensure that even with the given amount of GPS altitude error the pressure altitude is not breached\\. OBC users should set this to comply with their D2 safety case\\. A value of \\-1 will mean that barometer failure will lead to immediate termination\\."
msgstr ""

#: ../../source/docs/parameters.rst:3642
#: c2eab9f78b564707af16cb1fed6e7aa4
msgid "AFS\\_QNH\\_PRESSURE: QNH pressure"
msgstr ""

#: ../../source/docs/parameters.rst:3646
#: 70a31752c4fc435d89e6efc7bd40fbc7
msgid "This sets the QNH pressure in millibars to be used for pressure altitude in the altitude limit\\. A value of zero disables the altitude limit\\."
msgstr ""

#: ../../source/docs/parameters.rst:3652
#: d259336ef2c64b188b4f820903a3a2b5
msgid "hectopascal"
msgstr ""

#: ../../source/docs/parameters.rst:3661
#: f322cf4bcdd044b4a40493e15d9b3833
msgid "AFS\\_MAX\\_GPS\\_LOSS: Maximum number of GPS loss events"
msgstr ""

#: ../../source/docs/parameters.rst:3665
#: 75be4e62d7df42bfb2bc377944b7b780
msgid "Maximum number of GPS loss events before the aircraft stops returning to mission on GPS recovery\\. Use zero to allow for any number of GPS loss events\\."
msgstr ""

#: ../../source/docs/parameters.rst:3671
#: 03a80bc8841841b6bfa8bd3e03898a3d
msgid "AFS\\_MAX\\_COM\\_LOSS: Maximum number of comms loss events"
msgstr ""

#: ../../source/docs/parameters.rst:3675
#: 857cef0579a94fe2a480f30fbe7d73b9
msgid "Maximum number of comms loss events before the aircraft stops returning to mission on comms recovery\\. Use zero to allow for any number of comms loss events\\."
msgstr ""

#: ../../source/docs/parameters.rst:3681
#: 905498c3406d419cac860eb616da56da
msgid "AFS\\_GEOFENCE: Enable geofence Advanced Failsafe"
msgstr ""

#: ../../source/docs/parameters.rst:3685
#: ea09105bf9e14328984d7423cd24e05b
msgid "This enables the geofence part of the AFS\\. Will only be in effect if AFS\\_ENABLE is also 1"
msgstr ""

#: ../../source/docs/parameters.rst:3691
#: 6b1e6637b54746e4a9455877d97a4fca
msgid "AFS\\_RC: Enable RC Advanced Failsafe"
msgstr ""

#: ../../source/docs/parameters.rst:3695
#: fdf17150fa054ada8e7e0995ca62018f
msgid "This enables the RC part of the AFS\\. Will only be in effect if AFS\\_ENABLE is also 1"
msgstr ""

#: ../../source/docs/parameters.rst:3701
#: 3a36a2ba88094f069c9ce8b15b925795
msgid "AFS\\_RC\\_MAN\\_ONLY: Enable RC Termination only in manual control modes"
msgstr ""

#: ../../source/docs/parameters.rst:3705
#: 6bf9b2d6e69b480db1e159afcac650c0
msgid "If this parameter is set to 1\\, then an RC loss will only cause the plane to terminate in manual control modes\\. If it is 0\\, then the plane will terminate in any flight mode\\."
msgstr ""

#: ../../source/docs/parameters.rst:3711
#: 6cdeb1188af3426ba6cbe0489ba60386
msgid "AFS\\_DUAL\\_LOSS: Enable dual loss terminate due to failure of both GCS and GPS simultaneously"
msgstr ""

#: ../../source/docs/parameters.rst:3715
#: 83a873725c334c40a8492c8ca87f2e7d
msgid "This enables the dual loss termination part of the AFS system\\. If this parameter is 1 and both GPS and the ground control station fail simultaneously\\, this will be considered a \\\"dual loss\\\" and cause termination\\."
msgstr ""

#: ../../source/docs/parameters.rst:3721
#: 30c783c05ca64a3fb50a9eb6f0b328f4
msgid "AFS\\_RC\\_FAIL\\_TIME: RC failure time"
msgstr ""

#: ../../source/docs/parameters.rst:3725
#: 6a5288c3028c40c694ec31a18207ccf1
msgid "This is the time in seconds in manual mode that failsafe termination will activate if RC input is lost\\. For the OBC rules this should be \\(1\\.5\\)\\. Use 0 to disable\\."
msgstr ""

#: ../../source/docs/parameters.rst:3740
#: c5600a7263994318af190417d222d70b
msgid "AFS\\_MAX\\_RANGE: Max allowed range"
msgstr ""

#: ../../source/docs/parameters.rst:3744
#: 1b47aa78d79445cc975e53b1a5c48197
msgid "This is the maximum range of the vehicle in kilometers from first arming\\. If the vehicle goes beyond this range then the TERM\\_ACTION is performed\\. A value of zero disables this feature\\."
msgstr ""

#: ../../source/docs/parameters.rst:3750
#: ../../source/docs/parameters.rst:90183
#: de052d70c8554f34ba604ec3c9c6dd9b
#: 0332539edc5d4f53831104581967b77b
msgid "kilometers"
msgstr ""

#: ../../source/docs/parameters.rst:3759
#: 0b541e70d1af4c1ba85cfcee871849ec
msgid "AFS\\_OPTIONS: AFS options"
msgstr ""

#: ../../source/docs/parameters.rst:3762
#: 806dad7f23e14337bf0f601e39004189
msgid "See description for each bitmask bit description"
msgstr ""

#: ../../source/docs/parameters.rst:3771
#: fb45248c433e4b5eb1c0beb4e78228cc
msgid "Continue the mission even after comms are recovered (does not go to the mission item at the time comms were lost)"
msgstr ""

#: ../../source/docs/parameters.rst:3773
#: 99c675db29254a2bb40a271233f878e1
msgid "Enable AFS for all autonomous modes (not just AUTO)"
msgstr ""

#: ../../source/docs/parameters.rst:3775
#: 75f7b99e7dc44472ba8be03722e8de61
msgid "Option to not jump to AFS_WP_COMMS if already in the return path"
msgstr ""

#: ../../source/docs/parameters.rst:3786
#: 23d41bc0222c4e419db42901d9d6b42b
msgid "AFS\\_GCS\\_TIMEOUT: GCS timeout"
msgstr ""

#: ../../source/docs/parameters.rst:3790
#: 451f709a5b0a41ab96712f6ebe357b8e
msgid "The time \\(in seconds\\) of persistent data link loss before GCS failsafe occurs\\."
msgstr ""

#: ../../source/docs/parameters.rst:3806
#: 6bd1aa680943409eb545321ef390ff90
msgid "AHRS\\_ Parameters"
msgstr ""

#: ../../source/docs/parameters.rst:3812
#: ecf0ca86e690491eb2068a5534dc6135
msgid "AHRS\\_GPS\\_GAIN: AHRS GPS gain"
msgstr ""

#: ../../source/docs/parameters.rst:3816
#: 955b0a791a1a4ce29a058c1908114f69
msgid "This controls how much to use the GPS to correct the attitude\\. This should never be set to zero for a plane as it would result in the plane losing control in turns\\. For a plane please use the default value of 1\\.0\\."
msgstr ""

#: ../../source/docs/parameters.rst:3831
#: 3c0f2fed2c1f4d8694818b50b3708f02
msgid "AHRS\\_GPS\\_USE: AHRS use GPS for DCM navigation and position\\-down"
msgstr ""

#: ../../source/docs/parameters.rst:3835
#: c7f27617d6ea4e7f85798770c600031b
msgid "This controls whether to use dead\\-reckoning or GPS based navigation\\. If set to 0 then the GPS won\\'t be used for navigation\\, and only dead reckoning will be used\\. A value of zero should never be used for normal flight\\. Currently this affects only the DCM\\-based AHRS\\: the EKF uses GPS according to its own parameters\\. A value of 2 means to use GPS for height as well as position \\- both in DCM estimation and when determining altitude\\-above\\-home\\."
msgstr ""

#: ../../source/docs/parameters.rst:3846
#: 3284921dafc347759d1de868b46a085b
msgid "Use GPS for DCM position"
msgstr ""

#: ../../source/docs/parameters.rst:3848
#: 33d57e5caaf34e48b51e9650d411483c
msgid "Use GPS for DCM position and height"
msgstr ""

#: ../../source/docs/parameters.rst:3859
#: bef0f5d36b9a4e6381829a3c23a5da2f
msgid "AHRS\\_YAW\\_P: Yaw P"
msgstr ""

#: ../../source/docs/parameters.rst:3863
#: b4930db99e8b4c79a405d7e065ca8cc2
msgid "This controls the weight the compass or GPS has on the heading\\. A higher value means the heading will track the yaw source \\(GPS or compass\\) more rapidly\\."
msgstr ""

#: ../../source/docs/parameters.rst:3869
#: ../../source/docs/parameters.rst:3888
#: e2dfdf506a9646c78b319e1be43536d3
#: 73375a65b9ea44d6af19484d2850be30
msgid "0.1 to 0.4"
msgstr ""

#: ../../source/docs/parameters.rst:3878
#: 8d69a05f76794f089aca9b48be76db1f
msgid "AHRS\\_RP\\_P: AHRS RP\\_P"
msgstr ""

#: ../../source/docs/parameters.rst:3882
#: 88aaf31f0708401ea0a47ef76187a1a8
msgid "This controls how fast the accelerometers correct the attitude"
msgstr ""

#: ../../source/docs/parameters.rst:3897
#: c375215dc6ea49b59c168336b46c73a9
msgid "AHRS\\_WIND\\_MAX: Maximum wind"
msgstr ""

#: ../../source/docs/parameters.rst:3901
#: deeb0636d797491982f2820f5112ca92
msgid "This sets the maximum allowable difference between ground speed and airspeed\\. A value of zero means to use the airspeed as is\\. This allows the plane to cope with a failing airspeed sensor by clipping it to groundspeed plus\\/minus this limit\\. See ARSPD\\_OPTIONS and ARSPD\\_WIND\\_MAX to disable airspeed sensors\\."
msgstr ""

#: ../../source/docs/parameters.rst:3916
#: 365fef1a9f1f471a944724584b7c1123
msgid "AHRS\\_TRIM\\_X: AHRS Trim Roll"
msgstr ""

#: ../../source/docs/parameters.rst:3919
#: 5aa81037349c4780896836633c75f622
msgid "Compensates for the roll angle difference between the control board and the frame\\. Positive values make the vehicle roll right\\."
msgstr ""

