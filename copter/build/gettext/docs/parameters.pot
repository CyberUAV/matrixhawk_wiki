#: b73f72e478774fd5bc3f403d00d37781
msgid "Block"
msgstr ""

#: ../../source/docs/parameters.rst:55854
#: cde15f27b32f4fe6a408b2b393951586
msgid "LOG\\_FILE\\_BUFSIZE: Logging File and Block Backend buffer size max \\(in kibibytes\\)"
msgstr ""

#: ../../source/docs/parameters.rst:55857
#: eba8c18b6fa54f5dadabcbe8038345f3
msgid "The File and Block backends use a buffer to store data before writing to the block device\\.  Raising this value may reduce \\\"gaps\\\" in your SD card logging but increases memory usage\\.  This buffer size may be reduced to free up available memory"
msgstr ""

#: ../../source/docs/parameters.rst:55863
#: 4a32a7c047134ac282bc2e902a801dca
msgid "4 to 200"
msgstr ""

#: ../../source/docs/parameters.rst:55863
#: 7c8ebf9cba984b9a98597516e24c662a
msgid "kibibytes"
msgstr ""

#: ../../source/docs/parameters.rst:55872
#: 41930c1b93ab47fdbd8751ec4ebd2732
msgid "LOG\\_DISARMED: Enable logging while disarmed"
msgstr ""

#: ../../source/docs/parameters.rst:55875
#: 09d2ceb77b7e41c3a0d1153933ae8c15
msgid "If LOG\\_DISARMED is set to 1 then logging will be enabled at all times including when disarmed\\. Logging before arming can make for very large logfiles but can help a lot when tracking down startup issues and is necessary if logging of EKF replay data is selected via the LOG\\_REPLAY parameter\\. If LOG\\_DISARMED is set to 2\\, then logging will be enabled when disarmed\\, but not if a USB connection is detected\\. This can be used to prevent unwanted data logs being generated when the vehicle is connected via USB for log downloading or parameter changes\\. If LOG\\_DISARMED is set to 3 then logging will happen while disarmed\\, but if the vehicle never arms then the logs using the filesystem backend will be discarded on the next boot\\."
msgstr ""

#: ../../source/docs/parameters.rst:55888
#: d9961f89cd81486983ee7562518b7eff
msgid "Disabled on USB connection"
msgstr ""

#: ../../source/docs/parameters.rst:55890
#: 0f3b5ad55073446d8a1dd5916456e07f
msgid "Discard log on reboot if never armed"
msgstr ""

#: ../../source/docs/parameters.rst:55901
#: 621288bf15534280a285989e055da3e0
msgid "LOG\\_REPLAY: Enable logging of information needed for Replay"
msgstr ""

#: ../../source/docs/parameters.rst:55904
#: 10f5f866d98941979945e9b1ec5642d8
msgid "If LOG\\_REPLAY is set to 1 then the EKF2 and EKF3 state estimators will log detailed information needed for diagnosing problems with the Kalman filter\\. LOG\\_DISARMED must be set to 1 or 2 or else the log will not contain the pre\\-flight data required for replay testing of the EKF\\'s\\. It is suggested that you also raise LOG\\_FILE\\_BUFSIZE to give more buffer space for logging and use a high quality microSD card to ensure no sensor data is lost\\."
msgstr ""

#: ../../source/docs/parameters.rst:55926
#: 82d8b85c83ea4427984d2ddfae2af07b
msgid "LOG\\_FILE\\_DSRMROT: Stop logging to current file on disarm"
msgstr ""

#: ../../source/docs/parameters.rst:55929
#: 308b857dd47f4eae967baa000f56a4fb
msgid "When set\\, the current log file is closed when the vehicle is disarmed\\.  If LOG\\_DISARMED is set then a fresh log will be opened\\. Applies to the File and Block logging backends\\."
msgstr ""

#: ../../source/docs/parameters.rst:55951
#: 2bfad23822a548d2a696478fde0c7cc9
msgid "LOG\\_MAV\\_BUFSIZE: Maximum AP\\_Logger MAVLink Backend buffer size"
msgstr ""

#: ../../source/docs/parameters.rst:55955
#: 824b13b5efe34cf5937303c458986939
msgid "Maximum amount of memory to allocate to AP\\_Logger\\-over\\-mavlink"
msgstr ""

#: ../../source/docs/parameters.rst:55961
#: 67eb3ea2206848a09344fadfba633ea7
msgid "kilobytes"
msgstr ""

#: ../../source/docs/parameters.rst:55970
#: c3ad3542701749dea8a4a8383dc7d9df
msgid "LOG\\_FILE\\_TIMEOUT: Timeout before giving up on file writes"
msgstr ""

#: ../../source/docs/parameters.rst:55973
#: 70ccac54cd7d4ab08b0d204723de41a6
msgid "This controls the amount of time before failing writes to a log file cause the file to be closed and logging stopped\\."
msgstr ""

#: ../../source/docs/parameters.rst:55988
#: 0169854d503643ccaa9efdd9ad7a2131
msgid "LOG\\_FILE\\_MB\\_FREE: Old logs on the SD card will be deleted to maintain this amount of free space"
msgstr ""

#: ../../source/docs/parameters.rst:55991
#: 87dae2c7cc3842f49c5b9c642a98dc5d
msgid "Set this such that the free space is larger than your largest typical flight log"
msgstr ""

#: ../../source/docs/parameters.rst:55997
#: 854c9503a91b4a9c812d7ed283fc5630
msgid "2 to 1000"
msgstr ""

#: ../../source/docs/parameters.rst:55997
#: 9a6fa8de09da4832a8f022dc081599b3
msgid "megabyte"
msgstr ""

#: ../../source/docs/parameters.rst:56006
