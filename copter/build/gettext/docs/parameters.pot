#: ../../source/docs/parameters.rst:135892
#: 8481055e2bb543079e6a0b56ba5690c2
msgid "TERRAIN\\_ENABLE: Terrain data enable"
msgstr ""

#: ../../source/docs/parameters.rst:135896
#: 8ec74dca3acf4b2e8d89ef7f25ead47e
msgid "enable terrain data\\. This enables the vehicle storing a database of terrain data on the SD card\\. The terrain data is requested from the ground station as needed\\, and stored for later use on the SD card\\. To be useful the ground station must support TERRAIN\\_REQUEST messages and have access to a terrain database\\, such as the SRTM database\\."
msgstr ""

#: ../../source/docs/parameters.rst:135918
#: 1847f83dcfa2441784395ff3583fa7e8
msgid "TERRAIN\\_SPACING: Terrain grid spacing"
msgstr ""

#: ../../source/docs/parameters.rst:135922
#: 109411a3b113460884e61e706e739626
msgid "Distance between terrain grid points in meters\\. This controls the horizontal resolution of the terrain data that is stored on te SD card and requested from the ground station\\. If your GCS is using the ArduPilot SRTM database like Mission Planner or MAVProxy\\, then a resolution of 100 meters is appropriate\\. Grid spacings lower than 100 meters waste SD card space if the GCS cannot provide that resolution\\. The grid spacing also controls how much data is kept in memory during flight\\. A larger grid spacing will allow for a larger amount of data in memory\\. A grid spacing of 100 meters results in the vehicle keeping 12 grid squares in memory with each grid square having a size of 2\\.7 kilometers by 3\\.2 kilometers\\. Any additional grid squares are stored on the SD once they are fetched from the GCS and will be loaded as needed\\."
msgstr ""

#: ../../source/docs/parameters.rst:135937
#: 646e72c3ce3b4c2196fa483464b70a82
msgid "TERRAIN\\_OPTIONS: Terrain options"
msgstr ""

#: ../../source/docs/parameters.rst:135941
#: fe5af22885d84e2385dae59b7c2b7c63
msgid "Options to change behaviour of terrain system"
msgstr ""

#: ../../source/docs/parameters.rst:135950
#: 7a0d63dc483c4df7aff6222fe6cdc1c1
msgid "Disable Download"
msgstr ""

#: ../../source/docs/parameters.rst:135952
#: b0efae4571b54b38b3a8f146796636f7
msgid "Disable Disk"
msgstr ""

#: ../../source/docs/parameters.rst:135963
#: 97534c5673e14fdba35d599269f10b0b
msgid "TERRAIN\\_MARGIN: Acceptance margin"
msgstr ""

#: ../../source/docs/parameters.rst:135967
#: 6797ae34e3804156a5c18c9c713754ae
msgid "Margin in centi\\-meters to accept terrain data from the GCS\\. This can be used to allow older terrain data generated with less accurate latitude\\/longitude scaling to be used"
msgstr ""

#: ../../source/docs/parameters.rst:135973
#: 65fb51f822c94a3595075e8112e22300
msgid "0.05 to 50000"
msgstr ""

#: ../../source/docs/parameters.rst:135982
#: 2f110c030fa54c31a172b12cc03ec7fc
msgid "TERRAIN\\_OFS\\_MAX: Terrain reference offset maximum"
msgstr ""

#: ../../source/docs/parameters.rst:135986
#: 00294eebf55d42e0ac5370e83804b051
msgid "The maximum adjustment of terrain altitude based on the assumption that the vehicle is on the ground when it is armed\\. When the vehicle is armed the location of the vehicle is recorded\\, and when terrain data is available for that location a height adjustment for terrain data is calculated that aligns the terrain height at that location with the altitude recorded at arming\\. This height adjustment is applied to all terrain data\\. This parameter clamps the amount of adjustment\\. A value of zero disables the use of terrain height adjustment\\."
msgstr ""

#: ../../source/docs/parameters.rst:136001
#: 5db552b1e41a432499b619fd9b205ed0
msgid "TERRAIN\\_CACHE\\_SZ: Terrain cache size"
msgstr ""

#: ../../source/docs/parameters.rst:136005
#: 46d5ba958bbd4f1e983ed335242c95ae
msgid "The number of 32x28 cache blocks to keep in memory\\. Each block uses about 1800 bytes of memory"
msgstr ""

#: ../../source/docs/parameters.rst:136011
#: 311751c19b4c45df9abae41b3b3bb6f8
msgid "0 to 128"
msgstr ""

