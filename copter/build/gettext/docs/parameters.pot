msgid "SERVO\\_BLH\\_TMOUT: BLHeli protocol timeout"
msgstr ""

#: ../../source/docs/parameters.rst:123032
#: c14c35cdbe97411f9f5237b6e7782130
msgid "This sets the inactivity timeout for the BLHeli protocol in seconds\\. If no packets are received in this time normal MAVLink operations are resumed\\. A value of 0 means no timeout"
msgstr ""

#: ../../source/docs/parameters.rst:123047
#: 2131467adbe14b34835b844d833e73c7
msgid "SERVO\\_BLH\\_TRATE: BLHeli telemetry rate"
msgstr ""

#: ../../source/docs/parameters.rst:123050
#: 76098f9883f7443db7a95aede43c88f0
msgid "This sets the rate in Hz for requesting telemetry from ESCs\\. It is the rate per ESC\\. Setting to zero disables telemetry requests"
msgstr ""

#: ../../source/docs/parameters.rst:123065
#: 71b46900e55748fba3d0411b8917e006
msgid "SERVO\\_BLH\\_DEBUG: BLHeli debug level"
msgstr ""

#: ../../source/docs/parameters.rst:123068
#: 9e6cc7449e22411796c3e5478e326b95
msgid "When set to 1 this enabled verbose debugging output over MAVLink when the blheli protocol is active\\. This can be used to diagnose failures\\."
msgstr ""

#: ../../source/docs/parameters.rst:123090
#: 3025daaa96cd489ba9d736fd0bca7716
msgid "SERVO\\_BLH\\_OTYPE: BLHeli output type override"
msgstr ""

#: ../../source/docs/parameters.rst:123095
#: e498ded20fcb4e69a87c2d6fdd3be722
msgid "When set to a non\\-zero value this overrides the output type for the output channels given by SERVO\\_BLH\\_MASK\\. This can be used to enable DShot on outputs that are not part of the multicopter motors group\\."
msgstr ""

#: ../../source/docs/parameters.rst:123129
#: 054ba06d743148be9bde50b58bfa6391
msgid "SERVO\\_BLH\\_PORT: Control port"
msgstr ""

#: ../../source/docs/parameters.rst:123133
#: 91970b968e7047b285cae2f1255cdeb7
msgid "This sets the mavlink channel to use for blheli pass\\-thru\\. The channel number is determined by the number of serial ports configured to use mavlink\\. So 0 is always the console\\, 1 is the next serial port using mavlink\\, 2 the next after that and so on\\."
msgstr ""

