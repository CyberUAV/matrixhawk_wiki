#: ../../source/docs/common-holybro-pixhawk6X.rst:56
#: c027d81303394e06b256fdd35419d785
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:57
#: 1c0266536aaf4c7eaeed8b41a8d1ac4a
msgid "The RCIN pin, which by default is mapped to a timer input, can be used for all ArduPilot supported receiver protocols, except CRSF/ELRS and SRXL2 which require a true UART connection. However, FPort, when connected in this manner, will only provide RC without telemetry."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:59
#: cd418db788f1494fa07fb53c639c8077
msgid "To allow CRSF and embedded telemetry available in Fport, CRSF, and SRXL2 receivers, a full UART, such as SERIAL6 (UART4) would need to be used for receiver connections. Below are setups using Serial6."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:61
#: 2346a01b218f4f1d835f392da8fe3942
msgid ":ref:`SERIAL6_PROTOCOL<SERIAL6_PROTOCOL>` should be set to \"23\"."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:63
#: f47638f3cbce46289a09b7938e760bdb
msgid "FPort would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"15\"."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:65
#: 95ad508efab3452e84aa2ebc387a846a
msgid "CRSF would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"0\"."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:67
#: 8fa055511a534a569d2ab8d8206f7c3c
msgid "SRXL2 would require :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"4\" and connects only the TX pin."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:69
#: cac57c922a6c41a08c8a874f95b95295
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:72
#: ebcfe4a464fa4300aea396e661c3532e
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:74
#: 77c7a28143e34ca5aa2d1415acdacc3c
msgid "The Pixhawk6X supports up to 16 PWM outputs. All 16 outputs support all normal PWM output formats. All FMU outputs, except 7 and 8, also support DShot."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:77
#: c970e592429f4941ab62eaf9b63d00b2
msgid "The 8 FMU PWM outputs are in 4 groups:"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:79
#: 0d4fbe6b4931483d9bfc351932d46211
msgid "Outputs 1, 2, 3 and 4 in group1"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:80
#: f6c072c2961547be90ab9ffced3bcffb
msgid "Outputs 5 and 6 in group2"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:81
#: f69ec43bd6bc4aa19aa48f57950d187a
msgid "Outputs 7 and 8 in group3"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:84
#: 5cb229962ec84eed9242b649ce7de3ea
msgid "FMU outputs within the same group need to use the same output rate and protocol. If any output in a group uses DShot then all channels in that group need to use DShot."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:89
#: 7c7f84626df0409c8c20592d8491c710
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:91
#: 4c00adf0f40149e8a774c9db60bab7a1
msgid "The board has 2 dedicated power monitor ports with a 6 pin connector. They are intended for use with the I2C power monitor supplied with the autopilot."
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:94
#: 62916b1b977247618b314fa69a1ce9b4
msgid "do not try to use the Mission Planner SETUP->Optional Hardware->Battery Monitor tab to setup the I2C power monitors for the Pixhawk6X. The parameters needed for their operation are already setup by default:"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:96
#: 2bcc00fe0cd44b36a8f91e5d46e960ad
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 21"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:97
#: 0816c3f631f6408fa98622d002cb46de
msgid ":ref:`BATT_I2C_BUS<BATT_I2C_BUS__AP_BattMonitor_INA2xx>` = 1"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:98
#: 7f55d731eec346eb8955544d7f5248d5
msgid ":ref:`BATT_I2C_ADDR<BATT_I2C_ADDR__AP_BattMonitor_INA2xx>` = 65 (For Low voltage (6S) Digital Power Module),= 69 (For High Voltage (12S/14S) Digital Power Module)"
msgstr ""

#: ../../source/docs/common-holybro-pixhawk6X.rst:100
#: 2eee5b7c7b7e49ad8ea28e28d9d02680
msgid "In Ardupilot 4.4 and later, the BATT_I2C_ADDR for Pixhawk 6X is default to be 0. This will perform an auto detection of the I2C address, and you do not need to change BATT_I2C_ADDR parameter."
msgstr ""

