#: c2914e06363a4fd48035c6dc8e829ef5
#: b8ed2a1744aa4ee093760b3f72021c38
msgid ":code:`x( [new_x] )` - If called with no arguments, return the currently set X component as a floating point number. If called with one argument it will assign the value to the X component."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:192
#: ../../source/docs/common-lua-scripts.rst:219
#: ada888a746084731b69f2c105d10cc27
#: 14b4f8068a3943c39e1adc6ad5a029f0
msgid ":code:`y( [new_y] )` - If called with no arguments, return the currently set Y component as a floating point number. If called with one argument it will assign the value to the Y component."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:194
#: ../../source/docs/common-lua-scripts.rst:223
#: 8231a13c0aec4664960b268f072033cd
#: 4de2225ad2cf4d3eaee7dd2a2aeba329
msgid ":code:`length()` - Returns the length of the vector as a floating point number."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:196
#: ../../source/docs/common-lua-scripts.rst:225
#: 33fc0bc66fdf49d5908817841ad957dd
#: 0d8b5abb8ece4e2cb87bf6cb4f7cd152
msgid ":code:`normalize()` - Normalizes the vector to be a unit vector."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:198
#: ../../source/docs/common-lua-scripts.rst:227
#: abaae6e8ec99445b88142a63873e7819
#: e56cc47f89944aadaecdd4af6e5b379e
msgid ":code:`is_nan()` - Returns true if the vector contains any NaN members."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:200
#: ../../source/docs/common-lua-scripts.rst:229
#: c2cb692c9c6d42aba0d58becb467ae23
#: b4bb812d1bfb460992f88405ff9fc69c
msgid ":code:`is_inf()` - Returns true if the vector contains any infinity members."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:202
#: ../../source/docs/common-lua-scripts.rst:231
#: 442e8c8c767c481bb25f18060de9867f
#: acb59da041ba49d49a84f9b153aa48fc
msgid ":code:`is_zero()` - Returns true if all the vector fields are 0."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:204
#: fe076ccca555461d9712c0aa908e68d7
msgid "The following operators are supported on a Vector2f:"
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:206
#: ../../source/docs/common-lua-scripts.rst:235
#: 2bfc890ca8044a0ea401d85a874008fc
#: fb204f33ed314176a4e0fef30532ab75
msgid ":code:`+` - Adds the two vectors by components."
msgstr ""

#: ../../source/docs/common-lua-scripts.rst:208
#: ../../source/docs/common-lua-scripts.rst:237
