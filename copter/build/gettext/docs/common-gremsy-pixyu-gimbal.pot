#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:5
#: 8fdf88f78f474ec7a20fb810127fd074
msgid "Gremsy Mio, Pixy, S1, T3, T7, and ZIO 3-Axis Gimbals"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:7
#: f913436b639f4ceebbb8b63ca3d147ad
msgid "Gremsy `Mio <https://gremsy.com/products/mio>`__, `Pixy F <https://gremsy.com/products/pixy-f>`__, `Pixy U <https://gremsy.com/products/pixy-u>`__, `Pixy WP <https://gremsy.com/products/pixy-wp>`__,  `S1 <https://gremsy.com/products/gremsy-s1v3>`__, `T3 <https://gremsy.com/products/gremsy-t3v3>`__, `T7 <https://gremsy.com/products/gremsy-t7>`__ and `ZIO <https://gremsy.com/zio>`__ 3-axis gimbals can communicate with the autopilot using the MAVLink protocol and are compatible with a range of cameras for real-time video or mapping purposes."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:14
#: f115d392d65d4d1685b3e9f3a3323277
msgid "MIO gimbals are unable to communication with ArduPilot.  We hope for a fix with Gremsy software version 7.7.3."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:16
#: 84e15ba0fbcd450ab2dfef3ca917f021
msgid "T3V3 gimbals must be running 7.7.3-Preview (or higher)."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:18
#: fce339f21a9042df8729c942cf6958fc
msgid "PixyU gimbals must be running 7.7.1 or 7.7.2.  7.7.3 does not work correctly.  We hope for a fix with Gremsy version 7.7.4 (or higher)."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:20
#: 4aa367ec48bf432196b5fb31ba05ff2c
msgid "PixyWE gimbals are not supported."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:22
#: 666a06f6d8ca44eb9cf185adeffdf55e
msgid "ZIO gimbals cannot be used as a secondary mount (e.g. \"Connecting Two Gimbals\" below does not work with the ZIO)"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:25
#: 3cf00a954c8a450585baf87f9541bf36
msgid "Where to Buy"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:27
#: 326f33941cbc4e55ae022f545228ed55
msgid "These gimbals can be purchased from the `Gremsy store <https://gremsy.com/online-store>`__"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:30
#: de45968d172e431094557cec2c28cd28
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:36
#: bd73871ea919447d920e854828dd6e31
msgid "Connect the gimbals's COM2 port to one of the autopilot's Serial/Telemetry ports like Telem2 as shown above."
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:38
#: 1e58b4110dd24be5b243564b04ff0bd2
msgid "Connect to the autopilot with a ground station and set the following parameters, if using the first mount:"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:40
#: 619a1fc3cd1c4b8eb932af69975dc143
msgid ":ref:`MNT1_TYPE <MNT1_TYPE>` to \"6\" for \"MAVLink\" and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:41
#: 05f7cdfb4fc14fbf8f6626c524ac56d0
msgid "If using a ZIO with ArduPilot-4.5.0 (or higher) set :ref:`CAM1_TYPE <CAM1_TYPE>` to \"6\" (MAVLink..Gimbal V2 compatible) and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:42
#: 04eb7ff91d264ad281d95623ae9fed03
msgid ":ref:`SERIAL2_BAUD <SERIAL2_BAUD>` to \"115\" for 115200 bps.  \"SERIAL2\" can be replaced with another serial port (i.e. SERIAL1) depending upon the physical connection"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:43
#: 7e18436831eb41b29c23686d8e972a3b
msgid ":ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` to 2 for \"MAVLink2\""
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:44
#: 4424e7635c80411eae75cb9b5edc3632
msgid ":ref:`SERIAL2_OPTIONS <SERIAL2_OPTIONS>` to 1024 for \"Don't forward mavlink to/from\""
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:46
#: 339eb1b0ec7247ccb199b056dd6196b3
msgid "See the \"Control with an RC transmitter\" section of :ref:`this page <common-mount-targeting>` for details on parameter changes required to control the gimbal through an RC Transmitter (aka \"RC Targeting\")"
msgstr ""

#: ../../source/docs/common-gremsy-pixyu-gimbal.rst:48
#: c794532e5aec431a88a3277d73692465
msgid "When the autopilot has successfully connected to the gimbal, \"Mount: GREMSY PixyU fw:7.7.1.0\" (or similar) will be sent to the ground station.  Looking for this message may be useful in determining if the autopilot and gimbal are communicating successfully."
msgstr ""

