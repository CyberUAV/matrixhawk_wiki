msgid "Secure the copter (perhaps with tape) so that it does not move"
msgstr ""

#: ../../source/docs/common-compass-setup-advanced.rst:119
#: 7a20ef81b51b4b798a5e5f22bc1d4ab4
msgid "Turn on your transmitter and keep throttle at zero"
msgstr ""

#: ../../source/docs/common-compass-setup-advanced.rst:120
