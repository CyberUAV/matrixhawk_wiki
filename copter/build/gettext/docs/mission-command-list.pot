msgstr ""

#: ../../source/docs/mission-command-list.rst:373
#: e74c59d4e3bb44edb3fbaca9e94cf3ad
msgid "To stop the camera from triggering, add a DO_SET_CAM_TRIGG_DIST later in the mission with Dist = 0"
msgstr ""

#: ../../source/docs/mission-command-list.rst:378
