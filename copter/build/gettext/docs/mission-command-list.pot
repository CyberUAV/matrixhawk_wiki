#: ../../source/docs/mission-command-list.rst:391
#: 4db1ecf852e34a889d1be08bafd23f21
msgid "Do-Repeat-Relay"
msgstr ""

#: ../../source/docs/mission-command-list.rst:396
#: 46ab64e49fcd4d0ab4170603367ced1f
msgid "Toggle the :ref:`Relay <common-relay>` pin's voltage a specified number of times. In the example above, assuming the relay was off to begin with, it would be set high and then after 3 seconds it would be toggled low again."
msgstr ""

#: ../../source/docs/mission-command-list.rst:401
#: 1262c66799404eeb8f2257831a2adc85
msgid "**First column is Relay number** : 0 = First Relay, 1 = Second Relay"
msgstr ""

#: ../../source/docs/mission-command-list.rst:403
#: 1884da05d8914af7a7971df8bc133c52
msgid "**Repeat #** : how many times the relay should be toggled"
msgstr ""

#: ../../source/docs/mission-command-list.rst:405
#: 369a43c288994065bf2fff9ad75bcac2
msgid "**Delay(s)** - Number of seconds between each toggle."
msgstr ""

#: ../../source/docs/mission-command-list.rst:408
#: 980bb82dd3d543e8a9eb4a817e61b0a1
msgid "Do-Set-Servo"
msgstr ""

#: ../../source/docs/mission-command-list.rst:413
#: 4b10d3af0b364ad6888d462ce57778c7
msgid "Move a :ref:`servo <common-servo>` to a particular PWM value. In the example above, the servo attached to output channel 8 would be moved to PWM 1700 (servo's generally accept PWM values between 1000 and 2000)."
msgstr ""

#: ../../source/docs/mission-command-list.rst:417
#: ../../source/docs/mission-command-list.rst:434
#: 8893406a981042069b091e28e063b1b2
#: 62ce293aff5542a59a0a19df4c853ead
msgid "**Ser No** : the output channel the servo is attached to"
msgstr ""

#: ../../source/docs/mission-command-list.rst:419
#: ../../source/docs/mission-command-list.rst:436
#: 153d1984003346879ba387fef1733462
#: b36ad1853b7f47d38fc0a67116882344
msgid "**PWM** : PWM value to output to the servo"
msgstr ""

#: ../../source/docs/mission-command-list.rst:422
#: 874de53f7fef4c7aad39a43ddbd516cd
msgid "Do-Repeat-Servo"
msgstr ""

#: ../../source/docs/mission-command-list.rst:427
#: 9f04b41dc0c345dd8bf295ed02b6dea4
msgid "Repeatedly move a :ref:`servo <common-servo>` back and forth between its mid position and a specified PWM value. In the example above, the servo attached to output channel 8 would be moved to PWM 1700, then after 4 seconds, back to mid (default is 1500 which is held in the :ref:`RC8_TRIM<RC8_TRIM>` parameter), after another 4 seconds it would be moved to 1700 again, then finally after 4 more seconds it would be moved back to mid."
msgstr ""

#: ../../source/docs/mission-command-list.rst:438
#: 5ec92044e6514b108226574e921ded0f
msgid "**Repeat #** : Number of times to move the servo to the specified PWM value"
msgstr ""

#: ../../source/docs/mission-command-list.rst:441
#: 8b9fab2832e74719983e6198d1de992c
msgid "**Delay (s)** : the delay in seconds between each servo movement"
msgstr ""

#: ../../source/docs/mission-command-list.rst:444
#: e21a768c0cf14cf0b3c4fc4a4bfbccb7
msgid "Do-Digicam-Control"
msgstr ""

#: ../../source/docs/mission-command-list.rst:449
#: cdff990a60d24ef4a92115878509bee3
msgid "Trigger the :ref:`camera shutter <common-camera-shutter-with-servo>` once.  The \"Shutter Cmd\" field should be set to \"1\"."
msgstr ""

#: ../../source/docs/mission-command-list.rst:452
#: 6fc93afc1b5a4af1b58d502458cbeb92
msgid "Do-Fence-Enable"
msgstr ""

#: ../../source/docs/mission-command-list.rst:457
#: 116e04eb96c645d2bc438a2960491056
msgid "Enable(1) or Disable(0) the Copter :ref:`common-ac2_simple_geofence` and/or Copter :ref:`common-polygon_fence`. This command takes no additional arguments."
msgstr ""

#: ../../source/docs/mission-command-list.rst:460
#: 78712cd3a9c94930a7bf2ef98d64e8ec
msgid "Do-Gimbal-Manager-PitchYaw"
msgstr ""

#: ../../source/docs/mission-command-list.rst:465
#: 2564ee9829354cab9f35e878c49c2795
msgid "Moves the :ref:`camera gimbal <common-cameras-and-gimbals>` to the desired pitch and yaw angles (in degrees).  Positive pitch angles are up, Negative are down.  Positive yaw angles are clockwise, negative are counter clockwise.   If the \"Flags\" field is \"0\" the yaw angle is in \"body frame\" (e.g. 0 is forward).  If \"Flags\" is \"16\" the yaw angle is in \"earth frame\" (e.g. 0 is North)."
msgstr ""

#: ../../source/docs/mission-command-list.rst:467
#: 9c412163618e459fb8afeea0cb7f26ed
msgid "Alternatively Pitch Rate and Yaw Rate fields can be used to move the gimbal at a specified rate in deg/sec.  A Condition-Delay for a few seconds followed by another Do-Gimbal-Manager-PitchYaw should be used to eventually stop the gimbal from rotating."
msgstr ""

#: ../../source/docs/mission-command-list.rst:470
#: 0a65b174c65e4c7eae11356aeb175acf
msgid "Do-Mount-Control"
msgstr ""

#: ../../source/docs/mission-command-list.rst:475
#: a1a5f3145298464da439258b982ae3d2
msgid "Controls the roll, pitch and yaw angle of the :ref:`camera gimbal <common-cameras-and-gimbals>`. This can be used to point the camera in specific directions at various times in the mission."
msgstr ""

#: ../../source/docs/mission-command-list.rst:478
#: c445d17d6c17448bbfa0eec809796530
msgid "Do-Gripper"
msgstr ""

#: ../../source/docs/mission-command-list.rst:483
#: 8ef16b1f79384086a4a7884fc34ce578
msgid "This command allows opening and closing a :ref:`servo gripper <common-gripper-servo>` or :ref:`EPM gripper <common-cameras-and-gimbals>`. Set the \"drop/grab\" column to 0 to close the gripper, 1 to open the gripper.  The first column, \"Gripper No\" is ignored because we currently only support a single gripper per vehicle."
msgstr ""

#: ../../source/docs/mission-command-list.rst:487
#: 5aa4e494ae89417aa878e6c81f6d5b13
msgid "Do-Winch"
msgstr ""

#: ../../source/docs/mission-command-list.rst:492
#: 1d62c4bc09e549838936245220a2c59d
msgid "This command allows controlling a :ref:`winch <common-daiwa-winch>` to raise or lower a package."
msgstr ""

#: ../../source/docs/mission-command-list.rst:494
#: a78801b4c07443d7a4678ac84152d265
msgid "\"winch no\" is not used"
msgstr ""

#: ../../source/docs/mission-command-list.rst:495
#: fdf0f8a68cdc4d1f848de2f6e6fa7d51
msgid "\"action\" should be 0 to relax the winch, 1 for Length control, 2 for Rate control"
msgstr ""

#: ../../source/docs/mission-command-list.rst:496
#: 615d00ea43254e1e83be1d7890964363
msgid "\"length\" should be filled in with the meters of line to release.  Positive numbers release the line, negative retract the line.  Note \"action\" should be \"1\"."
msgstr ""

#: ../../source/docs/mission-command-list.rst:497
#: 743e477e87074a4e9ba0e3ad1c81b9d0
msgid "\"rate\" should be filled in with the speed (in m/s) to release the line.  Positive numbers release the line, negative retract the line.  Note \"action\" should be \"2\"."
msgstr ""
