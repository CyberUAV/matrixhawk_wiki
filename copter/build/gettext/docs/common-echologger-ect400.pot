#: ../../source/docs/common-echologger-ect400.rst:28
#: a3685f6268574d7bab187c1a90ddf090
msgid "The ECT400 provides distance measurements using the NMEA protocol over serial at 115200 baud."
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:30
#: 7abf018e7b7e488dae90b5ff5943784c
msgid "The sensor can be connected to any available serial/uart port on the autopilot.  In the diagram below the first sensor is connected to SERIAL2."
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:35
#: c4302b3f71514f81aad423efceaa061a
msgid "If the SERIAL2 is used then the following parameters should be set:"
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:37
#: 875388eaa821495bb9741a49608f934e
msgid ":ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:38
#: c410f974be714075b9d196e64d32402f
msgid ":ref:`SERIAL2_BAUD <SERIAL2_BAUD>` = 115 (115200 baud)"
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:40
#: 78508329b2af4d9c9464330c225920e9
msgid "Then the following range finder related parameters should be set:"
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:42
#: 933539be1777416089d125bc6a5347b0
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 17 (NMEA)"
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:43
#: 0cff963500a54a73ab23d0ebec2a841d
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.13"
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:44
#: acff97683fa04d9aa0c2161914e4f551
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 100 (i.e. 100m).  *This is the distance in meters that the rangefinder can reliably read.*"
msgstr ""

#: ../../source/docs/common-echologger-ect400.rst:45
#: 43a3d7a8f9144b6c90eed8004e62b028
msgid ":ref:`RNGFND1_ORIENT <RNGFND1_ORIENT>` = 25 (i.e. down) if mounted on a boat"
msgstr ""

