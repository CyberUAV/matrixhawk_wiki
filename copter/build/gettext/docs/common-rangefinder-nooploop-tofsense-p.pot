#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:5
#: e49964b04a8744298cb6bf7b46633619
msgid "Nooploop TOFSense/-UART/S"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:8
#: 282f9567493d4277bb9fde3f1eb5be4d
msgid "Support for this sensor is available in firmware versions 4.5 and later."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:10
#: 4cbfc654d98a4156852acc038bc0c70a
msgid "The `TOFSense/-UART/S <https://ftp.nooploop.com/downloads/tofsense/TOFSense_Datasheet_V3.0_en.pdf>`__ is lightweight rangefinder module that provides fast and accurate distance measurements up to 8 meters. It also has an adjustable field of view (FOV), ranging from 15 to 27 degrees with a measurement resolution of 1mm. ArduPilot currently supports this sensor via both UART and CAN."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:16
#: d79bf03e7daf489ea721007c5641fd82
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:18
#: 477e8aeceaf64e12893ad69f83559226
msgid "This sensor my be connected either via UART or CAN."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:21
#: 71aba5dc25ba424cbefb66233779c107
msgid "Connecting via UART"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:23
#: ea596e74fd564721b2f2f86421321319
msgid "Setup the sensor through the NAssistant Software provided by the manufacturer. More details can be found `here <https://www.nooploop.com/download/>`__. For UART mode, in the setup screen set \"Interface\" to UART, correct baudrate and Mode to \"active\". It is recommended to reduce the baudrate from the default 921600, to a smaller option (For example: 230400)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:29
#: aeda80f530c54efa9a6cd41fe22b4f61
msgid "You can use any spare autopilot Serial/UART port. The diagram below shows how to connect to SERIAL4 and the example parameters will be shown assuming this Serial port is used."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:34
#: 9c400cb5f8e0420bb38f3b4d0cef6d54
msgid "Set the following parameters:"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:36
#: be748a53811f44beb64a708411d73bae
msgid ":ref:`SERIAL4_PROTOCOL<SERIAL4_PROTOCOL>` = 9 (Lidar)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:37
#: e45aa081fa67447aacb205697ce362cf
msgid ":ref:`SERIAL4_BAUD<SERIAL4_BAUD>` = 230400 (Or as set in NAssistant)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:38
#: dd4689c28a20439aad129a1f877ad36f
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 37 (NoopLoop_TOFSense) Reboot after setting this."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:39
#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:68
#: a1352b5b8bd04914b74e07311fa8a3f9
#: ef2091f168134e2eb83233cb446f7c50
msgid ":ref:`RNGFND1_MAX <RNGFND1_MAX>` = 8 (i.e. 8m max range)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:40
#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:69
#: d6461863cb83436fbf091ef02de4a503
#: 25955476e410446bb2f4868df4b76938
msgid ":ref:`RNGFND1_MIN <RNGFND1_MIN>` = 0.02"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:44
#: 89fda3ad7c5c4f6287c9e9952084e594
msgid "Connecting via CAN"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:46
#: 473d4a928bff437ab387cc560a2ec262
msgid "Setup the sensor through the NAssistant Software provided by the manufacturer. More details can be found `here <https://www.nooploop.com/download/>`__. For CAN mode, in the setup screen set \"Interface\" to CAN, Mode to \"active\", and bitrate to \"1000000\". You can also set the \"ID\" to a unique number if planning to use multiple TOFSenseP on a single CAN bus. Setting ID to 0 will accept all ID's."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:52
#: 0ce70dc7871c4adfb323a8e0c701e85c
msgid "ArduPilot does not currently support  multiple instances of these rangefinders connected to different CAN ports. If you would like to use multiple instances of these CAN rangefinders together, connect them to the same bus."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:55
#: 87a69acb2fca4ea090f3fb713fb48476
msgid "The 4 Pin JST-GH connector wiring of the sensor does not match with the CAN wiring of most autopilots. Wiring incorrectly can lead to damaged sensor and/or autopilot."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:57
#: 18cf997f5eb64917a44dc0c5dcd9f0a9
msgid "For a CAN connection you can use any spare CAN port. Since this is not a DroneCAN based sensor, you will not be able to use the connected port with any other type of sensor. The diagram below shows how to connect to CAN2."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:62
#: 60bed57390d94b11b1ef510950698392
msgid "Set the following parameters"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:64
#: 0e2c13f9b801428a91ea4e07370539e7
msgid ":ref:`CAN_P2_DRIVER <CAN_P2_DRIVER>` = 1 (to enable the CAN port and use driver 2)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:65
#: 6bba3c7cec1a4602b42b1782bc278cbb
msgid ":ref:`CAN_P2_BITRATE<CAN_P2_BITRATE>` = 1000000 (Or as set in NAssistant)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:66
#: 5edc13392d9d410287554a36a35d1231
msgid ":ref:`CAN_D2_PROTOCOL<CAN_D2_PROTOCOL>` = 13 (TOFSenseP protocol)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:67
#: 3febbd4bc1f64798b0ad66eb62db488f
msgid ":ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 38 (NoopLoop_TOFSense_CAN) Reboot after setting this."
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:70
#: 10012bf402824f9ca8dda404ae5ab1ce
msgid ":ref:`RNGFND1_RECV_ID <RNGFND1_RECV_ID>` = ID of the sensor (0 to accept data from all CAN sensor IDs)"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:74
#: 46ead3cf9350480e91edacef16ecc3da
msgid "Testing the sensor"
msgstr ""

#: ../../source/docs/common-rangefinder-nooploop-tofsense-p.rst:76
#: 43f5bff2148c454c8ad36fcc170a5ccd
msgid "Distances read by the sensor can be seen in the Mission Planner's Flight Data screen's Status tab. Look for \"rangefinder1\"."
msgstr ""
