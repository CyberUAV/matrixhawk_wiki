msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:7
#: 740f5e9fa1de47699711969613d80256
msgid "The `Lightware SF40/C 360degree lidar <https://lightware.co.za/collections/lidar-rangefinders/products/sf40-c-100-m>`__ can be used for Object Avoidance in Copter-3.4 and higher in Loiter mode."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:11
#: 6206b58d010640cea6dc612ff1fbf4a7
msgid "This feature has not been tested in a wide variety of situations and should be used with caution."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:17
#: c0a18ea1c2e14159908b6537f6e8d90c
msgid "Mounting the SF40c"
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:23
#: f751aff031134ada80b41ffe1c328dda
msgid "The SF40c should be mounted on the top or bottom of the vehicle so that the rotating portion scans horizontally and its view is not obstructed by any portion of the vehicle including GPS mast, vehicle legs etc.  The round gold and black lightware logo should be facing forward."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:26
#: 3f601da439484e33a70798fd0435920f
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:31
#: 365410206ed149dbae2cfde8ebee07a1
msgid "The diagram above shows how the SF40c can be connected to the autopilot's serial input.  The above pictures shows use of Serial4 but any free serial port can be used."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:34
#: af082994f52d41cba21f4c1a20c72d33
msgid "Configuration through the Ground Station"
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:35
#: f7f9f7aab339459fb540388307731449
msgid "Example setup below shown for first proximity sensor:"
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:37
#: a3f773eb403d47c987e8a8791b6a3501
msgid ":ref:`SERIAL4_PROTOCOL <SERIAL4_PROTOCOL>` = \"11\" (\"Lidar360\") if using Serial4."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:38
#: 77b44a4daa43452b810d1395b5155857
msgid ":ref:`SERIAL4_BAUD <SERIAL4_BAUD>` =  \"921\" if using Serial4."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:39
#: 422df5ee07764dd4b381590eb1bf0844
msgid ":ref:`PRX1_TYPE <PRX1_TYPE>` = \"7\" (LightwareSF40c) or \"1\" (LightwareSF40C-legacy) if using a very old version of the sensor"
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:40
#: 8f530ebe833349d3aed1e60778e9a1e2
msgid ":ref:`PRX1_ORIENT <PRX1_ORIENT>` = \"0\" if mounted on the top of the vehicle, \"1\" if mounted upside-down on the bottom of the vehicle."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:41
#: aae4bbe5329f4b2e95695e9577839b6e
msgid ":ref:`PRX1_YAW_CORR <PRX1_YAW_CORR>` allows adjusting the forward direction of the SF40c.  One way to determine this angle is to use the Mission Planner's Setup >> Advanced, Proximity viewer and then walk around the vehicle and ensure that the sector distances shorten appropriately."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:42
#: ffc23e612d6e491bb58db0e8f8af1b29
msgid ":ref:`PRX1_IGN_ANG1 <PRX1_IGN_ANG1>` and :ref:`PRX1_IGN_WID1 <PRX1_IGN_WID1>` parameters allow defining zones around the vehicle that should be ignored.  For example to avoid a 20deg area behind the vehicle, set :ref:`PRX1_IGN_ANG1 <PRX1_IGN_ANG1>` to 180 and :ref:`PRX1_IGN_WID1 <PRX1_IGN_WID1>` to 20."
msgstr ""

#: ../../source/docs/common-lightware-sf40c-objectavoidance.rst:44
#: 507c33629df5417b82a4bf1898335838
msgid "More details on using this sensor for object avoidance on Copter can be found :ref:`here <common-object-avoidance-landing-page>`."
msgstr ""
