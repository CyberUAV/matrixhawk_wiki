msgid "Arm the throttle in Stabilize Mode"
msgstr ""

#: ../../source/docs/common-ground-resonance.rst:15
#: dea1b74f67c3408882136a390cfe909c
msgid "Lift the throttle to the point where the motors increase to MOT_SPIN_MIN"
msgstr ""

#: ../../source/docs/common-ground-resonance.rst:16
#: bf0f640ee6d54af49ad7cbeff3a372c3
msgid "Observe the axis off oscillation,"
msgstr ""

#: ../../source/docs/common-ground-resonance.rst:17
#: 401c540f406a4799a099a14564a5c7d8
msgid "Back off :ref:`ATC_LAND_Y_MULT<ATC_LAND_Y_MULT>` to 0.5"
msgstr ""

#: ../../source/docs/common-ground-resonance.rst:18
#: d435a02d6d184b8496220df474baa34c
msgid "Revaluate Roll and Pitch oscillation for improvement"
msgstr ""

#: ../../source/docs/common-ground-resonance.rst:19
