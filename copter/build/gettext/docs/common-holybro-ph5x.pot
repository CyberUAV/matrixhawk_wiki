#: 5b6c664b16f04fbda82ccb6467e57392
msgid "PWM 1, 2, 3 and 4 in group1"
msgstr ""

#: ../../source/docs/common-holybro-ph5x.rst:118
#: 1eb7f7a65cb640f8b69d8accd1442f92
msgid "PWM 5 and 6 in group2"
msgstr ""

#: ../../source/docs/common-holybro-ph5x.rst:119
#: ca8a6dca80e048c18d933f26af5b4a88
msgid "PWM 7 and 8 in group3"
msgstr ""

#: ../../source/docs/common-holybro-ph5x.rst:122
#: 8cb880bb2dad4525816b8451509004ca
msgid "FMU outputs within the same group need to use the same output rate and protocol. If any output in a group uses DShot then all channels in that group need to use DShot."
msgstr ""

