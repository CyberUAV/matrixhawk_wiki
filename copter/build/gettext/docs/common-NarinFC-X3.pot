msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:189
#: bc7f282038704fa3b3ff60c3fa0c7203
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:191
#: 1781f84ca7ce4e5896a058ad349d8353
msgid "The NarinFC-X3 supports up to 13 PWM outputs. Outputs 1-10 support DShot and Bi-Directional DShot. The pads for motor output M1 to M4 are provided on both the motor connectors and on separate pads, plus M9-13 on a separate pads for LED strip and other PWM outputs."
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:195
#: e8f70cd111584fa798dc152c644b5827
msgid "The PWM is in 4 groups:"
msgstr ""

