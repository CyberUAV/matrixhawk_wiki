#: ../../source/docs/common-NarinFC-X3.rst:169
#: e894804e4a8a4aa084eea563a3a08833
msgid "If the receiver is FPort the receiver must be tied to the USART6 TX pin , RSSI_TYPE set to 3, and SERIAL6_OPTIONS must be set to 7 (invert TX/RX, half duplex)."
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:171
#: 306f8d1a0fdd4770a8535bf22d3fb597
msgid "For full duplex like CRSF/ELRS use both RX6 and TX6 and set :ref:`RSSI_TYPE<RSSI_TYPE>` also to 3."
msgstr ""

