#: b008a26e65a947808e89fccc0f8374d8
msgid "PWM 1-2 in group1"
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:197
#: 97cd0a4014874f9f9937553a3db503b3
msgid "PWM 3-4 in group2"
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:198
#: 7e067965938249ba81016c0f25093d53
msgid "PWM 5-6 in group3"
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:199
#: c3c96e50f16142e18ada1d288fdb50db
msgid "PWM 7-10 in group4"
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:200
#: 19a0664523c749eab85c39c8f9d860c3
msgid "PWM 11-12 in group5"
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:201
#: fb8f155915224c28b7d9f00bee7fe77e
msgid "PWM 13 in group6"
msgstr ""

#: ../../source/docs/common-NarinFC-X3.rst:203
#: 380881bbe6224b4d820a4a2c1783b788
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. ALL outputs within the same group need to use the same output rate and protocol."
msgstr ""

