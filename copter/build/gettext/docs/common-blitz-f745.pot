#: 8cc9393a02d34e9da71a7437bbe59907
msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` 4"
msgstr ""

#: ../../source/docs/common-blitz-f745.rst:145
#: 686cdb1455db4e5687a2d60d5f756888
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` 13"
msgstr ""

#: ../../source/docs/common-blitz-f745.rst:146
#: ca68f55726184009a5ae4dcfad6fb9f2
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 12"
msgstr ""

#: ../../source/docs/common-blitz-f745.rst:147
#: 63866f15b974403282cf98fb4bb41aa6
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 11"
msgstr ""

#: ../../source/docs/common-blitz-f745.rst:148
#: 6bf35f4e073e4ce294fce55817b24cc6
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` 50 but varies depending on external current sensor"
msgstr ""

#: ../../source/docs/common-blitz-f745.rst:151
