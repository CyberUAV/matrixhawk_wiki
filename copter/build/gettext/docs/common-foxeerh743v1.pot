#: ../../source/docs/common-foxeerh743v1.rst:92
#: 5731f0882ff64bdc96dcbf8a9ab95102
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-foxeerh743v1.rst:94
#: 3e4023656ad045b180fe77e9b9e47cc2
msgid "RC input is configured by default on the R1 (UART1_RX) pin. It supports all serial RC protocols. For protocols requiring separate half-duplex serial to transmit telemetry (such as FPort) you should setup SERIAL1 as an RC input serial port, with half-duplex, pin-swap and inversion enabled (:ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` = 15)."
msgstr ""

#: ../../source/docs/common-foxeerh743v1.rst:96
#: 2810999c65464e41aeb14739d7ef55d3
msgid "The DJI connector also has UART4 RX input for DJI RC input. To use this you would need to set :ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>` to something other than \"23\" (RCinput) and set this protocol for :ref:`SERIAL4_PROTOCOL<SERIAL4_PROTOCOL>` instead."
msgstr ""

#: ../../source/docs/common-foxeerh743v1.rst:98
#: 98050c84285f4fd392761444bce6d498
msgid "For PPM support on UART4_RX set :ref:`BRD_ALT_CONFIG<BRD_ALT_CONFIG>` to 1 and use the UART4 RX pin as PPM (and any other serial RC protocol) input."
msgstr ""

#: ../../source/docs/common-foxeerh743v1.rst:101
#: aedeafb555c944ae9136aabe2a991acb
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-foxeerh743v1.rst:103
#: 25589b0c813c472e90681455eb4ae2ae
msgid "The FoxeerH7 MPU6000 supports using its internal OSD using OSD_TYPE 1 (MAX7456 driver). External OSD support such as DJI or DisplayPort is supported using UART7 or any other free UART. See :ref:`common-msp-osd-overview-4.2` for more info."
msgstr ""

