#: ../../source/docs/common-cheerson-cxof.rst:30
#: 4ed136d487884828893e2504e6cee74d
msgid "Connection to Autopilot"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:36
#: 46bef32e87c442d990c0840d601a4794
msgid "The flow sensor should be mounted on the underside of the copter with the camera lens pointing downwards.  The side of the sensor with the \"V2.0\" label should be towards the front of the vehicle.  The image above is incorrect because the autopilot's arrow is pointing down while the sensor's \"V2.0\" label is close to the top."
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:37
#: e22c7159be2b463f993596e4096c8a4b
msgid "Connect the sensor's TX and VSS (aka GND) pins to one of the autopilot's serial ports.  In the image above the sensor is connected to a Pixhawk's Telem2 port"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:38
#: 2e62c6f9f26f4e34b69abc62f72576d0
msgid "Connect the sensor's VDD (aka VCC or 3.3V) to a 3.3V power source.  In the above diagram the Pixhawk's Switch port is used but another alternative would be the SPKT/DSM port's power pin"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:40
#: cd7aebb41ad748a49acfe29201a9bde9
msgid "Set :ref:`FLOW_TYPE <FLOW_TYPE>` = 4"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:41
#: 71bce0e0ebb44a51a6ffc3781743b793
msgid "Set :ref:`SERIAL2_PROTOCOL <SERIAL2_PROTOCOL>` = 18 if using Serial2/Telem2, if connected to another serial port use the corresponding SERIALx_PROTOCOL parameter"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:44
#: 14169a67be894363abb1a156ecd9a9ce
msgid "Additional Notes"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:46
#: 167647da60f84777a60e42fd48338a87
msgid "As with the :ref:`PX4Flow sensor <common-px4flow-overview>` a range finder is required to use the sensor for autonomous modes including :ref:`Loiter <loiter-mode>` and :ref:`RTL <rtl-mode>`"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:47
#: d8da1c7a2d1f4b62a13b6c41641faff9
msgid ":ref:`FlowHold <flowhold-mode>` does not require the use of a rangefinder"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:48
#: ed5e672810394a56b72ea169b1d8b738
msgid "The sensor has been successfully tested to altitudes of about 40m"
msgstr ""

#: ../../source/docs/common-cheerson-cxof.rst:49
#: a0da6824013f4cfdb8e2770e0699579f
msgid "Performance can be improved by setting the :ref:`sensors position parameters <common-sensor-offset-compensation>`.  For example if the sensor is mounted 2cm forward and 5cm below the frame's center of rotation set :ref:`FLOW_POS_X <FLOW_POS_X>` to 0.02 and :ref:`FLOW_POS_Z <FLOW_POS_Z>` to 0.05."
msgstr ""

