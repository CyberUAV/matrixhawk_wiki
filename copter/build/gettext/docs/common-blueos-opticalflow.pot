#: ../../source/docs/common-blueos-opticalflow.rst:5
#: 9713d5d795ad46ff8fbb94ff1d3e81fb
msgid "BlueOS OpticalFlow Extension"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:9
#: 7763832dc1dc4b81a19d1ad7544e345b
msgid "`BlueOS's Optical Flow Extension <https://github.com/BlueOS-community/blueos-opticalflow>`__ allows a downward facing camera gimbal to be used as an optical flow sensor to improve performance in non-GPS environments."
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:16
#: c5f559db6f374698843e134595771ea5
msgid "Support for this extension was added in ArduPilot-4.7"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:19
#: 0be48cf9e6a0435fb9622711632980f3
msgid "Hardware Required"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:21
#: 3997d0b302dc4defb08fc5875fe85730
msgid "Please see :ref:`ArduPilot's BlueOS installation instructions <dev:companion-computer-blueos>` which also includes hardware recommendations."
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:23
#: eb2f30e8e27a49c196f1ac4d85033674
msgid "Any :ref:`supported camera gimbal <common-cameras-and-gimbals>` with ethernet connectivity should work including the :ref:`Siyi <common-siyi-zr10-gimbal>`, :ref:`ViewPro <common-viewpro-gimbal>` and :ref:`XFRobot <common-xfrobot-gimbal>` camera gimbals."
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:25
#: 2c6f006a1c424a9986e1d2742206c7bb
msgid "The camera gimbal should be mounted on the underside of the vehicle and optical flow will only operate when the camera gimbal is pointing downwards."
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:27
#: 5b93c3af2e5048adafc05d39faddf676
msgid "A :ref:`rangefinder <common-rangefinder-landingpage>` with at least a few meters of range is also required."
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:30
#: cb436b0138ce48429fd6167cd9376a05
msgid "BlueOS Extension Installation"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:32
#: 1c09e5af8cec4a2b9400e9658d9936d6
msgid "Once BlueOS has been :ref:`installed <dev:companion-computer-blueos>` on the companion computer:"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:34
#: 6f216dc4ebe64d2585ec3f5354938a0e
msgid "Ensure the companion computer is connected to the internet"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:35
#: e66aa14e04ca4bf8ac600389a6a0c0cc
msgid "From the left menu, select \"Extensions\""
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:36
#: 822b77451435474caceff073b6b5d869
msgid "Search for \"opticalflow\" and push the \"GET\" and \"INSTALL\" buttons"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:42
#: b741c943d98a46b683f437299a2351b7
msgid "From the left menu, select \"OpticalFlow\""
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:43
#: f45586163b6a466ca84d58be5a65077e
msgid "Select the \"Camera Type\" being used"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:44
#: 510e83dec8094a34b7782fddc5e860cd
msgid "Adjust the RTSP URL if not using the camera gimbal's default IP address or RTSP stream"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:45
#: 0609561033cd41a28e97f42bba6196ae
msgid "\"Flight Controller SysID\" should match the vehicle's :ref:`MAV_SYSID <MAV_SYSID>` parameter (normally 1)"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:46
#: 0cdba30114ce42f28210873d2e4042fe
msgid "Optionally adjust the Horizontal FOV to match the camera gimbal's lens"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:53
#: 892d1e7425b641368df60b4ac7c55537
msgid "AutoPilot Configuration and Calibration"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:55
#: 0e7d718bb2ad46d4bf8aff9570d310fc
msgid "Set :ref:`FLOW_TYPE <FLOW_TYPE>` = 5 (MAVLink) and reboot the autopilot"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:56
#: b2cc70799af94b4584ef14b3bf25780e
msgid "Set :ref:`FLOW_OPTIONS <FLOW_OPTIONS>` = 1 (Roll/Pitch stabilised)"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:57
#: e2aba0f681bc42dd9fd6af7ad4abc87a
msgid "Set :ref:`EK3_FLOW_DELAY <EK3_FLOW_DELAY>` = 150 (ms)"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:58
#: db3db17ec21e424aafb3196bd3daea87
msgid "Optionally set :ref:`EK3_OPTIONS <EK3_OPTIONS>` = 4 (Optflow may use terrain alt) to allow optical flow to be used beyond the rangefinder's maximum range"
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:59
#: 0cf3968cb57d430b923fc4c1dbb57632
msgid "The \"Inflight Calibration\" and \"Log based Calibration\" methods described in the :ref:`Optical Flow Sensor Testing and Setup <common-optical-flow-sensor-setup>` will not work for stabilised camera gimbals.  Instead the Extension's \"Horizontal FOV\" field can be adjusted if the vehicle's estimated position on the map (when using optical flow) significantly overshoots or undershoots the actual distance moved."
msgstr ""

#: ../../source/docs/common-blueos-opticalflow.rst:60
#: e6d093294a764db6a5acfcf808f83b0f
msgid "Performance can be improved by setting the :ref:`sensors position parameters <common-sensor-offset-compensation>`.  For example if the camera gimbal is mounted 2cm forward and 5cm below the frame's center of rotation set :ref:`FLOW_POS_X <FLOW_POS_X>` to 0.02 and :ref:`FLOW_POS_Z <FLOW_POS_Z>` to 0.05."
msgstr ""

