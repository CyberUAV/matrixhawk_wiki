#: ../../source/docs/common-hereflow.rst:5
#: 1f66afd14a6e463291d78dfc7a61af3d
msgid "CubePilot HereFlow Optical Flow Sensor"
msgstr ""

#: ../../source/docs/common-hereflow.rst:9
#: f4a6c6d5089a4069bb4e3ceb7a5375a1
msgid "The `HereFlow optical flow sensor <https://docs.cubepilot.org/user-guides/flow-senor/here-flow>`__ is a lightweight optical flow sensor including a short range lidar which uses the CAN protocol to communicate with the autopilot.  This can be used to improve horizontal position control especially in GPS denied environments."
msgstr ""

#: ../../source/docs/common-hereflow.rst:16
#: 25bbee26f2e449b0bec4690f5c454fff
msgid "The lidar included with the HereFlow is very short range especially outdoors.  We strongly recommend using a :ref:`longer range lidar instead <common-rangefinder-landingpage>`."
msgstr ""

#: ../../source/docs/common-hereflow.rst:19
#: 06389dd0446244e8bff1e433934d6019
msgid "Where to Buy"
msgstr ""

#: ../../source/docs/common-hereflow.rst:21
#: 728eaee16bc446a097a72767ce0a7182
msgid "The sensor is available from `CubePilot resellers <https://www.cubepilot.org/#/reseller/list>`__"
msgstr ""

#: ../../source/docs/common-hereflow.rst:24
#: 2ea3d972b62f4af091ee0b1ddd95269f
msgid "Connection to Autopilot"
msgstr ""

#: ../../source/docs/common-hereflow.rst:30
#: bbf269d61fe9440b93a10f60f63c6621
msgid "The flow sensor should be mounted on the underside of the copter with the camera lens pointing downwards.  The side of the sensor with the lens should be towards the front of the vehicle."
msgstr ""

#: ../../source/docs/common-hereflow.rst:31
#: d1caeea2c9c84797be7ad5b91a5552f9
msgid "Connect the sensor to the autopilots' CAN port (if using a Cube note that pre-Apr 2019 boards have CAN1 and CAN2 swapped)"
msgstr ""

#: ../../source/docs/common-hereflow.rst:32
#: 734ff5b98b264cb298be106a59fd85bf
msgid "Set :ref:`FLOW_TYPE <FLOW_TYPE>` = 6 (DroneCAN)"
msgstr ""

#: ../../source/docs/common-hereflow.rst:33
#: 650fca39b673466398b3400fd971e5b6
msgid "Set :ref:`CAN_P1_DRIVER <CAN_P1_DRIVER>` = 1 to enable DroneCAN"
msgstr ""

#: ../../source/docs/common-hereflow.rst:34
#: 6daf35b60d964ef282e8d1b93d7d2270
msgid "Set :ref:`CAN_D1_PROTOCOL <CAN_D1_PROTOCOL>` = 1 (DroneCAN)"
msgstr ""

#: ../../source/docs/common-hereflow.rst:35
#: b3af7d9fe5994af7ade1fb157188e6e8
msgid "Optionally set :ref:`BRD_BOOT_DELAY <BRD_BOOT_DELAY>` = 3000 (3 seconds) to slow the autopilot's startup which allows the flow sensor to boot up first and avoid initialisation issues"
msgstr ""

#: ../../source/docs/common-hereflow.rst:37
#: 4835faf478f14fbfb50e4880ad712b62
msgid "To use the onboard lidar (not recommended):"
msgstr ""

#: ../../source/docs/common-hereflow.rst:39
#: 575b905a4de74b53b035c1fa68247d05
msgid "Set :ref:`RNGFND1_TYPE <RNGFND1_TYPE>` = 24 (DroneCAN)"
msgstr ""

#: ../../source/docs/common-hereflow.rst:40
#: ad946a21553848d0a80c6cfb83bf4979
msgid "Set :ref:`RNGFND1_MAX <RNGFND1_MAX>` = 3 to set range finder's maximum range to 3m"
msgstr ""

#: ../../source/docs/common-hereflow.rst:43
#: b91f8e56259144ceb1a39eae9894a770
msgid "Additional Notes"
msgstr ""

#: ../../source/docs/common-hereflow.rst:45
#: 84df5480e9e6484998bf845d5d23b54f
msgid "As with the :ref:`PX4Flow sensor <common-px4flow-overview>` a range finder is required to use the sensor for autonomous modes including :ref:`Loiter <loiter-mode>` and :ref:`RTL <rtl-mode>`"
msgstr ""

#: ../../source/docs/common-hereflow.rst:46
#: 7250fbd3a725499e96604b695afe1e23
msgid ":ref:`FlowHold <flowhold-mode>` does not require the use of a rangefinder"
msgstr ""

#: ../../source/docs/common-hereflow.rst:47
#: c383481e5e3148f696a5592e6a7e7b44
msgid "Performance can be improved by setting the :ref:`sensors position parameters <common-sensor-offset-compensation>`.  For example if the sensor is mounted 2cm forward and 5cm below the frame's center of rotation set :ref:`FLOW_POS_X <FLOW_POS_X>` to 0.02 and :ref:`FLOW_POS_Z <FLOW_POS_Z>` to 0.05."
msgstr ""

