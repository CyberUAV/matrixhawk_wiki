msgstr ""

#: ../../source/docs/common-kakuteh7wing.rst:156
#: 3e2183152d7b4504878a65334a52209f
msgid "Then reboot."
msgstr ""

#: ../../source/docs/common-kakuteh7wing.rst:158
#: f6db2a609f80416a980c7ea31511609f
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` 8"
msgstr ""

#: ../../source/docs/common-kakuteh7wing.rst:160
#: 4d801ba660904efc8acd92a3bc646004
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` 4"
msgstr ""

#: ../../source/docs/common-kakuteh7wing.rst:162
#: 8525d0b45e13483996d82b9a2a97ff2a
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 18.18"
msgstr ""

