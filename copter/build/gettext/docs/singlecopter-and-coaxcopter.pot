#: ../../source/docs/singlecopter-and-coaxcopter.rst:44
#: fc63ae9447a547e8807625fff6c8c88c
msgid "Loading the Firmware"
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:46
#: c4296fb9936543039f354d9fbc8f374e
msgid "All of the multicopter firmware (quad, hexa, octa, octaquad, y6, tri, single, coax) including single and coax copter have been consolidated into a single firmware. This means the quad (or other multicopter) firmware should be loaded onto the autopilot and then please set:"
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:49
#: 29b18f6929614307a2872e27722287bd
msgid ":ref:`FRAME_CLASS <FRAME_CLASS>` to 8 for SingleCopter or 9 for CoaxCopter"
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:52
#: b68834a8901041dd80fd1c1a08e02102
msgid "Setting up the flaps"
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:54
#: 17ba5697e1034374aba93e4641a9c278
msgid "The neutral position, direction of movement, minimum and maximum deflection of each flap can be configured with the SERVOx_TRIM, SERVOx_REVERSED, SERVOx_MIN and SERVOx_MAX parameters (where \"x\" is the RC output number).  For example these are the parameters for the forward flap/servo which is connected to RC output 1:"
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:56
#: a84805a0a5db4e53a68dffa3b127d961
msgid ":ref:`SERVO1_MIN <SERVO1_MIN>`: the forward flap/servo's lowest PWM value before it hits its physical limits."
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:57
#: 227ad13fe3a24b359869bcbb3b5c70f8
msgid ":ref:`SERVO1_MAX <SERVO1_MAX>`: the forward flap/servo's highest PWM value before it hits its physical limits."
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:58
#: 954b1b1bcc8543f395a2967384f72786
msgid ":ref:`SERVO1_TRIM <SERVO1_TRIM>`: the forward flap/servo's PWM value close to what is required to keep the vehicle from spinning."
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:59
#: f4754bf00f264554946c60acbb0cacfd
msgid ":ref:`SERVO1_REVERSED <SERVO1_REVERSED>`: the forward flap/servo's reverse setting.  0 = servo moves in default direction, 1 to reverse direction of movement."
msgstr ""

