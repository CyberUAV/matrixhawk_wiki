msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:71
#: ../../source/docs/singlecopter-and-coaxcopter.rst:77
#: 077832689c844487beefaf7d8de4e861
#: 4b153bcbb6c94ed1accf14e164dddad6
msgid "transmitter roll right makes forward and back fins move right"
msgstr ""

#: ../../source/docs/singlecopter-and-coaxcopter.rst:72
#: ../../source/docs/singlecopter-and-coaxcopter.rst:78
#: b9b0d14925a84e47b1109227043f2ac4
#: 0356761a2eec4acda732aca333f75638
