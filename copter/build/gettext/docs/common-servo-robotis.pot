#: ../../source/docs/common-servo-robotis.rst:5
#: e196f2a87a1f4c7480646929514bb175
msgid "Robotis Servos"
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:9
#: 3cdc58ffb18c4b22b697b0852fdd0240
msgid "Robotis Dynamixel servos are high-end \"smart actuators\" featuring built in motion control hardware that can be controlled by ArduPilot once connected to the autopilot's serial port."
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:11
#: 87f9b445d3ae422a99377e5fd6b63112
msgid "Robotis servos using the \"`DYNAMIXEL Protocol 2.0 <http://emanual.robotis.com/docs/en/dxl/protocol2/>`__\" are supported. The `XM430\\-W350\\-T <https://emanual.robotis.com/docs/en/dxl/x/xm430-w350/>`__ in particular is known to work correctly with ArduPilot."
msgstr ""

#: ../../source/docs/common-servo-robotis.rst:15
#: 5f4bbd28dcdc4c26b6bc671f8051357b
msgid "Support for this peripheral may not be included in standard firmware releases. If needed, use the `custom firmware server <https://custom.ardupilot.org>`__ to  create a firmware that does."
msgstr ""

