msgid "Disable Parachute release"
msgstr ""

#: ../../source/docs/common-parachute.rst:100
#: 277b26d9b6954585b1c367400139f678
msgid "1"
msgstr ""

#: ../../source/docs/common-parachute.rst:100
#: 348b82d4079c463fa0740f4409ef0b34
msgid "Enable Parachute release"
msgstr ""

#: ../../source/docs/common-parachute.rst:102
#: 35d56e4d3c444cf9ad6004c0327eaac1
msgid "2"
msgstr ""

#: ../../source/docs/common-parachute.rst:102
#: 5b8e9065e13e4b58ab0b785c1ac0b0d5
