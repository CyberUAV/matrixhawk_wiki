#: ../../source/docs/common-parachute.rst:41
#: 712b2eb5d5af45519a66e2e450499891
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-parachute.rst:43
#: 80c67e00b3ac4209b3a4b7c9484a22d4
msgid "The parachute release mechanism can be triggered from either a Relay or a PWM (i.e. Servo). If a Relay pin is used, use a release mechanism that requires a high output level to trigger, since GPIOs are forced low during the bootloader period, and set the corresponding ``RELAYx_DEFAULT`` to OFF or No Change to avoid triggering the release during autopilot initialization."
msgstr ""

#: ../../source/docs/common-parachute.rst:50
#: e071ecc740aa41a595c47f288d76fc29
msgid "Setup through the Mission Planner"
msgstr ""

#: ../../source/docs/common-parachute.rst:52
#: defdece5966d4654ab7a054aaab4da97
msgid "To configure the parachute release, first connect to the autopilot with Mission Planner, and then open the CONFIG->Full Parameter List tab and set the following parameters."
msgstr ""

#: ../../source/docs/common-parachute.rst:56
#: 14e4e99c577049a2b13c169bcdf06426
msgid ":ref:`CHUTE_ENABLED <CHUTE_ENABLED>` = \"1\". Then refresh parameters, or reboot, to see the Chute parameters."
msgstr ""

#: ../../source/docs/common-parachute.rst:57
#: 7767b84f692c48f9b03aa5e83b00dce6
msgid ":ref:`CHUTE_CRT_SINK<CHUTE_CRT_SINK>` should be set to the sink rate in m/s that will trigger the chute release."
msgstr ""

#: ../../source/docs/common-parachute.rst:58
#: 187b79d2513740cf87d701e7e040392d
msgid ":ref:`CHUTE_ALT_MIN<CHUTE_ALT_MIN>` determines the minimum altitude above HOME required for automatic parachute release to occur when loss of control is first detected ."
msgstr ""

#: ../../source/docs/common-parachute.rst:61
#: 82e6d02013c94304ac91a75785793395
msgid "Servo Release"
msgstr ""

#: ../../source/docs/common-parachute.rst:63
#: fcf1ad2f42f8457ba9d94cd6c339069c
msgid ":ref:`CHUTE_TYPE <CHUTE_TYPE>` = \"10\" to release with a servo"
msgstr ""

#: ../../source/docs/common-parachute.rst:64
#: 2945b41ffc604d0a857f83efae319c17
msgid ":ref:`CHUTE_SERVO_ON <CHUTE_SERVO_ON>` should be set to the servo position required to release the parachute"
msgstr ""

#: ../../source/docs/common-parachute.rst:65
#: 31d26d098c20406d8f1aa7a472baee0e
msgid ":ref:`CHUTE_SERVO_OFF <CHUTE_SERVO_OFF>` should be the \"resting\" servo position.  I.e. the position the servo is in before the parachute is released"
msgstr ""

#: ../../source/docs/common-parachute.rst:66
#: 4c01075ffc8d45348f61a7bb9e83a64a
msgid "set :ref:`SERVO9_FUNCTION <SERVO9_FUNCTION>` = \"27\". On autopilots with an IOMCU (Outputs labeled MAIN and AUX), ``SERVO9`` refers to the Pixhawk's AUX OUT 1. To use AUX OUT2 instead set :ref:`SERVO10_FUNCTION <SERVO10_FUNCTION>` to 27, etc."
msgstr ""

#: ../../source/docs/common-parachute.rst:69
#: e4a4aa066f51487cac12a07ffcaed343
msgid "Relay Release"
msgstr ""

#: ../../source/docs/common-parachute.rst:72
#: 9e73e669ffd4431dad3e7062992fd0c3
msgid ":ref:`This function is a GPIO and has limited current capabilities.<gpio-warning>`"
msgstr ""

#: ../../source/docs/common-parachute.rst:74
#: 7ddb79ea96ff40b78d91ac64c036317a
msgid "Determine/Configure a pin to be a GPIO (see :ref:`common-gpios`)."
msgstr ""

#: ../../source/docs/common-parachute.rst:75
#: 60778f461caa4ea78b152331c0c9e401
msgid "Set that pin number as one of the RELAY outputs and assign that relay to the parachute function. For example, for GPIO pin 51 using the first relay, set :ref:`RELAY1_PIN<RELAY1_PIN>` = 51 and :ref:`RELAY1_FUNCTION<RELAY1_FUNCTION>` = 3 (Parachute)."
msgstr ""

#: ../../source/docs/common-parachute.rst:76
#: 9865fdac2b0f49d29d8f395876548b6a
msgid "Since GPIOs are always set low initially during the bootloader period, to avoid accidental release, always use a release mechanism that needs a high output level to trigger and set."
msgstr ""

#: ../../source/docs/common-parachute.rst:77
#: 44e8be5fbc9c41bcbe36026288e86869
msgid ":ref:`CHUTE_TYPE<CHUTE_TYPE>` = 0 to release with a relay. Set the corresponding relay function parameter, such as :ref:`RELAY1_FUNCTION<RELAY1_FUNCTION>` (for RELAY1), to 3 (Parachute) to choose which relay output is used."
msgstr ""

#: ../../source/docs/common-parachute.rst:86
#: 6f767c95499949fba5aa4fd83940745b
msgid "Manual Release"
msgstr ""

#: ../../source/docs/common-parachute.rst:88
#: b201c152fc1946d29078495caa3d2bee
msgid "The pilot can manually release the parachute using an RC channel/switch: set an ``RCx_OPTION`` to either 22 (Parachute Release) or 23 (Parachute 3Pos). Either function, when the RC channel is high, above :ref:`CHUTE_ALT_MIN<CHUTE_ALT_MIN>`, and is armed (Copter) or flying (Plane). See following section for requirements."
msgstr ""

#: ../../source/docs/common-parachute.rst:91
#: 385f2b36c4194b56926af6e5341bb6fc
msgid "MAVLink Command Release"
msgstr ""

#: ../../source/docs/common-parachute.rst:93
#: 67742aa357e0457bab005f325c9d6b70
msgid "The parachute may also be released/enabled/disabled via Ground Control Station command: MAV_CMD_DO_PARACHUTE (cmd id #208). This command has a parameter1 field that determines the action:"
msgstr ""

#: ../../source/docs/common-parachute.rst:96
#: b23f48a146014ff58f8bce33c4819795
msgid "param1"
msgstr ""

#: ../../source/docs/common-parachute.rst:96
#: fbf5cb1efe9541a8a887efc549035da3
msgid "Action"
msgstr ""

