msgstr ""

#: ../../source/docs/quiktune.rst:22
#: ac666317f1a24e8d9aadb81e3931e225
msgid ":ref:`ATC_RAT_PIT_P<ATC_RAT_PIT_P__AC_AttitudeControl_Multi>` and :ref:`ATC_RAT_PIT_I<ATC_RAT_PIT_I__AC_AttitudeControl_Multi>`"
msgstr ""

