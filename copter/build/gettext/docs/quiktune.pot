msgid ":ref:`ATC_RAT_YAW_P<ATC_RAT_YAW_P__AC_AttitudeControl_Multi>` and :ref:`ATC_RAT_YAW_I<ATC_RAT_YAW_I__AC_AttitudeControl_Multi>`"
msgstr ""

#: ../../source/docs/quiktune.rst:26
#: b240c39e00b246eabf578b5ee6b498cd
msgid "The advantage over :ref:`AutoTune <autotune>` is that QuikTune is safer because the vehicle does not need to move or twitch. The disadvantage is that QuikTune cannot find the vehicle's maximum rotational accelerations (e.g. :ref:`ATC_ACC_R_MAX<ATC_ACC_R_MAX>`, :ref:`ATC_ACC_P_MAX<ATC_ACC_P_MAX>`, :ref:`ATC_ACC_Y_MAX<ATC_ACC_Y_MAX>`)"
msgstr ""

#: ../../source/docs/quiktune.rst:30
#: 0f9cbc2798694e6ca17bda5d4e0c5499
msgid "Installing the Script"
msgstr ""

#: ../../source/docs/quiktune.rst:32
#: 5e7123e934e84c3a8b3808cf301ee3f1
msgid "Set :ref:`SCR_ENABLE <SCR_ENABLE>` = 1 to enable scripting and then reboot the autopilot"
msgstr ""

#: ../../source/docs/quiktune.rst:33
#: eba6d04a2ffd4391a7e9f4de57a83fb1
msgid "Download `VTOL-quicktune.lua <https://raw.githubusercontent.com/ArduPilot/ardupilot/master/libraries/AP_Scripting/applets/VTOL-quicktune.lua>`__ to your PC"
msgstr ""

#: ../../source/docs/quiktune.rst:34
#: ed12c28f841141e8bfb40d23a937accb
msgid "Copy the script to your autopilot's SD card's APM/scripts directory.  If using MP it may be easiest to use the Config, MAVFtp screen"
msgstr ""

#: ../../source/docs/quiktune.rst:40
#: 38e18bf451024840a659cec230e34740
msgid "Reboot the autopilot and set QUIK_ENABLE = 1"
msgstr ""

#: ../../source/docs/quiktune.rst:41
#: a4823d5da4834a68b5f867527478fea7
msgid "If an RC switch will be used to start/stop the tune set RCx_OPTION = 300 where \"x\" is the RC input channel number.  Alternatively set one of Mission Planner's Aux Function tab's rows to \"Scripting1\""
msgstr ""

#: ../../source/docs/quiktune.rst:48
#: f2d15b1ff2db4954a29e916609797e83
msgid "Running QuikTune"
msgstr ""

#: ../../source/docs/quiktune.rst:50
#: a71ce3eeac25456dbdef175d5e61a32b
msgid "Wait for a calm day and go to an open area with good GPS reception"
msgstr ""

#: ../../source/docs/quiktune.rst:51
#: f5dba2d9b9714890b242d74178636799
msgid "Connect with a ground station (e.g Mission Planner or QGC) and ensure that the Messages tab can be seen.  This is where output from the tune will appear"
msgstr ""

#: ../../source/docs/quiktune.rst:52
#: 6cdbb2664e764f48b5186103f6bd88e0
msgid "Move the RC switch to the low position OR push MP's Aux Function's \"Low\" button"
msgstr ""

#: ../../source/docs/quiktune.rst:53
#: f5441fb5e1954dca8c7d2c2a6a683176
msgid "Arm and takeoff in Loiter mode and climb to a height of about 3m"
msgstr ""

#: ../../source/docs/quiktune.rst:54
#: ac0e5f6afc5b46e0a774f31c9fb0b078
msgid "Begin the tune by moving the RC switch to the middle position OR push MP's Aux Function's \"Mid\" button"
msgstr ""

#: ../../source/docs/quiktune.rst:55
#: d325026c07654cfd8158ffd77cab3478
msgid "Monitor the progress of the tune using the GCS's Messages tab"
msgstr ""

#: ../../source/docs/quiktune.rst:56
#: 8c6ed0223d9a4d32bf054b8efb30e986
msgid "If necessary reposition the vehicle using the RC transmitter.  This will temporarily pause tuning and restore the original gains.  Tuning will resume a few seconds after the RC sticks are returned to their center position"
msgstr ""

#: ../../source/docs/quiktune.rst:57
#: adec6c8e95f541d4ba38b29fd869de92
msgid "If the vehicle begins oscillating violently cancel the tune by moving the RC switch to the low position OR push MP's Aux Function's \"Low\" button"
msgstr ""

#: ../../source/docs/quiktune.rst:58
#: 70cd0f985f29436f9250638f5ef0b480
msgid "Once the tune has completed accept the new gains by moving the RC aux switch to the high position OR push MP's Aux Function's \"High\" button"
msgstr ""

#: ../../source/docs/quiktune.rst:59
#: 83e4aa9bfac0494baa5f3a8787bbb037
msgid "Land and disarm the vehicle"
msgstr ""

#: ../../source/docs/quiktune.rst:62
#: b83bcb16e9e94d2e82cbc1ade0193dcd
msgid "Advanced Configuration"
msgstr ""

