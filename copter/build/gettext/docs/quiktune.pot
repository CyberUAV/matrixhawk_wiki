#: ../../source/docs/quiktune.rst:5
#: 56eb6ec19a084344a457a9c6de248e65
msgid "QuikTune"
msgstr ""

#: ../../source/docs/quiktune.rst:10
#: 067f704a76364d3d9ca836c467bdc372
msgid "The `VTOL QuikTune <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_Scripting/applets/VTOL-quicktune.md>`__ Lua script simplifies the process of finding a good tune for a multicopter's attitude control parameters."
msgstr ""

#: ../../source/docs/quiktune.rst:12
#: 5d771dfff3a345d9ad125023a95c782f
msgid "The script slowly increases the relevant gains until it detects an oscillation.  It then reduces the gains by 60% and moves onto the next gain. Once all the gains have been tuned the tune completes and the user can decide to save or discard the new gains."
msgstr ""

#: ../../source/docs/quiktune.rst:15
#: 9b6d0be6b5f6471f9dd8582e31d62955
msgid "be sure that you have prepared the vehicle for tuning by setting up parameters discussed here: :ref:`setting-up-for-tuning`. Also to assure the best tune, setup the noise notch filtering, see :ref:`common-imu-notch-filtering`. You may run QuickTune without this step to obtain initial fine tune, see :ref:`ac_rollpitchtuning` if the vehicle can't do an initial hover stably. Then setup the filters and retune for best results."
msgstr ""

#: ../../source/docs/quiktune.rst:17
#: b272e4391aaa421f9ea0a9ae58cd3a0e
msgid "The script attempts to tune all these parameters (in the given order)"
msgstr ""

#: ../../source/docs/quiktune.rst:19
#: 935105a7eff74786bdf123742767c9b1
msgid ":ref:`ATC_RAT_RLL_D<ATC_RAT_RLL_D__AC_AttitudeControl_Multi>`"
msgstr ""

#: ../../source/docs/quiktune.rst:20
