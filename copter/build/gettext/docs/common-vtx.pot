#: bc274cbdae2043fab127ee96b533326c
msgid "Parameter modification via CRSF OpenTX lua scripts (or OpenTX AgentX lua scripts) - CRSF only"
msgstr ""

#: ../../source/docs/common-vtx.rst:87
#: e42f7e35c16e417e96798efeaaaed20d
msgid "Spektrum VTX support. VTX settings on your Spektrum transmitter will be translated by either the DSMX or SRXL2 drivers and the appropriate VTX settings updated"
msgstr ""
