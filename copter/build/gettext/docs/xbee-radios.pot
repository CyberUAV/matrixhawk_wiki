#: ../../source/docs/xbee-radios.rst:272
#: 8e162ee408574e6e85bf3a5444381217
msgid "Using the USB adapter board:"
msgstr ""

#: ../../source/docs/xbee-radios.rst:274
#: a58f189bc7f140738ecfa597d1935be7
msgid "Take the module out of the interface board."
msgstr ""

#: ../../source/docs/xbee-radios.rst:275
#: 6d839b638e5c4f18b970c580157c9145
msgid "Connect the interface board to the computer."
msgstr ""

#: ../../source/docs/xbee-radios.rst:276
#: 63b4bac4fdac41aeb6749674b4c2eacb
msgid "Open X-CTU make sure Baud Rate is set to 9600"
msgstr ""

#: ../../source/docs/xbee-radios.rst:277
#: ac7d3a0d84234e5bbad2104883743815
msgid "Go to \"Modem Configuration\""
msgstr ""

#: ../../source/docs/xbee-radios.rst:278
#: 95dcf992c78c46ec82e42b25dcd0fd6f
msgid "Put a check in the \"Always update firmware\" box"
msgstr ""

#: ../../source/docs/xbee-radios.rst:279
#: a91ccb9c1624410e9b9350378130d7fd
msgid "Select proper modem from drop down menu (for the 900Mhz ones recommended above select \"XBP09-DP\"; for 2.4GHZ Xeebee Pro 2 select \"XBP24-B\")"
msgstr ""

#: ../../source/docs/xbee-radios.rst:282
#: 13761712519c431c8781ea605c785ada
msgid "Click on the \"Write\" button. After a few seconds of trying to read the modem, you will get an Info box that says Action Needed. At this point, CAREFULLY insert the module into the interface board. After a few seconds, this should trigger a reloading of the firmware."
msgstr ""

#: ../../source/docs/xbee-radios.rst:286
#: dbcc0390264e48e38b8423f1e55c60f3
msgid "You may get the info box again a short while after; if so just repeat the previous step a few times and it should work."
msgstr ""

#: ../../source/docs/xbee-radios.rst:288
#: 7a8ffb263bda44bdb80e2e7a486adcdc
msgid "This will put the module back to 9600 baud. Set your X-CTU PC settings to that and test it. It should report back that it's recognized."
msgstr ""

#: ../../source/docs/xbee-radios.rst:291
#: c4f40c503e564953b365a5ae6be20856
msgid "Once you've confirmed that it's working again, make you sure you reset its baud rate (typically 57k for APM) and VID number to match your other module."
msgstr ""

