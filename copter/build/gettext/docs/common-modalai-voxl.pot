#: ../../source/docs/common-modalai-voxl.rst:75
#: ffdecb92b2ec4ff7974bf7b847460867
msgid ":ref:`EK3_SRC1_VELXY <EK3_SRC1_VELXY>` = 3 (GPS)"
msgstr ""

#: ../../source/docs/common-modalai-voxl.rst:76
#: 80bbb165b8964e65b45bed3f78fe783f
msgid ":ref:`EK3_SRC1_POSZ <EK3_SRC1_POSZ>` = 1 (Baro)"
msgstr ""

#: ../../source/docs/common-modalai-voxl.rst:77
#: f0fae5d919984a07ab1896a789a0e668
