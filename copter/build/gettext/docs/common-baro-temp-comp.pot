#: ../../source/docs/common-baro-temp-comp.rst:5
#: 2c3bb0a1e93f465b85c4a4eeb9f48d58
msgid "Barometer Temperature Compensation"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:9
#: 4173a6972f2a412484fc295cc5f255f6
msgid "Some small autopilots with very tightly packed components can suffer from bad altitude control if the barometer suffers from significant changes in reported pressure as the temperature changes.  The barometer temperature compensation feature can be used to partially correct this issue."
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:13
#: 1ddec58fdd454edd8d55e644b3408485
msgid "This feature is not useful for most autopilots including the Pixracer and Pixhawk family of boards"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:17
#: 2fae7dc737504ebe8725a62debfeaeb1
msgid "This feature is available in Copter-3.6 (and higher)"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:20
#: 90f0ff3f55bb44a8b934369ccc9b5a10
msgid "How to Use"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:22
#: 48a32c424685453ab3494b332e182eef
msgid "set :ref:`TCAL_ENABLED <TCAL_ENABLED>` to 2 (to learn and use calibration)"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:23
#: 7f15a5be18ab49f3b26cebef58784e61
msgid "power down the board and let it cool for a few minutes"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:24
#: 5ce2963c678f46f097fd694860e648ed
msgid "power on the board and leave it for about 10 minutes"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:25
#: 9b11671df51b4e0a9400e4f4982fdb50
msgid "learning will happen as the board heats up and while it is not moving"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:26
#: c3aade92ef1048a4b100a746ca717107
msgid "the :ref:`TCAL_BARO_EXP <TCAL_BARO_EXP>` should be updated with a non-zero value"
msgstr ""

#: ../../source/docs/common-baro-temp-comp.rst:27
#: cc6358a11ac74b8abdb300c683714316
msgid "optionally turn off learning by setting :ref:`TCAL_ENABLED <TCAL_ENABLED>` to 1 (to use but not learn new calibration values)"
msgstr ""
