#: ../../source/docs/common-mambaf405-mini.rst:72
#: bfe6128f71cd41cf90371d0111272cc7
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:74
#: cb36a3cc2c284e4b80a0653aad5bf9ae
msgid "RC input is configured on the RX1 (UART1_RX) pin. It supports all serial RC protocols."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:76
#: 21abba4845614aaf9f5fc2775fe19f7e
msgid ":ref:`SERIAL1_PROTOCOL<SERIAL1_PROTOCOL>` is set to \"23\" by default, and:"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:78
#: cdb0e3ca9edb4d858872ca3b14e256ad
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:80
#: ad27295eac7a4ed4b95929d2a8d7c040
msgid "SBUS/DSM/SRXL connects to the RX1 pin, but SBUS requires that the :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` be set to \"3\"."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:82
#: abb8acc0f5b24946906525d801c0ab43
msgid "FPort requires connection to TX1 and :ref:`SERIAL7_OPTIONS<SERIAL7_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:84
#: 8ae33a781ac24275af886280df260ea9
msgid "CRSF also requires a TX1 connection, in addition to RX1, and automatically provides telemetry. Set :ref:`SERIAL1_OPTIONS<SERIAL7_OPTIONS>` to \"0\"."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:86
#: 78d5dc922dbc4b59a72de2c433e9987e
msgid "SRXL2 requires a connection to TX1 and automatically provides telemetry.  Set :ref:`SERIAL1_OPTIONS<SERIAL1_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:88
#: 9f6af6f7dbf24836b2bc24d7eac894b2
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:91
#: 5e0831e52a9b46999014265d79b78ee7
msgid "FrSky Telemetry"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:93
#: 1f2f1a03499a4c849aaf8382895b4ad8
msgid "FrSky Telemetry is supported using any UART TX pin. You need to set the following parameters to enable support for FrSky S.PORT (example given for UART4)"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:95
#: efb89829ee84460dbec9ebf57cc08b53
msgid ":ref:`SERIAL4_PROTOCOL<SERIAL4_PROTOCOL>` = 10"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:96
#: 43eccdf2e33a453e8fdfc0b63d9d4170
msgid ":ref:`SERIAL4_OPTIONS<SERIAL4_OPTIONS>` = 7"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:99
#: dfe5fc3f47e541f6b5c0e2b9a52595f1
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:101
#: 7a48e7e3887748e2bff9552874b99b52
msgid "The Mamba MK4 F405Mini supports internal OSD using :ref:`OSD_TYPE<OSD_TYPE>` = 1 (MAX7456 driver)."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:104
#: 912a7db4ee9a436eba5c1aedb8034c97
msgid "DJI Video"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:106
#: 2ebc8df91fd047afbdca46f61e534054
msgid "A standard DJI video connector is provided. Set :ref:`OSD_TYPE<OSD_TYPE>` to \"3\" (MSP) or \"5\" (DisplayPort) depending on use, and set :ref:`SERIAL3_PROTOCOL<SERIAL3_PROTOCOL>` to \"32\" (MSP) or \"42\" (DisplayPort) also."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:109
#: 1a2fd42ff966400384310682d3288a20
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:111
#: b88788521fd849b5ac2de1021113dcc2
msgid "The Mamba MK4 F405Mini supports up to 7 PWM outputs, all are DShot capable. The pads for motor output M1 to M4 are provided on  the motor connector and are BDShot capable, plus there is M7 on a separate pad for LED strip or another PWM output."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:113
#: 54f733cc3cd64008855b42eb64530053
msgid "The PWM is in 4 groups:"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:115
#: 76c073be8f7d420fa8fc6f7ebf06ac30
msgid "PWM 1,2 in group1  (if used for :ref:`GPIOs <common-gpios>` their reference pin numbers are 50 and 51, respectively)"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:116
#: 192b37178fa24d5289bdb19e1bd0b1f5
msgid "PWM 3,4 in group2 (if used for :ref:`GPIOs <common-gpios>` their reference pin numbers are 52 and 53, respectively)"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:117
#: 84fd2fe3974543ff83a029eabada5d47
msgid "PWM 5,6 in group3 (if used for :ref:`GPIOs <common-gpios>` their reference pin numbers are 54 and 55, respectively)"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:118
#: fbae8ed626f84a6bae74f79fb9c59897
msgid "PWM 7 (LED) in group4 (if used for :ref:`GPIOs <common-gpios>` its reference pin number is 56)"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:120
#: bc3490e5f54c4173a9daaf70d4006605
msgid "Channels within the same group need to use the same output rate. If any channel in a group uses DShot then all channels in the group need to use DShot. Channels 1-4 support bi-directional DShot."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:123
#: 73adc8a913a3464d9da19cd984d4f353
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:125
#: 5b5f7743e86842b49dc5add1ac8fb502
msgid "The board does not have a built-in current sensor. The voltage sensor can handle up to 6S LiPo batteries."
msgstr ""

