msgid ":ref:`BATT_MONITOR<BATT_MONITOR>` = 4"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:130
#: 6dddbada9bc24dfbbc004b4735ef9837
msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 11"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:131
#: a1d2717ebf5d4a41a9ccfd18f4eeb377
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 13"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:132
#: c5bbbdabc03c40f3b560d3a3ce3bfabb
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` = 11.1"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:133
#: 5a1a7594ef434e9ba34cf07e67269761
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` = 64 (will depend on external current sensor)"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:136
#: 2be29fbdae2a4e95b10a38e7a9bf9931
msgid "Compass"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:138
#: f4322f236126424f8f873bdc27b4b1fd
msgid "The Mamba MK4 F405Mini does not have a built-in compass, but you can attach an external compass using I2C on the SDA and SCL pads."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:141
#: a9eee9adb64b4ac3af286c347eeefe3e
msgid "RSSI"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:143
#: 1bb84e16d5e54bf7bcdb382159ece7d0
msgid "Analog RSSI input, if used, :ref:`RSSI_ANA_PIN<RSSI_ANA_PIN>` should be set to \"12\"."
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:146
#: 790a3b9072d140b5bf973c6792069109
msgid "Loading Firmware"
msgstr ""

#: ../../source/docs/common-mambaf405-mini.rst:148
#: b8396f0a2b534e67bf0c37770b6170cd
msgid "Firmware for this board can be found `here <https://firmware.ardupilot.org>`_ in  sub-folders labeled \"MambaF405-2022\"."
msgstr ""

