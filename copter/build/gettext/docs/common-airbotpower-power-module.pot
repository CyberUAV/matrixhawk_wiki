msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:38
#: e915e0199f7448fbb612091092bad56a
msgid "1 x 12 Volts power feed up to 3.5 amps (requires >=4S batteries)"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:39
#: a71b432f85d54e0d9bd24070f11c2393
msgid "Equivalent of three L/C filters on each power feed"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:40
#: 90e9c449587741598bcae2d0cbf4a224
msgid "Equivalent of three ferrites on each power feed"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:41
#: 3c92588d47064ae2b242818dd497f437
msgid "Voltage spikes suppression with 5.6V Zener diode (5Watts) + Capacitor on autopilot servo rail"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:43
#: fb5f14be3c5e4d3bbe37059d2b20f045
msgid "HALL EFFECT current measurement (ACS758) for currents to 150 amps"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:44
#: 7fc60c0c7b9a4f589d9b0df15471db2a
msgid "A dip-switch configurable 3S to 8S Voltage measurement"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:45
#: 6118e4cd91a54713b1acd9d2a27c0bc6
msgid "A primary DF13 6 position connector for direct plugging into autopilot power port"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:47
#: c841d7c2bcec4eb7bc1602b19a0b05b2
msgid "A redundant 5.3V servo connector for standard servo cabling into autopilot servo rail"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:49
#: 02c1cb48a4af436d9317fa7520a03624
msgid "A standard 12V servo connector output for powering FPV devices"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:50
#: b63da820016e4843bd747ff099f35aa7
msgid "Oversized double redundant parallel battery inputs (solder through pads, for 10 or 12AWG wires)"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:52
#: f2e8960f5d1b4cc9862ac66dd7a83698
msgid "Modular design separating the Power functions and the distribution function in two boards : allows to retrofit any drone already assembled with an existing Power Distribution Board (PDB). Stackable optional AirbotPDB distributionBoard, via XT150 connectors (less than 3cm height with stacked optional PDB)"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:57
#: 299b850ab33549f2881c712191347d4e
msgid "Large XT150 heavy duty connectors solder pads to either stack AirbotPDB or to link to an existing PDB. Flexibility to connect to PDB via connectors or soldered cables."
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:60
#: 7c6678d647c346458cee81c00537dd69
msgid "Overcurrent, ESD and shorts protections on all three BECs"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:61
#: ac5c0ff6bf624633812ad61594b903b0
msgid "No messy wiring & no cable fiddling thanks to a 6-pin DF13 output connector to connect the board to the autopilot's 6-pin power port."
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:63
#: ca723ebb203447d2a3950120f640b39a
msgid "Board dimensions (W x D) : 50 x 50 mm. A very compact format using standard 45x45 mm screw holes spacing (M3)"
msgstr ""

#: ../../source/docs/common-airbotpower-power-module.rst:65
#: d9301e46b28847519902b7c77394fb69
msgid "Lightweight and clean surface mount design: 21 grams"
msgstr ""

