#: ../../source/docs/common-non-gps-to-gps.rst:5
#: 41147a988c364c04825eaf613190012c
msgid "GPS / Non-GPS Transitions"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:10
#: fb938724517045fe8fb30b80ca7b9fd3
msgid "ArduPilot supports in-flight transitions between GPS and Non-GPS environments."
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:12
#: 9c918657818b42188967f39d3e18351f
msgid "Non-GPS navigation is available for all vehicles. However, it is not applicable to fast or high flying vehicles such as conventional Planes. QuadPlanes can utilize this when in VTOL operation and close to the ground, as when docking inside a hangar using 3D cameras or beacons."
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:15
#: 5787ca07738840c5b0b82e5a8983f4b2
msgid "Setup"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:17
#: 8eddc70900f84ae4a332d1faa1ce4924
msgid "To enable transitions, the EKF3 must be used, which is the default.  Instructions for enabling EKF3 can be found on the :ref:`Extended Kalman Filter page <common-apm-navigation-extended-kalman-filter-overview>` but in short it requires setting the following parameters:"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:19
#: f33d9e778db24b559873e86379aac212
msgid ":ref:`EK3_ENABLE <EK3_ENABLE>` = 1"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:20
#: c718931b8d744d6888322945f2d3fd2b
msgid ":ref:`EK2_ENABLE <EK2_ENABLE>` = 0"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:21
#: d952d282942d40dd82b97836d60ef302
msgid ":ref:`AHRS_EKF_TYPE <AHRS_EKF_TYPE>` = 3"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:23
#: a9cc5f45adda4008bd53218efa75faa8
msgid "Up to three \"sets\" of sensor sources are supported.  Normally the primary set should be configured for the GPS environment.  Below is the default setup:"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:25
#: 261d47314cbf42ceacb113c5bff31b15
msgid ":ref:`EK3_SRC1_POSXY <EK3_SRC1_POSXY>` = 3 (Primary horizontal position from GPS)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:26
#: 7a7719a79191460eb7e07de26e32c443
msgid ":ref:`EK3_SRC1_VELXY <EK3_SRC1_VELXY>` = 3 (Primary horizontal velocity from GPS)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:27
#: f279435365f947d2a5f4adb6d873d395
msgid ":ref:`EK3_SRC1_POSZ <EK3_SRC1_POSZ>` = 1 (Primary vertical position from barometer)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:28
#: fa982c90fb88410d8591fd3671ad7cd5
msgid ":ref:`EK3_SRC1_VELZ <EK3_SRC1_VELZ>` = 3 (Primary vertical velocity from GPS)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:29
#: 99ac9b128e6749218a89d96ff1a60e07
msgid ":ref:`EK3_SRC1_YAW <EK3_SRC1_YAW>` = 1 (Primary yaw/heading from compass)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:31
#: d9ed0ac89179460c9e534066b757099d
msgid "The secondary sensor source set should be configured for the non-GPS environment.  Please refer to the setup instructions for the :ref:`non-GPS sensor <common-non-gps-navigation-landing-page>` you plan to use.  Below is the setup if using the :ref:`Intel Realsense T265 <common-vio-tracking-camera>`:"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:33
#: e1039dcb0ff3458c8f0d3a301398c552
msgid ":ref:`EK3_SRC2_POSXY <EK3_SRC2_POSXY>` = 6 (Secondary horizontal position from External Nav)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:34
#: ec0a42f0143644889abf135dbbc7b2e1
msgid ":ref:`EK3_SRC2_VELXY <EK3_SRC2_VELXY>` = 6 (Secondary horizontal velocity from External Nav)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:35
#: 7d25c0ce756f429c80488e47ba5b32a5
msgid ":ref:`EK3_SRC2_POSZ <EK3_SRC2_POSZ>` = 1 (Secondary vertical position from barometer)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:36
#: 13c01f1f3e214b989d9e5598ac086f5b
msgid ":ref:`EK3_SRC2_VELZ <EK3_SRC2_VELZ>` = 6 (Secondary vertical velocity from External Nav)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:37
#: 292add8b88c6482d8abc4ade2f650cbf
msgid ":ref:`EK3_SRC2_YAW <EK3_SRC2_YAW>` = 6 (Secondary yaw/heading from External Nav)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:39
#: d60dc8ef6d4245c6a2784a7a08bf7b80
msgid "The fusing of all velocities should be disabled by unchecking the :ref:`EK3_SRC_OPTIONS <EK3_SRC_OPTIONS>` parameter's \"FuseAllVelocities\" bit:"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:41
#: bdd0baefdf404619b24194ebc9ab548f
msgid ":ref:`EK3_SRC_OPTIONS <EK3_SRC_OPTIONS>` = 0"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:43
#: 1e24237088c74ff4af1ee11f23680e60
msgid "The pilot can manually switch between the source sets using a 3-position :ref:`auxiliary switch <common-auxiliary-functions>` configured for \"EKF Pos Source\" (90).  When the switch is pulled low, the primary source set will be used.  Middle position is for the secondary source set and High is for the tiertiary source set.  If the transmitter's channel 8 switch is to be used set:"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:45
#: b7c8e47297a54b8390dc3d8f3a8dd16a
msgid ":ref:`RC8_OPTION <RC8_OPTION>` = 90 (EKF Pos Source)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:47
#: 9ac15b1f84424d77b059e2b2e63e0c91
msgid ":ref:`Lua scripts <common-lua-scripts>` can be used to automatically switch between sources based on information from the sensors (i.e. GPS speed accuracy, rangefinder distance, etc) or \"innovations\" from the EKF (\"innovations\" are a measure of how close the sensor's latest sensor data matches the EKF's estimate)."
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:49
#: d014983abe8c43f9ae0c28c6e91e1c4c
msgid "`ahrs-source.lua <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_Scripting/examples/ahrs-source.lua>`__ switches between GPS, T265 and optical flow"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:50
#: cfd97e673f27472a8c2efcc47730ac60
msgid "`ahrs-source-gps-optflow.lua <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_Scripting/examples/ahrs-source-gps-optflow.lua>`__ switches between GPS and optical flow (AP 4.2 and higher)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:51
#: 14caaf5eb42645d48e32acf31aa02b5c
msgid "`ahrs-source-gps-wheelencoders.lua <https://github.com/ArduPilot/ardupilot/blob/master/libraries/AP_Scripting/examples/ahrs-source-gps-wheelencoders.lua>`__ switches between GPS and wheel encoders (AP 4.2 and higher)"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:54
#: f0fd0c5d014441fcbec02c2151aa586b
msgid "Testing"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:56
#: e55e33463c524687ae1284b06b30b8c8
msgid "First perform a bench test, using the auxiliary switch to manually switch between sources."
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:58
#: 833c3ec540fd45629e1844a0ab1bd76a
msgid "Connect with a ground station and confirm that after switching sources, text messages appear indicating that the EKF has changed sources.  If using Mission Planner these messages will appear in on the Data screen's Messages tab"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:59
#: 4ee9db06d9884fe9968c9fdfdae4b5e4
msgid "After changing sources wait 10 seconds to confirm the EKF remains healthy. If using Mission Planner the EKF label on the HUD should remain white"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:60
#: f23d5edcc47241808536c26c2e4ad961
msgid "Check the vehicle's horizontal position, altitude and heading using the ground station.  If using GPS with the :ref:`Intel Realsense T265 <common-vio-tracking-camera>` you should notice a jump when switching from the T265 to GPS but not when switching from GPS to T265.  This is because the \"ExternalNav\" position is always updated to match the GPS when the GPS is the primary source set"
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:62
#: d36173df8ae1474590fae7e1ef3683b3
msgid "Next perform a flight test in a safe environment, manually switching between sources.  Be prepared to re-take control in a manual mode such as Stabilize."
msgstr ""

#: ../../source/docs/common-non-gps-to-gps.rst:64
#: 02595880aed449e2b4e48d0605797622
msgid "If you plan to automatically switch sources, first walk the vehicle between the GPS and Non-GPS environments to confirm it is switching source sets.  Finally perform a flight test in which the vehicle is flown (or driven) at low speeds between the two environments.  As with previous tests be ready to re-take control in a manual mode such as Stabilize."
msgstr ""

