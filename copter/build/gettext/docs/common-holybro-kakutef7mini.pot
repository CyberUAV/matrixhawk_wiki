#: 8919f866f1544a56944b518a0eb4fabf
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` 10.9"
msgstr ""

#: ../../source/docs/common-holybro-kakutef7mini.rst:130
#: dc98d3d29d044e5db134f6be7aa167f5
msgid ":ref:`BATT_AMP_PERVLT<BATT_AMP_PERVLT__AP_BattMonitor_Analog>` should be set to match external current sensor, if used."
