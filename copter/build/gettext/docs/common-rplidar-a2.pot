#: ../../source/docs/common-rplidar-a2.rst:37
#: 5bcb64fd05ab46658cf35231aa698a26
msgid "The lidar should be mounted horizontally on the top or bottom of the vehicle with the black cable pointing towards the rear of the vehicle. Ensure the sensor's view is not obstructed by any portion of the vehicle including GPS mast, vehicle legs etc."
msgstr ""

#: ../../source/docs/common-rplidar-a2.rst:40
#: 6b4be759fa854d6eb31dc3572e664411
msgid "The lidar can be connected to the autopilot's serial input as shown above. Be sure that the autopilot's 5V supply is capable of supplying the unit's required current. Otherwise provide an independent 5V supply to the unit."
msgstr ""

#: ../../source/docs/common-rplidar-a2.rst:43
#: d7466ba53bf64f0e9317b268bc6b9998
msgid "Example setup below shown for first proximity sensor using SERIAL1 UART:"
msgstr ""

#: ../../source/docs/common-rplidar-a2.rst:45
#: 3dfabe5385b04901957835cb62c8d9e8
msgid ":ref:`SERIAL1_PROTOCOL <SERIAL1_PROTOCOL>` = \"11\" (\"Lidar360\")"
msgstr ""

#: ../../source/docs/common-rplidar-a2.rst:46
#: 427d796ed0aa46c29a5e128e660a7a91
msgid ":ref:`SERIAL1_BAUD <SERIAL1_BAUD>` = \"460800\" for C1, \"115\" for A2, \"256\" for S1, A2M12"
msgstr ""

#: ../../source/docs/common-rplidar-a2.rst:47
#: 9b81f387a7a8497781f0fede8fd60a9b
msgid ":ref:`PRX1_TYPE <PRX1_TYPE>` = \"5\""
msgstr ""

#: ../../source/docs/common-rplidar-a2.rst:48
#: 6a62a2b218a0453f9eee22a03d06b9f1
msgid ":ref:`PRX1_ORIENT <PRX1_ORIENT>` = \"0\" if mounted on the top of the vehicle, \"1\" if mounted upside-down on the bottom of the vehicle."
msgstr ""

#: ../../source/docs/common-rplidar-a2.rst:50
#: 8b834f318e1b4391a53c6fae491de473
msgid "It may be necessary to turn off flow control if using Telem1 (aka Serial1) or Telem2 (aka Serial2)"
