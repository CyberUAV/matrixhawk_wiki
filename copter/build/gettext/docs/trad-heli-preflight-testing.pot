#: ../../source/docs/trad-heli-preflight-testing.rst:5
#: 850be9013b7e40a4a22018c5758a4d15
msgid "Traditional Helicopter - Pre-Flight Testing"
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:7
#: ad22b4ed35634987a886eb1bd919ad1a
msgid "Before your first flight, please follow these pre-flight checks:"
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:11
#: e40ce71ccba64be9a0f5864483222064
msgid "The drive should be disconnected on electric helicopters when they are being handled. An accidental startup can cause serious injury."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:14
#: 33d0679d0dcb417ea933b1f1ca51a9f1
msgid "Ensure the USB connector is disconnected from the autopilot"
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:15
#: feec950fc7fb438fa77e1cc0a191bad6
msgid "Connect the battery to power the autopilot and servos"
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:18
#: 7645b9439dd143ed837025dee23006e4
msgid "Test leaning the helicopter in Stabilize mode"
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:20
#: 42503cc737274568b98bd3764554b095
msgid "By hand, roll the helicopter to the left. The swash plate should lean to the right."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:22
#: a54f3c53aa8b45af819ed7c09e0391ae
msgid "Roll the helicopter to the right. The swash plate should lean to the left."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:24
#: 616e2d32967244cc99c410826ec8d4ec
msgid "Pitch the helicopter down (i.e. nose down). The swash plate should lean backwards."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:26
#: 6a5ca199c9f84a2fbdd197ccaf5f129e
msgid "Pitch the helicopter up (i.e. nose up). The swash plate should lean forwards."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:28
#: 5090bf1e719849d9b30cba64e92fc142
msgid "Rotate the helicopter quickly clockwise - the tail servo should move as if you had pushed the rudder control left (i.e. it should try to fight against the rotation)"
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:31
#: 3d48794839464b65b3acccabedcd01ca
msgid "Rotate the helicopter quickly counter-clockwise - the tail servo should move as if you had pushed the rudder control right (i.e. it should try to fight against the rotation)"
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:34
#: 6c99aa3a14644c6faa25e5778324c5ee
msgid "Next rotate the helicopter slowly. You should find that in a certain direction the rudder stays in the middle."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:38
#: 8e0cb25f09274415aff780997eae5ef3
msgid "Test the transmitter in Stabilize mode"
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:40
#: caf3cbf2d8854d7ba52ac4f63bba9cf2
msgid "Using the transmitter, move the roll stick to the left. The swashplate should lean slightly to the left."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:42
#: 3e6ae9c57008465d8c152938852e81c0
msgid "move the roll stick to the right. The swashplate should lean slightly to the right."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:44
#: f353a64d209142bea12c5323dfaf77b2
msgid "Move the pitch stick forward. The swashplate should lean slightly forward."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:46
#: 50d3f74d4df945e6a8585e62287f8a50
msgid "Move the pitch stick back. The swashplate should lean slightly backwards."
msgstr ""

#: ../../source/docs/trad-heli-preflight-testing.rst:48
#: c9e42dd92926409098db740cbf7402dd
msgid "Move the yaw stick to the left or right. The tail should move in the same direction (and about the same amount) as when you are in manual mode."
msgstr ""
