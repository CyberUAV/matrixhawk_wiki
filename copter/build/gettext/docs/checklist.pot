#: ../../source/docs/checklist.rst:5
#: 6dc2855dff7a4ea5b7d32d91b921c200
msgid "Pre-Flight Checklist (Copter)"
msgstr ""

#: ../../source/docs/checklist.rst:7
#: 7ccb07efcee14ec18a5e35202e36b9c0
msgid "This page is provides a list of things to check following configuration, and before your first flight."
msgstr ""

#: ../../source/docs/checklist.rst:11
#: 633d867d4bb64d7c8fe052e208e78a7a
msgid "Summary Checklist"
msgstr ""

#: ../../source/docs/checklist.rst:17
#: 58dbd15ae2604d3db590c77617f255ad
msgid "Configuration"
msgstr ""

#: ../../source/docs/checklist.rst:19
#: 67e417d0f66e4fe387edf7dca6f1136a
msgid "Spin up the propellers on the ground and check they are all moving :ref:`in the correct orientation <connect-escs-and-motors_attach_propellers>`."
msgstr ""

#: ../../source/docs/checklist.rst:21
#: 4277cea7347c4dd094a66163d7093ba8
msgid "Check that your copter knows what level is. With the copter on a flat surface connect to Mission Planner and ensure the artificial horizon display shows level."
msgstr ""

#: ../../source/docs/checklist.rst:24
#: bf6ec2f064fd44e6a70d14d11e3f5e99
msgid "Check all failsafe settings are enabled. Instructions are here for :ref:`radio <radio-failsafe>`, :ref:`battery <failsafe-battery>`, and :ref:`ekf/gps <ekf-inav-failsafe>`."
msgstr ""

#: ../../source/docs/checklist.rst:29
#: cef44c5b09104e9e85910e44c54348de
msgid "Flying"
msgstr ""

#: ../../source/docs/checklist.rst:31
#: 0914faca40b145deb4c8a9dd62f081c6
msgid "Make sure you have a GPS lock before flying if you intend to use any auto modes. Even if you're only flying in Stabilized mode this is a good idea so you can invoke Return To Launch if you get into trouble."
msgstr ""

#: ../../source/docs/checklist.rst:34
#: 04df066be4284bdcbe7fdf66d70eacca
msgid "Test RTL before sending your copter off on an auto waypoint flight. This is to check that the compass and GPS are working, and that it knows where home is before heading off on a more complex flight."
msgstr ""

#: ../../source/docs/checklist.rst:37
#: 98eaef5125d84eef930989442f1e446a
msgid "Ensure that flight in Stabilize works well before you attempt any more complex flight modes. Ensure loiter works before trying RTL. Ensure RTL works before trying auto."
msgstr ""

#: ../../source/docs/checklist.rst:40
#: 397347599b99475280201da45fc518f4
msgid "Once armed stand 3m-6m away from the arming point as when in RTL the copter will be returning to this point."
msgstr ""

#: ../../source/docs/checklist.rst:42
#: 61eb17f311ad42fb923ef9d275f56b0d
msgid "When testing more complex flight modes, be ready to switch back to Stabilize mode at any moment if it does anything strange. Stabilize or Acro are the only modes which can save you from a problem with the software or sensors. RTL is a good mode to save you from human error, but relies on the copter being able to locate and fly itself, so this should not be used as an emergency mode if other auto flight modes go wrong."
msgstr ""

#: ../../source/docs/checklist.rst:49
#: 171fe535fbba4ac4a0013b574ecee101
msgid "Be sure you have a way of knowing when your battery is getting low, and land before you have used more than 80% of your battery capacity."
msgstr ""
