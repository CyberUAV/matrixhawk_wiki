#: 535de2d623204ed09b4e548a8f245988
msgid ":ref:`ATC_RAT_RLL_FLTD <ATC_RAT_RLL_FLTD__AC_AttitudeControl_Multi>`: :ref:`INS_GYRO_FILTER <INS_GYRO_FILTER>` / 2"
msgstr ""

#: ../../source/docs/setting-up-for-tuning.rst:78
#: 93e313fb46bc4c02a0bfeac6f6bb8116
msgid ":ref:`ATC_RAT_RLL_FLTT <ATC_RAT_RLL_FLTT__AC_AttitudeControl_Multi>`: :ref:`INS_GYRO_FILTER <INS_GYRO_FILTER>` / 2"
msgstr ""

#: ../../source/docs/setting-up-for-tuning.rst:79
#: 5f50d6d57fa042418eba71d1daa8ec7b
msgid ":ref:`ATC_RAT_YAW_FLTE <ATC_RAT_YAW_FLTE__AC_AttitudeControl_Multi>`: 2"
msgstr ""

