#: ../../source/docs/tradhelihil.rst:48
#: 0443b3e7f73f43c3aabef50180b4d61a
msgid "Start the AP Mission Planner and perform the following set-up:"
msgstr ""

#: ../../source/docs/tradhelihil.rst:50
#: 4cf87de5943243d89e254cdf97adfc45
msgid "select Simulation from the Menu"
msgstr ""

#: ../../source/docs/tradhelihil.rst:51
#: 04d5498415b54ac5be64cd605246c425
msgid "check AeroSimRC"
msgstr ""

#: ../../source/docs/tradhelihil.rst:52
#: 491f946636e845cea59b0cde93741ac8
msgid "check Heli"
msgstr ""

#: ../../source/docs/tradhelihil.rst:53
#: 6af392e39649404d9306ff3e6ca80a7b
msgid "check Reverse Rudder and Display All"
msgstr ""

#: ../../source/docs/tradhelihil.rst:54
#: 271f41dc62f349889c22287d816730ca
msgid "set Roll gain = 4500"
msgstr ""

#: ../../source/docs/tradhelihil.rst:55
#: dbbd414ebb2d4c9cb4e19ad078246518
msgid "set Pitch gain = 4500"
msgstr ""

#: ../../source/docs/tradhelihil.rst:56
#: 479dc32f463d4c39a90a1250334218af
msgid "set Throttle gain = 4500"
msgstr ""

#: ../../source/docs/tradhelihil.rst:57
#: 3cf686a015e048808fa821c861517a5b
msgid "set Rudder gain = 300"
msgstr ""

#: ../../source/docs/tradhelihil.rst:58
#: 591b2dc6fce54c95bec249452c2ed4b3
msgid "select Save Settings so that you don't need to this next time"
msgstr ""

#: ../../source/docs/tradhelihil.rst:59
#: 537e24598f8f4a5ab3516e10ac92c82c
msgid "connect your APM to you PC through the USB port"
msgstr ""

#: ../../source/docs/tradhelihil.rst:60
#: e35c8fe7d91041ceb20795a5352e90ec
msgid "ensure the COM port and baud is correct in the APMissionPlanner and push the Connect button"
msgstr ""

#: ../../source/docs/tradhelihil.rst:62
#: 0cb5c50274804ec4abaa2ff45deb66f1
msgid "push SimLink Start/Stop button, you should see \"Sim Link Started\""
msgstr ""

#: ../../source/docs/tradhelihil.rst:67
#: ac238cffd3384d49ada7335b117e5d76
msgid "Start AeroSIM-RC and perform the following setup"
msgstr ""

#: ../../source/docs/tradhelihil.rst:69
#: f2a2f2e21d4545c2b5c73c12ff1ec113
msgid "select SIM, Select Model, Heli 30 from the menu"
msgstr ""

#: ../../source/docs/tradhelihil.rst:70
#: 5940e7eae7c14508a9178d83ecf558b7
msgid "select plug-ins, APM from the menu"
msgstr ""

#: ../../source/docs/tradhelihil.rst:71
#: fd6540c851204ee6ac8c4e341ce2b532
msgid "you should find the engines in the RC helicopter immediately start and that you are able to control the RC heli much like the real helicopter"
msgstr ""
