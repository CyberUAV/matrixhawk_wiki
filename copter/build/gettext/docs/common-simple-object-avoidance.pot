#: 7d437d9c27d845ed994cbaa27d5796f3
msgid "Example setup below shown for first proximity sensor:"
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:64
#: 21642e0fb08b4d9f94e86407268c48f4
msgid "set :ref:`AVOID_ENABLE <AVOID_ENABLE>` = 7 (\"All\") to use all sources of barrier information including \"Proximity\" sensors"
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:65
#: 846c7511a58444119bb19e85744cfb28
msgid "set :ref:`PRX1_TYPE <PRX1_TYPE>` to a 360 deg Lidar type being used or = 4, to enable using a range finders as a \"proximity sensor\""
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:66
#: 1b8c5497425545af99be69fa75235e3a
msgid "in :ref:`Loiter <loiter-mode>`"
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:68
#: 9ee09d7b7d83488b9ad654ee2cf06864
msgid ":ref:`AVOID_MARGIN <AVOID_MARGIN>` controls how many meters from the barrier the vehicle will attempt to stop or try to slide along it"
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:69
#: b62c7f3d5d5447eb9402ae4c5040bf35
msgid ":ref:`AVOID_BEHAVE <AVOID_BEHAVE>` allows setting whether the vehicle should simply Stop in front of the barrier or Slide around it. This parameter only affects Copter, since Rover always stops."
