#: ../../source/docs/common-simple-object-avoidance.rst:72
#: 4fff04e4e80f44c2884b1325e01670f3
msgid "Configuring Simple Avoidance for Rover"
msgstr ""

#: ../../source/docs/common-simple-object-avoidance.rst:75
#: e77f760813d747e8bb1388b0c2785dfc
msgid "set :ref:`AVOID_ENABLE <AVOID_ENABLE>` = 7 (\"All\") to use all sources of barrier information including \"Proximity\" sensors."
msgstr ""

