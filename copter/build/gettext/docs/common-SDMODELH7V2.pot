#: ../../source/docs/common-SDMODELH7V2.rst:80
#: d4902dd80dee47668d116f241c0720aa
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:82
#: fb7a8e221a374cc1aff179779789a8af
msgid "RC input is configured on the R3 (UART3_RX) pin for unidirectional protocols. The T3 pin must also be used for bi-directional protocols, such as CRSF/ELRS."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:84
#: 9cb2680071ed40629bc2a91714a47177
msgid "PPM is not supported."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:86
#: 40f978f0555444c789c0700758eddd2c
msgid "SBUS/DSM/SRXL connects to the R3 pin"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:88
#: df87841e1f71471c8df54cc146a50364
msgid "FPort requires connection to T3 and :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` be set to \"7\"."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:90
#: 01af228d73ff4460a8b450f2d54d50be
msgid "CRSF also requires a T3 connection, in addition to R6, and automatically provides telemetry. Set :ref:`SERIAL3_OPTIONS<SERIAL3_OPTIONS>` to \"0\"."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:92
#: f1ec0ffaf8a448a598e9d0c755705532
msgid "SRXL2 requires a connection to T6 and automatically provides telemetry.  Set :ref:`SERIAL6_OPTIONS<SERIAL6_OPTIONS>` to \"4\"."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:94
#: 6b8a04b1d17f4c3f86c17b8b476a4522
msgid "Any UART can be used for RC system connections in ArduPilot also, and is compatible with all protocols except PPM. See :ref:`common-rc-systems` for details. CRSF/ELRS requires full DMA for maximum reliability."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:97
#: 0132cfaf0c2c460683ffa9759a6b83f7
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:99
#: 0daf9ac03f634f8e85b6fe568debeb2f
msgid "The SDMODELH7V2  supports OSD using :ref:`OSD_TYPE<OSD_TYPE>` 1 (MAX7456 driver). Simultaneous DisplayPort OSD option is also available and SERIAL1 defaults to DisplayPort protocol."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:102
#: 068fad976bcf4093b442b59388b006f9
msgid "VTX Power Switch"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:104
#: e7caafab48f04154a7c4f7489642a12e
msgid "The JST-GH-6P connector supports a standard DJI HD VTX connection. Pin 1 of the connector is 9v so be careful not to connect this to a peripheral requiring 5v. The 9v supply is controlled by RELAY_PIN2 set to GPIO 81 and is on by default. It can be configured to be operated by an RC switch by selecting the function RELAY2."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:107
#: 9173e32d8b4c45fda2b972c280088c53
msgid "Camera Control Pin"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:109
#: 105258ed831e4fc99baf24bdeb4f0d03
msgid "The Cam pin is GPIO 84 and is set to be controlled by RELAY4 by default. Relay pins can be controlled either by an RC switch or GCS command. See :ref:`common-relay` for more information."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:112
#: b28abc59832e46989786de45e4827164
msgid "PWM Output"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:114
#: cfe26260c1db481bbde1dc5ca0a4582a
msgid "The SDMODELH7V2 supports up to 8 PWM outputs. Outputs are available via two JST-SH connectors. All 8 outputs support DShot as well as all PWM types. Outputs 1-4 also support Bi-Directional DSHOT."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:116
#: c5d6ed594b9743f5892b05a883f7d170
msgid "The PWM is in 3 groups:"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:118
#: 0713eb1e66d046fba0c972340699337c
msgid "PWM 1, 2 in group1"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:119
#: d267c1a6b7f74fcd87bf2f590415f9ee
msgid "PWM 3, 4 in group2"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:120
#: 759d8bb87654496197e0a98a95148a54
msgid "PWM 5, 6 in group3"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:121
#: 7ff956da82cf4e50a42b45cbc202ae82
msgid "PWM 7, 8 in group4"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:122
#: b76caf3cf02a461e93cc02401390c875
msgid "PWM 9(LED) in group5"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:124
#: 68304c058b4046a49b3a2cfb49536be7
msgid "Channels within the same group need to use the same output rate, whether PWM or Dshot. If any channel in a group uses DShot then all channels in the group need to use DShot."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:128
#: 06db715bbc124976b851ce59433836a9
msgid "for users migrating from BetaflightX quads, the first four outputs M1-M4 have been configured for use with existing motor wiring using these default parameters:"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:130
#: 279075bd3427428b93496be59966a335
msgid ":ref:`FRAME_CLASS<FRAME_CLASS>` = 1 (Quad)"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:131
#: d1bbc5600abb465d80b0ba74d47185ad
msgid ":ref:`FRAME_TYPE<FRAME_TYPE>` = 12 (BetaFlightX)"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:134
#: dd49fd6a894f41ddaecbedce76997ed5
msgid "LED Output"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:136
#: 28caf8bf73f84e8088ee1cf0319ff4da
msgid "The LED output (PWM9) is configured by default to support :ref:`NeoPixel LED strings<common-serial-led-neopixel>`."
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:139
#: a110d9d7a0aa41f987058d5750f25676
msgid "Battery Monitoring"
msgstr ""

#: ../../source/docs/common-SDMODELH7V2.rst:141
#: 9c8b2034f56545e6811373465f1dbb57
msgid "The board has a built-in voltage sensor via the B+ pin, but no internal current sensor. An external current sensor can be connected to the CUR pin. Default parameters for both internal voltage and external current monitoring are set by default to the below for use with any Holybro Tekko32 F4 4in1 ESC."
