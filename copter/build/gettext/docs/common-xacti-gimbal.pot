msgid "Firmware Updates"
msgstr ""

#: ../../source/docs/common-xacti-gimbal.rst:108
#: 94c453e53e6c43edba5641c776735168
msgid "Firmware updates are available from Xacti directly and normally include a \"firmware.bin\" file and an empty \"UPDATE.txt\" file.  To update the camera:"
msgstr ""

