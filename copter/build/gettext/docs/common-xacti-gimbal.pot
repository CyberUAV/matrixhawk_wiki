#: 582337f743014e86aad7de7c4e56ad93
msgid "To allow remotely powering on/off the camera the POWER_ON pin can be connected to an autopilot :ref:`relay pin <common-relay>` (see purple wire in image above) and then set the following parameters (assuming the autopilot's AUX OUT 5 pin is used)"
msgstr ""

#: ../../source/docs/common-xacti-gimbal.rst:77
#: 24f3101e5e74498c98c90ac90fd67f76
msgid "Connect the camera's POWER_ON pin (shown in purple in the image above) to one of the autopilot's AUX OUT signal pins (e.g. AUX OUT 5's bottom row pin)"
msgstr ""

#: ../../source/docs/common-xacti-gimbal.rst:78
#: 6cf301e5ab454ef892d6dde60fd00945
msgid ":ref:`RELAY1_PIN<RELAY1_PIN>` to 54 (AUX5) (if connected to AUX OUT 5)"
msgstr ""

