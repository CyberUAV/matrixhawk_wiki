#: 807b7437f6fe4dcaa0da9a637deb70bd
msgid "Power down the gimbal and remove its SD card"
msgstr ""

#: ../../source/docs/common-xacti-gimbal.rst:111
#: c23ffc82317d436eb8c1ef34c5bd4146
msgid "Copy the \"firmware.bin\" and \"UPDATE.txt\" files to the SD card"
msgstr ""

#: ../../source/docs/common-xacti-gimbal.rst:112
#: b1c1234c735b4d4f956fc9a007758a6e
msgid "Power up the gimbal and wait for at least 10 seconds"
msgstr ""

#: ../../source/docs/common-xacti-gimbal.rst:113
#: 3546bb0071db4d35af00d89b847e03c2
msgid "Optionally power down the gimbal, remove the SD card and check that the \"firmware.bin\" and/or \"UPDATE.txt\" files have been deleted.  If either was deleted then the firmware update was successful"
msgstr ""

#: ../../source/docs/common-xacti-gimbal.rst:114
#: 7b9cecf811b446ddb2109df807cf5ebf
msgid "Power up the gimbal and it should operate normally"
msgstr ""

