msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:23
#: 674ac8e317b64b59bcc5cfe470ab34f2
msgid "Connecting to the Autopilot"
msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:29
#: 14647fdb1438485bb0b4e4847b6a75a7
msgid "Connect one of the autopilot's serial ports to the CubeNodeETH's UART port. For optimum performance the autopilot's serial port should support flow control which normally means using Serial1 or Serial2.  In the image above Serial2 is used."
msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:31
#: b9d79acd809a4427b1db1e7b34e77a2a
msgid "Connect one of the autopilot's CAN ports to the CubeNodeETH's CAN port.  This connection is only used to configure the device and so it maybe removed after the configuration is completed.  In the image above the autopilot's CAN1 is used."
msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:33
#: 3ddc395d347f49a3af355203cda8dbce
msgid "While difficult to see in the image above, the CubeNodeETH has a 5-pin ethernet connector with the same pin layout as the `CubeLAN 8 Port Switch <https://docs.cubepilot.org/user-guides/switch/cubelan-8-port-switch>`__"
msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:39
#: d9f91248b8994f09b4b8f6805475bd5f
msgid "The general rule when connecting ethernet devices is:"
msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:41
#: 7976315ee7ef43d3b98d7ef3c4300284
msgid "When connecting a device to a switch the pins should be connected straight through (e.g. RX+ to RX+, RX- to RX-, TX+ to TX+, TX- to TX-)"
msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:42
#: f4a63e3bf80c4a1ba1b64a94937e9da7
msgid "When connecting a device to a device the pins should be crossed (e.g. RX+ to TX+, RX- to TX-, TX+ to RX+, TX- to RX-)"
msgstr ""

#: ../../source/docs/common-cubepilot-cubenodeeth.rst:45
#: d12b1b077e7141ba8d423329c761548a
msgid "Install ArduPilot with PPP Support"
msgstr ""

