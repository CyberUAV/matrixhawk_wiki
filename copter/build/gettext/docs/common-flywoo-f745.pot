msgid ":ref:`BATT_VOLT_PIN<BATT_VOLT_PIN__AP_BattMonitor_Analog>` = 13"
msgstr ""

#: ../../source/docs/common-flywoo-f745.rst:154
#: 2ae2e169ee9b4ee6b1b991d3be991b75
msgid ":ref:`BATT_VOLT_MULT<BATT_VOLT_MULT__AP_BattMonitor_Analog>` ~ 10.9"
msgstr ""

#: ../../source/docs/common-flywoo-f745.rst:155
#: 22c82530d60a42c29a5b907415c01d80
msgid ":ref:`BATT_CURR_PIN<BATT_CURR_PIN__AP_BattMonitor_Analog>` = 12"
