#: ../../source/docs/common-X_MAV_H743v2.rst:58
#: 68a431a7581647d5991483337c98811e
msgid "RC Input"
msgstr ""

#: ../../source/docs/common-X_MAV_H743v2.rst:60
#: 18295aa001a44307a1a3ec2d66fd0fbb
msgid "The default RC input is configured on the UART5 and supports all RC protocols except PPM. The SBUS pin is inverted and connected to RX5. When using RX5 or SBUS, the other input should be unconnected. RC can be attached to any UART port as long as the serial port protocol is set to ``SERIALn_PROTOCOL=23`` and SERIAL7_Protocol  is changed to something other than '23'."
msgstr ""

#: ../../source/docs/common-X_MAV_H743v2.rst:63
#: 95dc60dafe2e429bad3f28d0f78c49ec
msgid "OSD Support"
msgstr ""

#: ../../source/docs/common-X_MAV_H743v2.rst:65
#: 52a3450a386d48f89d72316d43520e58
msgid "The AP-H743v2 supports onboard analog SD OSD using a MAX7456 chip. Simultaneously, DisplayPort HD OSD is available on the DJI connector for HD VTX. Both on board OSD and DisplayPort OSD can be operated simultaneously and are enabled by default."
msgstr ""

#: ../../source/docs/common-X_MAV_H743v2.rst:68
#: b3d57fdb0b2447e3b74c465c43ac0e97
msgid "VTX Support"
msgstr ""

#: ../../source/docs/common-X_MAV_H743v2.rst:70
#: 1cc4b17134594d399235dde2bc94e91c
msgid "The SH1.0-6P connector supports a DJI Air Unit / HD VTX connection. Protocol defaults to DisplayPort. Pin 1 of the connector is 9v so be careful not to connect this to a peripheral requiring 5v."
msgstr ""

