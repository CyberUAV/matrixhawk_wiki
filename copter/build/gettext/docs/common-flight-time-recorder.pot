#: ../../source/docs/common-flight-time-recorder.rst:7
#: 2e7717d2ae6041d486653d981eee1ccb
msgid "Flight Statistics"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:9
#: 0185e6d2d0164a97827f48e091555fc3
msgid "ArduPilot includes a flight time recorder which records the board's total flight time, total run time and number of times the board has been rebooted. Numbers of flights and total distance flown (if location sensing is available) are also provided. These are stored in user re-settable parameters meaning they are not protected from being tampered with."
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:14
#: 7f0f85ab8844464b8be880c8e426fc66
msgid "Parameter Details"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:16
#: 016bb53b420a4a8ba16d8de6129327bf
msgid ":ref:`STAT_BOOTCNT <STAT_BOOTCNT>` holds the number of times the board has been booted"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:17
#: 4b87a202722845a09796fb90eb2f3bf2
msgid ":ref:`STAT_FLTTIME <STAT_FLTTIME>` holds the total number of seconds that the board/vehicle has been flying (including all previous flights)"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:18
#: 5b10206a99b244638900a45f6c7e4736
msgid ":ref:`STAT_RUNTIME <STAT_RUNTIME>` holds the total number of seconds that the board has been powered up (including all previous flights)"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:19
#: f4c1030ec8f44cc899f4cb6850252938
msgid ":ref:`STAT_RESET <STAT_RESET>` hold the number of seconds after epoch (1st Jan 1970) since the statistics were reset if the board has a GPS to provide a real time.  Without a GPS the time will be something close to 1st Jan 1970.  The user can trigger a reset of all statistic by setting this parameter to \"0\".  This parameter will then immediately be reset again to the current time since epoch and all other parameters set back to zero."
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:20
#: 3cfeb3b719234908a1ece855dc4aa61f
msgid ":ref:`STAT_FLTCNT <STAT_FLTCNT>` holds the total number of flights"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:21
#: 715f4b973a3b4afe83c944fa451a842a
msgid ":ref:`STAT_DISTFLWN <STAT_DISTFLWN>` holds the total distance flown, assuming valid location is available during the flights"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:24
#: 4e6c771ba605468597a8e52f9ba3645d
msgid "When will counters be reset?"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:26
#: 4e771fe6142d4889810dc6faf181aeb9
msgid "The STAT parameters will not be cleared when upgrading/downgrading firmware versions of a particular vehicle type (i.e. upgrading from Copter-3.4 to 3.5 will not clear the parameters)."
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:28
#: 197b0d0eef034d80a3b950c39f17a176
msgid "The parameters are not protected meaning they can be changed by the user.  In addition they may be reset when:"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:30
#: a0dcdb3eb3ef40a09e4e16f5432172ce
msgid "a different vehicle code is written to the board which clears all parameters (i.e. loading a copter firmware onto a board which was running the plane firmware)"
msgstr ""

#: ../../source/docs/common-flight-time-recorder.rst:31
#: 7512ffa701e84b8b997b2c75460111d4
msgid "user performs a :ref:`parameter reset <common-parameter-reset>`"
msgstr ""
