#: ../../source/docs/common-upixels-tx-series.rst:43
#: 973d5bbf195f4b8eafcd1a67aa53bc0f
msgid "Configuration and Parameters"
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:44
#: 038525bdf230456c959e19b27de7dc2f
msgid "Set :ref:`FLOW_TYPE<FLOW_TYPE>` = 9"
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:45
#: 992c40f10ad142af9800386dd53d8e3d
msgid "Set :ref:`SERIAL2_BAUD<SERIAL2_BAUD>` = 115200"
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:46
#: 9afe8cb423e44962a00fe9601f5c6159
msgid "Set :ref:`SERIAL2_PROTOCOL<SERIAL2_PROTOCOL>` = 18"
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:47
#: 114354a7c58243b8aac40d386a296af3
msgid "Set :ref:`RNGFND1_TYPE<RNGFND1_TYPE>` = 45"
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:48
#: a9a4b508236b430a88e9d0df3d7225bc
msgid "Set :ref:`RNGFND1_ORIENT<RNGFND1_ORIENT>` = 25"
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:49
#: 66347bcf90ea4068b3e38ad06876dbe6
msgid "Set :ref:`RNGFND1_MAX<RNGFND1_MAX>` = 4 (The UP-T101-Plus is set to 4 and the UP-T201 is set to 15)"
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:50
#: 1ffbeae72fa04d0fba15601d904dd6f7
msgid "Set :ref:`RNGFND1_MIN<RNGFND1_MIN>` = 0.02 (The UP-T101-Plus is set to 0.02 and the UP-T201 is set to 0.05)"
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:52
#: 2a87f394e527481ba0fd4a3316155ec2
msgid "Once the sensor is activated, you should be able to observe the optical flow and distance sensor data on the Status page of the task planner. \"opt_m_x\", \"opt_m_y\", \"opt_qua\" and \"rangefinder1\" data have been updated."
msgstr ""

#: ../../source/docs/common-upixels-tx-series.rst:55
